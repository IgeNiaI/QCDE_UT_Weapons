int lastPUCrefresh = -99999, lastPUC = -1;
#define PUC_REFRESH_RATE 35
function int PartyUpgradeCount(void)
{
	// Caching results to prevent lag spikes from massive iterating
	if(lastPUCrefresh + PUC_REFRESH_RATE > Timer() && lastPUC != -1) return lastPUC;
	lastPUCrefresh = Timer();

	int result = 0;

	int tid = 1064, w;
	while(tid --> 1000)
		if(IsTidUsed(tid))
			for(w = 0; w < NUMBER_OF_WEAPONS; w++)
				result += CheckActorInventory(tid, WeaponUpgrades[w][0][WU_TOKEN])
				        + CheckActorInventory(tid, WeaponUpgrades[w][1][WU_TOKEN]);

	lastPUC = result;
	return lastPUC;
}

