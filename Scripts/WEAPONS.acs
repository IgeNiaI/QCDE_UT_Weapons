	//					Name					Ammo Class		Ammo Use	Proj Speed	Min Dist	Max Dist	Flags	Alt Fire chance
	// Strong weapons
	TDB_Weapon_Pri(		"QCTriboltDM",			"QCBoltAmmo",		1,		30.0,		0.0,		400.0,		TDB_CW_PROJECTILE);
	TDB_Weapon_Pri(		"QCRocketLauncherDM",	"QCRocketAmmo",		1,		34.0,		0.0,		400.0,		TDB_CW_PROJECTILE|TDB_CW_EXPLOSIVE);
	TDB_Weapon_Pri(		"QCLightningGunDM",		"QCCoilAmmo",		1,		0.0,		200.0,		MAX_RANGE,	0);
	//TDB_Weapon_Alt(		"QCLightningGunDM",		"QCCoilAmmo",		2,		18.0,		200.0,		700.0,		TDB_CW_PROJECTILE,									0.5);
	TDB_Weapon_Pri(		"QCRailgunDM",			"QCSlugAmmo",		1,		0.0,		600.0,		MAX_RANGE,	0);
	TDB_Weapon_Pri(		"QCBFGDM",				"QCBFGAmmo",		1,		45.0,		0.0,		700.0,		TDB_CW_PROJECTILE|TDB_CW_EXPLOSIVE);
}


// Freeman PvE Ammo Box passive. Placing the script here for weapon addons to override
// Activator: dying victim
Script "QCDE_MonsterKill_QCFreeman" (void)
{
	if(CheckInventory("MonsterBig") || CheckInventory("MonsterBoss"))
	{
		int itemAmount = 0;
		itemAmount |= (random(0, 5) & 0xFF); // Sniper
		itemAmount <<= 8;
		itemAmount |= (random(0, 6) & 0xFF); // Rocket Launcher
		itemAmount <<= 8;
		itemAmount |= (random(0, 30) & 0xFF); // Pulse Gun
		itemAmount <<= 8;
		itemAmount |= (random(0, 30) & 0xFF); // Minigun

		if (itemAmount > 0)
			DropItem(0, "FreemanWeaponBox1", itemAmount, 256);

		itemAmount = 0;
		itemAmount |= (random(0, 1) & 0xFF); // Redeemer
		itemAmount <<= 8;
		itemAmount |= (random(0, 15) & 0xFF); // Shock Rifle
		itemAmount <<= 8;
		itemAmount |= (random(0, 20) & 0xFF); // Ripper
		itemAmount <<= 8;
		itemAmount |= (random(0, 10) & 0xFF); // Flak Cannon

		if (itemAmount > 0)
			DropItem(0, "FreemanWeaponBox2", itemAmount, 256);
	}
}

//------------------------------------------------
// Give Tribolt on map03
// or after 30 minutes on one map

Script "QCDE_MapsPlayed" OPEN
{
	GiveActorInventory(0,"MapsPlayed",1);
}

Script "QCDE_FreeTribolt" (void)
{
	if(GameType() >= GAME_NET_DEATHMATCH) terminate;
	if(CheckInventory("QCTribolt")) terminate;

	if(CheckInventory("MapsPlayed") != 2 + (GameType() == GAME_SINGLE_PLAYER))
		delay(30 * 60 * 35);

	SpawnForced("QCTribolt", GetActorX(0),GetActorY(0),GetActorZ(0));
}

Script "QCDE_ZoomControl" (int predicting, int justPressed, int justReleased, int buttons)
{
	if (!predicting)
	{
		// in UTDE, only Sniper  Rifle can zoom
		if (CheckWeapon("QCRailgun") || CheckWeapon("QCRailgunDM"))
		{
			bool shouldZoomIn = !CheckInventory("WeaponZoomedToken") && justPressed;
			bool shouldZoomOut = CheckInventory("WeaponZoomedToken") && GetCVar("cl_holdZoom") ? justReleased : justPressed;

			if (shouldZoomIn)
			{
				SetNetworkReplicationFlags( NETREP_SKIPOWNER );
				PlaySound(0,"UTDE/Weapons/SniperRifle/ZoomIn",CHAN_7,1.0,false);
				SetNetworkReplicationFlags( 0 );
				SetInventory("WeaponZoomedToken", 1);
				SetPlayerWeaponZoomFactor(PlayerNumber(), GetCVar("cl_sniperZoom"));
			}
			else if (shouldZoomOut)
			{
				SetNetworkReplicationFlags( NETREP_SKIPOWNER );
				PlaySound(0,"UTDE/Weapons/SniperRifle/ZoomOut",CHAN_7,1.0,false);
				SetNetworkReplicationFlags( 0 );
				SetInventory("WeaponZoomedToken", 0);
				SetPlayerWeaponZoomFactor(PlayerNumber(), 1.0);
			}
		}
	}
}

Script "UTDE_RlAltCheck" (void)
{
	if(GetPlayerInput(-1, INPUT_BUTTONS) & BT_ATTACK)
		SetResultValue(1);
	else
		SetResultValue(0);
}



script "UTDE_HoldBioNoAmmo" (void)
{
	if(GetPlayerInput(-1, INPUT_BUTTONS) & BT_ALTATTACK)
		SetResultValue(1);
	else
		SetResultValue(0);
}

#define MOVEMENT_BUTTONS (BT_MOVELEFT|BT_FORWARD|BT_MOVERIGHT|BT_BACK)
script "UTDE_StationarySniperUpgrade" (void)
{
	// This passive is human-scum-only.
	if(PlayerIsBot(PlayerNumber())) terminate;

	while(strcmp(GetWeapon(),"QCRailgun") == 0)
	{
		SetNetworkReplicationFlags( NETREP_SKIPOWNER );
		bool takeCharges = GetPlayerInput(-1, INPUT_BUTTONS) & MOVEMENT_BUTTONS || !CheckInventory("WeaponZoomedToken");
		bool giveCharges = !takeCharges && CheckInventory("RG_UG_Explosive") && CheckInventory("RailgunCharges") < 52;
		if (takeCharges)
		{
			TakeInventory("RailgunCharges",32767);
		}
		else if (giveCharges)
		{
			GiveInventory("RailgunCharges",1);
			if (CheckInventory("RailgunCharges") >= 52)
			{
				PlaySound(0,"QC/Weapons/Railgun/ChargeFull",CHAN_6,1.0,false);
			}
		}
		SetNetworkReplicationFlags( 0 );

		delay(1);
	}
}