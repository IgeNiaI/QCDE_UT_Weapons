	TDB_Weapon_Pri(		"QCMachinegunDM",		"QCBulletAmmo",		1,		0.0,		200.0,		MAX_RANGE,	0);
	TDB_Weapon_Pri(		"QCHeavyMachinegunDM",	"QCBulletAmmo",		1,		0.0,		200.0,		MAX_RANGE,	0);
