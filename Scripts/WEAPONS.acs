	TDB_Weapon_New(		"QCSuperNailgunDM",		2);
	TDB_Weapon_New(		"QCTriboltDM",			2);
	TDB_Weapon_New(		"QCRocketLauncherDM",	3);
	TDB_Weapon_New(		"QCLightningGunDM",		3);
	TDB_Weapon_New(		"QCRailgunDM",			3);
	TDB_Weapon_New(		"QCBFGDM",				4);

	// Setup fire modes
	//					Name					Ammo Class		Ammo Use	Proj Speed	Min Dist	Max Dist	Flags								Alt Fire chance
	// Abilities
	TDB_Weapon_Pri(		"DukeFreezeThrower",	"DukeAmmo",			1,		25.0,		0.0,		400.0,		TDB_CW_PROJECTILE);
	TDB_Weapon_Pri(		"SamMinigun",			"SeriousBullets",	1,		0.0,		0.0,		700.0,		0);
	TDB_Weapon_Alt(		"SamMinigun",			"SeriousBullets",	1,		0.0,		0.0,		400.0,		0,									0.5);

	//					Name					Ammo Class		Ammo Use	Proj Speed	Min Dist	Max Dist	Flags	Alt Fire chance
	// Starter weapons + upgrades
