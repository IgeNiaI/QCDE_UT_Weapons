//----------------------------------------------------------------------
// Script for controlled redeemer rocket
#DEFINE SPEED    16
#DEFINE TURNSPEED_BASE 0.008
#DEFINE TURNSPEED_UPGRADED 0.015
int greymask[64];

// Activator: controlled rocket
Script "QCDE_RocketControl" (void)
{
	int tid = GUIDEDROCK_TIDBASE + GetActorProperty(0, APROP_TargetTID) - 1000;
	int plrtid = GetActorProperty(0, APROP_TargetTID);
	int plr = plrtid - 1000;
	//printbold(s:"rocket flying with tid ", d:tid, s:", from ", n:plr + 1);

	Thing_ChangeTID(0, tid);

	SetActivator(plrtid);
	// Activator: rocket owner

	int turnSpeed = TURNSPEED_BASE;
	if (CheckInventory("BFG_UG_Charge"))
		turnSpeed = TURNSPEED_UPGRADED;

	delay(1);

	SetNetworkReplicationFlags( NETREP_SKIPOWNER );
	ChangeCamera(tid, false, false);
	SetNetworkReplicationFlags( 0 );
	SetActivator(tid);
	// Activator: controlled rocket

	greymask[plr] = true;
	int origa = GetActorAngle(plrtid), a = origa;
	int origp = GetActorPitch(plrtid), p = origp;
	while(!CheckInventory("ImDead") && GetActorProperty(tid, APROP_Health) > 0)
	{
		SetNetworkReplicationFlags( NETREP_SKIPOWNER );

		Thing_Stop(tid);

		int ip = -GetPlayerInput(plr, INPUT_PITCH);
		if(ip >  turnSpeed) ip =  turnSpeed;
		if(ip < -turnSpeed) ip = -turnSpeed;
		p += ip;
		if(p >  0.25) p =  0.25;
		if(p < -0.25) p = -0.25;

		int spd_ver = (-sin(p) * SPEED) >> 14;
		ThrustThingZ(tid, spd_ver, 0, 0);

		int ia = GetPlayerInput(plr, INPUT_YAW);
		if(ia >  turnSpeed) ia =  turnSpeed;
		if(ia < -turnSpeed) ia = -turnSpeed;
		a += ia;

		int spd_hor = (cos(p) * SPEED) >> 16;
		ThrustThing(a>>8, spd_hor, 1, tid);
		SetActorAngle(tid, a);
		SetActorPitch(tid, p);

		SetNetworkReplicationFlags( 0 );

		delay(1);

		int triggers = GetPlayerInput(plr, INPUT_BUTTONS) & ~GetPlayerInput(plr, INPUT_OLDBUTTONS);
		if(triggers & (BT_ATTACK | BT_ALTATTACK))
			GiveInventory("ImDead",1);
	}
	greymask[plr] = false;
	while(IsTidUsed(tid))
	{
		delay(1);
	}
	SetNetworkReplicationFlags( NETREP_SKIPOWNER );
	SetActorAngle(plrtid, origa);
	SetActorPitch(plrtid, origP);
	SetNetworkReplicationFlags( 0 );

	SetActivator(plrtid);
	SetPlayerProperty(0,0,PROP_TOTALLYFROZEN);
}

//this is the dark screen effect, will loop until the projectile terminates it manually
Script "QCDE_TunnelVision" (void)
{
	if (GetNetworkState() == NETSTATE_SERVER)
		terminate;

	delay(2); // time for rocket to initialize
	int plrtid = GetActorProperty(0, APROP_TargetTID);
	int plr = plrtid - 1000;
	SetActivator(plrtid);
	SetHudSize(320,240,1);
	SetFont("REDEEMER");
	while(greymask[plr])
	{
		//Log(s:"aaa");
		HudMessage(s:"A"; HUDMSG_PLAIN, HMID_TUNNEL_VISION + 63, -1, 160.0, 120.0, 0.1);
		delay(2);
	}
}

Script "QCDE_ResetRocketFov" (void)
{
	int tid = GUIDEDROCK_TIDBASE + GetActorProperty(0, APROP_TargetTID) - 1000;
	SetCameraToTexture(tid, "CAMERT", 90);
}


//------------------------------------------------
// Weapon alt fire modifier messages

script "QCDE_ModSelectedText" (int weapon, int upgrade)
{
	//SetHUDSize(800,600,1);
	SetHUDSize(400,300,1);
	SetFont("ESFONTAA");
	str color = strparam(s:"\c[", s:GetWeapon(), s:"]");
	HudMessage(s:color, s:WeaponUpgrades[weapon][1][WU_PROPERNAME], s:" engaged";HUDMSG_PLAIN,101,-1,200.0,240.0,0);

	while(checkinventory("WeaponZoomedToken"))
	{
		Delay(2);
	}

	ACS_NamedExecuteAlways("RemoveModText",0,0);
}

script "RemoveModText" (void)
{
	HudMessage(s:" ";HUDMSG_PLAIN,101,"SkyBlue",0.75,1.0,0.1);
}


//------------------------------------------------
// Weapon hitmarker

script "QCDE_HitMark" (void) clientside
{
	if(IsZandronum(true))
		if(ActivatorTid() != CheckPlayerCamera(ConsolePlayerNumber()))
			terminate;

	SetHUDSize(1200,900,1);
	SetFont("HITMED");
	HudMessageBold(s:"a";HUDMSG_FADEOUT,-234,-1,600.0,450.0,0.0,0.15);
}

Script "QCDE_ConfigureBotWeapons" (void)
{
	// Define ability weapons with max priority and infinite range, to prevent bots from switching to other weapons
 	TDB_Weapon_New(		"BlazkoAkimboBot",		10);
 	TDB_Weapon_New(		"CalebDollBot",			10);
 	TDB_Weapon_New(		"SlayerBFG",			10);
 	TDB_Weapon_New(		"Shieldquisitor",		10);
 	TDB_Weapon_New(		"PostalCowHead",		10);
 	TDB_Weapon_New(		"SorgaulFistsBot",		10);

 	// Setup fire modes
 	//					Name					Ammo Class		Ammo Use	Proj Speed	Min Dist	Max Dist	Flags								Alt Fire chance
 	TDB_Weapon_Pri(		"BlazkoAkimboBot",		"",					0,		25.0,		0.0,		MAX_RANGE,	TDB_CW_PROJECTILE);
 	TDB_Weapon_Alt(		"BlazkoAkimboBot",		"",					0,		0.0,		0.0,		MAX_RANGE,	0,									0.5);
 	TDB_Weapon_Pri(		"CalebDollBot",			"",					0,		0.0,		0.0,		MAX_RANGE,	TDB_CW_MELEE); // Using melee so that Caleb tried to get closer
 	TDB_Weapon_Pri(		"SlayerBFG",			"",					0,		25.0,		0.0,		MAX_RANGE,	TDB_CW_PROJECTILE);
 	TDB_Weapon_Pri(		"Shieldquisitor",		"",					0,		0.0,		0.0,		MAX_RANGE,	0);
 	TDB_Weapon_Pri(		"PostalCowHead",		"",					0,		14.0,		0.0,		MAX_RANGE,	TDB_CW_PROJECTILE);
 	TDB_Weapon_Pri(		"SorgaulFistsBot",		"",					0,		0.0,		0.0,		MAX_RANGE,	TDB_CW_MELEE);

	// Define normal weapons
	//					Name				Priority
	TDB_Weapon_New(		"DukeFreezeThrower",	4);
	TDB_Weapon_New(		"SamMinigun",			3);
	TDB_Weapon_New(		"QCGauntlet",			0);
