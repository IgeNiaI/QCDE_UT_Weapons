
FreeformMenu QCDE_SkirmishWeapons
{
	InsertFreeformMenu QCDE_SkirmishWeaponsCommon

	// no weapon bonus mechanics
}

FreeformMenu "QCDE_OptionsSkins"
{
	NoBackButton
	TopPadding 40
	DefaultSelection -2
	//OverrideHeight 320

	Label {
		Static
		Background	"BackMenw"
		Pos		0, 20
		Size	450, 500
	}

	Label {
		Pos		0, 50			Font		SmallFont
		Anchor	center, top		FontColor	DarkGray
		Text	"UT weapons addon doesn't support weapon skins yet"
	}


	InsertFreeformMenu MainMenuTopBar
	InsertFreeformMenu QCDE_OptionsTabs
}


FreeformMenu "QCDE_OptionsZoom"
{
	Label { // empty label to increase menu height
		Pos 0, 270
	}

	Label {
		Pos		0, 130				Font		QCSMFONT
		Anchor	center, center		FontColor	Gold
		Text	"Zoom"
	}

	Label {
		Pos		-85, 151			Font		SmallFont
		Anchor	right, center		FontColor	DarkGray
		Text	"Zooming Speed"
	}
	TextField {
		Pos		-67, 150		CVar				cl_fovchangespeed		Background			TX05028
		Size	25, 14			Font				SmallFont				SelectedBackground	TX05028S
		Anchor	center, center	SelectedFontColor	Gray
		Padding	0, 1
	}
	Slider {
		Pos		-50, 150		CVar	cl_fovchangespeed
		Size	105, 6			Range	1.0, 100.0, 1.0
		Anchor	left, center	MouseArea	105, 14
		Textures	SLIDER, SLIDERS, SLIDERSS, 8, 14
	}

	Label {
		Pos		-85, 171			Font		SmallFont
		Anchor	right, center		FontColor	DarkGray
		Text	"Sniper Rifle Zoom"
	}
	TextField {
		Pos		-67, 170		CVar				cl_sniperZoom			Background			TX05028
		Size	25, 14			Font				SmallFont				SelectedBackground	TX05028S
		Anchor	center, center	SelectedFontColor	Gray
		Padding	0, 1
	}
	Slider {
		Pos		-50, 170		CVar	cl_sniperZoom
		Size	105, 6			Range	1.1, 5.0, 0.1
		Anchor	left, center	MouseArea	105, 14
		Textures	SLIDER, SLIDERS, SLIDERSS, 8, 14
	}

	Label {
		Pos		80, 150				Font		SmallFont
		Anchor	left, center		FontColor	DarkGray
		Text	"Hold to zoom"
	}
	Option {
		Pos		185, 150			CVar				cl_holdZoom
		Size	14, 14				Values				QCDE_CheckText
		Anchor	right, center		BackgroundValues	QCDE_CheckBG
		MouseArea	105, 14			UnknownBackground	CHKBOX
									SelectedForeground	CHKBOXS, 14, 14
	}
}

FreeformMenu "QCDE_OptionsControls"
{
	NoBackButton
	TopPadding 40
	DefaultSelection -2

	Label {
		Static
		Background	"BackMenw"
		Pos		0, 20
		Size	450, 500
	}

	InsertFreeformMenu QCDE_OptionsControlsCommon

	InsertFreeformMenu QCDE_OptionsZoom

	InsertFreeformMenu MainMenuTopBar
	InsertFreeformMenu QCDE_OptionsTabs
}

AddFreeformMenu "QCDE_OptionsSound"
{
	Label {
		Pos		80, 97				Font		SmallFont
		Anchor	left, top			FontColor	DarkGray
		Text	"Multi-Spree Announcer"
	}
	Option {
		Pos		80, 114				CVar				cl_utannouncer	UnknownBackground	OP21028
		Size	105, 14				Values				UT_Announcers	SelectedBackground	OP21028S
		Anchor	left, center		Font				SmallFont		SelectedForeground	OP21028A, 119, 14
		Padding	3, 1				SelectedFontColor	Gray
	}
}

OptionValue "UT_Announcers"
{
	0, "UT99"
	1, "UT2004 Male"
	2, "UT2004 Female"
	3, "UT2004 Sexy"
	4, "UT2003"
}
