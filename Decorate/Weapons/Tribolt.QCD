		TNT1 A 0 A_FireCustomMissile("BioBall1DM", 0, false, 1, 2, 0, 3)
		Goto PostFire

	Fire2:
		TNT1 A 0 A_FireCustomMissile("BioBall2DM", 0, false, 1, 2, 0, 3)
		Goto PostFire

	Fire3:
		TNT1 A 0 A_FireCustomMissile("BioBall3DM", 0, false, 1, 2, 0, 3)
