		Goto PostFire
	
	Fire9:
		TNT1 A 0 A_FireCustomMissile("BioBall9", 0, false, 1, 2, 0, 3)
		Goto PostFire
	
	Fire10:
		TNT1 A 0 A_FireCustomMissile("BioBall10", 0, false, 1, 2, 0, 3)
		Goto PostFire
	
	PostFire:
		TNT1 A 0 A_GunFlash("Flash")
		UTBR B 1 Offset(3,35) 
		UTBR B 1 Offset(5,37)
		UTBR C 1 Offset(13,45)
		UTBR C 1 Offset(10,42)
		UTBR A 1 Offset(8,40)
		UTBR A 1 Offset(6,38)
		UTBR A 1 Offset(4,36)
		UTBR A 1 Offset(3,35)
		UTBR A 1 Offset(2,34)
		UTBR A 1 Offset(1,33)
		Goto "Ready"

	Flash:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_JumpIfInventory("PowerQuad",1,"QuadSound")
		Goto NormalSound
			
		NormalSound:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/BioRifle/Fire",CHAN_WEAPON,1.0,0)
			Goto EndFlash
		QuadSound:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/BioRifle/Quad/Fire",CHAN_WEAPON,1.0,0)
			Goto EndFlash
			
	EndFlash:
		TNT1 A 0 A_JumpIfInventory("WepNoRecoilToken",1,"EndFlashNoRecoil")
		TNT1 A 2 A_SetPitch(pitch-1.2)
		TNT1 AAA 1 A_SetPitch(pitch+0.4)
		Stop
	EndFlashNoRecoil:
		TNT1 A 1
		Stop

	}
}

// --------------------------------------------------------------------------
//	For competitive DM, weapons dont autoaim
// --------------------------------------------------------------------------
Actor QCTriboltDM : QCTribolt
{	
	+WEAPON.NOAUTOAIM	
	+CHEATNOTWEAPON
	Tag "$TAG_UTBioRifle" // "Tribolt (DM)"
	Weapon.AmmoGive 20
	Weapon.AmmoDmScale 1.0
	Weapon.AmmoDmRefill 2
}

ACTOR BioBall1
{
	Projectile
	+USEBOUNCESTATE
	-NOGRAVITY
	Gravity 0.5
	Radius 4
	Height 8
	Speed 30
	Damage 0
	Scale 0.25
	SeeSound "weapons/maceshoot"
	Obituary "$OB_UTBioRifle"

	States
	{
	Spawn:
		BIOB A 99
		Loop
	Death: // Touched wall
		TNT1 A 0 A_PlaySound("UTDE/Weapons/BioRifle/Impact",CHAN_AUTO,1.0,0)
	    TNT1 A 1 A_SpawnItemEx("BioBall1Sticky")
	    Stop
	XDeath:
		TNT1 A 0 A_PlaySound("UTDE/Weapons/BioRifle/Impact",CHAN_AUTO,1.0,0)
		TNT1 A 0 BRIGHT A_ChangeFlag("NOGRAVITY", true)
		TNT1 A 0 BRIGHT A_ChangeVelocity(0, 0, 0, CVF_REPLACE)
		TNT1 A 0 BRIGHT A_GiveToTarget("HitBeepLow",1)
		TNT1 A 0 A_Explode(10,128,1|XF_QROCKETJUMP,0,18)	//self rocket damage with rocket jump is 10
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", true)
		TNT1 A 0 A_Explode(25,128,0,0,18)		//then another 25 extra damage for impacting a player = 35dmg
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", false)
		BIOB A 8 BRIGHT
		Stop
	}
}

ACTOR BioBall1Sticky
{
	Radius 4
	Height 8
	Damage (1)
	+NOGRAVITY
	+MISSILE
	+SEEKERMISSILE //Not actually used for anything other than checking radius.
	+PUFFGETSOWNER
	Scale 0.25
	Obituary "$OB_UTBioRifle"

	States
	{
	Spawn:
		BIOB A 80
	Death:
		TNT1 A 0 A_SeekerMissile(0,0,SMF_LOOK|SMF_CURSPEED,256)
		TNT1 A 0 A_JumpIfTargetInLOS("RadiusHit",360,JLOSF_PROJECTILE,64)
		Goto DeathCont

		RadiusHit:	//splash damage beep
			TNT1 A 0 A_GiveToTarget("HitBeepLow",1)
			Goto DeathCont

	XDeath:
		TNT1 A 0 A_GiveToTarget("HitBeepLow",1)
		Goto DeathCont

	DeathCont:
		TNT1 A 0 A_PlaySound("UTDE/Weapons/BioRifle/Impact",CHAN_AUTO,1.0,0)
		TNT1 A 0 A_Explode(10,128,1|XF_QROCKETJUMP,0,18)	//self rocket damage with rocket jump is 10
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", true)
		TNT1 A 0 A_Explode(24,128,0,0,18)		//then another 24 extra damage for impacting a player + (1)dmg on the projectile = 35dmg
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", false)
		BIOB A 8 BRIGHT
		Stop
	}
}

