// --------------------------------------------------------------------------
//	For competitive DM, weapons dont autoaim
// --------------------------------------------------------------------------
Actor QCTriboltDM : QCWeapon
{
	+WEAPON.NOAUTOAIM
	+CHEATNOTWEAPON
	Height 48
	Weapon.SwaySpeed 2.7
	Weapon.Kickback 0
	Weapon.SelectionOrder 1950
	Weapon.AmmoUse 1
	Weapon.AmmoUse2 1
	Weapon.AmmoGive 30
	Weapon.AmmoDmScale 1.0
	Weapon.AmmoDmRefill 2
	Weapon.AmmoType "QCBoltAmmo"
	Weapon.AmmoType2 "QCBoltAmmo"
	Inventory.PickupMessage "$GOT_UTBioRifle"
	Obituary "$OB_UTBioRifle"
	Tag "$TAG_UTBioRifle"
	Scale 0.6
	States
	{
	Spawn:
		TNT1 A 1
		U4GE Y 35 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		Goto Idle
	DMSpawn:
		U4GE ZZZZZZZZZZZZZZZ 35 Bright
		Stop
	Idle:
		U4GE Y -1
		Wait

	//-----------------------
	// Select/Deselect Seq
	//-----------------------
	Select:
		TNT1 A 0 A_JumpIfInventory("UTBioRifleSkin", 9, "Select.UT99")
		TNT1 A 0 A_JumpIfInventory("UTBioRifleSkin", 8, "Select.UT99") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTBioRifleSkin", 7, "Select.UT99") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTBioRifleSkin", 6, "Select.UT2004") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTBioRifleSkin", 5, "Select.UT2004") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTBioRifleSkin", 4, "Select.UT2004")
		TNT1 A 0 A_JumpIfInventory("UTBioRifleSkin", 3, "Select.UT2004")
		TNT1 A 0 A_JumpIfInventory("UTBioRifleSkin", 2, "Select.U1") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTBioRifleSkin", 1, "Select.U1")
	Select.U1:
		U1GE A 0
		Goto SelectCont
	Select.UT2004:
		U4GE A 0
		Goto SelectCont
	Select.UT99:
		U9GE A 0
		Goto SelectCont

	SelectCont:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,2)
		"####" A 0 A_PlaySound("QC/Weapons/Switch",CHAN_5,1,0,3) //Not in Weapon.UpSound because it interrupts CHAN_WEAPON sounds
		"####" A 0 A_StopSound(CHAN_WEAPON) //stops any weapon looping sound
	SelectLooper:
		"####" A 1 A_Raise
		"####" AAA 0 A_Raise
		Loop

	Deselect:
		"####" A 0 A_StopSound(5)
		"####" A 0 A_StopSound(CHAN_WEAPON)
	DeselectLooper:
		"####" A 1 A_Lower
		"####" AAA 0 A_Lower
		Loop

	//-----------------------
	// Ready Seq
	//-----------------------
	Ready:
		TNT1 A 0 A_JumpIfInventory("UTBioRifleSkin", 9, "Ready.UT99")
		TNT1 A 0 A_JumpIfInventory("UTBioRifleSkin", 8, "Ready.UT99") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTBioRifleSkin", 7, "Ready.UT99") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTBioRifleSkin", 6, "Ready.UT2004") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTBioRifleSkin", 5, "Ready.UT2004") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTBioRifleSkin", 4, "Ready.UT2004")
		TNT1 A 0 A_JumpIfInventory("UTBioRifleSkin", 3, "Ready.UT2004")
		TNT1 A 0 A_JumpIfInventory("UTBioRifleSkin", 2, "Ready.U1") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTBioRifleSkin", 1, "Ready.U1")
	Ready.U1:
		U1GE A 0
		Goto ReadyCont
	Ready.UT2004:
		U4GE A 0
		Goto ReadyCont
	Ready.UT99:
		U9GE A 0
		Goto ReadyCont

	ReadyCont:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		"####" A 3 A_WeaponReady
		Loop

		ReadyCantFire:
			"####" A 0 A_StopSound(5)
			"####" A 0 A_StopSound(CHAN_WEAPON)
		RCFLooper:
			"####" A 4 A_WeaponReady(WRF_NOFIRE)
			"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"RCFLooper")
			Goto Ready

	//-----------------------
	// Fire Seq
	//-----------------------
	Fire:
		"####" A 0 A_JumpIfInventory("UTBioRifleSkin", 9, "Fire.UT99")
		"####" A 0 A_JumpIfInventory("UTBioRifleSkin", 8, "Fire.UT99") // Fallback to another skin
		"####" A 0 A_JumpIfInventory("UTBioRifleSkin", 7, "Fire.UT99") // Fallback to another skin
		"####" A 0 A_JumpIfInventory("UTBioRifleSkin", 6, "Fire.UT2004") // Fallback to another skin
		"####" A 0 A_JumpIfInventory("UTBioRifleSkin", 5, "Fire.UT2004") // Fallback to another skin
		"####" A 0 A_JumpIfInventory("UTBioRifleSkin", 4, "Fire.UT2004")
		"####" A 0 A_JumpIfInventory("UTBioRifleSkin", 3, "Fire.UT2004")
		"####" A 0 A_JumpIfInventory("UTBioRifleSkin", 2, "Fire.U1") // Fallback to another skin
		"####" A 0 A_JumpIfInventory("UTBioRifleSkin", 1, "Fire.U1")
	Fire.U1:
	Fire.UT99:
		"####" A 0 A_FireCustomMissile("BioBall1DM_U1", 0, true, 1, 2, 0, 3)
		Goto PostFire
	Fire.UT2004:
		"####" A 0 A_FireCustomMissile("BioBall1DM", 0, true, 1, 2, 0, 3)
		Goto PostFire

	//-----------------------
	// AltFire Seq
	//-----------------------
	AltFire:
		"####" A 0 A_JumpIfInventory("UTBioRifleSkin", 9, "AltFire.UT99")
		"####" A 0 A_JumpIfInventory("UTBioRifleSkin", 8, "AltFire.UT99") // Fallback to another skin
		"####" A 0 A_JumpIfInventory("UTBioRifleSkin", 7, "AltFire.UT99") // Fallback to another skin
		"####" A 0 A_JumpIfInventory("UTBioRifleSkin", 6, "AltFire.UT2004") // Fallback to another skin
		"####" A 0 A_JumpIfInventory("UTBioRifleSkin", 5, "AltFire.UT2004") // Fallback to another skin
