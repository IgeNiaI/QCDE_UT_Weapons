		UTBR I 0 A_ReFire("Charge36")
		TNT1 A 0 A_Jump(256,"Fire3") //for virtual jump to inherited versions
		Goto Fire3
	Charge36:
		UTBR I 1
		UTBR I 0 A_ReFire("Charge37")
		TNT1 A 0 A_Jump(256,"Fire3") //for virtual jump to inherited versions
		Goto Fire3
	Charge37:
