		NormalSound.UT99:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/BioRifle/Fire_U1",CHAN_WEAPON,1.0,0)
			Goto EndFlash
		NormalSound.UT2004:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/BioRifle/Fire_UT2004",CHAN_WEAPON,1.0,0)
			Goto EndFlash

		QuadSound:
			TNT1 A 0 A_JumpIfInventory("UTBioRifleSkin", 9, "QuadSound.UT99")
			TNT1 A 0 A_JumpIfInventory("UTBioRifleSkin", 8, "QuadSound.UT99") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTBioRifleSkin", 7, "QuadSound.UT99") // Fallback to another skin
