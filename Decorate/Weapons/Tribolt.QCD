	PostFire:
		"####" A 0 A_GunFlash("Flash")
		"####" B 1 Offset(2,34)
		"####" B 1 Offset(4,36)
		"####" C 1 Offset(12,44)
		"####" C 1 Offset(9,41)
		"####" A 1 Offset(7,39)
		"####" A 1 Offset(5,37)
		"####" A 1 Offset(3,35)
		"####" A 1 Offset(2,34)
		"####" A 1 Offset(1,33)
		"####" A 1 Offset(0,32)
		Goto "Ready"

	Flash:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_JumpIfInventory("PowerQuad",1,"QuadSound")
		TNT1 A 0 A_JumpIfInventory("PowerTerminatorArtifact",1,"QuadSound")
		Goto NormalSound

		NormalSound:
			TNT1 A 0 A_JumpIfInventory("UTBioRifleSkin", 9, "NormalSound.UT99")
			TNT1 A 0 A_JumpIfInventory("UTBioRifleSkin", 8, "NormalSound.UT99") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTBioRifleSkin", 7, "NormalSound.UT99") // Fallback to another skin
