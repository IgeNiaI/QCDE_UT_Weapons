			TNT1 A 0 A_JumpIfInventory("UTBioRifleSkin", 2, "NormalSound.U1") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTBioRifleSkin", 1, "NormalSound.U1")
