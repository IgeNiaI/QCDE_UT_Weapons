	// No ammo hold
	Charge49:
		UTBR K 0 Offset(1, 33)
		UTBR K 0 A_StopSound(CHAN_WEAPON) //stops any weapon looping sound
		UTBR K 1
		UTBR K 0 A_JumpIf(ACS_NamedExecuteWithResult("UTDE_HoldBioNoAmmo",0,0,0,0) == 1, "Charge49")
		UTBR K 0 A_Jump(256, "Fire4") // this will be executed on server when actually firing
		Goto Charge49 // only client should reach here. A_Jump doesn't execute on client, so this is a workaround to hold the client inside this loop

	// Charge 5
	Charge50:
		TNT1 L 0 A_FireCustomMissile("AmmoSpender", 0, true, 5, 2, FPF_NOUNLAGGED)
		UTBR L 1
		UTBR L 0 A_JumpIfNoAmmo("Charge59")
		UTBR L 0 A_ReFire("Charge51")
		TNT1 A 0 A_Jump(256,"Fire5") //for virtual jump to inherited versions
		Goto Fire5
