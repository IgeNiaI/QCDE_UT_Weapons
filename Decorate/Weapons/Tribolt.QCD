Actor CompatVer31_Tribolt {} // for compatibility checks

Actor TriboltPickup : QCWeaponPickup 15604
{
	//$NotAngled
	//$Category "QCDE Weapons"
	//$Color 14
	//$Title "Ripper (SP) / Bio Rifle (DM)"
	Height 48
	Radius 20
	Scale 0.6
	Inventory.PickupSound "QC/Items/WeaponPick"
	Inventory.PickupMessage "$GOT_UTBioRifle"
	Tag "$TAG_UTBioRifle"
	Inventory.RespawnTics 35
	States
	{
	Spawn:
		U9G5 Y 35 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		Goto Idle
	DMSpawn:
		"####" "#" 0 A_ChangeFlag("DROPPED", 0)
		U4GE Z 0 ACS_NamedExecuteWithResult("QCDE_WeaponSpawned",14,args[4],args[3])
		U4GE Z 0 A_SetArg(3, 1)
		U4GE Z -1 Bright A_SetArg(4, 0)
		Stop
	Idle:
		U9G5 Y 0 ACS_NamedExecuteWithResult("QCDE_WeaponSpawned",13,args[4],args[3])
		U9G5 Y 0 A_SetArg(3, 1)
		U9G5 Y -1 A_SetArg(4, 0)
		Wait
	Pickup:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMPickup")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"WeaponStay")
		TNT1 A 0 A_GiveInventory("QCTribolt")
		TNT1 A 0
		Stop
	DMPickup:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"DMWeaponStay")
		TNT1 A 0 A_GiveInventory("QCTriboltDM")
		TNT1 A 0
		TNT1 A 0 A_TakeInventory("QCTribolt")
		TNT1 A 0
		Stop
	WeaponStay:
		TNT1 A 0 A_JumpIfInventory("QCTribolt",1,"Stay")
		TNT1 A 0 A_SpawnItemEx("QCTribolt", velx,vely,velz, velx,vely,velz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Fail
	DMWeaponStay:
		TNT1 A 0 A_TakeInventory("QCTribolt")
		TNT1 A 0 A_JumpIfInventory("QCTriboltDM",1,"Stay")
		TNT1 A 0 A_SpawnItemEx("QCTriboltDM", velx,vely,velz, velx,vely,velz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Fail
	Stay:
		TNT1 A 0
		Fail
	HideIndefinitely:
		TNT1 A 1 A_SetTics(CallACS("QCDE_SetWeaponRespawnTics"))
		Goto Super::HideDoomish+1
	HideDoomish:
		TNT1 A 1
		TNT1 A 1 A_SetTics(CallACS("QCDE_SetWeaponRespawnTics"))
		Goto Super::HideDoomish+1
	}
}

Actor TriboltPickupNoGravity : TriboltPickup 15614
{
	//$Category "QCDE Weapons (No Gravity)"
	//$Title "Ripper (SP) / Bio Rifle (DM) (No Gravity)"
	+NOGRAVITY
}


Actor QCTribolt : QCWeapon
{
	Height 48
	Weapon.SwaySpeed 3.0
	Weapon.Kickback 0
	Weapon.SelectionOrder 1950
	Weapon.AmmoUse 1
	Weapon.AmmoUse2 1
	Weapon.AmmoGive 15
	Weapon.AmmoType "QCBoltAmmo"
	Weapon.AmmoType2 "QCBoltAmmo"
	Inventory.PickupMessage "$GOT_UTRipper"
	Obituary "$OB_UTRipper"
	Tag "$TAG_UTRipper"
	Scale 0.6
	States
	{
	Spawn:
		TNT1 A 1
		U9G5 Y 35 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		Goto Idle
	DMSpawn:
		U9G5 ZZZZZZZZZZZZZZZ 35 Bright
		Stop
	Idle:
		U9G5 Y -1
		Wait

	//-----------------------
	// Select/Deselect Seq
	//-----------------------
	Select:
		TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 9, "Select.UT99")
		TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 8, "Select.UT99") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 7, "Select.UT99") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 6, "Select.UC2")
		TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 5, "Select.UC2") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 4, "Select.UC2") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 3, "Select.UC2") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 2, "Select.U1") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 1, "Select.U1")
	Select.U1:
		U1G5 A 0
		Goto SelectCont
	Select.UC2:
		U6G5 A 0
		Goto SelectCont
	Select.UT99:
		U9G5 A 0
		Goto SelectCont

	SelectCont:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,2)
		"####" A 0 A_PlaySound("QC/Weapons/Switch",CHAN_5,1,0,3) //Not in Weapon.UpSound because it interrupts CHAN_WEAPON sounds
		"####" A 0 A_StopSound(CHAN_WEAPON) //stops any weapon looping sound
	SelectLooper:
		"####" A 1 A_Raise
		"####" AAA 0 A_Raise
		Loop

	Deselect:
		"####" A 0 A_StopSound(5)
		"####" A 0 A_StopSound(CHAN_WEAPON)
	DeselectLooper:
		"####" A 1 A_Lower
		"####" AAA 0 A_Lower
		Loop

	//-----------------------
	// Ready Seq
	//-----------------------
	Ready:
		TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 9, "Ready.UT99")
		TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 8, "Ready.UT99") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 7, "Ready.UT99") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 6, "Ready.UC2")
		TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 5, "Ready.UC2") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 4, "Ready.UC2") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 3, "Ready.UC2") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 2, "Ready.U1") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 1, "Ready.U1")
	Ready.U1:
		U1G5 A 0
		Goto ReadyCont
	Ready.UC2:
		U6G5 A 0
		Goto ReadyCont
	Ready.UT99:
		U9G5 A 0
		Goto ReadyCont

	ReadyCont:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		"####" AAABBBCCCDDDEEEFFFGGGHHHIIIJJJKKKLLLMMMNNNOOOPPPQQQRRR 1 A_WeaponReady
		Loop

		ReadyCantFire:
			"####" A 0 A_StopSound(5)
			"####" A 0 A_StopSound(CHAN_WEAPON)
		RCFLooper:
			"####" A 4 A_WeaponReady(WRF_NOFIRE)
			"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"RCFLooper")
			Goto Ready

	//-----------------------
	// Fire Seq
	//-----------------------
	Fire:
		"####" T 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		"####" T 0 A_GunFlash("Flash", GFF_NOEXTCHANGE)
		"####" T 1 		 	Offset(6,36)
		"####" U 1 		 	Offset(8,40)
		"####" U 1 		 	Offset(10,43)
		"####" U 1 		 	Offset(12,45)
		"####" V 1
		"####" V 1 			Offset(12,45)
		"####" V 1 			Offset(11,44)
		"####" W 1 			Offset(9,42)
		"####" W 1 			Offset(7,39)
		"####" W 1 			Offset(5,36)
		"####" X 1 			Offset(3,34)
		"####" X 1 			Offset(1,33)
		"####" X 1 			Offset(0,32)
		Goto Ready

	//-----------------------
	// Attack doers
	//-----------------------

	Flash:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_JumpIfInventory("TB_UG_Long",1,"FlashUpgraded")
		TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 9, "Flash.UT99")
		TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 8, "Flash.UT99") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 7, "Flash.UT99") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 6, "Flash.UC2")
		TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 5, "Flash.UC2") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 4, "Flash.UC2") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 3, "Flash.UC2") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 2, "Flash.U1") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 1, "Flash.U1")
	Flash.U1:
		TNT1 A 0 A_FireCustomMissile("UTRipperBlade_U1",0,true,1,4)
		Goto FlashCheckSound
	Flash.UC2:
		TNT1 A 0 A_FireCustomMissile("UTRipperBlade_UC2",0,true,1,4)
		Goto FlashCheckSound
	Flash.UT99:
		TNT1 A 0 A_FireCustomMissile("UTRipperBlade",0,true,1,4)
		Goto FlashCheckSound

	FlashUpgraded:
		TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 9, "FlashUpgraded.UT99")
		TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 8, "FlashUpgraded.UT99") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 7, "FlashUpgraded.UT99") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 6, "FlashUpgraded.UC2")
		TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 5, "FlashUpgraded.UC2") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 4, "FlashUpgraded.UC2") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 3, "FlashUpgraded.UC2") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 2, "FlashUpgraded.U1") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 1, "FlashUpgraded.U1")
	FlashUpgraded.U1:
		TNT1 A 0 A_FireCustomMissile("UTRipperBladeUpgraded_U1",0,true,1,4)
		Goto FlashCheckSound
	FlashUpgraded.UC2:
		TNT1 A 0 A_FireCustomMissile("UTRipperBladeUpgraded_UC2",0,true,1,4)
		Goto FlashCheckSound
	FlashUpgraded.UT99:
		TNT1 A 0 A_FireCustomMissile("UTRipperBladeUpgraded",0,true,1,4)
		Goto FlashCheckSound

	FlashCheckSound:
		TNT1 A 0 A_JumpIfInventory("PowerQuad",1,"QuadSound")
		TNT1 A 0 A_JumpIfInventory("PowerTerminatorArtifact",1,"QuadSound")
		Goto NormalSound

		NormalSound:
			TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 9, "NormalSound.UT99")
			TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 8, "NormalSound.UT99") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 7, "NormalSound.UT99") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 6, "NormalSound.UC2")
			TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 5, "NormalSound.UC2") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 4, "NormalSound.UC2") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 3, "NormalSound.UC2") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 2, "NormalSound.U1") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 1, "NormalSound.U1")
		NormalSound.U1:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Ripper/Fire_U1",CHAN_WEAPON)
			Goto EndFlash
		NormalSound.UC2:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Ripper/Fire_UC2",CHAN_WEAPON)
			Goto EndFlash
		NormalSound.UT99:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Ripper/Fire_UT99",CHAN_WEAPON)
			Goto EndFlash

		QuadSound:
			TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 9, "QuadSound.UT99")
			TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 8, "QuadSound.UT99") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 7, "QuadSound.UT99") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 6, "QuadSound.UC2")
			TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 5, "QuadSound.UC2") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 4, "QuadSound.UC2") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 3, "QuadSound.UC2") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 2, "QuadSound.U1") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 1, "QuadSound.U1")
		QuadSound.U1:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Ripper/Quad/Fire_U1",CHAN_WEAPON)
			Goto EndFlash
		QuadSound.UC2:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Ripper/Quad/Fire_UC2",CHAN_WEAPON)
			Goto EndFlash
		QuadSound.UT99:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Ripper/Quad/Fire_UT99",CHAN_WEAPON)
			Goto EndFlash

		EndFlash:
			TNT1 A 0 A_JumpIfInventory("WepNoRecoilToken",1,"EndFlashNoRecoil")
			TNT1 A 1 A_SetPitch(Pitch-0.4)
			TNT1 AA 1 A_SetPitch(Pitch+0.2)
			Stop
		EndFlashNoRecoil:
			TNT1 A 1
			Stop

	//-----------------------
	// AltFire Seq
	//-----------------------
	AltFire:
		"####" T 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		"####" T 0 A_GunFlash("AltFlash", GFF_NOEXTCHANGE)
		"####" T 1 		 	Offset(7,37)
		"####" T 1  		Offset(13,42)
		"####" T 1 			Offset(15,45)
		"####" T 1 			Offset(17,47)
		"####" T 1 			Offset(18,48)
		"####" T 1 			Offset(19,49)
		"####" T 1
		"####" T 1
		"####" T 1
		"####" T 1 			Offset(18,48)
		"####" T 1 			Offset(17,47)
		"####" U 1 			Offset(16,46)
		"####" U 1 			Offset(15,45)
		"####" U 1 			Offset(14,44)
		"####" V 1 			Offset(13,43)
		"####" V 1 			Offset(12,42)
		"####" V 1 			Offset(10,41)
		"####" W 1 			Offset(8,39)
		"####" W 1 			Offset(6,37)
		"####" W 1 			Offset(4,36)
		"####" X 1 			Offset(2,34)
		"####" X 1 			Offset(1,33)
		"####" X 1 			Offset(0,32)
		Goto Ready

	//-----------------------
	// Attack doers
	//-----------------------

	AltFlash:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_JumpIfInventory("TB_UG_Grenade",1,"AltFlashUpgraded")
		TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 9, "AltFlash.UT99")
		TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 8, "AltFlash.UT99") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 7, "AltFlash.UT99") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 6, "AltFlash.UC2")
		TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 5, "AltFlash.UC2") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 4, "AltFlash.UC2") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 3, "AltFlash.UC2") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 2, "AltFlash.U1") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 1, "AltFlash.U1")
	AltFlash.U1:
		TNT1 A 0 A_FireCustomMissile("UTRipperBladeAlt_U1",0,true,1,4)
		Goto AltFlashCheckSound
	AltFlash.UC2:
		TNT1 A 0 A_FireCustomMissile("UTRipperBladeAlt_UC2",0,true,1,4)
		Goto AltFlashCheckSound
	AltFlash.UT99:
		TNT1 A 0 A_FireCustomMissile("UTRipperBladeAlt",0,true,1,4)
		Goto AltFlashCheckSound

	AltFlashUpgraded:
		TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 9, "AltFlashUpgraded.UT99")
		TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 8, "AltFlashUpgraded.UT99") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 7, "AltFlashUpgraded.UT99") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 6, "AltFlashUpgraded.UC2")
		TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 5, "AltFlashUpgraded.UC2") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 4, "AltFlashUpgraded.UC2") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 3, "AltFlashUpgraded.UC2") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 2, "AltFlashUpgraded.U1") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 1, "AltFlashUpgraded.U1")
	AltFlashUpgraded.U1:
		TNT1 A 0 A_FireCustomMissile("UTRipperBladeAltUpgraded_U1",0,true,1,4)
		Goto AltFlashCheckSound
	AltFlashUpgraded.UC2:
		TNT1 A 0 A_FireCustomMissile("UTRipperBladeAltUpgraded_UC2",0,true,1,4)
		Goto AltFlashCheckSound
	AltFlashUpgraded.UT99:
		TNT1 A 0 A_FireCustomMissile("UTRipperBladeAltUpgraded",0,true,1,4)
		Goto AltFlashCheckSound

	AltFlashCheckSound:
		TNT1 A 0 A_JumpIfInventory("PowerQuad",1,"QuadSound")
		TNT1 A 0 A_JumpIfInventory("PowerTerminatorArtifact",1,"QuadSound")
		Goto AltNormalSound

		AltNormalSound:
			TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 9, "AltNormalSound.UT99")
			TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 8, "AltNormalSound.UT99") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 7, "AltNormalSound.UT99") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 6, "AltNormalSound.UC2")
			TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 5, "AltNormalSound.UC2") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 4, "AltNormalSound.UC2") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 3, "AltNormalSound.UC2") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 2, "AltNormalSound.U1") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 1, "AltNormalSound.U1")
		AltNormalSound.U1:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Ripper/AltFire_U1",CHAN_WEAPON)
			Goto EndFlash
		AltNormalSound.UC2:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Ripper/AltFire_UC2",CHAN_WEAPON)
			Goto EndFlash
		AltNormalSound.UT99:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Ripper/AltFire_UT99",CHAN_WEAPON)
			Goto EndFlash

		AltQuadSound:
			TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 9, "AltQuadSound.UT99")
			TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 8, "AltQuadSound.UT99") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 7, "AltQuadSound.UT99") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 6, "AltQuadSound.UC2")
			TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 5, "AltQuadSound.UC2") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 4, "AltQuadSound.UC2") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 3, "AltQuadSound.UC2") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 2, "AltQuadSound.U1") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTRipperSkin", 1, "AltQuadSound.U1")
		AltQuadSound.U1:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Ripper/Quad/AltFire_U1",CHAN_WEAPON)
			Goto EndFlash
		AltQuadSound.UC2:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Ripper/Quad/AltFire_UC2",CHAN_WEAPON)
			Goto EndFlash
		AltQuadSound.UT99:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Ripper/Quad/AltFire_UT99",CHAN_WEAPON)
			Goto EndFlash
	}
}

Actor UTRipperBlade
{
	Projectile
	+BLOODSPLATTER
	+USEBOUNCESTATE
	+NODAMAGETHRUST
	+MTHRUSPECIES
	+DONTBLAST
	ReactionTime 7
	Obituary "$OB_UTRipper"
	Speed 36
	Radius 8
	Height 3
	Damage (random(70,90))
	Decal "GauntletDecal_Quake3"
	Scale 0.33
	BounceType Doom
	BounceFactor 1.0
	WallBounceFactor 1.0
	States
	{
	Spawn:
		BLD9 AAA 1
		Loop

	Bounce:
		TNT1 A 0 A_PlaySound("UTDE/Weapons/Ripper/Bounce_UT99",CHAN_AUTO,1,0,1)
		TNT1 A 0 A_Jump(256, "BounceCont") //for virtual jump to inherited versions

	BounceCont:
		TNT1 A 0 A_ChangeFlag("HITOWNER",1)
		TNT1 A 0 A_ChangeFlag("MTHRUSPECIES",0)
		TNT1 A 0 A_Countdown
		TNT1 A 0 A_Jump(256, "Spawn") //for virtual jump to inherited versions
		Goto Spawn

	XDeath:
		TNT1 A 0 A_PlaySound("UTDE/Weapons/Ripper/Impact_UT99",CHAN_AUTO,1,0,1)
		TNT1 A 0 A_Jump(256, "XDeathCont") //for virtual jump to inherited versions

	XDeathCont:
		TNT1 A 0 A_GiveToTarget("HitBeepMid",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		Stop

	Death:
		TNT1 A 0 A_PlaySound("UTDE/Weapons/Ripper/Bounce_UT99",CHAN_AUTO,1,0,1)
		TNT1 A 0 A_Jump(256, "DeathCont") //for virtual jump to inherited versions

	DeathCont:
	DeathFx:
		TNT1 A 0 A_SpawnItemEx("UTRipperBladeFX")
		TNT1 AAAAAAAAAA 0 A_SpawnItemEx("QCRocketExploParticle",3,0,0,frandom(3,5.5),frandom(3,5.5),frandom(-5.5,5.5),random(0,359),SXF_NOCHECKPOSITION)
		Stop
	}
}

