		TNT1 A 0 BRIGHT A_GiveToTarget("HitBeepBig",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		TNT1 A 0 A_Explode(50,128,XF_HURTSOURCE,0,18)	//self rocket damage with rocket jump is 50
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", true)
		TNT1 A 0 A_Explode(140,128,0,0,18)		//then another 140 extra damage for impacting a player = 190dmg
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", false)
		Goto DeathCont
	}
}

