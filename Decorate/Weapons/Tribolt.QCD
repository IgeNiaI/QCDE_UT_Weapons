ACTOR BioBallDeathFX
{
	+NOINTERACTION
	+FORCEXYBILLBOARD
	+NONETID
	+CLIENTSIDEONLY
	Radius 1
	Height 1
	Speed 0
	Scale 0.40
	Translation "0:255=%[0,0,0]:[0.0,1.0,0.0]"
	RenderStyle Add

	States
	{
	Spawn:
		DB63 CDEFGHIJKLMNOPQRSTUVWXYZ 1 BRIGHT
		Stop
	}
}

ACTOR BioBallSticky1DM
{
	Radius 2
	Height 4
	Damage (1)
	+NOGRAVITY
	+MISSILE
	+SEEKERMISSILE //Not actually used for anything other than checking radius.
	+PUFFGETSOWNER
	Scale 0.25
	Obituary "$OB_UTBioRifle"

	States
	{
	Spawn:
		BIOB ABCDEFABCDEFABCDE 6 Light(OliveGreenSmallPoint3) Bright
		Goto Death

	Death:
		TNT1 A 0 A_SeekerMissile(0,0,SMF_LOOK|SMF_CURSPEED,256)
		TNT1 A 0 A_JumpIfTargetInLOS("RadiusHit",360,JLOSF_PROJECTILE,192)
		TNT1 A 0 A_Jump(256,"DeathCont") //for virtual jump to inherited versions
		Goto DeathInvis

		RadiusHit:	//splash damage beep
			TNT1 A 0 A_GiveToTarget("HitBeepLow",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		    TNT1 A 0 A_Jump(256,"DeathCont") //for virtual jump to inherited versions
			Goto DeathInvis

	XDeath:
		TNT1 A 0 A_GiveToTarget("HitBeepLow",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		TNT1 A 0 A_Jump(256,"DeathCont") //for virtual jump to inherited versions
		Goto DeathInvis

    DeathInvis:     // To workaround multiplayer clients skipping A_Jump calls and going to incorrect state
        TNT1 A 99   // So instead display nothing and wait for server to send correct state from it's A_Jump call

	DeathCont:
		TNT1 A 0 A_PlaySound("UTDE/Weapons/BioRifle/Impact_UT2004",CHAN_AUTO,1.0,0)
		TNT1 A 0 A_RadiusThrust(34,128,RTF_AFFECTSOURCE|RTF_THRUSTZ)	//thrust players only this way, without damage
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", true)
		TNT1 A 0 A_Explode(10,128,XF_HURTSOURCE,0,18)	//self rocket damage with rocket jump is 10
		TNT1 A 0 A_Explode(24,128,0,0,18)		//then another 24 extra damage for impacting a player + (1)dmg on the projectile = 35dmg
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", false)
		Goto DeathFinish

	DeathFinish:
		TNT1 A 0 A_SpawnItemEx("BioBallDeathFX", 0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION)
		TNT1 A 99 // We need this for proper rocket jump unlagged when exploding too soon
		Stop
	}
}

ACTOR BioBallSticky1DM_U1 : BioBallSticky1DM
{
	States
	{
	Spawn:
		BIOG ABCDEFABCDEFABCDE 6 Light(GreenSmallPoint3) Bright
		Goto Death

	DeathCont:
		TNT1 A 0 A_PlaySound("UTDE/Weapons/BioRifle/Impact_U1",CHAN_AUTO,1.0,0)
		Goto Super::DeathCont+1
	}
}

