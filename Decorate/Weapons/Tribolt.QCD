		UTBR G 0 A_StopSound(CHAN_WEAPON) //stops any weapon looping sound
		UTBR G 1
		UTBR G 0 A_JumpIf(ACS_NamedExecuteWithResult("UTDE_HoldBioNoAmmo",0,0,0,0) == 1, "Charge29")
		UTBR G 0 A_Jump(256, "Fire2") // this will be executed on server when actually firing
		Goto Charge29 // only client should reach here. A_Jump doesn't execute on client, so this is a workaround to hold the client inside this loop

	// Charge 3
	Charge30:
		TNT1 H 0 A_FireCustomMissile("AmmoSpender", 0, true, 5, 2, FPF_NOUNLAGGED)
		UTBR H 1
