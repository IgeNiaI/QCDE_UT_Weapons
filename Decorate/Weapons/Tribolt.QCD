		UTBR I 0 Offset(1, 33)
		UTBR I 0 A_StopSound(CHAN_WEAPON) //stops any weapon looping sound
		UTBR I 1
		UTBR I 0 A_JumpIf(ACS_NamedExecuteWithResult("UTDE_HoldBioNoAmmo",0,0,0,0) == 1, "Charge39")
		UTBR I 0 A_Jump(256, "Fire3") // this will be executed on server when actually firing
