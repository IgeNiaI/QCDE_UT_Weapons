// --------------------------------------------------------------------------
//
// Redeemer (SP) and Bio Rifle (MP)
// Weapon and Pickup sprite by Pixo
// Weapon code by geNia
//
// --------------------------------------------------------------------------

Actor TriboltPickup : CustomInventory 15604
{
	//$NotAngled
	//$Category "QCDE Weapons"
	//$Color 14
	//$Title "Ripper (SP) / Bio Rifle (DM)"
	Height 48
	Radius 20
	Scale 0.6
	Inventory.PickupSound "QC/Items/WeaponPick"
	Inventory.PickupMessage "$GOT_UTBioRifle"
	Tag "$TAG_UTBioRifle"
	Inventory.RespawnTics 35
	States
	{
	Spawn:
		UTRP Y 35 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		Goto Idle
	DMSpawn:
		"####" "#" 0 A_ChangeFlag("DROPPED", 0)
		UTBR Z -1 Bright ACS_NamedExecuteWithResult("QCDE_WeaponSpawned",14,args[4])
		Stop
	Idle:
		UTRP Y -1 ACS_NamedExecuteWithResult("QCDE_WeaponSpawned",13,args[4])
		Wait
	Pickup:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMPickup")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"WeaponStay")
		TNT1 A 0 A_GiveInventory("QCTribolt")
		TNT1 A 0
		Stop
	DMPickup:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"DMWeaponStay")
		TNT1 A 0 A_GiveInventory("QCTriboltDM")
		TNT1 A 0
		TNT1 A 0 A_TakeInventory("QCTribolt")
		TNT1 A 0
		Stop
	WeaponStay:
		TNT1 A 0 A_JumpIfInventory("QCTribolt",1,"Stay")
		TNT1 A 0 A_SpawnItemEx("QCTribolt", velx,vely,velz, velx,vely,velz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Fail
	DMWeaponStay:
		TNT1 A 0 A_TakeInventory("QCTribolt")
		TNT1 A 0 A_JumpIfInventory("QCTriboltDM",1,"Stay")
		TNT1 A 0 A_SpawnItemEx("QCTriboltDM", velx,vely,velz, velx,vely,velz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Fail
	Stay:
		TNT1 A 0
		Fail
	HideIndefinitely:
		TNT1 A 1 A_SetTics(CallACS("QCDE_SetWeaponRespawnTics"))
		Goto HideDoomish+1
	}
}

Actor TriboltPickupFloat : TriboltPickup 15614
{
	//$Title "Float Ripper (SP) / Bio Rifle (DM)"
	+NOGRAVITY
}


Actor QCTribolt : QCWeapon
{
	Height 48
	Weapon.SwaySpeed 2.6
	Weapon.Kickback 0
	Weapon.SelectionOrder 1950
	Weapon.AmmoUse 1
	Weapon.AmmoUse2 1
	Weapon.AmmoGive 15
	Weapon.AmmoType "QCBoltAmmo"
	Weapon.AmmoType2 "QCBoltAmmo"
	Inventory.PickupMessage "$GOT_UTRipper"
	Obituary "$OB_UTRipper"
	Tag "$TAG_UTRipper"
	Scale 0.6
	States
	{
	Spawn:
		TNT1 A 1
		UTRP Y 35 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		Goto Idle
	DMSpawn:
		UTRP ZZZZZZZZZZZZZZZ 35 Bright
		Stop
	Idle:
		UTRP Y -1
		Wait

	//-----------------------
	// Select/Deselect Seq
	//-----------------------
	Select:
		UTRP A 0 A_JumpIfInventory("NoWeaponFireToken",1,2)
		UTRP A 0 A_PlaySound("QC/Weapons/Switch",5,1,0,3) //Not in Weapon.UpSound because it interrupts CHAN_WEAPON sounds
		"####" "#" 0 A_StopSound(CHAN_WEAPON) //stops any weapon looping sound
	SelectLooper:
		UTRP A 1 A_Raise
		UTRP "###" 0 A_Raise
		Loop

	Deselect:
		UTRP A 0 A_StopSound(5)
		UTRP A 0 A_StopSound(CHAN_WEAPON)
	DeselectLooper:
		UTRP A 1 A_Lower
		"####" "###" 0 A_Lower
		Loop

	//-----------------------
	// Ready Seq
	//-----------------------
	Ready:
		UTRP A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		UTRP AAABBBCCCDDDEEEFFFGGGHHHIIIJJJKKKLLLMMMNNNOOOPPP 1 A_WeaponReady
		Loop

		ReadyCantFire:
			UTRP A 0 A_StopSound(5)
			UTRP A 0 A_StopSound(CHAN_WEAPON)
		RCFLooper:
			UTRP A 4 A_WeaponReady(WRF_NOFIRE)
			UTRP A 0 A_JumpIfInventory("NoWeaponFireToken",1,"RCFLooper")
			Goto Ready

	//-----------------------
	// Fire Seq
	//-----------------------
	Fire:
		UTRP Q 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		UTRP Q 0 A_GunFlash("Flash")
		UTRP Q 1 Bright 	Offset(7,36)
		UTRP Q 1 		 	Offset(9,40)
		UTRP Q 1 		 	Offset(11,43)
		UTRP Q 1 		 	Offset(13,45)
		UTRP R 1
		UTRP R 1 			Offset(13,45)
		UTRP R 1 			Offset(12,44)
		UTRP S 1 			Offset(10,42)
		UTRP S 1 			Offset(8,39)
		UTRP S 1 			Offset(6,36)
		UTRP T 1 			Offset(4,34)
		UTRP T 1 			Offset(2,33)
		UTRP T 1 			Offset(1,32)
		Goto Ready

	//-----------------------
	// Attack doers
	//-----------------------

	Flash:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_FireCustomMissile("UTRipperBlade",0,true,1,4)
		Goto FlashCheckSound

	FlashCheckSound:
		TNT1 A 0 A_JumpIfInventory("PowerQuad",1,"QuadSound")
		Goto NormalSound

		NormalSound:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Ripper/Fire",CHAN_WEAPON)
			Goto EndFlash
		QuadSound:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Ripper/Quad/Fire",CHAN_WEAPON)
			Goto EndFlash

		EndFlash:
			TNT1 A 0 A_JumpIfInventory("WepNoRecoilToken",1,"EndFlashNoRecoil")
			TNT1 A 1 A_SetPitch(Pitch-0.6)
			TNT1 AA 1 A_SetPitch(Pitch+0.3)
			Stop
		EndFlashNoRecoil:
			TNT1 A 1
			Stop

	//-----------------------
	// AltFire Seq
	//-----------------------
	AltFire:
		UTRP Q 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		UTRP Q 0 A_GunFlash("AltFlash")
		UTRP Q 1 Bright 	Offset(9,38)
		UTRP Q 1  			Offset(15,43)
		UTRP Q 1 			Offset(17,46)
		UTRP Q 1 			Offset(19,48)
		UTRP Q 1 			Offset(20,49)
		UTRP Q 1 			Offset(21,50)
		UTRP Q 1
		UTRP Q 1
		UTRP Q 1
		UTRP Q 1 			Offset(20,49)
		UTRP Q 1 			Offset(19,48)
		UTRP Q 1 			Offset(18,47)
		UTRP Q 1 			Offset(17,46)
		UTRP Q 1 			Offset(16,45)
		UTRP R 1 			Offset(15,44)
		UTRP R 1 			Offset(14,43)
		UTRP R 1 			Offset(12,42)
		UTRP S 1 			Offset(10,40)
		UTRP S 1 			Offset(8,38)
		UTRP S 1 			Offset(6,37)
		UTRP T 1 			Offset(4,35)
		UTRP T 1 			Offset(3,34)
		UTRP T 1 			Offset(2,33)
		Goto Ready

	//-----------------------
	// Attack doers
	//-----------------------

	AltFlash:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_FireCustomMissile("UTRipperBladeAlt",0,true,1,4)
		Goto AltFlashCheckSound

	AltFlashCheckSound:
		TNT1 A 0 A_JumpIfInventory("PowerQuad",1,"QuadSound")
		Goto AltNormalSound

		AltNormalSound:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Ripper/AltFire",CHAN_WEAPON)
			Goto EndFlash
		AltQuadSound:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Ripper/Quad/AltFire",CHAN_WEAPON)
			Goto EndFlash
	}
}

Actor UTRipperBlade
{
	Projectile
	+BLOODSPLATTER
	+USEBOUNCESTATE
	+NODAMAGETHRUST
	+MTHRUSPECIES
	+DONTBLAST
	ReactionTime 7
	Obituary "$OB_UTRipper"
	Speed 36
	Radius 8
	Height 3
	Damage (random(70,90))
	Decal "Q4PlasmaBlack"
	Scale 0.33
	BounceType Doom
	BounceFactor 1.0
	WallBounceFactor 1.0
	States
	{
	Spawn:
		BLAD BCABCABC 1
		TNT1 A 0 A_ChangeFlag("HITOWNER",1)

	Looper:
		BLAD ABC 1
		Loop

	Bounce:
		TNT1 A 0 A_PlaySound("UTDE/Weapons/Ripper/Bounce",CHAN_AUTO,1,0,1)
		TNT1 A 0 A_ChangeFlag("HITOWNER",1)
		TNT1 A 0 A_Countdown
		Goto Looper

	XDeath:
		TNT1 A 0 A_PlaySound("UTDE/Weapons/Ripper/Impact",CHAN_AUTO,1,0,1)
		TNT1 A 0 A_GiveToTarget("HitBeepMid",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		Stop

	Death:
		TNT1 A 0 A_PlaySound("UTDE/Weapons/Ripper/Bounce",CHAN_AUTO,1,0,1)
		Goto DeathCont

	DeathCont:
		TNT1 A 0 A_SpawnItemEx("UTRipperBladeFX")
		Stop
	}
}

Actor UTRipperBladeAlt : UTRipperBlade
{
	+SEEKERMISSILE //Not actually used for anything other than checking radius.
	Damage (random(70,90))
	BounceType None

	States
	{
	XDeath:
		TNT1 A 0 A_PlaySound("UTDE/Weapons/Ripper/Impact",CHAN_AUTO,1,0,1)
		TNT1 A 0 A_GiveToTarget("HitBeepBig",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		TNT1 A 0 A_Explode(random(35,50),64,1,0,18)
		Stop

	Death:
		TNT1 A 0 A_PlaySound("UTDE/Weapons/Ripper/Bounce",CHAN_AUTO,1,0,1)
		TNT1 A 0 A_Explode(random(35,50),64,1,0,18)
		TNT1 A 0 A_SeekerMissile(0,0,SMF_LOOK|SMF_CURSPEED,256)
		TNT1 A 0 A_JumpIfTargetInLOS("RadiusHit",360,JLOSF_PROJECTILE,128)
		Goto DeathCont

		RadiusHit:	//splash damage beep
			TNT1 A 0 A_GiveToTarget("HitBeepMid",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
			Goto DeathCont
	}
}

Actor UTRipperBladeFX
{
	+CLIENTSIDEONLY +NONETID
	+NOINTERACTION +NOTONAUTOMAP
	+FORCEXYBILLBOARD
	+DONTBLAST
	RenderStyle Translucent
	Translation "0:255=%[0,0,0]:[1.0,1.0,1.0]"
	Alpha 0.75
	Scale 0.75
	States
	{
	Spawn:
		BLAD DEFGHIJKLMNOPQRST 1
		Stop
	}
}

// --------------------------------------------------------------------------
//	For competitive DM, weapons dont autoaim
// --------------------------------------------------------------------------
Actor QCTriboltDM : QCWeapon
{
	+WEAPON.NOAUTOAIM
	+CHEATNOTWEAPON
	Height 48
	Weapon.SwaySpeed 2.7
	Weapon.Kickback 0
	Weapon.SelectionOrder 1950
	Weapon.AmmoUse 1
	Weapon.AmmoUse2 1
	Weapon.AmmoGive 20
	Weapon.AmmoDmScale 1.0
	Weapon.AmmoDmRefill 2
	Weapon.AmmoType "QCBoltAmmo"
	Weapon.AmmoType2 "QCBoltAmmo"
	Inventory.PickupMessage "$GOT_UTBioRifle"
	Obituary "$OB_UTBioRifle"
	Tag "$TAG_UTBioRifle"
	Scale 0.6
	States
	{
	Spawn:
		TNT1 A 1
		UTBR Y 35 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		Goto Idle
	DMSpawn:
		UTBR ZZZZZZZZZZZZZZZ 35 Bright
		Stop
	Idle:
		UTBR Y -1
		Wait

	//-----------------------
	// Select/Deselect Seq
	//-----------------------
	Select:
		UTBR A 0 A_JumpIfInventory("NoWeaponFireToken",1,2)
		UTBR A 0 A_PlaySound("QC/Weapons/Switch",5,1,0,3) //Not in Weapon.UpSound because it interrupts CHAN_WEAPON sounds
		"####" "#" 0 A_StopSound(CHAN_WEAPON) //stops any weapon looping sound
	SelectLooper:
		UTBR A 1 A_Raise
		UTBR "###" 0 A_Raise
		Loop

	Deselect:
		UTBR A 0 A_StopSound(5)
		UTBR A 0 A_StopSound(CHAN_WEAPON)
	DeselectLooper:
		UTBR A 1 A_Lower
		"####" "###" 0 A_Lower
		Loop

	//-----------------------
	// Ready Seq
	//-----------------------
	Ready:
		UTBR A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		UTBR A 3 A_WeaponReady
		Loop

		ReadyCantFire:
			UTBR A 0 A_StopSound(5)
			UTBR A 0 A_StopSound(CHAN_WEAPON)
		RCFLooper:
			UTBR A 4 A_WeaponReady(WRF_NOFIRE)
			UTBR A 0 A_JumpIfInventory("NoWeaponFireToken",1,"RCFLooper")
			Goto Ready

	//-----------------------
	// Fire Seq
	//-----------------------
	Fire:
		TNT1 A 0 A_FireCustomMissile("BioBall1DM", 0, true, 1, 2, 0, 3)
		Goto PostFire

	//-----------------------
	// AltFire Seq
	//-----------------------
	AltFire:
		TNT1 A 0 A_PlaySound("UTDE/Weapons/BioRifle/Charge",CHAN_WEAPON,1.0,0)
		Goto Charge10

	// Charge 1
	Charge10:
		TNT1 D 0 A_FireCustomMissile("AmmoSpender", 0, true, 5, 2, FPF_NOUNLAGGED)
		UTBR D 1
		UTBR D 0 A_JumpIfNoAmmo("Charge19")
		UTBR D 0 A_ReFire("Charge11")
		TNT1 A 0 A_Jump(256,"Fire1") //for virtual jump to inherited versions
		Goto Fire1
	Charge11:
		UTBR D 1
		UTBR D 0 A_ReFire("Charge12")
		TNT1 A 0 A_Jump(256,"Fire1") //for virtual jump to inherited versions
		Goto Fire1
	Charge12:
		UTBR D 1
		UTBR D 0 A_ReFire("Charge13")
		TNT1 A 0 A_Jump(256,"Fire1") //for virtual jump to inherited versions
		Goto Fire1
	Charge13:
		UTBR D 1
		UTBR D 0 A_ReFire("Charge14")
		TNT1 A 0 A_Jump(256,"Fire1") //for virtual jump to inherited versions
		Goto Fire1
	Charge14:
		UTBR E 1
		UTBR E 0 A_ReFire("Charge15")
		TNT1 A 0 A_Jump(256,"Fire1") //for virtual jump to inherited versions
		Goto Fire1
	Charge15:
		UTBR E 1
		UTBR E 0 A_ReFire("Charge16")
		TNT1 A 0 A_Jump(256,"Fire1") //for virtual jump to inherited versions
		Goto Fire1
	Charge16:
		UTBR E 1
		UTBR E 0 A_ReFire("Charge17")
		TNT1 A 0 A_Jump(256,"Fire1") //for virtual jump to inherited versions
		Goto Fire1
	Charge17:
		UTBR E 1
		UTBR E 0 A_ReFire("Charge20")
		TNT1 A 0 A_Jump(256,"Fire1") //for virtual jump to inherited versions
		Goto Fire1

	// No ammo hold
	Charge19:
		UTBR E 0 Offset(1, 33)
		UTBR E 0 A_StopSound(CHAN_WEAPON) //stops any weapon looping sound
		UTBR E 1
		UTBR E 0 A_JumpIf(ACS_NamedExecuteWithResult("UTDE_HoldBioNoAmmo",0,0,0,0) == 1, "Charge19")
		UTBR E 0 A_Jump(256, "Fire1") // this will be executed on server when actually firing
		Goto Charge19 // only client should reach here. A_Jump doesn't execute on client, so this is a workaround to hold the client inside this loop

	// Charge 2
	Charge20:
		TNT1 F 0 A_FireCustomMissile("AmmoSpender", 0, true, 5, 2, FPF_NOUNLAGGED)
		UTBR F 1
		UTBR F 0 A_JumpIfNoAmmo("Charge29")
		UTBR F 0 A_ReFire("Charge21")
		TNT1 A 0 A_Jump(256,"Fire2") //for virtual jump to inherited versions
		Goto Fire2
