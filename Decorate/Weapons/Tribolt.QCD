			TNT1 A 0 A_JumpIfInventory("UTBioRifleSkin", 5, "QuadSound.UT2004") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTBioRifleSkin", 4, "QuadSound.UT2004")
			TNT1 A 0 A_JumpIfInventory("UTBioRifleSkin", 3, "QuadSound.UT2004")
			TNT1 A 0 A_JumpIfInventory("UTBioRifleSkin", 2, "QuadSound.U1") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTBioRifleSkin", 1, "QuadSound.U1")
		QuadSound.U1:
		QuadSound.UT99:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/BioRifle/Quad/Fire_U1",CHAN_WEAPON,1.0,0)
			Goto EndFlash
		QuadSound.UT2004:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/BioRifle/Quad/Fire_UT2004",CHAN_WEAPON,1.0,0)
			Goto EndFlash

	EndFlash:
		TNT1 A 0 A_JumpIfInventory("WepNoFlashToken",1,"EndFlashCont")
		TNT1 A 0 A_SetBlend("Green",0.03,3)
	EndFlashCont:
		TNT1 A 0 A_JumpIfInventory("WepNoRecoilToken",1,"EndFlashNoRecoil")
		TNT1 A 2 A_SetPitch(pitch-0.6)
		TNT1 AAA 1 A_SetPitch(pitch+0.2)
		Stop
	EndFlashNoRecoil:
		TNT1 A 1
		Stop

	}
}

ACTOR BioBall1DM
{
	Projectile
	-NOGRAVITY
	Gravity 0.5
	Radius 2
	Height 4
	Speed 30
	Damage 0
	Scale 0.25
	SeeSound "weapons/maceshoot"
	Obituary "$OB_UTBioRifle"
	Decal "UTBioRifleFull"

	States
	{
	Spawn:
		BIOB ABCDEF 3 Light(OliveGreenSmallPoint3) Bright
		Loop
	Death: // Touched wall
		TNT1 A 0 A_PlaySound("UTDE/Weapons/BioRifle/Impact_UT2004",CHAN_AUTO,1.0,0)
	    TNT1 A 1 A_SpawnItemEx("BioBallSticky1DM")
	    Stop
	XDeath:
		TNT1 A 0 BRIGHT A_GiveToTarget("HitBeepLow",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		TNT1 A 0 A_RadiusThrust(34,128,RTF_AFFECTSOURCE|RTF_THRUSTZ)	//thrust players only this way, without damage
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", true)
		TNT1 A 0 A_Explode(10,128,XF_HURTSOURCE,0,18)	//self rocket damage with rocket jump is 10
		TNT1 A 0 A_Explode(25,128,0,0,18)		//then another 25 extra damage for impacting a player = 35dmg
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", false)
		Goto DeathCont

	DeathCont:
		TNT1 A 0 A_PlaySound("UTDE/Weapons/BioRifle/Impact_UT2004",CHAN_AUTO,1.0,0)
		TNT1 A 0 BRIGHT A_ChangeFlag("NOGRAVITY", true)
		TNT1 A 0 BRIGHT A_ChangeVelocity(0, 0, 0, CVF_REPLACE)
		TNT1 A 0 A_Jump(256,"DeathFX") //for virtual jump to inherited versions

	DeathFX:
		BIOB B 2 BRIGHT
		BIOB C 2 BRIGHT
		BIOB D 2 BRIGHT
		BIOB E 2 BRIGHT
		Stop
	}
}

