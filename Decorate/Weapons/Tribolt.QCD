Actor UTRipperBladeAltUpgraded : UTRipperBladeAlt
{
	var int user_velx;
	var int user_vely;
	var int user_velz;
	var int user_vel_set;

	States
	{
	Spawn:
		TNT1 A 0
		TNT1 A 0 A_SetUserVar("user_velx", velx)
		TNT1 A 0 A_SetUserVar("user_vely", vely)
		TNT1 A 0 A_SetUserVar("user_velz", velz)
		TNT1 A 0 A_SetUserVar("user_vel_set", 1)
		TNT1 A 0 A_Jump(256, "SpawnLoop") //for virtual jump to inherited versions
	SpawnLoop:
		BLD9 AAA 1
		Loop

	XDeath:
		TNT1 A 0 A_PlaySound("UTDE/Weapons/Ripper/Impact_UT99",CHAN_AUTO,1,0,1)
		TNT1 A 0 A_GiveToTarget("HitBeepBig",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		TNT1 A 0 A_JumpIf(user_vel_set == 0, 2)
		TNT1 A 0 A_SpawnItemEx("UTRipperBladeAltUpgradedRipper", 0, 0, 0, user_velx, user_vely, user_velz, 0, SXF_ABSOLUTEVELOCITY|SXF_TRANSFERPOINTERS)
		TNT1 A 0 // need this state to jump to if ripper shouldn't spawn
		Stop
	}
}

