ACTOR BioBallSticky3DM : BioBallSticky1DM
{
	Radius 3
	Height 6
	Scale 0.33

	States
	{
	XDeath:
		TNT1 A 0 A_GiveToTarget("HitBeepMid",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		Goto DeathCont

	DeathCont:
		TNT1 A 0 A_PlaySound("UTDE/Weapons/BioRifle/Impact_UT2004",CHAN_AUTO,1.0,0)
		TNT1 A 0 A_RadiusThrust(68,128,RTF_AFFECTSOURCE|RTF_THRUSTZ)	//thrust players only this way, without damage
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", true)
		TNT1 A 0 A_Explode(20,128,XF_HURTSOURCE,0,18)	//self rocket damage with rocket jump is 20
		TNT1 A 0 A_Explode(52,128,0,0,18)		//then another 52 extra damage for impacting a player + (1)dmg on the projectile = 73dmg
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", false)
		Goto DeathFinish
	}
}

ACTOR BioBallSticky3DM_U1 : BioBallSticky3DM
{
	States
	{
	Spawn:
		BIOG ABCDEFABCDEFABCDE 6 Light(GreenSmallPoint3) Bright
		Goto Death

	DeathCont:
		TNT1 A 0 A_PlaySound("UTDE/Weapons/BioRifle/Impact_U1",CHAN_AUTO,1.0,0)
		Goto Super::DeathCont+1
	}
}

