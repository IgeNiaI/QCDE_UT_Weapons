// --------------------------------------------------------------------------
//
// Flak Cannon Mini
// Weapon sprites by geNia, Pickup and HUD sprites by Pixo
// Weapon code by geNia
//
// --------------------------------------------------------------------------

Actor CompatVer31_Shotgun {} // for compatibility checks

Actor ShotgunPickup : QCWeaponPickup 15601
{
	//$NotAngled
	//$Category "QCDE Weapons"
	//$Color 14
	//$Title "Flak Cannon Mini (DM becomes ammo)"
	Height 48
	Radius 20
	Scale 0.55
	Inventory.PickupSound "QC/Items/WeaponPick"
	Inventory.PickupMessage "$GOT_UTDispersion"
	Tag "$TAG_UTDispersion"
	Inventory.RespawnTics 35
	States
	{
	Spawn:
		U1GG Y 35 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		U1GG Y 35 A_CheckFlag("DROPPED", "BecomeWeaponItself")
		Goto Idle
	DMSpawn:
		"####" "#" 0 A_ChangeFlag("DROPPED", 0)
		TNT1 A 0 A_Jump(256,"BeHourglass","BeBackpack","BeWeapon")
		Stop
	BeHourglass:
		TNT1 A 0 A_SpawnItemEx("BigHourglass")
		Stop
	BeBackpack:
		TNT1 A 0 A_SpawnItemEx("QCBackpack")
		Stop
	BeWeapon:
		TNT1 A 0 A_Jump(256,"BeHeavyMachinegun","BeSuperNailgun","BeTribolt")
		Stop
		BeHeavyMachinegun:
			TNT1 A 0 A_SpawnItemEx("HeavyMachinegunPickup")
			Stop
		BeSuperNailgun:
			TNT1 A 0 A_SpawnItemEx("SuperNailgunPickup")
			Stop
		BeTribolt:
			TNT1 A 0 A_SpawnItemEx("TriboltPickup")
			Stop

	BecomeWeaponItself:
		TNT1 A 0 A_SpawnItemEx("QCShotgun")
		TNT1 A 0 A_JumpIf(true, "End") Goto Idle // <-- this is to fool client-side predictor
	End:TNT1 A 0
		Stop

	Idle:
		U1GG Y 0 ACS_NamedExecuteWithResult("QCDE_WeaponSpawned",3,args[4])
		U1GG Y -1 A_SetArg(4, 0)
		Wait
	Pickup:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"WeaponStay")
		TNT1 A 0 A_GiveInventory("QCShotgun")
		TNT1 A 0
		Stop
	WeaponStay:
		TNT1 A 0 A_JumpIfInventory("QCShotgun",1,"Stay")
		TNT1 A 0 A_SpawnItemEx("QCShotgun", velx,vely,velz, velx,vely,velz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Fail
	Stay:
		TNT1 A 0
		Fail
	HideIndefinitely:
		TNT1 A 1 A_SetTics(CallACS("QCDE_SetWeaponRespawnTics"))
		Goto Super::HideDoomish+1
	HideDoomish:
		TNT1 A 1
		TNT1 A 1 A_SetTics(CallACS("QCDE_SetWeaponRespawnTics"))
		Goto Super::HideDoomish+1
	}
}

Actor ShotgunPickupNoGravity : ShotgunPickup 15611
{
	//$Category "QCDE Weapons (No Gravity)"
	//$Title "Flak Cannon Mini (No Gravity)"
	+NOGRAVITY
}


Actor QCShotgun : QCWeapon
{
	+INVENTORY.ALWAYSPICKUP
	Height 48
	Weapon.SwaySpeed 3.4
	Weapon.Kickback 35
	Weapon.SelectionOrder 1940
	Weapon.AmmoGive 1
	Weapon.AmmoType "UTDisprAmmo"
	Obituary "$OB_UTDispersion"
	Inventory.PickupMessage "$GOT_UTDispersion"
	Tag "$TAG_UTDispersion"
	Scale 0.55
	States
	{
	Spawn:
		TNT1 A 1
		U1GG Y 35 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		Goto Idle
	DMSpawn:
		U1GG Z 0 Bright A_ChangeFlag("NOBLOCKMAP",1)	//in DM, if a player drops this weapon, cant be picked
		TNT1 Z 3	//and disappears
		Stop
	Idle:
		U1GG Y -1
		Wait

	//-----------------------
	// Select/Deselect Seq
	//-----------------------
	Select:
		TNT1 A 0 A_JumpIfInventory("SG_UG_Spread", 1, "SecondUpgradeCheckSelect")
		TNT1 A 0 A_JumpIfInventory("SG_UG_Explosive", 1, "Select3")
		Goto Select1
	SecondUpgradeCheckSelect:
		TNT1 A 0 A_JumpIfInventory("SG_UG_Explosive", 1, "Select5")
		Goto Select3

	Select1:
		TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 20, "Select1.Modded")
		TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 7, "Select1.U1") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 3, "Select1.UC2") // 3-5 fall back to UC2
	Select1.U1:
		U1AG A 0
		Goto SelectCont
	Select1.UC2:
		U6AG A 0
		Goto SelectCont
	Select1.Modded:
		MDAG A 0
		Goto SelectCont
	Select3:
		TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 20, "Select3.Modded")
		TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 7, "Select3.U1") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 3, "Select3.UC2")
	Select3.U1:
		U1CG A 0
		Goto SelectCont
	Select3.UC2:
		U6CG A 0
		Goto SelectCont
	Select3.Modded:
		MDCG A 0
		Goto SelectCont
	Select5:
		TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 20, "Select5.Modded")
		TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 7, "Select5.U1") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 3, "Select5.UC2")
	Select5.U1:
		U1EG A 0
		Goto SelectCont
	Select5.UC2:
		U6EG A 0
		Goto SelectCont
	Select5.Modded:
		MDEG A 0
		Goto SelectCont

	SelectCont:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,2)
		"####" A 0 A_PlaySound("QC/Weapons/Switch",CHAN_5,1,0,3) //Not in Weapon.UpSound because it interrupts CHAN_WEAPON sounds
		"####" A 0 A_StopSound(CHAN_WEAPON) //stops any weapon looping sound
	SelectLooper:
		"####" A 1 A_Raise
		"####" AAA 0 A_Raise
		Loop

	Deselect:
		"####" A 0 A_StopSound(5)
		"####" A 0 A_StopSound(CHAN_WEAPON)
	DeselectLooper:
		"####" A 1 A_Lower
		"####" AAA 0 A_Lower
		Loop

	//-----------------------
	// Ready Seq
	//-----------------------
	Ready:
		TNT1 A 0 A_JumpIfInventory("SG_UG_Spread", 1, "SecondUpgradeCheckReady")
		TNT1 A 0 A_JumpIfInventory("SG_UG_Explosive", 1, "Prepare3")
		Goto Prepare1
	SecondUpgradeCheckReady:
		TNT1 A 0 A_JumpIfInventory("SG_UG_Explosive", 1, "Prepare5")
		Goto Prepare3

	Prepare1:
		TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 20, "Prepare1.Modded")
		TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 7, "Prepare1.U1") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 3, "Prepare1.UC2")
	Prepare1.U1:
		U1AG A 0
		Goto Prepare1Cont
	Prepare1.UC2:
		U6AG A 0
		Goto Prepare1Cont
	Prepare1.Modded:
		MDAG A 0 A_PlaySound("UTDE/Weapons/Dispr/Prepare_Modded",CHAN_WEAPON,1,0,3)
		Goto Prepare1Cont
	Prepare1Cont:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire1")
		"####" ABCDEFGHIJKLMNOPQRSTUVWXYZ 1 A_WeaponReady
		Goto Idle1

	Idle1:
		TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 20, "Idle1.Modded")
		TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 7, "Idle1.U1") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 3, "Idle1.UC2")
	Idle1.U1:
		U1GG A 0
		Goto Idle1Cont
	Idle1.UC2:
		U6GG A 0
		Goto Idle1Cont
	Idle1.Modded:
		MDGG A 0 A_PlaySound("UTDE/Weapons/Dispr/Idle_Modded",CHAN_WEAPON,1,1)
		Goto Idle1Cont
	Idle1Cont:
		"####" A 0 A_JumpIfInventory("SG_UG_Spread", 1, "Ready")
		"####" A 0 A_JumpIfInventory("SG_UG_Explosive", 1, "Ready")
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire1")
		"####" ABCDEF 1 A_WeaponReady
		Goto Idle1Cont

		ReadyCantFire1:
			"####" A 0 A_StopSound(5)
			"####" A 0 A_StopSound(CHAN_WEAPON)
		RCFLooper1:
			"####" A 4 A_WeaponReady(WRF_NOFIRE)
			"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"RCFLooper1")
			Goto Ready

	Prepare3:
		TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 20, "Prepare3.Modded")
		TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 7, "Prepare3.U1") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 3, "Prepare3.UC2")
	Prepare3.U1:
		U1CG A 0
		Goto Prepare3Cont
	Prepare3.UC2:
		U6CG A 0
		Goto Prepare3Cont
	Prepare3.Modded:
		MDCG A 0 A_PlaySound("UTDE/Weapons/Dispr/Prepare_Modded",CHAN_WEAPON,1,0,3)
		Goto Prepare3Cont
	Prepare3Cont:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire3")
		"####" ABCDEFGHIJKLMNOPQRSTUVWXYZ 1 A_WeaponReady
		Goto Idle3

	Idle3:
		TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 20, "Idle3.Modded")
		TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 7, "Idle3.U1") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 3, "Idle3.UC2")
	Idle3.U1:
		U1IG A 0
		Goto Idle3Cont
	Idle3.UC2:
		U6IG A 0
		Goto Idle3Cont
	Idle3.Modded:
		MDIG A 0 A_PlaySound("UTDE/Weapons/Dispr/Idle_Modded",CHAN_WEAPON,1,1)
		Goto Idle3Cont
	Idle3Cont:
		"####" A 0 A_JumpIfInventory("SG_UG_Spread", 1, "Idle3SpreadCheck")
		"####" A 0 A_JumpIfInventory("SG_UG_Explosive", -1, "Ready")
		Goto Idle3Loop
	Idle3SpreadCheck:
		"####" A 0 A_JumpIfInventory("SG_UG_Explosive", 1, "Ready")
	Idle3Loop:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire3")
		"####" ABCDEF 1 A_WeaponReady
		Goto Idle3Cont

		ReadyCantFire3:
			"####" A 0 A_StopSound(5)
			"####" A 0 A_StopSound(CHAN_WEAPON)
		RCFLooper3:
			"####" A 4 A_WeaponReady(WRF_NOFIRE)
			"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"RCFLooper3")
			Goto Ready

	Prepare5:
		TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 20, "Prepare5.Modded")
		TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 7, "Prepare5.U1") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 3, "Prepare5.UC2")
	Prepare5.U1:
		U1EG A 0
		Goto Prepare5Cont
	Prepare5.UC2:
		U6EG A 0
		Goto Prepare5Cont
	Prepare5.Modded:
		MDEG A 0 A_PlaySound("UTDE/Weapons/Dispr/Prepare_Modded",CHAN_WEAPON,1,0,3)
		Goto Prepare5Cont
	Prepare5Cont:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire5")
		"####" ABCDEFGHIJKLMNOPQRSTUVWXYZ 1 A_WeaponReady
		Goto Idle5

	Idle5:
		TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 20, "Idle5.Modded")
		TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 7, "Idle5.U1") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 3, "Idle5.UC2")
	Idle5.U1:
		U1KG A 0
		Goto Idle5Cont
	Idle5.UC2:
		U6KG A 0
		Goto Idle5Cont
	Idle5.Modded:
		MDKG A 0 A_PlaySound("UTDE/Weapons/Dispr/Idle_Modded",CHAN_WEAPON,1,1)
		Goto Idle5Cont
	Idle5Cont:
		"####" A 0 A_JumpIfInventory("SG_UG_Spread", -1, "Ready")
		"####" A 0 A_JumpIfInventory("SG_UG_Explosive", -1, "Ready")
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire5")
		"####" ABCDEF 1 A_WeaponReady
		Goto Idle5Cont

		ReadyCantFire5:
			"####" A 0 A_StopSound(5)
			"####" A 0 A_StopSound(CHAN_WEAPON)
		RCFLooper5:
			"####" A 4 A_WeaponReady(WRF_NOFIRE)
			"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"RCFLooper5")
			Goto Ready

	//-----------------------
	// Fire Seq
	//-----------------------
	Fire:
		"####" A 0 A_JumpIfInventory("SG_UG_Spread", 1, "SecondUpgradeCheckFire")
		"####" A 0 A_JumpIfInventory("SG_UG_Explosive", 1, "Fire3")
		Goto Fire1

	SecondUpgradeCheckFire:
		"####" A 0 A_JumpIfInventory("SG_UG_Explosive", 1, "Fire5")
		Goto Fire3

	// Base fire
	Fire1:
		TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 20, "Fire1.Modded")
		TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 7, "Fire1.U1") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 3, "Fire1.UC2")
	Fire1.U1:
		U1MG A 0
		Goto Fire1Cont
	Fire1.UC2:
		U6MG A 0
		Goto Fire1Cont
	Fire1.Modded:
		MDMG A 0
		Goto Fire1Cont
	Fire1Cont:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire1")
		"####" A 0 A_GunFlash("Flash1")
		"####" B 1
		"####" C 1 Offset(3,35)
		"####" D 1 Offset(5,37)
		"####" E 1 Offset(7,39)
		"####" F 1 Offset(8,40)
		"####" G 1 Offset(7,39)
		"####" H 1 Offset(5,37)
		"####" I 1 Offset(3,35)
		"####" J 1 Offset(2,34)
		"####" K 1 Offset(1,33)
		"####" L 1 Offset(0,32)
		Goto Ready

	Flash1:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 20, "Flash1.Modded")
		TNT1 A 0 A_FireCustomMissile("UTDispr1",0,false,1,4,0,0)
		Goto FlashCheckSound1
	Flash1.Modded:
		TNT1 A 0 A_FireCustomMissile("UTDispr1_Modded",0,false,1,4,0,0)
		Goto FlashCheckSound1

	FlashCheckSound1:
		TNT1 A 0 A_JumpIfInventory("PowerQuad",1,"QuadSound1")
		TNT1 A 0 A_JumpIfInventory("PowerTerminatorArtifact",1,"QuadSound1")
		Goto NormalSound1

		NormalSound1:
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 20, "NormalSound1.Modded")
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 9, "NormalSound1.U1") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 8, "NormalSound1.U1") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 7, "NormalSound1.U1") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 6, "NormalSound1.UC2")
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 5, "NormalSound1.UC2") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 4, "NormalSound1.UC2") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 3, "NormalSound1.UC2") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 2, "NormalSound1.U1") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 1, "NormalSound1.U1")
		NormalSound1.U1:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Dispr/Fire_U1",CHAN_WEAPON)
			Goto FlashEnder1
		NormalSound1.UC2:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Dispr/Fire_UC2",CHAN_WEAPON)
			Goto FlashEnder1
		NormalSound1.Modded:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Dispr/Fire_Modded",CHAN_WEAPON)
			Goto FlashEnder1

		QuadSound1:
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 20, "QuadSound1.Modded")
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 9, "QuadSound1.U1") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 8, "QuadSound1.U1") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 7, "QuadSound1.U1") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 6, "QuadSound1.UC2")
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 5, "QuadSound1.UC2") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 4, "QuadSound1.UC2") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 3, "QuadSound1.UC2") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 2, "QuadSound1.U1") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 1, "QuadSound1.U1")
		QuadSound1.U1:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Dispr/Quad/Fire_U1",CHAN_WEAPON)
			Goto FlashEnder1
		QuadSound1.UC2:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Dispr/Quad/Fire_UC2",CHAN_WEAPON)
			Goto FlashEnder1
		QuadSound1.Modded:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Dispr/Quad/Fire_Modded",CHAN_WEAPON)
			Goto FlashEnder1

	FlashEnder1:
		TNT1 A 0 A_JumpIfInventory("WepNoFlashToken",1,"FlashEnder1Cont")
		TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin",20,"FlashEnder1.Modded")
		TNT1 A 0 A_SetBlend("Blue",0.10,10)
		Goto FlashEnder1Cont
	FlashEnder1.Modded:
		TNT1 A 0 A_SetBlend("$WeaponSkin_DispersionPistol_ScreenBlend_Modded",0.10,10)
	FlashEnder1Cont:
		TNT1 A 0 A_JumpIfInventory("WepNoRecoilToken",1,"FlashEnderNoRecoil1")
		TNT1 A 0 A_SetPitch(pitch-0.5)
		TNT1 A 2
		TNT1 A 1 A_SetPitch(pitch+0.5)
		Stop
	FlashEnderNoRecoil1:
		TNT1 A 1
		Stop

	// Single upgrade fire
	Fire3:
		TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 20, "Fire3.Modded")
		TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 7, "Fire3.U1") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 3, "Fire3.UC2")
	Fire3.U1:
		U1OG A 0
		Goto Fire3Cont
	Fire3.UC2:
		U6OG A 0
		Goto Fire3Cont
	Fire3.Modded:
		MDOG A 0
		Goto Fire3Cont
	Fire3Cont:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire3")
		"####" A 0 A_GunFlash("Flash3")
		"####" B 1
		"####" C 1 Offset(3,35)
		"####" D 1 Offset(5,37)
		"####" E 1 Offset(7,39)
		"####" F 1 Offset(8,40)
		"####" G 1 Offset(7,39)
		"####" H 1 Offset(5,37)
		"####" I 1 Offset(3,35)
		"####" J 1 Offset(2,34)
		"####" K 1 Offset(1,33)
		"####" L 1 Offset(0,32)
		Goto Ready

	Flash3:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 20, "Flash3.Modded")
		TNT1 A 0 A_FireCustomMissile("UTDispr3",0,false,1,4,0,0)
		Goto FlashCheckSound3
	Flash3.Modded:
		TNT1 A 0 A_FireCustomMissile("UTDispr3_Modded",0,false,1,4,0,0)
		Goto FlashCheckSound3

	FlashCheckSound3:
		TNT1 A 0 A_JumpIfInventory("PowerQuad",1,"QuadSound3")
		TNT1 A 0 A_JumpIfInventory("PowerTerminatorArtifact",1,"QuadSound3")
		Goto NormalSound3

		NormalSound3:
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 20, "NormalSound3.Modded")
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 9, "NormalSound3.U1") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 8, "NormalSound3.U1") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 7, "NormalSound3.U1") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 6, "NormalSound3.UC2")
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 5, "NormalSound3.UC2") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 4, "NormalSound3.UC2") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 3, "NormalSound3.UC2") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 2, "NormalSound3.U1") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 1, "NormalSound3.U1")
		NormalSound3.U1:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Dispr/Fire_U1",CHAN_WEAPON)
			Goto FlashEnder3
		NormalSound3.UC2:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Dispr/Fire_UC2",CHAN_WEAPON)
			Goto FlashEnder3
		NormalSound3.Modded:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Dispr/Fire_Modded",CHAN_WEAPON)
			Goto FlashEnder3

		QuadSound3:
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 20, "QuadSound3.Modded")
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 9, "QuadSound3.U1") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 8, "QuadSound3.U1") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 7, "QuadSound3.U1") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 6, "QuadSound3.UC2")
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 5, "QuadSound3.UC2") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 4, "QuadSound3.UC2") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 3, "QuadSound3.UC2") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 2, "QuadSound3.U1") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 1, "QuadSound3.U1")
		QuadSound3.U1:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Dispr/Quad/Fire_U1",CHAN_WEAPON)
			Goto FlashEnder3
		QuadSound3.UC2:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Dispr/Quad/Fire_UC2",CHAN_WEAPON)
			Goto FlashEnder3
		QuadSound3.Modded:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Dispr/Quad/Fire_Modded",CHAN_WEAPON)
			Goto FlashEnder3

	FlashEnder3:
		TNT1 A 0 A_JumpIfInventory("WepNoFlashToken",1,"FlashEnder3Cont")
		TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin",20,"FlashEnder3.Modded")
		TNT1 A 0 A_SetBlend("Green",0.10,13)
		Goto FlashEnder3Cont
	FlashEnder3.Modded:
		TNT1 A 0 A_SetBlend("$WeaponSkin_DispersionPistol_ScreenBlend_OneUpgrade_Modded",0.10,13)
	FlashEnder3Cont:
		TNT1 A 0 A_JumpIfInventory("WepNoRecoilToken",1,"FlashEnderNoRecoil3")
		TNT1 A 0 A_SetPitch(pitch-1.5)
		TNT1 A 2
		TNT1 AAA 1 A_SetPitch(pitch+0.5)
		Stop
	FlashEnderNoRecoil3:
		TNT1 A 1
		Stop

	// Double upgrade fire
	Fire5:
		TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 20, "Fire5.Modded")
		TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 7, "Fire5.U1") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 3, "Fire5.UC2")
	Fire5.U1:
		U1QG A 0
		Goto Fire5Cont
	Fire5.UC2:
		U6QG A 0
		Goto Fire5Cont
	Fire5.Modded:
		MDQG A 0
		Goto Fire5Cont
	Fire5Cont:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire5")
		"####" A 0 A_GunFlash("Flash5")
		"####" B 1
		"####" C 1 Offset(3,35)
		"####" D 1 Offset(5,37)
		"####" E 1 Offset(7,39)
		"####" F 1 Offset(8,40)
		"####" G 1 Offset(7,39)
		"####" H 1 Offset(5,37)
		"####" I 1 Offset(3,35)
		"####" J 1 Offset(2,34)
		"####" K 1 Offset(1,33)
		"####" L 1 Offset(0,32)
		Goto Ready

	Flash5:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 20, "Flash5.Modded")
		TNT1 A 0 A_FireCustomMissile("UTDispr5",0,false,1,4,0,0)
		Goto FlashCheckSound5
	Flash5.Modded:
		TNT1 A 0 A_FireCustomMissile("UTDispr5_Modded",0,false,1,4,0,0)
		Goto FlashCheckSound5

	FlashCheckSound5:
		TNT1 A 0 A_JumpIfInventory("PowerQuad",1,"QuadSound5")
		TNT1 A 0 A_JumpIfInventory("PowerTerminatorArtifact",1,"QuadSound5")
		Goto NormalSound5

		NormalSound5:
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 20, "NormalSound5.Modded")
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 9, "NormalSound5.U1") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 8, "NormalSound5.U1") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 7, "NormalSound5.U1") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 6, "NormalSound5.UC2")
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 5, "NormalSound5.UC2") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 4, "NormalSound5.UC2") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 3, "NormalSound5.UC2") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 2, "NormalSound5.U1") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 1, "NormalSound5.U1")
		NormalSound5.U1:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Dispr/Fire_U1",CHAN_WEAPON)
			Goto FlashEnder5
		NormalSound5.UC2:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Dispr/Fire_UC2",CHAN_WEAPON)
			Goto FlashEnder5
		NormalSound5.Modded:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Dispr/Fire_Modded",CHAN_WEAPON)
			Goto FlashEnder5

		QuadSound5:
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 20, "QuadSound5.Modded")
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 9, "QuadSound5.U1") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 8, "QuadSound5.U1") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 7, "QuadSound5.U1") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 6, "QuadSound5.UC2")
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 5, "QuadSound5.UC2") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 4, "QuadSound5.UC2") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 3, "QuadSound5.UC2") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 2, "QuadSound5.U1") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 1, "QuadSound5.U1")
		QuadSound5.U1:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Dispr/Quad/Fire_U1",CHAN_WEAPON)
			Goto FlashEnder5
		QuadSound5.UC2:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Dispr/Quad/Fire_UC2",CHAN_WEAPON)
			Goto FlashEnder5
		QuadSound5.Modded:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Dispr/Quad/Fire_Modded",CHAN_WEAPON)
			Goto FlashEnder5

	FlashEnder5:
		TNT1 A 0 A_JumpIfInventory("WepNoFlashToken",1,"FlashEnder5Cont")
		TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin",20,"FlashEnder5.Modded")
		TNT1 A 0 A_SetBlend("Red",0.10,15)
		Goto FlashEnder5Cont
	FlashEnder5.Modded:
		TNT1 A 0 A_SetBlend("$WeaponSkin_DispersionPistol_ScreenBlend_TwoUpgrades_Modded",0.10,15)
	FlashEnder5Cont:
		TNT1 A 0 A_JumpIfInventory("WepNoRecoilToken",1,"FlashEnderNoRecoil5")
		TNT1 A 0 A_SetPitch(pitch-1.5)
		TNT1 A 2
		TNT1 AAA 1 A_SetPitch(pitch+0.5)
		Stop
	FlashEnderNoRecoil5:
		TNT1 A 1
		Stop
	}
}

Actor UTDispr1 : FastProjectile
{
	Projectile
	+FORCEXYBILLBOARD
	+BLOODSPLATTER
	+MTHRUSPECIES
	+DONTBLAST
	Obituary "$OB_UTDispersion"
	Speed 40
	Radius 4
	Height 9
	Damage (random(10,20))
	Decal "Q4PlasmaBlack"
	Scale 0.18
	SeeSound ""
	RenderStyle Add
	States
	{
	Spawn:
		PSMA AAABBB 1 Light("BlueMediumFlicker2") Bright
		Loop

	XDeath:
		TNT1 A 10 A_GiveToTarget("HitBeepLow",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		Stop

	Death:
		LBA2 A 0 A_PlaySound("UTDE/Weapons/Dispr/Impact",CHAN_AUTO,1,0,1)
		LBA2 A 1 Light("BlueMediumFlicker3") Bright
		LBA2 BCDEFGH 1 Bright
		Stop
	}
}

Actor UTDispr3 : UTDispr1
{
	Damage (random(30,50))
	Scale 0.19
	States
	{
	Spawn:
		PSMB AAABBB 1 Light("GreenMediumFlicker2") Bright
		Loop

	XDeath:
		TNT1 A 10 A_GiveToTarget("HitBeepMid",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		Stop

	Death:
		LBA2 A 0 A_PlaySound("UTDE/Weapons/Dispr/Impact",CHAN_AUTO,1,0,1)
		LBA2 A 1 Light("GreenMediumFlicker3") Bright
		LBA2 BCDEFGH 1 Bright
		Stop
	}
}

Actor UTDispr5 : UTDispr1
{
	Damage (random(60,90))
	Scale 0.20
	States
	{
	Spawn:
		PSMC AAABBB 1 Light("RedMediumFlicker2") Bright
		Loop

	XDeath:
		TNT1 A 10 A_GiveToTarget("HitBeepBig",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		Stop

	Death:
		LBA2 A 0 A_PlaySound("UTDE/Weapons/Dispr/Impact",CHAN_AUTO,1,0,1)
		LBA2 A 1 Light("RedSmallFlicker3") Bright
		LBA2 BCDEFGH 1 Bright
		Stop
	}
}

