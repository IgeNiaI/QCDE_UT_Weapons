// --------------------------------------------------------------------------
//
// Flak Cannon Mini
// Weapon and Pickup sprite by Pixo
// Weapon code by geNia
//
// --------------------------------------------------------------------------

Actor ShotgunPickup : CustomInventory 15601
{
	//$NotAngled
	//$Category "QCDE Weapons"
	//$Color 14
	//$Title "Flak Cannon Mini (DM becomes ammo)"
	Height 48
	Radius 20
	Scale 0.55
	Inventory.PickupSound "QC/Items/WeaponPick"
	Inventory.PickupMessage "$GOT_UTFlakMini"
	Tag "$TAG_UTFlakMini"
	Inventory.RespawnTics 35
	States
	{
	Spawn:
		UTFM Y 35 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		UTFM Y 35 A_CheckFlag("DROPPED", "BecomeWeaponItself")
		Goto Idle
	DMSpawn:
		"####" "#" 0 A_ChangeFlag("DROPPED", 0)
		TNT1 A 0 A_Jump(256,"BeHourglass","BeBackpack","BeWeapon")
		Stop
	BeHourglass:
		TNT1 A 0 A_SpawnItemEx("BigHourglass")
		Stop
	BeBackpack:
		TNT1 A 0 A_SpawnItemEx("QCBackpack")
		Stop
	BeWeapon:
		TNT1 A 0 A_Jump(256,"BeHeavyMachinegun","BeSuperNailgun","BeTribolt")
		Stop
		BeHeavyMachinegun:
			TNT1 A 0 A_SpawnItemEx("HeavyMachinegunPickup")
			Stop
		BeSuperNailgun:
			TNT1 A 0 A_SpawnItemEx("SuperNailgunPickup")
			Stop
		BeTribolt:
			TNT1 A 0 A_SpawnItemEx("TriboltPickup")
			Stop
	
	BecomeWeaponItself:
		TNT1 A 0 A_SpawnItemEx("QCShotgun")
		TNT1 A 0 A_JumpIf(true, "End") Goto Idle // <-- this is to fool client-side predictor
	End:TNT1 A 0
		Stop
	
	Idle:
		UTFM Y -1 ACS_NamedExecuteWithResult("QCDE_WeaponSpawned",3,args[4])
		Wait
	Pickup:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"WeaponStay")
		TNT1 A 0 A_GiveInventory("QCShotgun")
		TNT1 A 0 
		Stop
	WeaponStay:
		TNT1 A 0 A_JumpIfInventory("QCShotgun",1,"Stay")
		TNT1 A 0 A_SpawnItemEx("QCShotgun", velx,vely,velz, velx,vely,velz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Fail
	Stay:
		TNT1 A 0
		Fail
	}
}


Actor QCShotgun : QCWeapon
{
	Height 48
	Weapon.SwaySpeed 1.6
	Weapon.Kickback 35
	Weapon.SelectionOrder 1940
	Weapon.AmmoUse 1
	Weapon.AmmoGive 15
	Weapon.AmmoType "QCShellAmmo"
	Obituary "$OB_UTFlakMini"
	Inventory.PickupMessage "$GOT_UTFlakMini"
	Tag "$TAG_UTFlakMini"
	Scale 0.55
	States
	{
	Spawn:
		UTFM Y 35 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		Goto Idle
	DMSpawn:
		UTFM Z 0 Bright A_ChangeFlag("NOBLOCKMAP",1)	//in DM, if a player drops this weapon, cant be picked
		TNT1 Z 3	//and disappears
		Stop
	Idle:
		UTFM Y -1
		Wait

	//-----------------------
	// Select/Deselect Seq
	//-----------------------
	Select:
		UTFM A 0 A_JumpIfInventory("NoWeaponFireToken",1,2)
		UTFM A 0 A_PlaySound("QC/Weapons/Switch",5,1,0,3) //Not in Weapon.UpSound because it interrupts CHAN_WEAPON sounds
		"####" "#" 0 A_StopSound(CHAN_WEAPON) //stops any weapon looping sound
	SelectLooper:
		UTFM A 1 A_Raise
		"####" "###" 0 A_Raise
		Loop
		
	Deselect:
		UTFM A 0 A_StopSound(5)
		UTFM A 0 A_StopSound(CHAN_WEAPON)
	DeselectLooper:
		UTFM A 1 A_Lower
		"####" "###" 0 A_Lower
		Loop

	//-----------------------
	// Ready Seq
	//-----------------------
	Ready:
		UTFM A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		UTFM A 3 A_WeaponReady
		Loop
		
		ReadyCantFire:
			UTFM A 0 A_StopSound(5)
			UTFM A 0 A_StopSound(CHAN_WEAPON)
		RCFLooper:
			UTFM A 4 A_WeaponReady(WRF_NOFIRE)
			UTFM A 0 A_JumpIfInventory("NoWeaponFireToken",1,"RCFLooper")
			Goto Ready

	//-----------------------
	// Fire Seq
	//-----------------------
	Fire: 	//27 tics, 0.77sec
		UTFM A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		UTFM B 0 A_GunFlash("Flash")
		UTFM B 1
		UTFM C 1 Offset(3,35)
		UTFM D 1 Offset(8,38)
		UTFM E 1 Offset(11,40)
		UTFM E 1 Offset(14,42)
		UTFM F 1 Offset(17,46)
		UTFM F 1 Offset(20,50)
		UTFM G 1
		UTFM G 1 Offset(19,49)  //10
		UTFM H 1 Offset(18,49)
		UTFM H 1 Offset(17,48)
		UTFM I 1 Offset(16,48)
		UTFM I 1 Offset(15,47)
		UTFM J 1 Offset(14,46)
		UTFM J 1 Offset(13,45)
		UTFM K 1 Offset(12,44)
		UTFM K 1 Offset(11,43)
		UTFM L 1 Offset(10,42)
		UTFM L 1 Offset(9,41)	//20
		UTFM M 1 Offset(8,40)
		UTFM M 1 Offset(7,39)
		UTFM N 1 Offset(6,38)
		UTFM N 1 Offset(5,37)
		UTFM O 1 Offset(4,36)
		UTFM O 1 Offset(3,35)
		UTFM P 1 Offset(2,34)
		UTFM Q 1 Offset(1,33)	//28
		Goto Ready

	Flash:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_FireCustomMissile("UTFlakMiniShell",frandom(3.0,-3.0),true,1,4,0,frandom(3.0,-3.0)) // Use ammo
		TNT1 AAAAAAAA 0 A_FireCustomMissile("UTFlakMiniShell",frandom(3.0,-3.0),false,1,4,0,frandom(3.0,-3.0)) // Don't use ammo
		Goto FlashCheckSound
			
	FlashCheckSound:
		TNT1 A 0 A_JumpIfInventory("PowerQuad",1,"QuadSound")
		Goto NormalSound
		
		NormalSound:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/FlakMini/Fire",CHAN_WEAPON)
			Goto FlashEnder
		QuadSound:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/FlakMini/Quad/Fire",CHAN_WEAPON)
			Goto FlashEnder
			
	FlashEnder:
		TNT1 A 0 A_JumpIfInventory("WepNoRecoilToken",1,"FlashEnderNoRecoil")		
		TNT1 A 0 A_SetPitch(pitch-3.5)
		TNT1 A 2
		TNT1 AAAAAAA 1 A_SetPitch(pitch+0.5)
		Stop
	FlashEnderNoRecoil:
		TNT1 A 1
		Stop

	}
}

Actor UTFlakMiniShell : FastProjectile
{
	var int user_velx;
	var int user_vely;
	var int user_velz;

	Projectile
	+FORCEXYBILLBOARD
	+DONTSPLASH
	+BLOODSPLATTER
	+MTHRUSPECIES
	+DONTBLAST
	ReactionTime 35
	damage (random(8,12))
	radius 2
	height 2
	speed 65
	renderstyle ADD
	alpha 0.9
	scale 0.4
	MissileType "UTFlakShellTrailFX"
	MissileHeight 8
	states
	{
	Spawn:
		TNT1 A 0
		TNT1 A 0 A_SetUserVar("user_velx", velx)
		TNT1 A 0 A_SetUserVar("user_vely", vely)
		TNT1 A 0 A_SetUserVar("user_velz", velz)
	FlyLoop:
		NAIL A 0 BRIGHT A_Countdown
		NAIL A 1 BRIGHT A_Jump(192, "Spawn")
		Goto FlyLoop+1
	XDeath:
		TNT1 A 0 A_GiveToTarget("HitBeepMid",1)
		Stop
	Death:
		TNT1 A 0 A_SpawnItemEx("UTFlakMiniShellBounced", 0, 0, 0, user_velx, user_vely, user_velz, 0, SXF_ABSOLUTEVELOCITY|SXF_TRANSFERPOINTERS)
		Stop
	}
}

Actor UTFlakMiniShellBounced
{
	Projectile
	+FORCEXYBILLBOARD
	+DONTSPLASH
	+USEBOUNCESTATE
	+BLOODSPLATTER
	+MTHRUSPECIES
	+DONTBLAST
	-NOGRAVITY
	ReactionTime 35
	Gravity 0.5
	damage (random(8,12))
	radius 2
	height 2
	speed 65
	renderstyle ADD
	alpha 0.9
	scale 0.4
	BounceType Doom
	BounceFactor 0.35
	WallBounceFactor 0.35
	Obituary "$OB_UTFlakMini"
	States
	{
	Spawn:
		NAIL A 0 BRIGHT A_Countdown
		NAIL A 0 BRIGHT A_SpawnItemEx("UTFlakShellTrailFXBounced")
		NAIL A 1 A_Jump(192, "Spawn")
		Goto Spawn+1
	Bounce:
		TNT1 A 0 A_PlaySound("UTDE/Weapons/Flak/Bounce",CHAN_AUTO,1,0,1)
		Goto Spawn
	XDeath:
		TNT1 A 0 A_GiveToTarget("HitBeepMid",1)
	Death:
		TNT1 A 1
		Stop
	}
}

// --------------------------------------------------------------------------
//	For competitive DM, weapons dont autoaim
// --------------------------------------------------------------------------
Actor QCShotgunDM : QCShotgun
{
	+WEAPON.NOAUTOAIM
	+CHEATNOTWEAPON
	Tag "$TAG_UTFlakMini"
	Weapon.AmmoGive 15
	Weapon.AmmoDmScale 1.0
	Weapon.AmmoDmRefill 2

	States
	{
	Flash:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_FireCustomMissile("UTFlakMiniShellDM",frandom(4.0,-4.0),true,1,4,0,frandom(4.0,-4.0)) // Use ammo
		TNT1 AAAAAAAA 0 A_FireCustomMissile("UTFlakMiniShellDM",frandom(4.0,-4.0),false,1,4,0,frandom(4.0,-4.0)) // Don't use ammo
		Goto FlashCheckSound
	}
}

Actor UTFlakMiniShellDM : UTFlakMiniShell
{
	-MTHRUSPECIES
	-DONTBLAST
	damage (10)
	Obituary "$OB_UTFlakMini"
	States
	{
	Death:
		TNT1 A 0 A_SpawnItemEx("UTFlakMiniShellBouncedDM", 0, 0, 0, user_velx, user_vely, user_velz, 0, SXF_ABSOLUTEVELOCITY|SXF_TRANSFERPOINTERS)
		Stop
	}
}

Actor UTFlakMiniShellBouncedDM : UTFlakMiniShellBounced
{
	-MTHRUSPECIES
	-DONTBLAST
	damage (10)
}
