// --------------------------------------------------------------------------

Actor CompatVer31_Shotgun {} // for compatibility checks

Actor ShotgunPickup : QCWeaponPickup 15601
{
	//$NotAngled
	//$Category "QCDE Weapons"
	//$Color 14
	//$Title "Flak Cannon Mini (DM becomes ammo)"
	Height 48
	Radius 20
	Scale 0.55
	Inventory.PickupSound "QC/Items/WeaponPick"
	Inventory.PickupMessage "$GOT_UTDispersion"
	Tag "$TAG_UTDispersion"
	Inventory.RespawnTics 35
	States
	{
	Spawn:
		U1GG Y 35 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		U1GG Y 35 A_CheckFlag("DROPPED", "BecomeWeaponItself")
		Goto Idle
	DMSpawn:
		"####" "#" 0 A_ChangeFlag("DROPPED", 0)
		TNT1 A 0 A_Jump(256,"BeHourglass","BeBackpack","BeWeapon")
		Stop
	BeHourglass:
		TNT1 A 0 A_SpawnItemEx("BigHourglass")
		Stop
	BeBackpack:
		TNT1 A 0 A_SpawnItemEx("QCBackpack")
		Stop
	BeWeapon:
		TNT1 A 0 A_Jump(256,"BeHeavyMachinegun","BeSuperNailgun","BeTribolt")
		Stop
		BeHeavyMachinegun:
			TNT1 A 0 A_SpawnItemEx("HeavyMachinegunPickup")
			Stop
		BeSuperNailgun:
			TNT1 A 0 A_SpawnItemEx("SuperNailgunPickup")
			Stop
		BeTribolt:
			TNT1 A 0 A_SpawnItemEx("TriboltPickup")
			Stop

	BecomeWeaponItself:
		TNT1 A 0 A_SpawnItemEx("QCShotgun")
		TNT1 A 0 A_JumpIf(true, "End") Goto Idle // <-- this is to fool client-side predictor
	End:TNT1 A 0
		Stop

	Idle:
		U1GG Y 0 ACS_NamedExecuteWithResult("QCDE_WeaponSpawned",3,args[4])
		U1GG Y -1 A_SetArg(4, 0)
		Wait
	Pickup:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"WeaponStay")
		TNT1 A 0 A_GiveInventory("QCShotgun")
		TNT1 A 0
		Stop
	WeaponStay:
		TNT1 A 0 A_JumpIfInventory("QCShotgun",1,"Stay")
		TNT1 A 0 A_SpawnItemEx("QCShotgun", velx,vely,velz, velx,vely,velz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Fail
	Stay:
		TNT1 A 0
		Fail
	HideIndefinitely:
		TNT1 A 1 A_SetTics(CallACS("QCDE_SetWeaponRespawnTics"))
		Goto Super::HideDoomish+1
	HideDoomish:
		TNT1 A 1
		TNT1 A 1 A_SetTics(CallACS("QCDE_SetWeaponRespawnTics"))
		Goto Super::HideDoomish+1
	}
}

Actor ShotgunPickupNoGravity : ShotgunPickup 15611
{
	//$Category "QCDE Weapons (No Gravity)"
	//$Title "Flak Cannon Mini (No Gravity)"
	+NOGRAVITY
}


Actor QCShotgun : QCWeapon
{
	+INVENTORY.ALWAYSPICKUP
	Height 48
	Weapon.SwaySpeed 3.4
	Weapon.Kickback 35
	Weapon.SelectionOrder 1940
	Weapon.AmmoGive 1
	Weapon.AmmoType "UTDisprAmmo"
	Obituary "$OB_UTDispersion"
	Inventory.PickupMessage "$GOT_UTDispersion"
	Tag "$TAG_UTDispersion"
	Scale 0.55
	States
	{
	Spawn:
		TNT1 A 1
		U1GG Y 35 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		Goto Idle
	DMSpawn:
		U1GG Z 0 Bright A_ChangeFlag("NOBLOCKMAP",1)	//in DM, if a player drops this weapon, cant be picked
		TNT1 Z 3	//and disappears
		Stop
	Idle:
		U1GG Y -1
		Wait

	//-----------------------
	// Select/Deselect Seq
	//-----------------------
	Select:
		TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 6, "Select.UC2")
		TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 1, "Select.U1")
	Select.U1:
		U1GG A 0
		Goto SelectCont
	Select.UC2:
		U6GG A 0
		Goto SelectCont

	SelectCont:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,2)
		"####" A 0 A_PlaySound("QC/Weapons/Switch",CHAN_5,1,0,3) //Not in Weapon.UpSound because it interrupts CHAN_WEAPON sounds
		"####" A 0 A_StopSound(CHAN_WEAPON) //stops any weapon looping sound
		"####" A 0 A_JumpIfInventory("SG_UG_Spread", 1, "SecondUpgradeCheckSelect")
		"####" A 0 A_JumpIfInventory("SG_UG_Explosive", 1, "SelectLooper3")
		Goto SelectLooper1

	SecondUpgradeCheckSelect:
		"####" A 0 A_JumpIfInventory("SG_UG_Explosive", 1, "SelectLooper5")
		Goto SelectLooper3

	SelectLooper1:
		"####" A 1 A_Raise
		"####" AAA 0 A_Raise
		Loop
	SelectLooper3:
		"####" D 1 A_Raise
		"####" DDD 0 A_Raise
		Loop
	SelectLooper5:
		"####" G 1 A_Raise
		"####" GGG 0 A_Raise
		Loop

	Deselect:
		"####" A 0 A_StopSound(5)
		"####" A 0 A_StopSound(CHAN_WEAPON)
		"####" A 0 A_JumpIfInventory("SG_UG_Spread", 1, "SecondUpgradeCheckDeselect")
		"####" A 0 A_JumpIfInventory("SG_UG_Explosive", 1, "DeselectLooper3")
		Goto DeselectLooper1

	SecondUpgradeCheckDeselect:
		"####" A 0 A_JumpIfInventory("SG_UG_Explosive", 1, "DeselectLooper5")
		Goto DeselectLooper3

	DeselectLooper1:
		"####" A 1 A_Lower
		"####" AAA 0 A_Lower
		Loop
	DeselectLooper3:
		"####" D 1 A_Lower
		"####" DDD 0 A_Lower
		Loop
	DeselectLooper5:
		"####" G 1 A_Lower
		"####" GGG 0 A_Lower
		Loop

	//-----------------------
	// Ready Seq
	//-----------------------
	Ready:
		TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 6, "Ready.UC2")
		TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 1, "Ready.U1")
	Ready.U1:
		U1GG A 0
		Goto ReadyCont
	Ready.UC2:
		U6GG A 0
		Goto ReadyCont

	ReadyCont:
		"####" A 0 A_JumpIfInventory("SG_UG_Spread", 1, "Ready3")
		"####" A 0 A_JumpIfInventory("SG_UG_Explosive", 1, "Ready3v2")
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire1")
		"####" A 3 A_WeaponReady
		Loop

		ReadyCantFire1:
			"####" A 0 A_StopSound(5)
			"####" A 0 A_StopSound(CHAN_WEAPON)
		RCFLooper1:
			"####" A 4 A_WeaponReady(WRF_NOFIRE)
			"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"RCFLooper1")
			Goto Ready

	Ready3:
		"####" A 0 A_JumpIfInventory("SG_UG_Explosive", 1, "Ready5")
		"####" A 0 A_JumpIfInventory("SG_UG_Spread", -1, "Ready")
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire3")
		"####" D 3 A_WeaponReady
		Loop

		ReadyCantFire3:
			"####" A 0 A_StopSound(5)
			"####" A 0 A_StopSound(CHAN_WEAPON)
		RCFLooper3:
			"####" D 4 A_WeaponReady(WRF_NOFIRE)
			"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"RCFLooper3")
			Goto Ready3

	Ready3v2:
		"####" A 0 A_JumpIfInventory("SG_UG_Spread", 1, "Ready5")
		"####" A 0 A_JumpIfInventory("SG_UG_Explosive", -1, "Ready")
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire3v2")
		"####" D 3 A_WeaponReady
		Loop

		ReadyCantFire3v2:
			"####" A 0 A_StopSound(5)
			"####" A 0 A_StopSound(CHAN_WEAPON)
		RCFLooper3v2:
			"####" D 4 A_WeaponReady(WRF_NOFIRE)
			"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"RCFLooper3v2")
			Goto Ready3v2

	Ready5:
		"####" A 0 A_JumpIfInventory("SG_UG_Spread", -1, "Ready")
		"####" A 0 A_JumpIfInventory("SG_UG_Explosive", -1, "Ready")
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire5")
		"####" G 3 A_WeaponReady
		Loop

		ReadyCantFire5:
			"####" A 0 A_StopSound(5)
			"####" A 0 A_StopSound(CHAN_WEAPON)
		RCFLooper5:
			"####" G 4 A_WeaponReady(WRF_NOFIRE)
			"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"RCFLooper5")
			Goto Ready5

	//-----------------------
	// Fire Seq
	//-----------------------
	Fire:
		"####" A 0 A_JumpIfInventory("SG_UG_Spread", 1, "SecondUpgradeCheckFire")
		"####" A 0 A_JumpIfInventory("SG_UG_Explosive", 1, "Fire3")
		Goto Fire1

	SecondUpgradeCheckFire:
		"####" A 0 A_JumpIfInventory("SG_UG_Explosive", 1, "Fire5")
		Goto Fire3

	// Base fire
	Fire1:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire1")
		"####" A 0 A_GunFlash("Flash1")
		"####" B 1
		"####" B 1 Offset(3,35)
		"####" C 1 Offset(5,37)
		"####" C 1 Offset(7,39)
		"####" A 1 Offset(8,40)
		"####" A 1 Offset(7,39)
		"####" A 1 Offset(5,37)
		"####" A 1 Offset(3,35)
		"####" A 1 Offset(2,34)
		"####" A 1 Offset(1,33)
		"####" A 1 Offset(0,32)
		Goto Ready

	Flash1:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_FireCustomMissile("UTDispr1",0,false,1,4,0,0)
		Goto FlashCheckSound1

	FlashCheckSound1:
		TNT1 A 0 A_JumpIfInventory("PowerQuad",1,"QuadSound1")
		TNT1 A 0 A_JumpIfInventory("PowerTerminatorArtifact",1,"QuadSound1")
		Goto NormalSound1

		NormalSound1:
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 6, "NormalSound1.UC2")
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 1, "NormalSound1.U1")
		NormalSound1.U1:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Dispr/Fire_U1",CHAN_WEAPON)
			Goto FlashEnder1
		NormalSound1.UC2:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Dispr/Fire_UC2",CHAN_WEAPON)
			Goto FlashEnder1

		QuadSound1:
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 6, "QuadSound1.UC2")
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 1, "QuadSound1.U1")
		QuadSound1.U1:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Dispr/Quad/Fire_U1",CHAN_WEAPON)
			Goto FlashEnder1
		QuadSound1.UC2:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Dispr/Quad/Fire_UC2",CHAN_WEAPON)
			Goto FlashEnder1

	FlashEnder1:
		TNT1 A 0 A_JumpIfInventory("WepNoFlashToken",1,"FlashEnder1Cont")
		TNT1 A 0 A_SetBlend("Blue",0.10,10)
	FlashEnder1Cont:
		TNT1 A 0 A_JumpIfInventory("WepNoRecoilToken",1,"FlashEnderNoRecoil1")
		TNT1 A 0 A_SetPitch(pitch-0.5)
		TNT1 A 2
		TNT1 A 1 A_SetPitch(pitch+0.5)
		Stop
	FlashEnderNoRecoil1:
		TNT1 A 1
		Stop

	// Single upgrade fire
	Fire3:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire3")
		"####" A 0 A_GunFlash("Flash3")
		"####" E 1
		"####" E 1 Offset(3,35)
		"####" F 1 Offset(5,37)
		"####" F 1 Offset(7,39)
		"####" D 1 Offset(8,40)
		"####" D 1 Offset(7,39)
		"####" D 1 Offset(5,37)
		"####" D 1 Offset(3,35)
		"####" D 1 Offset(2,34)
		"####" D 1 Offset(1,33)
		"####" D 1 Offset(0,32)
		Goto Ready

	Flash3:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_FireCustomMissile("UTDispr3",0,false,1,4,0,0)
		Goto FlashCheckSound3

	FlashCheckSound3:
		TNT1 A 0 A_JumpIfInventory("PowerQuad",1,"QuadSound3")
		TNT1 A 0 A_JumpIfInventory("PowerTerminatorArtifact",1,"QuadSound3")
		Goto NormalSound3

		NormalSound3:
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 6, "NormalSound3.UC2")
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 1, "NormalSound3.U1")
		NormalSound3.U1:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Dispr/Fire_U1",CHAN_WEAPON)
			Goto FlashEnder3
		NormalSound3.UC2:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Dispr/Fire_UC2",CHAN_WEAPON)
			Goto FlashEnder3

		QuadSound3:
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 6, "QuadSound3.UC2")
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 1, "QuadSound3.U1")
		QuadSound3.U1:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Dispr/Quad/Fire_U1",CHAN_WEAPON)
			Goto FlashEnder3
		QuadSound3.UC2:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Dispr/Quad/Fire_UC2",CHAN_WEAPON)
			Goto FlashEnder3

	FlashEnder3:
		TNT1 A 0 A_JumpIfInventory("WepNoFlashToken",1,"FlashEnder3Cont")
		TNT1 A 0 A_SetBlend("Green",0.10,13)
	FlashEnder3Cont:
		TNT1 A 0 A_JumpIfInventory("WepNoRecoilToken",1,"FlashEnderNoRecoil3")
		TNT1 A 0 A_SetPitch(pitch-1.5)
		TNT1 A 2
		TNT1 AAA 1 A_SetPitch(pitch+0.5)
		Stop
	FlashEnderNoRecoil3:
		TNT1 A 1
		Stop

	// Double upgrade fire
	Fire5:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire5")
		"####" A 0 A_GunFlash("Flash5")
		"####" H 1
		"####" H 1 Offset(3,35)
		"####" I 1 Offset(5,37)
		"####" I 1 Offset(7,39)
		"####" G 1 Offset(8,40)
		"####" G 1 Offset(7,39)
		"####" G 1 Offset(5,37)
		"####" G 1 Offset(3,35)
		"####" G 1 Offset(2,34)
		"####" G 1 Offset(1,33)
		"####" G 1 Offset(0,32)
		Goto Ready

	Flash5:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_FireCustomMissile("UTDispr5",0,false,1,4,0,0)
		Goto FlashCheckSound5

	FlashCheckSound5:
		TNT1 A 0 A_JumpIfInventory("PowerQuad",1,"QuadSound5")
		TNT1 A 0 A_JumpIfInventory("PowerTerminatorArtifact",1,"QuadSound5")
		Goto NormalSound5

		NormalSound5:
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 6, "NormalSound5.UC2")
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 1, "NormalSound5.U1")
		NormalSound5.U1:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Dispr/Fire_U1",CHAN_WEAPON)
			Goto FlashEnder5
		NormalSound5.UC2:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Dispr/Fire_UC2",CHAN_WEAPON)
			Goto FlashEnder5

		QuadSound5:
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 6, "QuadSound5.UC2")
			TNT1 A 0 A_JumpIfInventory("UTDispersionPistolSkin", 1, "QuadSound5.U1")
		QuadSound5.U1:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Dispr/Quad/Fire_U1",CHAN_WEAPON)
			Goto FlashEnder5
		QuadSound5.UC2:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Dispr/Quad/Fire_UC2",CHAN_WEAPON)
			Goto FlashEnder5

	FlashEnder5:
		TNT1 A 0 A_JumpIfInventory("WepNoFlashToken",1,"FlashEnder5Cont")
		TNT1 A 0 A_SetBlend("Red",0.10,15)
	FlashEnder5Cont:
		TNT1 A 0 A_JumpIfInventory("WepNoRecoilToken",1,"FlashEnderNoRecoil5")
		TNT1 A 0 A_SetPitch(pitch-1.5)
		TNT1 A 2
		TNT1 AAA 1 A_SetPitch(pitch+0.5)
		Stop
	FlashEnderNoRecoil5:
		TNT1 A 1
		Stop
	}
}

Actor UTDispr1 : FastProjectile
{
	Projectile
	+FORCEXYBILLBOARD
	+BLOODSPLATTER
	+MTHRUSPECIES
	+DONTBLAST
	Obituary "$OB_UTDispersion"
	Speed 40
	Radius 4
	Height 9
	Damage (random(10,20))
	Decal "Q4PlasmaBlack"
	Scale 0.18
	SeeSound ""
	RenderStyle Add
	States
	{
	Spawn:
		PSMA AAABBB 1 Light("BlueMediumFlicker2") Bright
		Loop

	XDeath:
		TNT1 A 10 A_GiveToTarget("HitBeepLow",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		Stop

	Death:
		LBA2 A 0 A_PlaySound("UTDE/Weapons/Dispr/Impact",CHAN_AUTO,1,0,1)
		LBA2 A 1 Light("BlueMediumFlicker3") Bright
		LBA2 BCDEFGH 1 Bright
		Stop
	}
}

Actor UTDispr3 : UTDispr1
{
	Damage (random(30,50))
	Scale 0.19
	States
	{
	Spawn:
		PSMB AAABBB 1 Light("GreenMediumFlicker2") Bright
		Loop

	XDeath:
		TNT1 A 10 A_GiveToTarget("HitBeepMid",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		Stop

	Death:
		LBA2 A 0 A_PlaySound("UTDE/Weapons/Dispr/Impact",CHAN_AUTO,1,0,1)
		LBA2 A 1 Light("GreenMediumFlicker3") Bright
		LBA2 BCDEFGH 1 Bright
		Stop
	}
}

Actor UTDispr5 : UTDispr1
{
	Damage (random(60,90))
	Scale 0.20
	States
	{
	Spawn:
		PSMC AAABBB 1 Light("RedMediumFlicker2") Bright
		Loop

	XDeath:
		TNT1 A 10 A_GiveToTarget("HitBeepBig",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		Stop

	Death:
		LBA2 A 0 A_PlaySound("UTDE/Weapons/Dispr/Impact",CHAN_AUTO,1,0,1)
		LBA2 A 1 Light("RedSmallFlicker3") Bright
		LBA2 BCDEFGH 1 Bright
		Stop
	}
}

// --------------------------------------------------------------------------
//	For competitive DM, weapons dont autoaim
// --------------------------------------------------------------------------
Actor QCShotgunDM : QCShotgun
{
	+WEAPON.NOAUTOAIM
	+CHEATNOTWEAPON
	Height 48
	Weapon.SwaySpeed 3.2
	Weapon.Kickback 35
	Weapon.SelectionOrder 1940
	Weapon.AmmoUse 1
	Weapon.AmmoDmScale 1.0
	Weapon.AmmoDmRefill 2
	Weapon.AmmoGive 15
	Weapon.AmmoType "QCShellAmmo"
	Obituary "$OB_UTFlakMini"
	Inventory.PickupMessage "$GOT_UTFlakMini"
	Tag "$TAG_UTFlakMini"
	Scale 0.55
	States
	{
	Spawn:
		TNT1 A 1
		U1G3 Y 35 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		Goto Idle
	DMSpawn:
		U1G3 Z 0 Bright A_ChangeFlag("NOBLOCKMAP",1)	//in DM, if a player drops this weapon, cant be picked
		TNT1 Z 3	//and disappears
		Stop
	Idle:
		U1G3 Y -1
		Wait

	//-----------------------
	// Select/Deselect Seq
	//-----------------------
	Select:
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 2, "Select.U1Stinger")
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 1, "Select.U1Flak")
	Select.U1Flak:
		U1G3 A 0
		Goto SelectCont
	Select.U1Stinger:
		U2G3 A 0
		Goto SelectCont

	SelectCont:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,2)
		"####" A 0 A_PlaySound("QC/Weapons/Switch",CHAN_5,1,0,3) //Not in Weapon.UpSound because it interrupts CHAN_WEAPON sounds
		"####" A 0 A_StopSound(CHAN_WEAPON) //stops any weapon looping sound
	SelectLooper:
		"####" A 1 A_Raise
		"####" AAA 0 A_Raise
		Loop

	Deselect:
		"####" A 0 A_StopSound(5)
		"####" A 0 A_StopSound(CHAN_WEAPON)
	DeselectLooper:
		"####" A 1 A_Lower
		"####" AAA 0 A_Lower
		Loop

	//-----------------------
	// Ready Seq
	//-----------------------
	Ready:
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 2, "Ready.U1Stinger")
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 1, "Ready.U1Flak")
	Ready.U1Flak:
		U1G3 A 0
		Goto ReadyCont
	Ready.U1Stinger:
		U2G3 A 0
		Goto ReadyCont

	ReadyCont:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		"####" A 3 A_WeaponReady
		Loop

		ReadyCantFire:
			"####" A 0 A_StopSound(5)
			"####" A 0 A_StopSound(CHAN_WEAPON)
		RCFLooper:
			"####" A 4 A_WeaponReady(WRF_NOFIRE)
			"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"RCFLooper")
			Goto Ready

	//-----------------------
	// Fire Seq
	//-----------------------
	Fire: 	//27 tics, 0.77sec
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		"####" B 0 A_GunFlash("Flash")
		"####" B 1
		"####" C 1 Offset(2,34)
		"####" D 1 Offset(7,37)
		"####" E 1 Offset(10,39)
		"####" E 1 Offset(13,41)
		"####" F 1 Offset(16,45)
		"####" F 1 Offset(19,49)
		"####" G 1
		"####" G 1 Offset(18,48)  //10
		"####" H 1 Offset(17,48)
		"####" H 1 Offset(16,47)
		"####" I 1 Offset(15,47)
		"####" I 1 Offset(14,46)
		"####" J 1 Offset(13,45)
		"####" J 1 Offset(12,44)
		"####" K 1 Offset(11,43)
		"####" K 1 Offset(10,42)
		"####" L 1 Offset(9,41)
		"####" L 1 Offset(8,40)	//20
		"####" M 1 Offset(7,39)
		"####" M 1 Offset(6,38)
		"####" N 1 Offset(5,37)
		"####" N 1 Offset(4,36)
		"####" O 1 Offset(3,35)
		"####" O 1 Offset(2,34)
		"####" P 1 Offset(1,33)
		"####" P 1 Offset(0,32)	//28
		Goto Ready

	Flash:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 2, "Flash.U1Stinger")
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 1, "Flash.U1Flak")
	Flash.U1Flak:
		TNT1 A 0 A_FireCustomMissile("UTFlakMiniShellDM",0,true,1,4,0,0) // Use ammo
		TNT1 A 0 A_FireCustomMissile("UTFlakMiniShellDM",   sin(0)*4.0, false,1,4,0,   cos(0)*4.0)
		TNT1 A 0 A_FireCustomMissile("UTFlakMiniShellDM",  sin(45)*4.0, false,1,4,0,  cos(45)*4.0)
		TNT1 A 0 A_FireCustomMissile("UTFlakMiniShellDM",  sin(90)*4.0, false,1,4,0,  cos(90)*4.0)
		TNT1 A 0 A_FireCustomMissile("UTFlakMiniShellDM", sin(135)*4.0, false,1,4,0, cos(135)*4.0)
		TNT1 A 0 A_FireCustomMissile("UTFlakMiniShellDM", sin(180)*4.0, false,1,4,0, cos(180)*4.0)
		TNT1 A 0 A_FireCustomMissile("UTFlakMiniShellDM", sin(225)*4.0, false,1,4,0, cos(225)*4.0)
		TNT1 A 0 A_FireCustomMissile("UTFlakMiniShellDM", sin(270)*4.0, false,1,4,0, cos(270)*4.0)
		TNT1 A 0 A_FireCustomMissile("UTFlakMiniShellDM", sin(315)*4.0, false,1,4,0, cos(315)*4.0)
		Goto FlashCheckSound
	Flash.U1Stinger:
		TNT1 A 0 A_FireCustomMissile("UTFlakMiniShellDM_Stinger",0,true,1,4,0,0) // Use ammo
		TNT1 A 0 A_FireCustomMissile("UTFlakMiniShellDM_Stinger",   sin(0)*4.0, false,1,4,0,   cos(0)*4.0)
		TNT1 A 0 A_FireCustomMissile("UTFlakMiniShellDM_Stinger",  sin(45)*4.0, false,1,4,0,  cos(45)*4.0)
		TNT1 A 0 A_FireCustomMissile("UTFlakMiniShellDM_Stinger",  sin(90)*4.0, false,1,4,0,  cos(90)*4.0)
		TNT1 A 0 A_FireCustomMissile("UTFlakMiniShellDM_Stinger", sin(135)*4.0, false,1,4,0, cos(135)*4.0)
		TNT1 A 0 A_FireCustomMissile("UTFlakMiniShellDM_Stinger", sin(180)*4.0, false,1,4,0, cos(180)*4.0)
		TNT1 A 0 A_FireCustomMissile("UTFlakMiniShellDM_Stinger", sin(225)*4.0, false,1,4,0, cos(225)*4.0)
		TNT1 A 0 A_FireCustomMissile("UTFlakMiniShellDM_Stinger", sin(270)*4.0, false,1,4,0, cos(270)*4.0)
		TNT1 A 0 A_FireCustomMissile("UTFlakMiniShellDM_Stinger", sin(315)*4.0, false,1,4,0, cos(315)*4.0)
		Goto FlashCheckSound

	FlashCheckSound:
		TNT1 A 0 A_JumpIfInventory("PowerQuad",1,"QuadSound")
		TNT1 A 0 A_JumpIfInventory("PowerTerminatorArtifact",1,"QuadSound")
		Goto NormalSound

		NormalSound:
			TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 2, "NormalSound.U1Stinger")
			TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 1, "NormalSound.U1Flak")
		NormalSound.U1Flak:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/FlakMini/Fire_U1Flak",CHAN_WEAPON)
			Goto FlashEnder
		NormalSound.U1Stinger:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/FlakMini/Fire_U1Stinger",CHAN_WEAPON)
			Goto FlashEnder

		QuadSound:
			TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 2, "QuadSound.U1Stinger")
			TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 1, "QuadSound.U1Flak")
		QuadSound.U1Flak:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/FlakMini/Quad/Fire_U1Flak",CHAN_WEAPON)
			Goto FlashEnder
		QuadSound.U1Stinger:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/FlakMini/Quad/Fire_U1Stinger",CHAN_WEAPON)
			Goto FlashEnder

	FlashEnder:
		TNT1 A 0 A_JumpIfInventory("WepNoFlashToken",1,"FlashEnderCont")
		TNT1 A 0 A_SetBlend("Yellow",0.05,7)
	FlashEnderCont:
		TNT1 A 0 A_JumpIfInventory("WepNoRecoilToken",1,"FlashEnderNoRecoil")
		TNT1 A 0 A_SetPitch(pitch-3.5)
		TNT1 A 2
		TNT1 AAAAAAA 1 A_SetPitch(pitch+0.5)
		Stop
	FlashEnderNoRecoil:
		TNT1 A 1
		Stop
	}
}

Actor UTFlakMiniShellDM : FastProjectile
{
	var int user_velx;
	var int user_vely;
	var int user_velz;

	Projectile
	+FORCEXYBILLBOARD
	+DONTSPLASH
	+BLOODSPLATTER
	-MTHRUSPECIES
	-DONTBLAST
	ReactionTime 35
	damage (10)
	radius 2
	height 2
	speed 65
	renderstyle ADD
	alpha 0.9
	scale 0.4
	Obituary "$OB_UTFlakMini"
	MissileType "UTFlakShellTrailFX"
	MissileHeight 8
	Decal "BulletChip"
	States
	{
	Spawn:
		NAIL A 0
		Goto SpawnCont

	SpawnCont:
		"####" A 0 A_SetUserVar("user_velx", velx)
		"####" A 0 A_SetUserVar("user_vely", vely)
		"####" A 0 A_SetUserVar("user_velz", velz)
	FlyLoop:
		"####" A 0 BRIGHT A_Countdown
		"####" A 1 BRIGHT A_Jump(192, "Spawn")
		Goto FlyLoop+1
	XDeath:
		TNT1 A 0 A_GiveToTarget("HitBeepMid",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		TNT1 A 1 // Need the actor to live one more tick so that a proper obituary message is shown
		Stop
	Death:
		TNT1 A 0 A_SpawnItemEx("UTFlakMiniShellBouncedDM", 0, 0, 0, user_velx, user_vely, user_velz, 0, SXF_ABSOLUTEVELOCITY|SXF_TRANSFERPOINTERS)
		TNT1 A 1 // Need the actor to live one more tick so that a proper obituary message is shown
		Stop
	}
}

Actor UTFlakMiniShellDM_Stinger : UTFlakMiniShellDM
{
	alpha 0.99
	scale 0.1
	MissileType ""
	States
	{
	Spawn:
		TRYD A 0
		Goto SpawnCont

	Death:
		TNT1 A 0 A_SpawnItemEx("UTFlakMiniShellBouncedDM_Stinger", 0, 0, 0, user_velx, user_vely, user_velz, 0, SXF_ABSOLUTEVELOCITY|SXF_TRANSFERPOINTERS)
		TNT1 A 1 // Need the actor to live one more tick so that a proper obituary message is shown
		Stop
	}
}

Actor UTFlakMiniShellBouncedDM
{
	Projectile
	+FORCEXYBILLBOARD
	+DONTSPLASH
	+USEBOUNCESTATE
	+BLOODSPLATTER
	+HITOWNER
	-MTHRUSPECIES
	-DONTBLAST
	-NOGRAVITY
	ReactionTime 35
	Gravity 0.5
	damage (10)
	radius 2
	height 2
	speed 65
	renderstyle ADD
	alpha 0.9
	scale 0.4
	BounceType Doom
	BounceFactor 0.35
	WallBounceFactor 0.35
	Obituary "$OB_UTFlakMini"
	States
	{
	Spawn:
		NAIL A 0 BRIGHT A_Countdown
		Goto FlyLoop

	FlyLoop:
		"####" A 0 BRIGHT A_SpawnItemEx("UTFlakShellTrailFXBounced")
		"####" A 1 A_Jump(192, "Spawn")
		Goto FlyLoop
	Bounce:
		TNT1 A 0 A_PlaySound("UTDE/Weapons/Flak/Bounce",CHAN_AUTO,1,0,1)
		Goto Spawn
	XDeath:
		TNT1 A 0 A_GiveToTarget("HitBeepMid",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
	Death:
		TNT1 A 1 // Need the actor to live one more tick so that a proper obituary message is shown
		Stop
	}
}

Actor UTFlakMiniShellBouncedDM_Stinger : UTFlakMiniShellBouncedDM
{
	alpha 0.99
	scale 0.1
	MissileType ""
	States
	{
	Spawn:
		TRYD A 0 BRIGHT A_Countdown
		Goto FlyLoop
	}
}

