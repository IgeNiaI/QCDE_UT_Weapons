	}
}

// --------------------------------------------------------------------------
//	For competitive DM, weapons dont autoaim
// --------------------------------------------------------------------------
Actor QCShotgunDM : QCShotgun
{
	+WEAPON.NOAUTOAIM
	+CHEATNOTWEAPON
	Height 48
	Weapon.SwaySpeed 3.2
	Weapon.Kickback 35
	Weapon.SelectionOrder 1940
	Weapon.AmmoUse 1
	Weapon.AmmoDmScale 1.0
	Weapon.AmmoDmRefill 2
	Weapon.AmmoGive 15
	Weapon.AmmoType "QCShellAmmo"
	Obituary "$OB_UTFlakMini"
	Inventory.PickupMessage "$GOT_UTFlakMini"
	Tag "$TAG_UTFlakMini"
	Scale 0.55
	States
	{
	Spawn:
		TNT1 A 1
		U1G3 Y 35 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		Goto SpawnIdle
	DMSpawn:
		U1G3 Z 0 Bright A_ChangeFlag("NOBLOCKMAP",1)	//in DM, if a player drops this weapon, cant be picked
		TNT1 Z 3	//and disappears
		Stop
	SpawnIdle:
		U1G3 Y -1
		Wait

	//-----------------------
	// Select/Deselect Seq
	//-----------------------
	Select:
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 20, "Select.Modded")
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 9, "Select.U1Flak") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 8, "Select.U1Flak") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 7, "Select.U1Flak") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 6, "Select.U1Stinger") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 5, "Select.U1Stinger") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 4, "Select.U1Stinger") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 3, "Select.U1Stinger") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 2, "Select.U1Stinger")
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 1, "Select.U1Flak")
	Select.U1Flak:
		U1A3 A 0
		Goto SelectCont
	Select.U1Stinger:
		U2A3 A 0
		Goto SelectCont
	Select.Modded:
		MDA3 A 0
		Goto SelectCont

	SelectCont:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,2)
		"####" A 0 A_PlaySound("QC/Weapons/Switch",CHAN_5,1,0,3) //Not in Weapon.UpSound because it interrupts CHAN_WEAPON sounds
		"####" A 0 A_StopSound(CHAN_WEAPON) //stops any weapon looping sound
	SelectLooper:
		"####" A 1 A_Raise
		"####" AAA 0 A_Raise
		Loop

	Deselect:
		"####" A 0 A_StopSound(5)
		"####" A 0 A_StopSound(CHAN_WEAPON)
	DeselectLooper:
		"####" A 1 A_Lower
		"####" AAA 0 A_Lower
		Loop

	//-----------------------
	// Ready Seq
	//-----------------------
	Ready:
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 20, "Prepare.Modded")
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 9, "Prepare.U1Flak") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 8, "Prepare.U1Flak") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 7, "Prepare.U1Flak") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 6, "Prepare.U1Stinger") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 5, "Prepare.U1Stinger") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 4, "Prepare.U1Stinger") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 3, "Prepare.U1Stinger") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 2, "Prepare.U1Stinger")
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 1, "Prepare.U1Flak")
	Prepare.U1Flak:
		U1A3 A 0
		Goto PrepareCont
	Prepare.U1Stinger:
		U2A3 A 0
		Goto PrepareCont
	Prepare.Modded:
		MDA3 A 0 A_PlaySound("UTDE/Weapons/FlakMini/Prepare_Modded",CHAN_WEAPON,1,0,3)
		Goto PrepareCont

	PrepareCont:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		"####" ABCDEFGHIJKLMNOPQRSTUVWXYZ 1 A_WeaponReady
		Goto Idle

	Idle:
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 20, "Idle.Modded")
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 9, "Idle.U1Flak") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 8, "Idle.U1Flak") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 7, "Idle.U1Flak") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 6, "Idle.U1Stinger") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 5, "Idle.U1Stinger") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 4, "Idle.U1Stinger") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 3, "Idle.U1Stinger") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 2, "Idle.U1Stinger")
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 1, "Idle.U1Flak")
	Idle.U1Flak:
		U1C3 A 0
		Goto IdleCont
	Idle.U1Stinger:
		U2C3 A 0
		Goto IdleCont
	Idle.Modded:
		MDC3 A 0 A_PlaySound("UTDE/Weapons/FlakMini/Idle_Modded",CHAN_WEAPON,1,1)
		Goto IdleCont

	IdleCont:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
	IdleLoop:
		"####" ABCDEF 1 A_WeaponReady
		Loop

		ReadyCantFire:
			"####" A 0 A_StopSound(5)
			"####" A 0 A_StopSound(CHAN_WEAPON)
		RCFLooper:
			"####" A 4 A_WeaponReady(WRF_NOFIRE)
			"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"RCFLooper")
			Goto Ready

	//-----------------------
	// Fire Seq
	//-----------------------
	Fire: 	//27 tics, 0.77sec
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 20, "Fire.Modded")
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 9, "Fire.U1Flak") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 8, "Fire.U1Flak") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 7, "Fire.U1Flak") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 6, "Fire.U1Stinger") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 5, "Fire.U1Stinger") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 4, "Fire.U1Stinger") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 3, "Fire.U1Stinger") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 2, "Fire.U1Stinger")
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 1, "Fire.U1Flak")
	Fire.U1Flak:
		U1E3 A 0
		Goto FireCont
	Fire.U1Stinger:
		U2E3 A 0
		Goto FireCont
	Fire.Modded:
		MDE3 A 0
		Goto FireCont

	FireCont:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		"####" B 0 A_GunFlash("Flash")
		"####" B 1
		"####" C 1 Offset(2,34)
		"####" D 1 Offset(7,37)
		"####" E 1 Offset(10,39)
		"####" E 1 Offset(13,41)
		"####" F 1 Offset(16,45)
		"####" F 1 Offset(19,49)
		"####" G 1
		"####" G 1 Offset(18,48)
		"####" H 1 Offset(17,48)
		"####" H 1 Offset(16,47)
		"####" I 1 Offset(15,47)
		"####" I 1 Offset(14,46)
		"####" J 1 Offset(13,45)
		"####" J 1 Offset(12,44)
		"####" K 1 Offset(11,43)
		"####" K 1 Offset(10,42)
		"####" L 1 Offset(9,41)
		"####" L 1 Offset(8,40)
		"####" M 1 Offset(7,39)
		"####" M 1 Offset(6,38)
		"####" N 1 Offset(5,37)
		"####" N 1 Offset(4,36)
		"####" O 1 Offset(3,35)
		"####" O 1 Offset(2,34)
		"####" P 1 Offset(1,33)
		"####" P 1 Offset(0,32)
		Goto Ready

	Flash:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 20, "Flash.Modded")
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 9, "Flash.U1Flak") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 8, "Flash.U1Flak") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 7, "Flash.U1Flak") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 6, "Flash.U1Stinger") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 5, "Flash.U1Stinger") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 4, "Flash.U1Stinger") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 3, "Flash.U1Stinger") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 2, "Flash.U1Stinger")
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 1, "Flash.U1Flak")
	Flash.U1Flak:
		TNT1 A 0 A_FireCustomMissile("UTFlakMiniShellDM",0,true,1,4,0,0) // Use ammo
		TNT1 A 0 A_FireCustomMissile("UTFlakMiniShellDM",   sin(0)*4.0, false,1,4,0,   cos(0)*4.0)
		TNT1 A 0 A_FireCustomMissile("UTFlakMiniShellDM",  sin(45)*4.0, false,1,4,0,  cos(45)*4.0)
		TNT1 A 0 A_FireCustomMissile("UTFlakMiniShellDM",  sin(90)*4.0, false,1,4,0,  cos(90)*4.0)
		TNT1 A 0 A_FireCustomMissile("UTFlakMiniShellDM", sin(135)*4.0, false,1,4,0, cos(135)*4.0)
		TNT1 A 0 A_FireCustomMissile("UTFlakMiniShellDM", sin(180)*4.0, false,1,4,0, cos(180)*4.0)
		TNT1 A 0 A_FireCustomMissile("UTFlakMiniShellDM", sin(225)*4.0, false,1,4,0, cos(225)*4.0)
		TNT1 A 0 A_FireCustomMissile("UTFlakMiniShellDM", sin(270)*4.0, false,1,4,0, cos(270)*4.0)
		TNT1 A 0 A_FireCustomMissile("UTFlakMiniShellDM", sin(315)*4.0, false,1,4,0, cos(315)*4.0)
		Goto FlashCheckSound
	Flash.U1Stinger:
		TNT1 A 0 A_FireCustomMissile("UTFlakMiniShellDM_Stinger",0,true,1,4,0,0) // Use ammo
		TNT1 A 0 A_FireCustomMissile("UTFlakMiniShellDM_Stinger",   sin(0)*4.0, false,1,4,0,   cos(0)*4.0)
		TNT1 A 0 A_FireCustomMissile("UTFlakMiniShellDM_Stinger",  sin(45)*4.0, false,1,4,0,  cos(45)*4.0)
		TNT1 A 0 A_FireCustomMissile("UTFlakMiniShellDM_Stinger",  sin(90)*4.0, false,1,4,0,  cos(90)*4.0)
		TNT1 A 0 A_FireCustomMissile("UTFlakMiniShellDM_Stinger", sin(135)*4.0, false,1,4,0, cos(135)*4.0)
		TNT1 A 0 A_FireCustomMissile("UTFlakMiniShellDM_Stinger", sin(180)*4.0, false,1,4,0, cos(180)*4.0)
		TNT1 A 0 A_FireCustomMissile("UTFlakMiniShellDM_Stinger", sin(225)*4.0, false,1,4,0, cos(225)*4.0)
		TNT1 A 0 A_FireCustomMissile("UTFlakMiniShellDM_Stinger", sin(270)*4.0, false,1,4,0, cos(270)*4.0)
		TNT1 A 0 A_FireCustomMissile("UTFlakMiniShellDM_Stinger", sin(315)*4.0, false,1,4,0, cos(315)*4.0)
		Goto FlashCheckSound
	Flash.Modded:
		TNT1 A 0 A_FireCustomMissile("UTFlakMiniShellDM_Modded",0,true,1,4,0,0) // Use ammo
		TNT1 A 0 A_FireCustomMissile("UTFlakMiniShellDM_Modded",   sin(0)*4.0, false,1,4,0,   cos(0)*4.0)
		TNT1 A 0 A_FireCustomMissile("UTFlakMiniShellDM_Modded",  sin(45)*4.0, false,1,4,0,  cos(45)*4.0)
		TNT1 A 0 A_FireCustomMissile("UTFlakMiniShellDM_Modded",  sin(90)*4.0, false,1,4,0,  cos(90)*4.0)
		TNT1 A 0 A_FireCustomMissile("UTFlakMiniShellDM_Modded", sin(135)*4.0, false,1,4,0, cos(135)*4.0)
		TNT1 A 0 A_FireCustomMissile("UTFlakMiniShellDM_Modded", sin(180)*4.0, false,1,4,0, cos(180)*4.0)
		TNT1 A 0 A_FireCustomMissile("UTFlakMiniShellDM_Modded", sin(225)*4.0, false,1,4,0, cos(225)*4.0)
		TNT1 A 0 A_FireCustomMissile("UTFlakMiniShellDM_Modded", sin(270)*4.0, false,1,4,0, cos(270)*4.0)
		TNT1 A 0 A_FireCustomMissile("UTFlakMiniShellDM_Modded", sin(315)*4.0, false,1,4,0, cos(315)*4.0)
		Goto FlashCheckSound

	FlashCheckSound:
		TNT1 A 0 A_JumpIfInventory("PowerQuad",1,"QuadSound")
		TNT1 A 0 A_JumpIfInventory("PowerTerminatorArtifact",1,"QuadSound")
		Goto NormalSound

		NormalSound:
			TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 20, "NormalSound.Modded")
			TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 9, "NormalSound.U1Flak") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 8, "NormalSound.U1Flak") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 7, "NormalSound.U1Flak") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 6, "NormalSound.U1Stinger") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 5, "NormalSound.U1Stinger") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 4, "NormalSound.U1Stinger") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 3, "NormalSound.U1Stinger") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 2, "NormalSound.U1Stinger")
			TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 1, "NormalSound.U1Flak")
		NormalSound.U1Flak:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/FlakMini/Fire_U1Flak",CHAN_WEAPON)
			Goto FlashEnder
		NormalSound.U1Stinger:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/FlakMini/Fire_U1Stinger",CHAN_WEAPON)
			Goto FlashEnder
		NormalSound.Modded:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/FlakMini/Fire_Modded",CHAN_WEAPON)
			Goto FlashEnder

		QuadSound:
			TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 20, "QuadSound.Modded")
			TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 9, "QuadSound.U1Flak") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 8, "QuadSound.U1Flak") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 7, "QuadSound.U1Flak") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 6, "QuadSound.U1Stinger") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 5, "QuadSound.U1Stinger") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 4, "QuadSound.U1Stinger") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 3, "QuadSound.U1Stinger") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 2, "QuadSound.U1Stinger")
			TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin", 1, "QuadSound.U1Flak")
		QuadSound.U1Flak:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/FlakMini/Quad/Fire_U1Flak",CHAN_WEAPON)
			Goto FlashEnder
		QuadSound.U1Stinger:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/FlakMini/Quad/Fire_U1Stinger",CHAN_WEAPON)
			Goto FlashEnder
		QuadSound.Modded:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/FlakMini/Quad/Fire_Modded",CHAN_WEAPON)
			Goto FlashEnder

	FlashEnder:
		TNT1 A 0 A_JumpIfInventory("WepNoFlashToken",1,"FlashEnderCont")
		TNT1 A 0 A_JumpIfInventory("UTFlakMiniSkin",20,"FlashEnder.Modded")
		TNT1 A 0 A_SetBlend("Yellow",0.05,7)
		Goto FlashEnderCont
	FlashEnder.Modded:
		TNT1 A 0 A_SetBlend("$WeaponSkin_FlakMini_ScreenBlend_Modded",0.05,7)
	FlashEnderCont:
		TNT1 A 0 A_JumpIfInventory("WepNoRecoilToken",1,"FlashEnderNoRecoil")
		TNT1 A 0 A_SetPitch(pitch-3.5)
		TNT1 A 2
		TNT1 AAAAAAA 1 A_SetPitch(pitch+0.5)
		Stop
	FlashEnderNoRecoil:
		TNT1 A 1
		Stop
	}
}

Actor UTFlakMiniShellDM : FastProjectile
{
	var int user_velx;
	var int user_vely;
	var int user_velz;

	Projectile
	+FORCEXYBILLBOARD
	+DONTSPLASH
	+BLOODSPLATTER
	-MTHRUSPECIES
	-DONTBLAST
	ReactionTime 35
	damage (10)
	radius 2
	height 2
	speed 65
	renderstyle ADD
	alpha 0.9
	scale 0.4
	Obituary "$OB_UTFlakMini"
	MissileType "UTFlakShellTrailFX"
	MissileHeight 8
	Decal "BulletChip"
	States
	{
	Spawn:
		NAIL A 0
		Goto SpawnCont

	SpawnCont:
		"####" A 0 A_SetUserVar("user_velx", velx)
		"####" A 0 A_SetUserVar("user_vely", vely)
		"####" A 0 A_SetUserVar("user_velz", velz)
	FlyLoop:
		"####" A 0 BRIGHT A_Countdown
		"####" A 1 BRIGHT A_Jump(192, "Spawn")
		Goto FlyLoop+1
	XDeath:
		TNT1 A 0 A_GiveToTarget("HitBeepMid",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		TNT1 A 1 // Need the actor to live one more tick so that a proper obituary message is shown
		Stop
	Death:
		TNT1 A 0 A_SpawnItemEx("UTFlakMiniShellBouncedDM", 0, 0, 0, user_velx, user_vely, user_velz, 0, SXF_ABSOLUTEVELOCITY|SXF_TRANSFERPOINTERS)
		TNT1 A 1 // Need the actor to live one more tick so that a proper obituary message is shown
		Stop
	}
}

Actor UTFlakMiniShellDM_Stinger : UTFlakMiniShellDM
{
	alpha 0.99
	scale 0.1
	MissileType ""
	States
	{
	Spawn:
		TRYD A 0
		Goto SpawnCont

	Death:
		TNT1 A 0 A_SpawnItemEx("UTFlakMiniShellBouncedDM_Stinger", 0, 0, 0, user_velx, user_vely, user_velz, 0, SXF_ABSOLUTEVELOCITY|SXF_TRANSFERPOINTERS)
		TNT1 A 1 // Need the actor to live one more tick so that a proper obituary message is shown
		Stop
	}
}

Actor UTFlakMiniShellBouncedDM
{
	Projectile
	+FORCEXYBILLBOARD
	+DONTSPLASH
	+USEBOUNCESTATE
	+BLOODSPLATTER
	+HITOWNER
	-MTHRUSPECIES
	-DONTBLAST
	-NOGRAVITY
	ReactionTime 35
	Gravity 0.5
	damage (10)
	radius 2
	height 2
	speed 65
	renderstyle ADD
	alpha 0.9
	scale 0.4
	BounceType Doom
	BounceFactor 0.35
	WallBounceFactor 0.35
	Obituary "$OB_UTFlakMini"
	States
	{
	Spawn:
		NAIL A 0 BRIGHT A_Countdown
		Goto FlyLoop

	FlyLoop:
		"####" A 0 BRIGHT A_SpawnItemEx("UTFlakShellTrailFXBounced")
		"####" A 1 A_Jump(192, "Spawn")
		Goto FlyLoop
	Bounce:
		TNT1 A 0 A_PlaySound("UTDE/Weapons/Flak/Bounce",CHAN_AUTO,1,0,1)
		Goto Spawn
	XDeath:
		TNT1 A 0 A_GiveToTarget("HitBeepMid",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
	Death:
		TNT1 A 1 // Need the actor to live one more tick so that a proper obituary message is shown
		Stop
	}
}

Actor UTFlakMiniShellBouncedDM_Stinger : UTFlakMiniShellBouncedDM
{
	alpha 0.99
	scale 0.1
	MissileType ""
	States
	{
	Spawn:
		TRYD A 0 BRIGHT A_Countdown
		Goto FlyLoop
	}
}

// --------------------------------------------------------------------------
// Modded Flak Mini projectile and trail replacement hooks
// --------------------------------------------------------------------------
Actor UTFlakMiniShellDM_Modded : UTFlakMiniShellDM
{
	MissileType "UTFlakMiniTrailFX_Modded"
	States
	{
	Death:
		TNT1 A 0 A_SpawnItemEx("UTFlakMiniShellBouncedDM_Modded", 0, 0, 0, user_velx, user_vely, user_velz, 0, SXF_ABSOLUTEVELOCITY|SXF_TRANSFERPOINTERS)
		TNT1 A 1 // Preserve the extra tic for the obituary message
		Stop
	}
}

Actor UTFlakMiniShellBouncedDM_Modded : UTFlakMiniShellBouncedDM
{
	States
	{
	Spawn:
		NAIL A 0 BRIGHT A_Countdown
		Goto FlyLoop
	FlyLoop:
		"####" A 0 BRIGHT A_SpawnItemEx("UTFlakMiniTrailFXBounced_Modded")
		"####" A 1 A_Jump(192, "Spawn")
		Goto FlyLoop
	Bounce:
		TNT1 A 0 A_PlaySound("UTDE/Weapons/FlakMini/Bounce_Modded",CHAN_AUTO,1,0,1)
		Goto Spawn
	}
}

Actor UTFlakMiniTrailFX_Modded : UTFlakShellTrailFX {}
Actor UTFlakMiniTrailFXBounced_Modded : UTFlakShellTrailFXBounced {}

