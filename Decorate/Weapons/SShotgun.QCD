Actor CompatVer31_SShotgun {} // for compatibility checks

Actor SuperShotgunPickup : QCWeaponPickup 15602
{
	//$NotAngled
	//$Category "QCDE Weapons"
	//$Color 14
	//$Title "Flak Cannon"
	Height 48
	Radius 20
	Scale 0.66
	Inventory.PickupSound "QC/Items/WeaponPick"
	Inventory.PickupMessage "$GOT_UTFlakCannon"
	Tag "$TAG_UTFlakCannon"
	Inventory.RespawnTics 35
	States
	{
	Spawn:
		U4GC Y 35 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		Goto Idle
	DMSpawn:
		"####" "#" 0 A_ChangeFlag("DROPPED", 0)
		U4GC Z 0 ACS_NamedExecuteWithResult("QCDE_WeaponSpawned",10,args[4],args[3])
		U4GC Z 0 A_SetArg(3, 1)
		U4GC Z -1 Bright A_SetArg(4, 0)
		Stop
	Idle:
		U4GC Y 0 ACS_NamedExecuteWithResult("QCDE_WeaponSpawned",9,args[4],args[3])
		U4GC Y 0 A_SetArg(3, 1)
		U4GC Y -1 A_SetArg(4, 0)
		Wait
	Pickup:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMPickup")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"WeaponStay")
		TNT1 A 0 A_GiveInventory("QCSuperShotgun")
		TNT1 A 0
		Stop
	DMPickup:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"DMWeaponStay")
		TNT1 A 0 A_GiveInventory("QCSuperShotgunDM")
		TNT1 A 0 A_JumpIf(CallACS("QCDE_SelectUpgradedWeapon",2,0,0,0), "Stay") // never jumps, but had to wrap CallACS or else the weapon will be always picked up
		TNT1 A 0 A_TakeInventory("QCShotgunDM")
		TNT1 A 0 A_TakeInventory("QCSuperShotgun")
		TNT1 A 0 A_TakeInventory("QCShotgun")
		Stop
	WeaponStay:
		TNT1 A 0 A_JumpIfInventory("QCSuperShotgun",1,"Stay")
		TNT1 A 0 A_SpawnItemEx("QCSuperShotgun", velx,vely,velz, velx,vely,velz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Fail
	DMWeaponStay:
		TNT1 A 0 A_JumpIf(CallACS("QCDE_SelectUpgradedWeapon",2,0,0,0), "Stay") // never jumps, but had to wrap CallACS or else the weapon will be always picked up
		TNT1 A 0 A_TakeInventory("QCSuperShotgun")
		TNT1 A 0 A_JumpIfInventory("QCSuperShotgunDM",1,"Stay")
		TNT1 A 0 A_SpawnItemEx("QCSuperShotgunDM", velx,vely,velz, velx,vely,velz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Fail
	Stay:
		TNT1 A 0
		Fail
	HideIndefinitely:
		TNT1 A 1 A_SetTics(CallACS("QCDE_SetWeaponRespawnTics"))
		Goto Super::HideDoomish+1
	HideDoomish:
		TNT1 A 1
		TNT1 A 1 A_SetTics(CallACS("QCDE_SetWeaponRespawnTics"))
		Goto Super::HideDoomish+1
	}
}

Actor SuperShotgunPickupNoGravity : SuperShotgunPickup 15612
{
	//$Category "QCDE Weapons (No Gravity)"
	//$Title "Flak Cannon (No Gravity)"
	+NOGRAVITY
}

Actor SuperShotgunPickupDMvar: CustomInventory 	//this one is for SSGs spawned in DM maps that have 200
{												//SSG spawns in the map. Most of the time, it'll be something else
	//$NotAngled
	//$Color 14
	//$Title "SSG-in-vanilla Replacer"
	var int user_type;
	Height 48
	Scale 0.66
	Inventory.PickupSound "QC/Items/WeaponPick"
	Inventory.PickupMessage "$GOT_UTFlakCannon"
	Tag "$TAG_UTFlakCannon"
	Inventory.RespawnTics 35
	States
	{
	Spawn:
		U4GC Y 35 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		Goto Idle

	DMSpawn:
		"####" "#" 0 A_ChangeFlag("DROPPED", 0)
		Goto ChooseWeapon

		ChooseWeapon:
			TNT1 A 0 A_Jump(200,"BeTribolt","BeHMG","BeSNG")
			Goto BeSSG //about 1/5th of the time, it'll be ssg
		BeTribolt:
			TNT1 A 0 A_SpawnItemEx("TriboltPickup", 0,0,0, 0,0,0, 0,SXF_NOCHECKPOSITION)
			Stop
		BeHMG:
			TNT1 A 0 A_SpawnItemEx("HeavyMachinegunPickup", 0,0,0, 0,0,0, 0,SXF_NOCHECKPOSITION)
			Stop
		BeSNG:
			TNT1 A 0 A_SpawnItemEx("SuperNailgunPickup", 0,0,0, 0,0,0, 0,SXF_NOCHECKPOSITION)
			Stop
		BeSSG:
			U4GC Z 0 ACS_NamedExecuteWithResult("QCDE_WeaponSpawned",10,args[4])
			U4GC Z -1 Bright A_SetArg(4, 0)
			Wait

	Idle:
		U4GC Y 0 ACS_NamedExecuteWithResult("QCDE_WeaponSpawned",9,args[4])
		U4GC Y -1 A_SetArg(4, 0)
		Wait
	Pickup:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMPickup")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"WeaponStay")
		TNT1 A 0 A_GiveInventory("QCSuperShotgun")
		TNT1 A 0
		Stop
	DMPickup:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"DMWeaponStay")
		TNT1 A 0 A_GiveInventory("QCSuperShotgunDM")
		TNT1 A 0 A_JumpIf(CallACS("QCDE_SelectUpgradedWeapon",2,0,0,0), "Stay") // never jumps, but had to wrap CallACS or else the weapon will be always picked up
		TNT1 A 0 A_TakeInventory("QCShotgunDM")
		TNT1 A 0 A_TakeInventory("QCSuperShotgun")
		TNT1 A 0 A_TakeInventory("QCShotgun")
		Stop
	WeaponStay:
		TNT1 A 0 A_JumpIfInventory("QCSuperShotgun",1,"Stay")
		TNT1 A 0 A_SpawnItemEx("QCSuperShotgun", velx,vely,velz, velx,vely,velz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Fail
	DMWeaponStay:
		TNT1 A 0 A_JumpIf(CallACS("QCDE_SelectUpgradedWeapon",2,0,0,0), "Stay") // never jumps, but had to wrap CallACS or else the weapon will be always picked up
		TNT1 A 0 A_TakeInventory("QCSuperShotgun")
		TNT1 A 0 A_JumpIfInventory("QCSuperShotgunDM",1,"Stay")
		TNT1 A 0 A_SpawnItemEx("QCSuperShotgunDM", velx,vely,velz, velx,vely,velz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Fail
	Stay:
		TNT1 A 0
		Fail
	HideIndefinitely:
		TNT1 A 1 A_SetTics(CallACS("QCDE_SetWeaponRespawnTics"))
		Goto HideDoomish+1
	}
}


Actor QCSuperShotgun : QCWeapon
{
	Height 48
	Weapon.SwaySpeed 3.0
	Weapon.Kickback 35
	Weapon.SelectionOrder 1100
	Weapon.AmmoUse 1
	Weapon.AmmoUse2 1
	Weapon.AmmoGive 15
	Weapon.AmmoType "QCShellAmmo"
	Weapon.AmmoType2 "QCShellAmmo"
	Obituary "$OB_UTFlakCannon"
	Inventory.PickupMessage "$GOT_UTFlakCannon"
	Tag "$TAG_UTFlakCannon"
	Scale 0.66
	States
	{
	Spawn:
		TNT1 A 1
		U4GC Y 35 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		Goto Idle
	DMSpawn:
		U4GC ZZZZZZZZZZZZZZZ 35 Bright
		Stop
	Idle:
		U4GC Y -1
		Wait

	//-----------------------
	// Select/Deselect Seq
	//-----------------------
	Select:
		TNT1 A 0 A_JumpIfInventory("UTFlakSkin", 9, "Select.UT99")
		TNT1 A 0 A_JumpIfInventory("UTFlakSkin", 8, "Select.UT99") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTFlakSkin", 7, "Select.UT99") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTFlakSkin", 6, "Select.UC2")
		TNT1 A 0 A_JumpIfInventory("UTFlakSkin", 5, "Select.UC1")
		TNT1 A 0 A_JumpIfInventory("UTFlakSkin", 4, "Select.UT2004")
		TNT1 A 0 A_JumpIfInventory("UTFlakSkin", 3, "Select.UT2004")
		TNT1 A 0 A_JumpIfInventory("UTFlakSkin", 2, "Select.UT99") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTFlakSkin", 1, "Select.UT99") // Fallback to another skin
	Select.UT2004:
		U4GC A 0
		Goto SelectCont
	Select.UC1:
		U5GC A 0
		Goto SelectCont
	Select.UC2:
		U6GC A 0
		Goto SelectCont
	Select.UT99:
		U9GC A 0
		Goto SelectCont

	SelectCont:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,2)
		"####" A 0 A_PlaySound("QC/Weapons/Switch",CHAN_5,1,0,3) //Not in Weapon.UpSound because it interrupts CHAN_WEAPON sounds
		"####" A 0 A_TakeInventory("QCShotgunDM")
		"####" A 0 A_StopSound(CHAN_WEAPON) //stops any weapon looping sound
	SelectLooper:
		"####" A 1 A_Raise
		"####" AAA 0 A_Raise
		Loop

	Deselect:
		"####" A 0 A_StopSound(5)
		"####" A 0 A_StopSound(CHAN_WEAPON)
	DeselecLooper:
		"####" A 1 A_Lower
		"####" AAA 0 A_Lower
		Loop

	//-----------------------
	// Ready Seq
	//-----------------------
	Ready:
		TNT1 A 0 A_JumpIfInventory("UTFlakSkin", 9, "Ready.UT99")
		TNT1 A 0 A_JumpIfInventory("UTFlakSkin", 8, "Ready.UT99") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTFlakSkin", 7, "Ready.UT99") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTFlakSkin", 6, "Ready.UC2")
		TNT1 A 0 A_JumpIfInventory("UTFlakSkin", 5, "Ready.UC1")
		TNT1 A 0 A_JumpIfInventory("UTFlakSkin", 4, "Ready.UT2004")
		TNT1 A 0 A_JumpIfInventory("UTFlakSkin", 3, "Ready.UT2004")
		TNT1 A 0 A_JumpIfInventory("UTFlakSkin", 2, "Ready.UT99") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTFlakSkin", 1, "Ready.UT99") // Fallback to another skin
	Ready.UT2004:
		U4GC A 0
		Goto ReadyCont
	Ready.UC1:
		U5GC A 0
		Goto ReadyCont
	Ready.UC2:
		U6GC A 0
		Goto ReadyCont
	Ready.UT99:
		U9GC A 0
		Goto ReadyCont

	ReadyCont:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		"####" A 3 A_WeaponReady
		Loop

		ReadyCantFire:
			"####" A 0 A_StopSound(5)
			"####" A 0 A_StopSound(CHAN_WEAPON)
		RCFLooper:
			"####" A 4 A_WeaponReady(WRF_NOFIRE)
			"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"RCFLooper")
			Goto Ready

	//-----------------------
	// Fire Seq
	//-----------------------
	Fire: 	//27 tics, 0.77sec
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		"####" A 0 A_GunFlash("Flash")
		"####" B 1
		"####" C 1 Offset(2,34)
		"####" D 1 Offset(7,37)
		"####" E 1 Offset(10,39)
		"####" E 1 Offset(13,41)
		"####" F 1 Offset(16,45)
		"####" F 1 Offset(19,49)
		"####" G 1
		"####" G 1 Offset(18,48)  //10
		"####" H 1 Offset(17,48)
		"####" H 1 Offset(16,47)
        "####" I 1 Offset(15,47)
		"####" I 1 Offset(14,46)
		"####" J 1 Offset(13,45)
		"####" J 1 Offset(12,44)
		"####" K 1 Offset(11,43)
		"####" L 1 Offset(10,42)
		"####" M 1 Offset(9,41)
		"####" N 1 Offset(8,40)	//20
		"####" O 1 Offset(7,39)
		"####" P 1 Offset(6,38)
		"####" Q 1 Offset(5,37)
		"####" R 1 Offset(4,36)
		"####" S 1 Offset(3,35)
		"####" T 1 Offset(2,34)
		"####" U 1 Offset(1,33)
		"####" V 1 Offset(0,32)	//28
		Goto Ready

	Flash:
		TNT1 A 0 A_FireCustomMissile("UTFlakShell",afrandom(4.0,-4.0),true,1,4,0,afrandom(4.0,-4.0)) // Use ammo
		TNT1 AAAAAAAA 0 A_FireCustomMissile("UTFlakShell",afrandom(4.0,-4.0),false,1,4,0,afrandom(4.0,-4.0)) // Don't use ammo
		TNT1 A 0 A_JumpIfInventory("SSG_UG_Flame", 1, "FlashUpgraded")
		Goto FlashCheckSound

	FlashUpgraded:
		TNT1 AAAAAAAA 0 A_FireCustomMissile("UTFlakShell",afrandom(4.0,-4.0),false,1,4,0,afrandom(4.0,-4.0)) // Don't use ammo
		Goto FlashCheckSound

	FlashCheckSound:
		TNT1 A 0 A_JumpIfInventory("PowerQuad",1,"QuadSound")
		TNT1 A 0 A_JumpIfInventory("PowerTerminatorArtifact",1,"QuadSound")
		Goto NormalSound

		NormalSound:
			TNT1 A 0 A_JumpIfInventory("UTFlakSkin", 9, "NormalSound.UT99")
			TNT1 A 0 A_JumpIfInventory("UTFlakSkin", 8, "NormalSound.UT99") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTFlakSkin", 7, "NormalSound.UT99") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTFlakSkin", 6, "NormalSound.UC2")
			TNT1 A 0 A_JumpIfInventory("UTFlakSkin", 5, "NormalSound.UT2004") // UC1 uses UT2003 sounds
			TNT1 A 0 A_JumpIfInventory("UTFlakSkin", 4, "NormalSound.UT2004")
			TNT1 A 0 A_JumpIfInventory("UTFlakSkin", 3, "NormalSound.UT2004")
			TNT1 A 0 A_JumpIfInventory("UTFlakSkin", 2, "NormalSound.UT99") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTFlakSkin", 1, "NormalSound.UT99") // Fallback to another skin
		NormalSound.UT2004:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Flak/Fire_UT2004",CHAN_WEAPON)
			Goto FlashEnder
		NormalSound.UC2:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Flak/Fire_UC2",CHAN_WEAPON)
			Goto FlashEnder
		NormalSound.UT99:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Flak/Fire_UT99",CHAN_WEAPON)
			Goto FlashEnder

		QuadSound:
			TNT1 A 0 A_JumpIfInventory("UTFlakSkin", 9, "QuadSound.UT99")
			TNT1 A 0 A_JumpIfInventory("UTFlakSkin", 8, "QuadSound.UT99") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTFlakSkin", 7, "QuadSound.UT99") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTFlakSkin", 6, "QuadSound.UC2")
			TNT1 A 0 A_JumpIfInventory("UTFlakSkin", 5, "QuadSound.UT2004") // UC1 uses UT2003 sounds
			TNT1 A 0 A_JumpIfInventory("UTFlakSkin", 4, "QuadSound.UT2004")
			TNT1 A 0 A_JumpIfInventory("UTFlakSkin", 3, "QuadSound.UT2004")
			TNT1 A 0 A_JumpIfInventory("UTFlakSkin", 2, "QuadSound.UT99") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTFlakSkin", 1, "QuadSound.UT99") // Fallback to another skin
		QuadSound.UT2004:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Flak/Quad/Fire_UT2004",CHAN_WEAPON)
			Goto FlashEnder
		QuadSound.UC2:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Flak/Quad/Fire_UC2",CHAN_WEAPON)
			Goto FlashEnder
		QuadSound.UT99:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Flak/Quad/Fire_UT99",CHAN_WEAPON)
			Goto FlashEnder

	FlashEnder:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_JumpIfInventory("WepNoFlashToken",1,"FlashEnderCont")
		TNT1 A 0 A_SetBlend("Yellow",0.07,7)
	FlashEnderCont:
		TNT1 A 0 A_JumpIfInventory("WepNoRecoilToken",1,"FlashEnderNoRecoil")
		TNT1 A 0 A_SetPitch(pitch-3.5)
		TNT1 A 2
		TNT1 AAAAAAA 1 A_SetPitch(pitch+0.5)
		Stop
	FlashEnderNoRecoil:
		TNT1 A 1
		Stop

	//-----------------------
	// AltFire Seq
	//-----------------------
	AltFire: 	//35 tics, 1sec
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		"####" A 0 A_GunFlash("AltFlash")
		"####" F 1
		"####" G 1 Offset(2,34)
		"####" G 1 Offset(7,37)
		"####" H 1 Offset(10,39)
		"####" H 1 Offset(13,41)
		"####" I 1 Offset(16,45)
		"####" I 1 Offset(19,49)
		"####" J 1
		"####" J 1 Offset(18,48)  //10
		"####" K 1 Offset(17,48)
		"####" K 1 Offset(16,47)
		"####" L 1 Offset(15,47)
		"####" L 1 Offset(14,46)
		"####" M 1 Offset(13,45)
		"####" M 1 Offset(12,44)
		"####" N 1 Offset(11,43)
		"####" N 1 Offset(10,42)
		"####" O 1 Offset(9,41)
		"####" O 1 Offset(8,40)	//20
		"####" P 1 Offset(7,39)
		"####" P 1 Offset(6,38)
		"####" Q 1 Offset(5,37)
		"####" Q 1 Offset(4,36)
		"####" R 1 Offset(3,35)
		"####" R 1 Offset(2,34)
		"####" S 1 Offset(1,33)
		"####" S 1 Offset(0,32)	//28
		"####" T 1
		"####" T 1
		"####" U 1
		"####" U 1
		"####" V 1
		"####" V 1
		Goto Ready

	AltFlash:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_FireCustomMissile("UTFlakBomb",0,true,1,-1,FPF_UNLAGDEATH,10) // Use ammo
		Goto AltFlashCheckSound

	AltFlashCheckSound:
		TNT1 A 0 A_JumpIfInventory("PowerQuad",1,"AltQuadSound")
		TNT1 A 0 A_JumpIfInventory("PowerTerminatorArtifact",1,"AltQuadSound")
		Goto AltNormalSound

		AltNormalSound:
			TNT1 A 0 A_JumpIfInventory("UTFlakSkin", 9, "AltNormalSound.UT99")
			TNT1 A 0 A_JumpIfInventory("UTFlakSkin", 8, "AltNormalSound.UT99") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTFlakSkin", 7, "AltNormalSound.UT99") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTFlakSkin", 6, "AltNormalSound.UC2")
			TNT1 A 0 A_JumpIfInventory("UTFlakSkin", 5, "AltNormalSound.UT2004") // UC1 uses UT2003 sounds
			TNT1 A 0 A_JumpIfInventory("UTFlakSkin", 4, "AltNormalSound.UT2004")
			TNT1 A 0 A_JumpIfInventory("UTFlakSkin", 3, "AltNormalSound.UT2004")
			TNT1 A 0 A_JumpIfInventory("UTFlakSkin", 2, "AltNormalSound.UT99") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTFlakSkin", 1, "AltNormalSound.UT99") // Fallback to another skin
		AltNormalSound.UT2004:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Flak/AltFire_UT2004",CHAN_WEAPON)
			Goto FlashEnder
		AltNormalSound.UC2:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Flak/AltFire_UC2",CHAN_WEAPON)
			Goto FlashEnder
		AltNormalSound.UT99:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Flak/AltFire_UT99",CHAN_WEAPON)
			Goto FlashEnder

		AltQuadSound:
			TNT1 A 0 A_JumpIfInventory("UTFlakSkin", 9, "AltQuadSound.UT99")
			TNT1 A 0 A_JumpIfInventory("UTFlakSkin", 8, "AltQuadSound.UT99") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTFlakSkin", 7, "AltQuadSound.UT99") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTFlakSkin", 6, "AltQuadSound.UC2")
			TNT1 A 0 A_JumpIfInventory("UTFlakSkin", 5, "AltQuadSound.UT2004") // UC1 uses UT2003 sounds
			TNT1 A 0 A_JumpIfInventory("UTFlakSkin", 4, "AltQuadSound.UT2004")
			TNT1 A 0 A_JumpIfInventory("UTFlakSkin", 3, "AltQuadSound.UT2004")
			TNT1 A 0 A_JumpIfInventory("UTFlakSkin", 2, "AltQuadSound.UT99") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTFlakSkin", 1, "AltQuadSound.UT99") // Fallback to another skin
		AltQuadSound.UT2004:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Flak/Quad/AltFire_UT2004",CHAN_WEAPON)
			Goto FlashEnder
		AltQuadSound.UC2:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Flak/Quad/AltFire_UC2",CHAN_WEAPON)
			Goto FlashEnder
		AltQuadSound.UT99:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Flak/Quad/AltFire_UT99",CHAN_WEAPON)
			Goto FlashEnder

	AltFlashEnder:
		TNT1 A 0 A_JumpIfInventory("WepNoRecoilToken",1,"AltFlashEnderNoRecoil")
		TNT1 A 0 A_SetPitch(pitch-2.5)
		TNT1 A 2
		TNT1 AAAAA 1 A_SetPitch(pitch+0.5)
		Stop
	AltFlashEnderNoRecoil:
		TNT1 A 1
		Stop

	}
}

Actor UTFlakShell : FastProjectile
{
	var int user_velx;
	var int user_vely;
	var int user_velz;

	Projectile
	+FORCEXYBILLBOARD
	+DONTSPLASH
	+BLOODSPLATTER
	+MTHRUSPECIES
	+DONTBLAST
	ReactionTime 35
	damage (random(16,24))
	radius 2
	height 2
	speed 65
	renderstyle ADD
	alpha 0.9
	scale 0.4
	Obituary "$OB_UTFlakCannon"
	MissileType "UTFlakShellTrailFX"
	MissileHeight 8
	Obituary "$OB_UTFlakCannon"
	Decal "BulletChip"
	States
	{
	Spawn:
		TNT1 A 0
		TNT1 A 0 A_SetUserVar("user_velx", velx)
		TNT1 A 0 A_SetUserVar("user_vely", vely)
		TNT1 A 0 A_SetUserVar("user_velz", velz)
	FlyLoop:
		NAIL A 0 BRIGHT A_Countdown
		NAIL A 1 BRIGHT A_Jump(192, "Spawn")
		Goto FlyLoop+1
	XDeath:
		TNT1 A 0 A_GiveToTarget("HitBeepMid",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		TNT1 A 1 // Need the actor to live one more tick so that a proper obituary message is shown
		Stop
	Death:
		TNT1 A 0 A_JumpIfInTargetInventory("SSG_UG_Speed", 1, "DeathUpgraded")
		TNT1 A 0 A_SpawnItemEx("UTFlakShellBounced", 0, 0, 0, user_velx, user_vely, user_velz, 0, SXF_ABSOLUTEVELOCITY|SXF_TRANSFERPOINTERS)
		TNT1 A 1 // Need the actor to live one more tick so that a proper obituary message is shown
		Stop
	DeathUpgraded:
		TNT1 A 0 A_SpawnItemEx("UTFlakShellBouncedUpgraded", 0, 0, 0, user_velx, user_vely, user_velz, 0, SXF_ABSOLUTEVELOCITY|SXF_TRANSFERPOINTERS)
		TNT1 A 1 // Need the actor to live one more tick so that a proper obituary message is shown
		Stop
	}
}

Actor UTFlakShellBounced
{
	Projectile
	+FORCEXYBILLBOARD
	+DONTSPLASH
	+USEBOUNCESTATE
	+BLOODSPLATTER
	+HITOWNER
	//+MTHRUSPECIES // this flag conflicts with +HITOWNER
	+DONTBLAST
	-NOGRAVITY
	ReactionTime 35
	Gravity 0.5
	damage (random(16,24))
	radius 2
	height 2
	speed 65
	renderstyle ADD
	alpha 0.9
	scale 0.4
	BounceType Doom
	BounceFactor 0.35
	WallBounceFactor 0.35
	Obituary "$OB_UTFlakCannon"
	states
	{
	Spawn:
		NAIL A 0 BRIGHT A_Countdown
		NAIL A 0 BRIGHT A_SpawnItemEx("UTFlakShellTrailFXBounced")
		NAIL A 1 A_Jump(192, "Spawn")
		Goto Spawn+1
	Bounce:
		TNT1 A 0 A_PlaySound("UTDE/Weapons/Flak/Bounce",CHAN_AUTO,1,0,1)
		Goto Spawn
	XDeath:
		TNT1 A 0 A_GiveToTarget("HitBeepMid",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
	Death:
		TNT1 A 1 // Need the actor to live one more tick so that a proper obituary message is shown
		Stop
	}
}

Actor UTFlakShellBouncedUpgraded : UTFlakShellBounced
{
	-HITOWNER
}

Actor UTFlakBomb
{
	Projectile
	+BLOODSPLATTER
	+FORCEXYBILLBOARD
	+SEEKERMISSILE //Not actually used for anything other than checking radius.
	+MTHRUSPECIES
	+DONTBLAST
	-NOGRAVITY
	Gravity 0.65
	damage (random(20,50))
	radius 5
	height 10
	speed 25
	alpha 1.0
	scale 1.0
	Obituary "$OB_UTFlakCannon"
	DeathSound "QC/Weapons/RocketLauncher/RocketExplo"
	Decal "D4ExploScorch"
	states
	{
	Spawn:
		TNT1 A 0
	Looper:
		FLAK A 1 BRIGHT A_SpawnItemEx("UTBombTrailFX")
		FLAK A 0 BRIGHT
		Loop

	Death:
		TNT1 A 0 A_ChangeFlag("NOINTERACTION",1)
		TNT1 A 0 A_Stop
		TNT1 A 0 A_SeekerMissile(0,0,SMF_LOOK|SMF_CURSPEED,256)
		TNT1 A 0 A_JumpIfTargetInLOS("RadiusHit",360,JLOSF_PROJECTILE,208)
		Goto DeathCont

		RadiusHit:	//splash damage beep
			TNT1 A 0 A_GiveToTarget("HitBeepMid",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
			Goto DeathCont

	XDeath:
		TNT1 A 0 A_GiveToTarget("HitBeepBig",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		TNT1 A 0 A_ChangeFlag("NOINTERACTION",1)
		TNT1 A 0 A_Stop
		Goto DeathCont

	DeathCont:
		TNT1 A 0 A_RadiusThrust(85,128,RTF_AFFECTSOURCE|RTF_THRUSTZ)	//thrust players only this way, without damage
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", true)
		TNT1 A 0 A_Explode(25,144,XF_HURTSOURCE,0,18)
		TNT1 A 0 A_Explode(random(0,10),144,XF_HURTSOURCE,0,18)
		TNT1 A 0 A_Explode(random(45,55),144,0,0,18)		//then another 40-50 extra damage for impacting a player + (15)dmg on the projectile =80-100dmg
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", false)
		TNT1 A 0 A_JumpIfInTargetInventory("SSG_UG_Speed", 1, "SpawnSafeDebris")
		Goto SpawnDebris

	SpawnDebris:
		TNT1 AAAAAAAAAA 0 A_SpawnItemEx("UTFlakShellBounced",0,0,1,afrandom(-30.0, 30.0),afrandom(-30.0, 30.0),afrandom(-30.0, 30.0))
		TNT1 A 0 A_JumpIfInTargetInventory("SSG_UG_Flame", 1, "SpawnMoreDebris")
		Goto DeathFx

	SpawnMoreDebris:
		TNT1 AAAAAAAAA 0 A_SpawnItemEx("UTFlakShellBounced",0,0,1,afrandom(-30.0, 30.0),afrandom(-30.0, 30.0),afrandom(-30.0, 30.0))
		Goto DeathFx

	SpawnSafeDebris:
		TNT1 AAAAAAAAAA 0 A_SpawnItemEx("UTFlakShellBouncedUpgraded",0,0,1,afrandom(-30.0, 30.0),afrandom(-30.0, 30.0),afrandom(-30.0, 30.0))
		TNT1 A 0 A_JumpIfInTargetInventory("SSG_UG_Flame", 1, "SpawnMoreSafeDebris")
		Goto DeathFx

	SpawnMoreSafeDebris:
		TNT1 AAAAAAAAA 0 A_SpawnItemEx("UTFlakShellBouncedUpgraded",0,0,1,afrandom(-30.0, 30.0),afrandom(-30.0, 30.0),afrandom(-30.0, 30.0))
		Goto DeathFx

	DeathFx:
		TNT1 A 0 A_PlaySound("UTDE/Weapons/Flak/Explo",CHAN_AUTO,1,0,1)
		TNT1 A 0 A_SpawnItemEx("QCRocketExploDebris",-1,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 AAAAA 0 A_SpawnItemEx("QCRocketExploParticle",3,0,0,frandom(3,5.5),frandom(3,5.5),frandom(1,6),random(0,359),SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SpawnItemEx("QCRocketExplosion",-2,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 A 99 // We need this for proper rocket jump unlagged when exploding too soon
		Stop
	}
}

// --------------------------------------------------------------------------
//	For competitive DM, weapons dont autoaim
// --------------------------------------------------------------------------
Actor QCSuperShotgunDM : QCSuperShotgun
{
	+WEAPON.NOAUTOAIM
	+CHEATNOTWEAPON
	Tag "$TAG_UTFlakCannon"
	Weapon.AmmoUse 1
	Weapon.AmmoUse2 1
	Weapon.AmmoGive 15
	Weapon.AmmoDmScale 1.0
	Weapon.AmmoDmRefill 2

	States
	{
	Flash:
		TNT1 A 0 A_FireCustomMissile("UTFlakShellDM",0,true,1,4,0,0) // Use ammo
		TNT1 A 0 A_FireCustomMissile("UTFlakShellDM",   sin(0)*4.0, false,1,4,0,   cos(0)*4.0)
		TNT1 A 0 A_FireCustomMissile("UTFlakShellDM",  sin(45)*4.0, false,1,4,0,  cos(45)*4.0)
		TNT1 A 0 A_FireCustomMissile("UTFlakShellDM",  sin(90)*4.0, false,1,4,0,  cos(90)*4.0)
		TNT1 A 0 A_FireCustomMissile("UTFlakShellDM", sin(135)*4.0, false,1,4,0, cos(135)*4.0)
		TNT1 A 0 A_FireCustomMissile("UTFlakShellDM", sin(180)*4.0, false,1,4,0, cos(180)*4.0)
		TNT1 A 0 A_FireCustomMissile("UTFlakShellDM", sin(225)*4.0, false,1,4,0, cos(225)*4.0)
		TNT1 A 0 A_FireCustomMissile("UTFlakShellDM", sin(270)*4.0, false,1,4,0, cos(270)*4.0)
		TNT1 A 0 A_FireCustomMissile("UTFlakShellDM", sin(315)*4.0, false,1,4,0, cos(315)*4.0)
		Goto FlashCheckSound

	AltFlash:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_FireCustomMissile("UTFlakBombDM",0,true,1,-1,FPF_UNLAGDEATH,10) // Use ammo
		Goto AltFlashCheckSound
	}
}

Actor UTFlakShellDM : UTFlakShell
{
	-MTHRUSPECIES
	-DONTBLAST
	damage (13)
	States
	{
	Death:
		TNT1 A 0 A_SpawnItemEx("UTFlakShellBouncedDM", 0, 0, 0, user_velx, user_vely, user_velz, 0, SXF_ABSOLUTEVELOCITY|SXF_TRANSFERPOINTERS)
		Stop
	}
}

Actor UTFlakShellBouncedDM : UTFlakShellBounced
{
	-MTHRUSPECIES
	-DONTBLAST
	damage (10)
}

Actor UTFlakBombDM : UTFlakBomb
{
	-MTHRUSPECIES
	-DONTBLAST
	damage (15)
	States
	{
	Death:	// don't remove this state even thought it's exactly the same as in coop version.
          	// Zandro doesn't handle A_Jump on death properly so have to rely on Goto
		TNT1 A 0 A_ChangeFlag("NOINTERACTION",1)
		TNT1 A 0 A_Stop
		TNT1 A 0 A_SeekerMissile(0,0,SMF_LOOK|SMF_CURSPEED,256)
		TNT1 A 0 A_JumpIfTargetInLOS("RadiusHit",360,JLOSF_PROJECTILE,208)
		Goto DeathCont

		RadiusHit:	//splash damage beep
			TNT1 A 0 A_GiveToTarget("HitBeepMid",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
			Goto DeathCont

	XDeath: // don't remove this state even thought it's exactly the same as in coop version.
			// Zandro doesn't handle A_Jump on death properly so have to rely on Goto
		TNT1 A 0 A_GiveToTarget("HitBeepBig",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		TNT1 A 0 A_ChangeFlag("NOINTERACTION",1)
		TNT1 A 0 A_Stop
		Goto DeathCont

	DeathCont:
		TNT1 A 0 A_RadiusThrust(85,128,RTF_AFFECTSOURCE|RTF_THRUSTZ)	//thrust players only this way, without damage
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", true)
		TNT1 A 0 A_Explode(25,144,XF_HURTSOURCE,0,18)
		TNT1 A 0 A_Explode(10,144,XF_HURTSOURCE,0,18)
		TNT1 A 0 A_Explode(40,144,0,0,18)					//then another 40 extra damage for impacting a player + (15)dmg on the projectile =90dmg
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", false)
		TNT1 AAAAAAAAAA 0 A_SpawnItemEx("UTFlakShellBouncedDM",0,0,1,afrandom(-30.0, 30.0),afrandom(-30.0, 30.0),afrandom(-30.0, 30.0))
		TNT1 A 0 A_PlaySound("UTDE/Weapons/Flak/Explo",CHAN_AUTO,1,0,1)
		TNT1 A 0 A_SpawnItemEx("QCRocketExploDebrisDM",-1,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 AAAAA 0 A_SpawnItemEx("QCRocketExploParticle",3,0,0,frandom(3,5.5),frandom(3,5.5),frandom(1,6),random(0,359),SXF_NOCHECKPOSITION)
		TNT1 A 10 A_SpawnItemEx("QCRocketExplosionDM",-2,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		Stop
	}
}

// --------------------------------------------------------------------------
//	Effects
// --------------------------------------------------------------------------

Actor UTFlakShellTrailFX
{
	+NOINTERACTION
	+FORCEXYBILLBOARD
	+CLIENTSIDEONLY
	+NONETID
	radius 20
	RenderStyle Add
	Translation "0:255=%[2.0,1.48,0.62]:[2.0,1.48,0.62]"
	Scale 0.25
	Alpha 0.25
	States
	{
	Spawn:
		TNT1 A 0
		DB60 A 1 A_FadeOut(0.05)
		Loop
	}
}

Actor UTFlakShellTrailFXBounced : UTFlakShellTrailFX
{
	States
	{
	Spawn:
		TNT1 A 0
		TNT1 A 1
	Looper:
		DB60 A 1 A_FadeOut(0.05)
		Loop
	}
}

Actor UTBombTrailFX
{
	+CLIENTSIDEONLY +NONETID
	+NOINTERACTION +NOTONAUTOMAP
	+FORCEXYBILLBOARD
	+DONTBLAST
	RenderStyle Translucent
	Alpha 0.4
	Scale 0.0
	States
	{
	Spawn:
		TNT1 A 0 NoDelay A_Jump(256,1,2,3,4)
		X037 A 0 A_SetScale(frandom(0,0.2)) Goto Missile
		X037 B 0 A_SetScale(frandom(0,0.2)) Goto Missile
		X037 C 0 A_SetScale(frandom(0,0.2)) Goto Missile
		X037 D 0 A_SetScale(frandom(0,0.2)) Goto Missile
	Missile:
		"####" "#" 1 A_SetScale(ScaleX+0.007)	"####" "#" 0 A_FadeIn(0.02)
		"####" "#" 1 A_SetScale(ScaleX+0.007)	"####" "#" 0 A_FadeIn(0.02)
		"####" "#" 1 A_SetScale(ScaleX+0.007)	"####" "#" 0 A_FadeIn(0.02)
		"####" "#" 1 A_SetScale(ScaleX+0.007)	"####" "#" 0 A_FadeIn(0.02)
		"####" "#" 1 A_SetScale(ScaleX+0.007)	"####" "#" 0 A_FadeIn(0.02)
		"####" "#" 1 A_SetScale(ScaleX+0.007)	"####" "#" 0 A_FadeIn(0.02)
		"####" "#" 1 A_SetScale(ScaleX+0.007)	"####" "#" 0 A_FadeIn(0.02)
		"####" "#" 1 A_SetScale(ScaleX+0.007)	"####" "#" 0 A_FadeIn(0.02)
		Goto Continue
	Continue:
		"####" "#" 1 A_FadeOut(0.08)
		"####" "#" 1 A_SetScale(ScaleX+0.007)
		Loop
	}
}

