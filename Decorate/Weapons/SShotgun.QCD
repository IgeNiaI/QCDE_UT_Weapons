// --------------------------------------------------------------------------
//
// Flak Cannon
// Weapon and Pickup sprite by Pixo
// Weapon code by geNia
//
// --------------------------------------------------------------------------

Actor SuperShotgunPickup : CustomInventory 15602
{
	//$NotAngled
	//$Category "QCDE Weapons"
	//$Color 14
	//$Title "Flak Cannon"
	Height 48
	Radius 20
	Scale 0.66
	Inventory.PickupSound "QC/Items/WeaponPick"
	Inventory.PickupMessage "$GOT_UTFlakCannon"
	Tag "$TAG_UTFlakCannon"
	Inventory.RespawnTics 35
	States
	{
	Spawn:
		UTFC Y 35 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		Goto Idle
	DMSpawn:
		"####" "#" 0 A_ChangeFlag("DROPPED", 0)
		UTFC Z -1 Bright ACS_NamedExecuteWithResult("QCDE_WeaponSpawned",10,args[4])
		Stop
	Idle:
		UTFC Y -1 ACS_NamedExecuteWithResult("QCDE_WeaponSpawned",9,args[4])
		Wait
	Pickup:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMPickup")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"WeaponStay")
		TNT1 A 0 A_GiveInventory("QCSuperShotgun")
		TNT1 A 0
		Stop
	DMPickup:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"DMWeaponStay")
		TNT1 A 0 A_GiveInventory("QCSuperShotgunDM")
		TNT1 A 0 A_TakeInventory("QCShotgunDM")
		TNT1 A 0 A_TakeInventory("QCSuperShotgun")
		TNT1 A 0 A_TakeInventory("QCShotgun")
		Stop
	WeaponStay:
		TNT1 A 0 A_JumpIfInventory("QCSuperShotgun",1,"Stay")
		TNT1 A 0 A_SpawnItemEx("QCSuperShotgun", velx,vely,velz, velx,vely,velz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Fail
	DMWeaponStay:
		TNT1 A 0 A_TakeInventory("QCSuperShotgun")
		TNT1 A 0 A_JumpIfInventory("QCSuperShotgunDM",1,"Stay")
		TNT1 A 0 A_SpawnItemEx("QCSuperShotgunDM", velx,vely,velz, velx,vely,velz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Fail
	Stay:
		TNT1 A 0
		Fail
	HideIndefinitely:
		TNT1 A 1 A_SetTics(CallACS("QCDE_SetWeaponRespawnTics"))
		Goto HideDoomish+1
	}
}

Actor SuperShotgunPickupDMvar: CustomInventory 	//this one is for SSGs spawned in DM maps that have 200
{												//SSG spawns in the map. Most of the time, it'll be something else
	//$NotAngled
	//$Color 14
	//$Title "SSG-in-vanilla Replacer"
	var int user_type;
	Height 48
	Scale 0.66
	Inventory.PickupSound "QC/Items/WeaponPick"
	Inventory.PickupMessage "$GOT_UTFlakCannon"
	Tag "$TAG_UTFlakCannon"
	Inventory.RespawnTics 35
	States
	{
	Spawn:
		UTFC Y 35 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		Goto Idle
		
	DMSpawn:
		"####" "#" 0 A_ChangeFlag("DROPPED", 0)
		Goto ChooseWeapon
		
		ChooseWeapon:
			TNT1 A 0 A_Jump(200,"BeTribolt","BeHMG","BeSNG") 
			Goto BeSSG //about 1/5th of the time, it'll be ssg
		BeTribolt:
			TNT1 A 0 A_SpawnItemEx("TriboltPickup", 0,0,0, 0,0,0, 0,SXF_NOCHECKPOSITION) 
			Stop
		BeHMG:
			TNT1 A 0 A_SpawnItemEx("HeavyMachinegunPickup", 0,0,0, 0,0,0, 0,SXF_NOCHECKPOSITION) 
			Stop
		BeSNG:
			TNT1 A 0 A_SpawnItemEx("SuperNailgunPickup", 0,0,0, 0,0,0, 0,SXF_NOCHECKPOSITION) 
			Stop
		BeSSG:
			UTFC Z -1 Bright ACS_NamedExecuteWithResult("QCDE_WeaponSpawned",10,args[4])
			Wait
		
	Idle:
		UTFC Y -1 ACS_NamedExecuteWithResult("QCDE_WeaponSpawned",9,args[4])
		Wait
	Pickup:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMPickup")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"WeaponStay")
		TNT1 A 0 A_GiveInventory("QCSuperShotgun")
		TNT1 A 0
		Stop
	DMPickup:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"DMWeaponStay")
		TNT1 A 0 A_GiveInventory("QCSuperShotgunDM")
		TNT1 A 0 A_TakeInventory("QCShotgunDM")
		TNT1 A 0 A_TakeInventory("QCSuperShotgun")
		TNT1 A 0 A_TakeInventory("QCShotgun")
		Stop
	WeaponStay:
		TNT1 A 0 A_JumpIfInventory("QCSuperShotgun",1,"Stay")
		TNT1 A 0 A_SpawnItemEx("QCSuperShotgun", velx,vely,velz, velx,vely,velz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Fail
	DMWeaponStay:
		TNT1 A 0 A_TakeInventory("QCSuperShotgun")
		TNT1 A 0 A_JumpIfInventory("QCSuperShotgunDM",1,"Stay")
		TNT1 A 0 A_SpawnItemEx("QCSuperShotgunDM", velx,vely,velz, velx,vely,velz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Fail
	Stay:
		TNT1 A 0
		Fail
	HideIndefinitely:
		TNT1 A 1 A_SetTics(CallACS("QCDE_SetWeaponRespawnTics"))
		Goto HideDoomish+1
	}
}


Actor QCSuperShotgun : QCWeapon
{
	Height 48
	Weapon.SwaySpeed 3.0
	Weapon.Kickback 35
	Weapon.SelectionOrder 1100
	Weapon.AmmoUse 2
	Weapon.AmmoUse2 2
	Weapon.AmmoGive 15
	Weapon.AmmoType "QCShellAmmo"
	Weapon.AmmoType2 "QCShellAmmo"
	Obituary "$OB_UTFlakCannon"
	Inventory.PickupMessage "$GOT_UTFlakCannon"
	Tag "$TAG_UTFlakCannon"
	Scale 0.66
	States
	{
	Spawn:
		UTFC Y 35 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		Goto Idle
	DMSpawn:
		UTFC ZZZZZZZZZZZZZZZ 35 Bright
		Stop
	Idle:
		UTFC Y -1
		Wait

	//-----------------------
	// Select/Deselect Seq
	//-----------------------
	Select:
		UTFC A 0 A_JumpIfInventory("NoWeaponFireToken",1,2)
		UTFC A 0 A_PlaySound("QC/Weapons/Switch",5,1,0,3) //Not in Weapon.UpSound because it interrupts CHAN_WEAPON sounds
		UTFC A 0 A_TakeInventory("QCShotgunDM")
		"####" "#" 0 A_StopSound(CHAN_WEAPON) //stops any weapon looping sound
	SelectLooper:
		UTFC A 1 A_Raise
		"####" "###" 0 A_Raise
		Loop
	
	Deselect:
		UTFC A 0 A_StopSound(5)
		UTFC A 0 A_StopSound(CHAN_WEAPON)
	DeselecLooper:
		UTFC A 1 A_Lower
		"####" "###" 0 A_Lower
		Loop

	//-----------------------
	// Ready Seq
	//-----------------------
	Ready:
		UTFC A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		UTFC A 3 A_WeaponReady
		Loop
		
		ReadyCantFire:
			UTFC A 0 A_StopSound(5)
			UTFC A 0 A_StopSound(CHAN_WEAPON)
		RCFLooper:
			UTFC A 4 A_WeaponReady(WRF_NOFIRE)
			UTFC A 0 A_JumpIfInventory("NoWeaponFireToken",1,"RCFLooper")
			Goto Ready

	//-----------------------
	// Fire Seq
	//-----------------------
	Fire: 	//27 tics, 0.77sec
		TNT1 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		TNT1 A 0 A_GunFlash("Flash")
		UTFC B 1
		UTFC C 1 Offset(3,35)
		UTFC D 1 Offset(8,38)
		UTFC E 1 Offset(11,40)
		UTFC E 1 Offset(14,42)
		UTFC F 1 Offset(17,46)
		UTFC F 1 Offset(20,50)
		UTFC G 1
		UTFC G 1 Offset(19,49)  //10
		UTFC H 1 Offset(18,49)
		UTFC H 1 Offset(17,48)
        UTFC I 1 Offset(16,48)
		UTFC I 1 Offset(15,47)
		UTFC J 1 Offset(14,46)
		UTFC J 1 Offset(13,45)
		UTFC K 1 Offset(12,44)
		UTFC L 1 Offset(11,43)
		UTFC M 1 Offset(10,42)
		UTFC N 1 Offset(9,41)	//20
		UTFC O 1 Offset(8,40)
		UTFC P 1 Offset(7,39)
		UTFC Q 1 Offset(6,38)
		UTFC R 1 Offset(5,37)
		UTFC S 1 Offset(4,36)
		UTFC T 1 Offset(3,35)
		UTFC U 1 Offset(2,34)
		UTFC V 1 Offset(1,33)	//28
		Goto Ready

	Flash:
		TNT1 A 0 A_FireCustomMissile("UTFlakShell",afrandom(4.0,-4.0),true,1,4,0,afrandom(4.0,-4.0)) // Use ammo
		TNT1 AAAAAAAA 0 A_FireCustomMissile("UTFlakShell",afrandom(4.0,-4.0),false,1,4,0,afrandom(4.0,-4.0)) // Don't use ammo
		Goto FlashCheckSound
			
	FlashCheckSound:
		TNT1 A 0 A_JumpIfInventory("PowerQuad",1,"QuadSound")
		Goto NormalSound
		
		NormalSound:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Flak/Fire",CHAN_WEAPON)
			Goto FlashEnder
		QuadSound:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Flak/Quad/Fire",CHAN_WEAPON)
			Goto FlashEnder
			
	FlashEnder:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_JumpIfInventory("WepNoRecoilToken",1,"FlashEnderNoRecoil")		
		TNT1 A 0 A_SetPitch(pitch-3.5)
		TNT1 A 2
		TNT1 AAAAAAA 1 A_SetPitch(pitch+0.5)
		Stop
	FlashEnderNoRecoil:
		TNT1 A 1
		Stop

	//-----------------------
	// AltFire Seq
	//-----------------------
	AltFire: 	//35 tics, 1sec
		TNT1 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		TNT1 A 0 A_GunFlash("AltFlash")
		UTFC F 1
		UTFC G 1 Offset(3,35)
		UTFC G 1 Offset(8,38)
		UTFC H 1 Offset(11,40)
		UTFC H 1 Offset(14,42)
		UTFC I 1 Offset(17,46)
		UTFC I 1 Offset(20,50)
		UTFC J 1
		UTFC J 1 Offset(19,49)  //10
		UTFC K 1 Offset(18,49)
		UTFC K 1 Offset(17,48)
		UTFC L 1 Offset(16,48)
		UTFC L 1 Offset(15,47)
		UTFC M 1 Offset(14,46)
		UTFC M 1 Offset(13,45)
		UTFC N 1 Offset(12,44)
		UTFC N 1 Offset(11,43)
		UTFC O 1 Offset(10,42)
		UTFC O 1 Offset(9,41)	//20
		UTFC P 1 Offset(8,40)
		UTFC P 1 Offset(7,39)
		UTFC Q 1 Offset(6,38)
		UTFC Q 1 Offset(5,37)
		UTFC R 1 Offset(4,36)
		UTFC R 1 Offset(3,35)
		UTFC S 1 Offset(2,34)
		UTFC S 1 Offset(1,33)	//28
		UTFC T 1
		UTFC T 1
		UTFC U 1
		UTFC U 1
		UTFC V 1
		UTFC V 1
		Goto Ready

	AltFlash:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_FireCustomMissile("UTFlakBomb",0,true,1,-1,0,10) // Use ammo
		Goto AltFlashCheckSound
			
	AltFlashCheckSound:
		TNT1 A 0 A_JumpIfInventory("PowerQuad",1,"AltQuadSound")
		Goto AltNormalSound
		
		AltNormalSound:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Flak/AltFire",CHAN_WEAPON)
			Goto AltFlashEnder
		AltQuadSound:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Flak/Quad/AltFire",CHAN_WEAPON)
			Goto AltFlashEnder
			
	AltFlashEnder:
		TNT1 A 0 A_JumpIfInventory("WepNoRecoilToken",1,"AltFlashEnderNoRecoil")
		TNT1 A 0 A_SetPitch(pitch-2.5)
		TNT1 A 2
		TNT1 AAAAA 1 A_SetPitch(pitch+0.5)
		Stop
	AltFlashEnderNoRecoil:
		TNT1 A 1
		Stop

	}
}

Actor UTFlakShell : FastProjectile
{
	var int user_velx;
	var int user_vely;
	var int user_velz;

	Projectile
	+FORCEXYBILLBOARD
	+DONTSPLASH
	+BLOODSPLATTER
	+MTHRUSPECIES
	+DONTBLAST
	ReactionTime 35
	damage (random(16,24))
	radius 2
	height 2
	speed 65
	renderstyle ADD
	alpha 0.9
	scale 0.4
	Obituary "$OB_UTFlakCannon"
	MissileType "UTFlakShellTrailFX"
	MissileHeight 8
	Obituary "$OB_UTFlakCannon"
	States
	{
	Spawn:
		TNT1 A 0
		TNT1 A 0 A_SetUserVar("user_velx", velx)
		TNT1 A 0 A_SetUserVar("user_vely", vely)
		TNT1 A 0 A_SetUserVar("user_velz", velz)
	FlyLoop:
		NAIL A 0 BRIGHT A_Countdown
		NAIL A 1 BRIGHT A_Jump(192, "Spawn")
		Goto FlyLoop+1
	XDeath:
		TNT1 A 0 A_GiveToTarget("HitBeepMid",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		Stop
	Death:
		TNT1 A 0 A_SpawnItemEx("UTFlakShellBounced", 0, 0, 0, user_velx, user_vely, user_velz, 0, SXF_ABSOLUTEVELOCITY|SXF_TRANSFERPOINTERS)
		Stop
	}
}

Actor UTFlakShellBounced
{
	Projectile
	+FORCEXYBILLBOARD
	+DONTSPLASH
	+USEBOUNCESTATE
	+BLOODSPLATTER
	+HITOWNER
	+MTHRUSPECIES
	+DONTBLAST
	-NOGRAVITY
	ReactionTime 35
	Gravity 0.5
	damage (random(16,24))
	radius 2
	height 2
	speed 65
	renderstyle ADD
	alpha 0.9
	scale 0.4
	BounceType Doom
	BounceFactor 0.35
	WallBounceFactor 0.35
	Obituary "$OB_UTFlakCannon"
	states
	{
	Spawn:
		NAIL A 0 BRIGHT A_Countdown
		NAIL A 0 BRIGHT A_SpawnItemEx("UTFlakShellTrailFXBounced")
		NAIL A 1 A_Jump(192, "Spawn")
		Goto Spawn+1
	Bounce:
		TNT1 A 0 A_PlaySound("UTDE/Weapons/Flak/Bounce",CHAN_AUTO,1,0,1)
		Goto Spawn
	XDeath:
		TNT1 A 0 A_GiveToTarget("HitBeepMid",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
	Death:
		TNT1 A 1
		Stop
	}
}

Actor UTFlakBomb
{
	Projectile
	+BLOODSPLATTER
	+FORCEXYBILLBOARD
	+MTHRUSPECIES
	+DONTBLAST
	-NOGRAVITY
	Gravity 0.65
	damage (random(20,50))
	radius 5
	height 10
	speed 25
	alpha 1.0
	scale 1.0
	Obituary "$OB_UTFlakCannonAlt"
	DeathSound "QC/Weapons/RocketLauncher/RocketExplo"
	states
	{
	Spawn:
		TNT1 A 0
	Looper:
		FLAK A 1 BRIGHT A_SpawnItemEx("UTBombTrailFX")
		FLAK A 0 BRIGHT
		Loop

	Death:
		TNT1 A 0 A_ChangeFlag("NOINTERACTION",1)
		TNT1 A 0 A_Stop
		TNT1 A 0 A_JumpIfTargetInLOS("RadiusHit",360,JLOSF_PROJECTILE,208)
		TNT1 A 0 A_Jump(256,"DeathCont") //for virtual jump to inherited versions
		Goto DeathCont

		RadiusHit:	//splash damage beep
			TNT1 A 0 A_GiveToTarget("HitBeepMid",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
			TNT1 A 0 A_Jump(256,"DeathCont") //for virtual jump to inherited versions
			Goto DeathCont

	XDeath:
		TNT1 A 0 A_GiveToTarget("HitBeepBig",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		TNT1 A 0 A_ChangeFlag("NOINTERACTION",1)
		TNT1 A 0 A_Stop
		TNT1 A 0 A_Jump(256,"DeathCont") //for virtual jump to inherited versions
		Goto DeathCont

	DeathCont:
		TNT1 A 0 A_Explode(25,144,XF_HURTSOURCE,0,18)	//self rocket damage with rocket jump is 25
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", true)
		TNT1 A 0 A_Explode(random(0,10),144,XF_HURTSOURCE,0,18)			//self rocket damage without rocket jump is 0-10
		TNT1 A 0 A_Explode(random(45,55),144,0,0,18)		//then another 40-50 extra damage for impacting a player + (15)dmg on the projectile =80-100dmg
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", false)
		TNT1 AAAAAAAAAA 0 A_SpawnItemEx("UTFlakShellBounced",0,0,1,afrandom(-30.0, 30.0),afrandom(-30.0, 30.0),afrandom(-30.0, 30.0))
		TNT1 A 0 A_PlaySound("UTDE/Weapons/Flak/Explo",CHAN_AUTO,1,0,1)
		TNT1 A 0 A_SpawnItemEx("QCRocketExploDebris",-1,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 AAAAA 0 A_SpawnItemEx("QCRocketExploParticle",3,0,0,frandom(3,5.5),frandom(3,5.5),frandom(1,6),random(0,359),SXF_NOCHECKPOSITION)
		TNT1 A 10 A_SpawnItemEx("QCRocketExplosion",-2,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		Stop
	}
}

// --------------------------------------------------------------------------
//	For competitive DM, weapons dont autoaim
// --------------------------------------------------------------------------
Actor QCSuperShotgunDM : QCSuperShotgun
{
	+WEAPON.NOAUTOAIM
	+CHEATNOTWEAPON
	Tag "$TAG_UTFlakCannon"
	Weapon.AmmoUse 1
	Weapon.AmmoUse2 1
	Weapon.AmmoGive 15
	Weapon.AmmoDmScale 1.0
	Weapon.AmmoDmRefill 2

	States
	{
	Flash:
		TNT1 A 0 A_FireCustomMissile("UTFlakShellDM",afrandom(4.0,-4.0),true,1,4,0,afrandom(4.0,-4.0)) // Use ammo
		TNT1 AAAAAAAA 0 A_FireCustomMissile("UTFlakShellDM",afrandom(4.0,-4.0),false,1,4,0,afrandom(4.0,-4.0)) // Don't use ammo
		Goto FlashCheckSound

	AltFlash:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_FireCustomMissile("UTFlakBombDM",0,true,1,-1,0,10) // Use ammo
		Goto AltFlashCheckSound
	}
}

Actor UTFlakShellDM : UTFlakShell
{
	-MTHRUSPECIES
	-DONTBLAST
	damage (13)
	States
	{
	Death:
		TNT1 A 0 A_SpawnItemEx("UTFlakShellBouncedDM", 0, 0, 0, user_velx, user_vely, user_velz, 0, SXF_ABSOLUTEVELOCITY|SXF_TRANSFERPOINTERS)
		Stop
	}
}

Actor UTFlakShellBouncedDM : UTFlakShellBounced
{
	-MTHRUSPECIES
	-DONTBLAST
	damage (10)
}

Actor UTFlakBombDM : UTFlakBomb
{
	-MTHRUSPECIES
	-DONTBLAST
	damage (15)
	States
	{
	DeathCont:
		TNT1 A 0 A_Explode(25,144,XF_HURTSOURCE,0,18)	//self rocket damage with rocket jump is 25
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", true)
		TNT1 A 0 A_Explode(10,144,XF_HURTSOURCE,0,18)					//self rocket damage without rocket jump is 10
		TNT1 A 0 A_Explode(40,144,0,0,18)					//then another 40 extra damage for impacting a player + (15)dmg on the projectile =90dmg
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", false)
		TNT1 AAAAAAAAAA 0 A_SpawnItemEx("UTFlakShellBouncedDM",0,0,1,afrandom(-30.0, 30.0),afrandom(-30.0, 30.0),afrandom(-30.0, 30.0))
		TNT1 A 0 A_PlaySound("UTDE/Weapons/Flak/Explo",CHAN_AUTO,1,0,1)
		TNT1 A 0 A_SpawnItemEx("QCRocketExploDebrisDM",-1,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 AAAAA 0 A_SpawnItemEx("QCRocketExploParticle",3,0,0,frandom(3,5.5),frandom(3,5.5),frandom(1,6),random(0,359),SXF_NOCHECKPOSITION)
		TNT1 A 10 A_SpawnItemEx("QCRocketExplosionDM",-2,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		Stop
	}
}

// --------------------------------------------------------------------------
//	Effects
// --------------------------------------------------------------------------

Actor UTFlakShellTrailFX
{
	+NOINTERACTION
	+FORCEXYBILLBOARD
	+CLIENTSIDEONLY
	+NONETID
	radius 20
	RenderStyle Add
	Translation "0:255=%[2.0,1.48,0.62]:[2.0,1.48,0.62]"
	Scale 0.25
	Alpha 0.25
	States
	{
	Spawn:
		TNT1 A 0
		DB60 A 1 A_FadeOut(0.05)
		Loop
	}
}

Actor UTFlakShellTrailFXBounced : UTFlakShellTrailFX
{
	States
	{
	Spawn:
		TNT1 A 0
		TNT1 A 1
	Looper:
		DB60 A 1 A_FadeOut(0.05)
		Loop
	}
}

Actor UTBombTrailFX
{
	+CLIENTSIDEONLY +NONETID
	+NOINTERACTION +NOTONAUTOMAP
	+FORCEXYBILLBOARD
	+DONTBLAST
	RenderStyle Translucent
	Alpha 0.4
	Scale 0.0
	States
	{
	Spawn:
		TNT1 A 0 NoDelay A_Jump(256,1,2,3,4)
		X037 A 0 A_SetScale(frandom(0,0.2)) Goto Missile
		X037 B 0 A_SetScale(frandom(0,0.2)) Goto Missile
		X037 C 0 A_SetScale(frandom(0,0.2)) Goto Missile
		X037 D 0 A_SetScale(frandom(0,0.2)) Goto Missile
	Missile:
		"####" "#" 1 A_SetScale(ScaleX+0.007)	"####" "#" 0 A_FadeIn(0.02)
		"####" "#" 1 A_SetScale(ScaleX+0.007)	"####" "#" 0 A_FadeIn(0.02)
		"####" "#" 1 A_SetScale(ScaleX+0.007)	"####" "#" 0 A_FadeIn(0.02)
		"####" "#" 1 A_SetScale(ScaleX+0.007)	"####" "#" 0 A_FadeIn(0.02)
		"####" "#" 1 A_SetScale(ScaleX+0.007)	"####" "#" 0 A_FadeIn(0.02)
		"####" "#" 1 A_SetScale(ScaleX+0.007)	"####" "#" 0 A_FadeIn(0.02)
		"####" "#" 1 A_SetScale(ScaleX+0.007)	"####" "#" 0 A_FadeIn(0.02)
		"####" "#" 1 A_SetScale(ScaleX+0.007)	"####" "#" 0 A_FadeIn(0.02)
		Goto Continue
	Continue:
		"####" "#" 1 A_FadeOut(0.08)
		"####" "#" 1 A_SetScale(ScaleX+0.007)
		Loop
	}
}

Actor SSG_UG_Speed : Token {}
