Actor CompatVer31_Railgun {} // for compatibility checks

Actor RailgunPickup : QCWeaponPickup 15607
{
	//$NotAngled
	//$Category "QCDE Weapons"
	//$Color 14
	//$Title "Sniper Rifle"
	Height 48
	Radius 20
	Scale 0.63
	Inventory.PickupSound "QC/Items/WeaponPick"
	Inventory.PickupMessage "$GOT_UTSniperRifle"
	Tag "$TAG_UTSniperRifle"
	Inventory.RespawnTics 35
	States
	{
	Spawn:
		U4G8 Y 35 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		Goto Idle
	DMSpawn:
		"####" "#" 0 A_ChangeFlag("DROPPED", 0)
		U4G8 Z 0 ACS_NamedExecuteWithResult("QCDE_WeaponSpawned",20,args[4],args[3])
		U4G8 Z 0 A_SetArg(3, 1)
		U4G8 Z -1 Bright A_SetArg(4, 0)
		Stop
	Idle:
		U4G8 Y 0 ACS_NamedExecuteWithResult("QCDE_WeaponSpawned",19,args[4],args[3])
		U4G8 Y 0 A_SetArg(3, 1)
		U4G8 Y -1 A_SetArg(4, 0)
		Wait
	Pickup:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMPickup")
		//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"WeaponStay")
		TNT1 A 0 A_GiveInventory("QCRailgun")
		TNT1 A 0
		Stop
	DMPickup:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"DMWeaponStay")
		TNT1 A 0 A_GiveInventory("QCRailgunDM")
		TNT1 A 0
		TNT1 A 0 A_TakeInventory("QCRailgun")
		TNT1 A 0
		Stop
	WeaponStay:
		TNT1 A 0 A_JumpIfInventory("QCRailgun",1,"Stay")
		TNT1 A 0 A_SpawnItemEx("QCRailgun", velx,vely,velz, velx,vely,velz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Fail
	DMWeaponStay:
		TNT1 A 0 A_TakeInventory("QCRailgun")
		TNT1 A 0 A_JumpIfInventory("QCRailgunDM",1,"Stay")
		TNT1 A 0 A_SpawnItemEx("QCRailgunDM", velx,vely,velz, velx,vely,velz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Fail
	Stay:
		TNT1 A 0
		Fail
	HideIndefinitely:
		TNT1 A 1 A_SetTics(CallACS("QCDE_SetWeaponRespawnTics"))
		Goto Super::HideDoomish+1
	HideDoomish:
		TNT1 A 1
		TNT1 A 1 A_SetTics(CallACS("QCDE_SetWeaponRespawnTics"))
		Goto Super::HideDoomish+1
	}
}

Actor RailgunPickupNoGravity : RailgunPickup 15617
{
	//$Category "QCDE Weapons (No Gravity)"
	//$Title "Sniper Rifle (No Gravity)"
	+NOGRAVITY
}


Actor QCRailGun : QCWeapon
{
	Height 48
	+FLOORCLIP
	+INVENTORY.IGNORESKILL
	+WEAPON.NOALERT
	+WEAPON.NOALTAUTOFIRE
	+WEAPON.NOAUTOAIM	//rails never autoaim, but this needed for effects and sound spawners
	Weapon.SwaySpeed 2.7
	Weapon.AmmoType1 "QCSlugAmmo"
	Weapon.AmmoGive1 10
	Weapon.AmmoUse1 1
	Weapon.SelectionOrder 1400
	Inventory.PickupMessage "$GOT_UTSniperRifle"
	Tag "$TAG_UTSniperRifle"
	Obituary "$OB_UTSniperRifle"
	Decal "BulletChip"
	Scale 0.63
	Weapon.KickBack 90
	States
	{
	Spawn:
		TNT1 A 1
		U4G8 Y 35 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		Goto Idle
	DMSpawn:
		U4G8 ZZZZZZZZZZZZZZZ 35 Bright
		Stop
	Idle:
		U4G8 Y -1
		Wait
	//-----------------------
	// Select/Deselect Seq
	//-----------------------
	Select:
		TNT1 A 0 A_JumpIfInventory("UTSniperRifleSkin", 9, "Select.UT99")
		TNT1 A 0 A_JumpIfInventory("UTSniperRifleSkin", 6, "Select.UC2")
		TNT1 A 0 A_JumpIfInventory("UTSniperRifleSkin", 4, "Select.UT2004")
		TNT1 A 0 A_JumpIfInventory("UTSniperRifleSkin", 3, "Select.UT2003")
		TNT1 A 0 A_JumpIfInventory("UTSniperRifleSkin", 1, "Select.U1")
	Select.U1:
		U1G8 A 0
		Goto SelectCont
	Select.UT2003:
		U3G8 A 0
		Goto SelectCont
	Select.UT2004:
		U4G8 A 0
		Goto SelectCont
	Select.UC2:
		U6G8 A 0
		Goto SelectCont
	Select.UT99:
		U9G8 A 0
		Goto SelectCont

	SelectCont:
		"####" A 0 ACS_NamedExecuteWithResult("UTDE_StationarySniperUpgrade",0,0,0,0)
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,2)
		"####" A 0 A_PlaySound("QC/Weapons/Switch",CHAN_5,1,0,3) //Not in Weapon.UpSound because it interrupts CHAN_WEAPON sounds
		"####" A 0 A_StopSound(CHAN_WEAPON) //stops any weapon looping sound
		"####" A 0 A_ZoomFactor(1.0) //for when you exited the level zoomed, upon entering new level, resets zoom here
		"####" A 0 A_TakeInventory("WeaponZoomedToken",32767)
	SelectLooper:
		"####" A 1 A_Raise
		"####" AAA 0 A_Raise
		Loop

	Deselect:
		"####" A 0 A_StopSound(5) //idle sound
		"####" A 0 A_ZoomFactor(1.0)
		"####" A 0 A_TakeInventory("WeaponZoomedToken",32767)
	DeselectLooper:
		"####" A 1 A_Lower
		"####" AAA 0 A_Lower
		Loop

	//-----------------------
	// Ready Seq
	//-----------------------
	Ready:
		TNT1 A 0 A_JumpIfInventory("UTSniperRifleSkin", 9, "Ready.UT99")
		TNT1 A 0 A_JumpIfInventory("UTSniperRifleSkin", 6, "Ready.UC2")
		TNT1 A 0 A_JumpIfInventory("UTSniperRifleSkin", 4, "Ready.UT2004")
		TNT1 A 0 A_JumpIfInventory("UTSniperRifleSkin", 3, "Ready.UT2003")
		TNT1 A 0 A_JumpIfInventory("UTSniperRifleSkin", 1, "Ready.U1")
	Ready.U1:
		U1G8 A 0
		Goto ReadyCont
	Ready.UT2003:
		U3G8 A 0
		Goto ReadyCont
	Ready.UT2004:
		U4G8 A 0
		Goto ReadyCont
	Ready.UC2:
		U6G8 A 0
		Goto ReadyCont
	Ready.UT99:
		U9G8 A 0
		Goto ReadyCont

	ReadyCont:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		"####" A 0 A_JumpIfInventory("WeaponZoomedToken",1,"ReadyZoomed")
		"####" A 1 A_WeaponReady
		"####" A 0 A_JumpIfInventory("WeaponZoomedToken",1,"ReadyZoomed")
		"####" A 1 A_WeaponReady
		"####" A 0 A_JumpIfInventory("WeaponZoomedToken",1,"ReadyZoomed")
		"####" A 1 A_WeaponReady
		"####" A 0 A_JumpIfInventory("WeaponZoomedToken",1,"ReadyZoomed")
		"####" A 1 A_WeaponReady
		"####" B 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		"####" B 0 A_JumpIfInventory("WeaponZoomedToken",1,"ReadyZoomed")
		"####" B 1 A_WeaponReady
		"####" B 0 A_JumpIfInventory("WeaponZoomedToken",1,"ReadyZoomed")
		"####" B 1 A_WeaponReady
		"####" B 0 A_JumpIfInventory("WeaponZoomedToken",1,"ReadyZoomed")
		"####" B 1 A_WeaponReady
		"####" B 0 A_JumpIfInventory("WeaponZoomedToken",1,"ReadyZoomed")
		"####" B 1 A_WeaponReady
		"####" C 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		"####" C 0 A_JumpIfInventory("WeaponZoomedToken",1,"ReadyZoomed")
		"####" C 1 A_WeaponReady
		"####" C 0 A_JumpIfInventory("WeaponZoomedToken",1,"ReadyZoomed")
		"####" C 1 A_WeaponReady
		"####" C 0 A_JumpIfInventory("WeaponZoomedToken",1,"ReadyZoomed")
		"####" C 1 A_WeaponReady
		"####" C 0 A_JumpIfInventory("WeaponZoomedToken",1,"ReadyZoomed")
		"####" C 1 A_WeaponReady
		"####" D 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		"####" D 0 A_JumpIfInventory("WeaponZoomedToken",1,"ReadyZoomed")
		"####" D 1 A_WeaponReady
		"####" D 0 A_JumpIfInventory("WeaponZoomedToken",1,"ReadyZoomed")
		"####" D 1 A_WeaponReady
		"####" D 0 A_JumpIfInventory("WeaponZoomedToken",1,"ReadyZoomed")
		"####" D 1 A_WeaponReady
		"####" D 0 A_JumpIfInventory("WeaponZoomedToken",1,"ReadyZoomed")
		"####" D 1 A_WeaponReady
		"####" E 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		"####" E 0 A_JumpIfInventory("WeaponZoomedToken",1,"ReadyZoomed")
		"####" E 1 A_WeaponReady
		"####" E 0 A_JumpIfInventory("WeaponZoomedToken",1,"ReadyZoomed")
		"####" E 1 A_WeaponReady
		"####" E 0 A_JumpIfInventory("WeaponZoomedToken",1,"ReadyZoomed")
		"####" E 1 A_WeaponReady
		"####" E 0 A_JumpIfInventory("WeaponZoomedToken",1,"ReadyZoomed")
		"####" E 1 A_WeaponReady
		"####" F 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		"####" F 0 A_JumpIfInventory("WeaponZoomedToken",1,"ReadyZoomed")
		"####" F 1 A_WeaponReady
		"####" F 0 A_JumpIfInventory("WeaponZoomedToken",1,"ReadyZoomed")
		"####" F 1 A_WeaponReady
		"####" F 0 A_JumpIfInventory("WeaponZoomedToken",1,"ReadyZoomed")
		"####" F 1 A_WeaponReady
		"####" F 0 A_JumpIfInventory("WeaponZoomedToken",1,"ReadyZoomed")
		"####" F 1 A_WeaponReady
		Loop

	ReadyZoomed:
		TNT1 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		TNT1 A 0 A_JumpIfInventory("WeaponZoomedToken",-1,"Ready")
		TNT1 A 1 A_WeaponReady
		Loop

		ReadyCantFire:
			"####" A 0 A_StopSound(5)
			"####" A 0 A_ZoomFactor(1.0)
			"####" A 0 A_TakeInventory("WeaponZoomedToken",32767)
		RCFLooper:
			"####" A 4 A_WeaponReady(WRF_NOFIRE)
			"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"RCFLooper")
			Goto Ready



	//-----------------------
	// Fire Seq
	//-----------------------
	Fire:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		"####" A 0 A_JumpIfInventory("WeaponZoomedToken",1,"FireZoomed")
		"####" A 0 A_GunFlash("Flash")
		Goto Recharge1

	//-----------------------
	// Post Fire Seq
	//-----------------------
	Recharge1:
		"####" G 0
		"####" G 0 A_JumpIfInventory("WeaponZoomedToken",1,"ZoomIn")
		"####" G 0 A_GiveInventory("SniperRifleTicCounter",1)
		"####" G 1 A_WeaponReady(WRF_NOBOB|WRF_NOPRIMARY|WRF_NOSWITCH)
	Recharge2:
		"####" G 0 Offset(9,41)
		"####" G 0 A_JumpIfInventory("WeaponZoomedToken",1,"ZoomIn")
		"####" G 0 A_GiveInventory("SniperRifleTicCounter",1)
		"####" G 1 A_WeaponReady(WRF_NOBOB|WRF_NOPRIMARY|WRF_NOSWITCH)
	Recharge3:
