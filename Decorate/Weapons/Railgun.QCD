// --------------------------------------------------------------------------
//	For competitive DM, weapons dont autoaim
// --------------------------------------------------------------------------
Actor QCRailGunDM : QCRailGun
{
	+WEAPON.NOAUTOAIM
	+CHEATNOTWEAPON
	Tag "$TAG_UTLightningGun"
	Weapon.AmmoGive1 15
	Weapon.AmmoDmScale 1.0
	Weapon.AmmoDmRefill 1

	States
	{
	FlashNoCharge:
		TNT1 A 0 A_RailAttack(70, 4, true, None, None, RGF_SILENT|RGF_NOPIERCING|RGF_FULLBRIGHT, 0, "LightningGunPuff_DM", 0, 0, 0, 0, 15, 1, "LaserKraftTrail", -2)
		Goto FlashCheckSound
	FlashVeryLowCharge:
		TNT1 A 0 A_RailAttack(80, 4, true, None, None, RGF_SILENT|RGF_NOPIERCING|RGF_FULLBRIGHT, 0, "LightningGunPuff_DM", 0, 0, 0, 0, 15, 1, "LaserKraftTrail", -2)
		Goto FlashCheckSound
	FlashLowCharge:
		TNT1 A 0 A_RailAttack(90, 4, true, None, None, RGF_SILENT|RGF_NOPIERCING|RGF_FULLBRIGHT, 0, "LightningGunPuff_DM", 0, 0, 0, 0, 15, 1, "LaserKraftTrail", -2)
		Goto FlashCheckSound
	FlashMidCharge:
		TNT1 A 0 A_RailAttack(100, 4, true, None, None, RGF_SILENT|RGF_NOPIERCING|RGF_FULLBRIGHT, 0, "LightningGunPuff_DM", 0, 0, 0, 0, 15, 1, "LaserKraftTrail", -2)
		Goto FlashCheckSound
	FlashHighCharge:
		TNT1 A 0 A_RailAttack(110, 4, true, None, None, RGF_SILENT|RGF_NOPIERCING|RGF_FULLBRIGHT, 0, "LightningGunPuff_DM", 0, 0, 0, 0, 15, 1, "LaserKraftTrail", -2)
		Goto FlashCheckSound
	FlashVeryHighCharge:
		TNT1 A 0 A_RailAttack(120, 4, true, None, None, RGF_SILENT|RGF_NOPIERCING|RGF_FULLBRIGHT, 0, "LightningGunPuff_DM", 0, 0, 0, 0, 15, 1, "LaserKraftTrail", -2)
		Goto FlashCheckSound
	}
}

// --------------------------------------------------------------------------
//	Effects
// --------------------------------------------------------------------------

Actor LightningGunPuff
{
	+CLIENTSIDEONLY +NONETID
	+NOINTERACTION +NOTONAUTOMAP
	+ALWAYSPUFF
	+PUFFGETSOWNER
	+PUFFONACTORS
	+MTHRUSPECIES
	Radius 10
	Scale 0.35
	Renderstyle Add
	Obituary "$OB_UTLightningGun"
	+FORCEXYBILLBOARD
	+DONTSPLASH
	DamageType "Electric"
	States
	{
	Spawn:	//hit non bleeding actor
		TNT1 A 0
		TNT1 A 0 A_PlaySound("UTDE/Weapons/LightningGun/Impact",CHAN_AUTO,1,0,1)
		TNT1 A 0 A_GiveToTarget("HitBeepBig",1)
		Goto Crash
	Xdeath:	//hit bleeding actor
		TNT1 A 0
		TNT1 A 0 A_PlaySound("UTDE/Weapons/LightningGun/Impact",CHAN_AUTO,1,0,1)
		TNT1 A 0 A_GiveToTarget("HitBeepBig",1)
		TNT1 A 1
		Stop
	Crash:
		TNT1 A 0 A_PlaySound("UTDE/Weapons/LightningGun/Impact",CHAN_AUTO,1,0,1)
		TNT1 A 0 A_JumpIf(waterlevel > 0, "Water")
		TNT1 A 0 A_SpawnItemEx("LaserPuffFx", 0,0,0, 0,0,0, 0,SXF_NOCHECKPOSITION)
		Stop
	Choose:
		TNT1 A 100
		Stop
	Water:
		TNT1 A 0 A_SpawnItemEx("WaterLightningSparks", 0,0,0, 0,0,0,0, SXF_NOCHECKPOSITION,160)
		TNT1 A 100 A_Explode(waterlevel * 16, waterlevel * 64)
		Stop
	}
}

Actor LightningGunPuff_DM : LightningGunPuff
{
	-MTHRUSPECIES
}

Actor RG_UG_Pierce : Token {}
Actor RG_UG_Explosive : Token {}