Actor CompatVer31_Railgun {} // for compatibility checks

Actor RailgunPickup : CustomInventory 15607
{
	//$NotAngled
	//$Category "QCDE Weapons"
	//$Color 14
	//$Title "Sniper Rifle"
	Height 48
	Radius 20
	Scale 0.63
	Inventory.PickupSound "QC/Items/WeaponPick"
	Inventory.PickupMessage "$GOT_UTSniperRifle"
	Tag "$TAG_UTSniperRifle"
	Inventory.RespawnTics 35
	States
	{
	Spawn:
		UTSP Y 35 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		Goto Idle
	DMSpawn:
		"####" "#" 0 A_ChangeFlag("DROPPED", 0)
		UTSP Z 0 ACS_NamedExecuteWithResult("QCDE_WeaponSpawned",20,args[4])
		UTSP Z -1 Bright A_SetArg(4, 0)
		Stop
	Idle:
		UTSP Y 0 ACS_NamedExecuteWithResult("QCDE_WeaponSpawned",19,args[4])
		UTSP Y -1 A_SetArg(4, 0)
		Wait
	Pickup:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMPickup")
		//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"WeaponStay")
		TNT1 A 0 A_GiveInventory("QCRailgun")
		TNT1 A 0
		Stop
	DMPickup:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"DMWeaponStay")
		TNT1 A 0 A_GiveInventory("QCRailgunDM")
		TNT1 A 0
		TNT1 A 0 A_TakeInventory("QCRailgun")
		TNT1 A 0
		Stop
	WeaponStay:
		TNT1 A 0 A_JumpIfInventory("QCRailgun",1,"Stay")
		TNT1 A 0 A_SpawnItemEx("QCRailgun", velx,vely,velz, velx,vely,velz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Fail
	DMWeaponStay:
		TNT1 A 0 A_TakeInventory("QCRailgun")
		TNT1 A 0 A_JumpIfInventory("QCRailgunDM",1,"Stay")
		TNT1 A 0 A_SpawnItemEx("QCRailgunDM", velx,vely,velz, velx,vely,velz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Fail
	Stay:
		TNT1 A 0
		Fail
	HideIndefinitely:
		TNT1 A 1 A_SetTics(CallACS("QCDE_SetWeaponRespawnTics"))
		Goto Super::HideDoomish+1
	HideDoomish:
		TNT1 A 1
		TNT1 A 1 A_SetTics(CallACS("QCDE_SetWeaponRespawnTics"))
		Goto Super::HideDoomish+1
	}
}

Actor RailgunPickupNoGravity : RailgunPickup 15617
{
	//$Category "QCDE Weapons (No Gravity)"
	//$Title "Sniper Rifle (No Gravity)"
	+NOGRAVITY
}


Actor QCRailGun : QCWeapon
{
	Height 48
	+FLOORCLIP
	+INVENTORY.IGNORESKILL
	+WEAPON.NOALERT
	+WEAPON.NOALTAUTOFIRE
	+WEAPON.NOAUTOAIM	//rails never autoaim, but this needed for effects and sound spawners
	Weapon.SwaySpeed 2.7
	Weapon.AmmoType1 "QCSlugAmmo"
	Weapon.AmmoGive1 10
	Weapon.AmmoUse1 1
	Weapon.SelectionOrder 1400
	Inventory.PickupMessage "$GOT_UTSniperRifle"
	Tag "$TAG_UTSniperRifle"
	Obituary "$OB_UTSniperRifle"
	Decal "BulletChip"
	Scale 0.63
	Weapon.KickBack 90
	States
	{
	Spawn:
		TNT1 A 1
		UTSP Y 35 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		Goto Idle
	DMSpawn:
		UTSP ZZZZZZZZZZZZZZZ 35 Bright
		Stop
	Idle:
		UTSP Y -1
		Wait
	//-----------------------
	// Select/Deselect Seq
	//-----------------------
	Select:
		UTSP A 0 ACS_NamedExecuteWithResult("UTDE_StationarySniperUpgrade",0,0,0,0)
		UTSP A 0 A_JumpIfInventory("NoWeaponFireToken",1,2)
		UTSP A 0 A_PlaySound("QC/Weapons/Switch",CHAN_5,1,0,3) //Not in Weapon.UpSound because it interrupts CHAN_WEAPON sounds
		UTSP A 0 A_StopSound(CHAN_WEAPON) //stops any weapon looping sound
		TNT1 A 0 A_ZoomFactor(1.0) //for when you exited the level zoomed, upon entering new level, resets zoom here
		"####" "#" 0 A_TakeInventory("WeaponZoomedToken",32767)
	SelectLooper:
		UTSP A 1 A_Raise
		TNT1 AAA 0 A_Raise
		Loop

	Deselect:
		TNT1 A 0 A_StopSound(5) //idle sound
		"####" "#" 0 A_ZoomFactor(1.0)
		"####" "#" 0 A_TakeInventory("WeaponZoomedToken",32767)
	DeselectLooper:
		UTSP A 1 A_Lower
		TNT1 AAA 0 A_Lower
		Loop

	//-----------------------
	// Ready Seq
	//-----------------------
	Ready:
		TNT1 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		TNT1 A 0 A_JumpIfInventory("WeaponZoomedToken",1,"ReadyZoomed")
		UTSP A 1 A_WeaponReady
		Loop

	ReadyZoomed:
		TNT1 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		TNT1 A 0 A_JumpIfInventory("WeaponZoomedToken",-1,"Ready")
		TNT1 A 1 A_WeaponReady
		Loop

		ReadyCantFire:
			UTSP A 0 A_StopSound(5)
			TNT1 A 0 A_ZoomFactor(1.0)
			TNT1 A 0 A_TakeInventory("WeaponZoomedToken",32767)
		RCFLooper:
			UTSP A 4 A_WeaponReady(WRF_NOFIRE)
			UTSP A 0 A_JumpIfInventory("NoWeaponFireToken",1,"RCFLooper")
			Goto Ready



	//-----------------------
	// Fire Seq
	//-----------------------
	Fire:
		TNT1 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		TNT1 A 0 A_JumpIfInventory("WeaponZoomedToken",1,"FireZoomed")
		UTSP A 0 A_GunFlash("Flash")
		Goto Recharge1

	//-----------------------
	// Post Fire Seq
	//-----------------------
	Recharge1:
		UTSP B 0
		UTSP B 0 A_JumpIfInventory("WeaponZoomedToken",1,"ZoomIn")
		UTSP B 0 A_GiveInventory("SniperRifleTicCounter",1)
		UTSP B 1 A_WeaponReady(WRF_NOBOB|WRF_NOPRIMARY|WRF_NOSWITCH)
	Recharge2:
		UTSP B 0 Offset(9,41)
		UTSP B 0 A_JumpIfInventory("WeaponZoomedToken",1,"ZoomIn")
		UTSP B 0 A_GiveInventory("SniperRifleTicCounter",1)
		UTSP B 1 A_WeaponReady(WRF_NOBOB|WRF_NOPRIMARY|WRF_NOSWITCH)
	Recharge3:
		UTSP B 0 Offset(12,44)
		UTSP B 0 A_JumpIfInventory("WeaponZoomedToken",1,"ZoomIn")
		UTSP B 0 A_GiveInventory("SniperRifleTicCounter",1)
		UTSP B 1 A_WeaponReady(WRF_NOBOB|WRF_NOPRIMARY|WRF_NOSWITCH)
	Recharge4:
		UTSP C 0 Offset(14,46)
		UTSP C 0 A_JumpIfInventory("WeaponZoomedToken",1,"ZoomIn")
		UTSP C 0 A_GiveInventory("SniperRifleTicCounter",1)
		UTSP C 1 A_WeaponReady(WRF_NOBOB|WRF_NOPRIMARY|WRF_NOSWITCH)
	Recharge5:
		UTSP D 0 Offset(15,47)
		UTSP D 0 A_JumpIfInventory("WeaponZoomedToken",1,"ZoomIn")
		UTSP D 0 A_GiveInventory("SniperRifleTicCounter",1)
		UTSP D 1 A_WeaponReady(WRF_NOBOB|WRF_NOPRIMARY|WRF_NOSWITCH)
	Recharge6:
		UTSP E 0 Offset(16,48)
		UTSP E 0 A_JumpIfInventory("WeaponZoomedToken",1,"ZoomIn")
		UTSP E 0 A_GiveInventory("SniperRifleTicCounter",1)
		UTSP E 1 A_WeaponReady(WRF_NOBOB|WRF_NOPRIMARY|WRF_NOSWITCH)
