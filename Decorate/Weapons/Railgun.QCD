		TNT1 A 0 Offset(1,33)
		TNT1 A 0 A_GiveInventory("LightningGunTicCounter",1)
		TNT1 A 1 A_WeaponReady(WRF_NOBOB|WRF_NOPRIMARY|WRF_NOSWITCH)

		TNT1 A 0 A_TakeInventory("LightningGunTicCounter",32767)
		Goto ReadyZoomed

	Flash:
		TNT1 A 0 A_AlertMonsters
		
		// 120 damage, 52 charges
		TNT1 A 0 A_JumpIfInventory("RailgunCharges",52,"FlashVeryHighCharge")
		
		// 110 damage, 41-51 charges
		TNT1 A 0 A_JumpIfInventory("RailgunCharges",51,"FlashHighCharge")
