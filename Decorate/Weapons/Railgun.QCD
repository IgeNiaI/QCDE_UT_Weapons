	FlashEnder:
		TNT1 A 0 A_FireCustomMissile("RailgunWhoosher",0,false,1,5,FPF_NOUNLAGGED|FPF_SKIPOWNER,0)
		TNT1 A 0 A_JumpIfInventory("WepNoFlashToken",1,"FlashEnderCont")
