		TNT1 A 0 A_GiveInventory("SniperRifleTicCounter",1)
		TNT1 A 1 A_WeaponReady(WRF_NOBOB|WRF_NOPRIMARY|WRF_NOSWITCH)
	RechargeZoomed51:
		TNT1 A 0 Offset(2,34)
		TNT1 A 0 A_JumpIfInventory("WeaponZoomedToken",-1,"ZoomOut")
		TNT1 A 0 A_GiveInventory("SniperRifleTicCounter",1)
		TNT1 A 1 A_WeaponReady(WRF_NOBOB|WRF_NOPRIMARY|WRF_NOSWITCH)
	RechargeZoomed52:
		TNT1 A 0 Offset(1,33)
		TNT1 A 0 A_JumpIfInventory("WeaponZoomedToken",-1,"ZoomOut")
		TNT1 A 0 A_GiveInventory("SniperRifleTicCounter",1)
		TNT1 A 1 A_WeaponReady(WRF_NOBOB|WRF_NOPRIMARY|WRF_NOSWITCH)

		TNT1 A 0 A_TakeInventory("SniperRifleTicCounter",32767)
		Goto ReadyZoomed

	Flash:
		TNT1 A 0 A_JumpIfInventory("RG_UG_Pierce",1,"FlashCont")
		TNT1 A 0 A_AlertMonsters
	FlashCont:
		TNT1 A 0 A_JumpIfInventory("RailgunCharges",52,"FlashUpgraded")
		TNT1 A 0 A_JumpIfInventory("WeaponZoomedToken",1,"FlashZoomed")
		TNT1 A 0 A_JumpIfInventory("UTSniperRifleSkin", 4, "FlashCont.Default")
		TNT1 A 0 A_JumpIfInventory("UTSniperRifleSkin", 3, "FlashCont.UT2003")
	FlashCont.Default:
		TNT1 A 0 A_RailAttack(random(300,400), 1, true, None, None, RGF_SILENT|RGF_NOPIERCING|RGF_FULLBRIGHT|RGF_EXTRATRAIL, 0, "SniperRiflePuff", 0, 0, 0, 0, 6, 1, "SniperTrail", 1)
		TNT1 A 0 A_FireCustomMissile("SniperSmokeSpawner",0, false,3,2)
		Goto FlashCheckSound
	FlashCont.UT2003:
		TNT1 A 0 A_RailAttack(random(300,400), 4, true, None, None, RGF_SILENT|RGF_NOPIERCING|RGF_FULLBRIGHT, 0, "UTLGPuff", 0, 0, 0, 0, 20.0, 1.0, "LaserKraftTrail", -2)
		Goto FlashCheckSound

	FlashZoomed:
		TNT1 A 0 A_JumpIfInventory("UTSniperRifleSkin", 4, "FlashZoomed.Default")
		TNT1 A 0 A_JumpIfInventory("UTSniperRifleSkin", 3, "FlashZoomed.UT2003")
	FlashZoomed.Default:
		TNT1 A 0 A_RailAttack(random(300,400), 0, true, None, None, RGF_SILENT|RGF_NOPIERCING|RGF_FULLBRIGHT|RGF_EXTRATRAIL, 0, "SniperRiflePuff", 0, 0, 0, 0, 6, 1, "SniperTrail", 1)
		TNT1 A 0 A_FireCustomMissile("SniperSmokeSpawner",0, false,0,2)
		Goto FlashCheckSound
	FlashZoomed.UT2003:
		TNT1 A 0 A_RailAttack(random(300,400), 0, true, None, None, RGF_SILENT|RGF_NOPIERCING|RGF_FULLBRIGHT, 0, "UTLGPuff", 0, 0, 0, 0, 20.0, 1.0, "LaserKraftTrail", 1)
		Goto FlashCheckSound

	FlashUpgraded:
		TNT1 A 0 A_JumpIfInventory("WeaponZoomedToken",1,"FlashZoomedUpgraded")
		TNT1 A 0 A_JumpIfInventory("UTSniperRifleSkin", 4, "FlashUpgraded.Default")
		TNT1 A 0 A_JumpIfInventory("UTSniperRifleSkin", 3, "FlashUpgraded.UT2003")
	FlashUpgraded.Default:
		TNT1 A 0 A_RailAttack(random(600,800), 1, true, None, None, RGF_SILENT|RGF_NOPIERCING|RGF_FULLBRIGHT|RGF_EXTRATRAIL, 0, "SniperRiflePuff", 0, 0, 0, 0, 6, 1, "SniperTrailUpgraded", 1)
		TNT1 A 0 A_FireCustomMissile("SniperSmokeSpawner",0, false,3,2)
		Goto FlashCheckSound
	FlashUpgraded.UT2003:
		TNT1 A 0 A_RailAttack(random(600,800), 4, true, None, None, RGF_SILENT|RGF_NOPIERCING|RGF_FULLBRIGHT, 0, "UTLGPuff", 0, 0, 0, 0, 20.0, 1.0, "LaserKraftTrail", -2)
		Goto FlashCheckSound

	FlashZoomedUpgraded:
		TNT1 A 0 A_JumpIfInventory("UTSniperRifleSkin", 4, "FlashZoomedUpgraded.Default")
		TNT1 A 0 A_JumpIfInventory("UTSniperRifleSkin", 3, "FlashZoomedUpgraded.UT2003")
	FlashZoomedUpgraded.Default:
		TNT1 A 0 A_RailAttack(random(600,800), 0, true, None, None, RGF_SILENT|RGF_NOPIERCING|RGF_FULLBRIGHT|RGF_EXTRATRAIL, 0, "SniperRiflePuff", 0, 0, 0, 0, 6, 1, "SniperTrailUpgraded", 1)
		TNT1 A 0 A_FireCustomMissile("SniperSmokeSpawner",0, false,0,2)
		Goto FlashCheckSound
	FlashZoomedUpgraded.UT2003:
		TNT1 A 0 A_RailAttack(random(600,800), 0, true, None, None, RGF_SILENT|RGF_NOPIERCING|RGF_FULLBRIGHT, 0, "UTLGPuff", 0, 0, 0, 0, 20.0, 1.0, "LaserKraftTrail", 1)
		Goto FlashCheckSound

	FlashCheckSound:
		TNT1 A 0 A_TakeInventory("RailgunCharges",32767)
		TNT1 A 0 A_JumpIfInventory("RG_UG_Pierce",1,"QuietSound")
		TNT1 A 0 A_JumpIfInventory("PowerQuad",1,"QuadSound")
		TNT1 A 0 A_JumpIfInventory("PowerTerminatorArtifact",1,"QuadSound")
		Goto NormalSound

		NormalSound:
			TNT1 A 0 A_JumpIfInventory("UTSniperRifleSkin", 9, "NormalSound.UT99")
			TNT1 A 0 A_JumpIfInventory("UTSniperRifleSkin", 6, "NormalSound.UC2")
			TNT1 A 0 A_JumpIfInventory("UTSniperRifleSkin", 4, "NormalSound.UT2004")
			TNT1 A 0 A_JumpIfInventory("UTSniperRifleSkin", 3, "NormalSound.UT2003")
			TNT1 A 0 A_JumpIfInventory("UTSniperRifleSkin", 1, "NormalSound.U1")
		NormalSound.U1:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/SniperRifle/Fire_U1",CHAN_WEAPON)
			Goto FlashEnder
		NormalSound.UT2003:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/SniperRifle/Fire_UT2003",CHAN_WEAPON)
			Goto FlashEnder
		NormalSound.UT2004:
