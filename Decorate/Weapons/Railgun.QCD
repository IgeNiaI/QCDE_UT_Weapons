	FlashNoCharge:
		TNT1 A 0 A_RailAttack(random(275,330), 4, true, None, None, RGF_SILENT|RGF_NOPIERCING|RGF_FULLBRIGHT, 0, "LightningGunPuff", 0, 0, 0, 0, 15, 1, "LaserKraftTrail", -2)
		Goto FlashCheckSound
	FlashVeryLowCharge:
		TNT1 A 0 A_RailAttack(random(310,375), 4, true, None, None, RGF_SILENT|RGF_NOPIERCING|RGF_FULLBRIGHT, 0, "LightningGunPuff", 0, 0, 0, 0, 15, 1, "LaserKraftTrail", -2)
		Goto FlashCheckSound
	FlashLowCharge:
		TNT1 A 0 A_RailAttack(random(345,410), 4, true, None, None, RGF_SILENT|RGF_NOPIERCING|RGF_FULLBRIGHT, 0, "LightningGunPuff", 0, 0, 0, 0, 15, 1, "LaserKraftTrail", -2)
		Goto FlashCheckSound
	FlashMidCharge:
		TNT1 A 0 A_RailAttack(random(370,465), 4, true, None, None, RGF_SILENT|RGF_NOPIERCING|RGF_FULLBRIGHT, 0, "LightningGunPuff", 0, 0, 0, 0, 15, 1, "LaserKraftTrail", -2)
		Goto FlashCheckSound
	FlashHighCharge:
		TNT1 A 0 A_RailAttack(random(415,510), 4, true, None, None, RGF_SILENT|RGF_NOPIERCING|RGF_FULLBRIGHT, 0, "LightningGunPuff", 0, 0, 0, 0, 15, 1, "LaserKraftTrail", -2)
		Goto FlashCheckSound
	FlashVeryHighCharge:
		TNT1 A 0 A_RailAttack(random(450,555), 4, true, None, None, RGF_SILENT|RGF_NOPIERCING|RGF_FULLBRIGHT, 0, "LightningGunPuff", 0, 0, 0, 0, 15, 1, "LaserKraftTrail", -2)
		Goto FlashCheckSound
			
	FlashCheckSound:
		TNT1 A 0 A_TakeInventory("RailgunCharges",32767)
		TNT1 A 0 A_JumpIfInventory("PowerQuad",1,"QuadSound")
		Goto NormalSound
		
		NormalSound:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/LightningGun/Fire",CHAN_WEAPON)
			Goto FlashEnder
		QuadSound:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/LightningGun/Quad/Fire",CHAN_WEAPON)
			Goto FlashEnder
			
	FlashEnder:
		TNT1 A 0 A_JumpIfInventory("WepNoRecoilToken",1,"FlashEnderNoRecoil")
		TNT1 A 0 A_SetPitch(pitch-3.5)
		TNT1 A 2
		TNT1 AAAAAAA 1 A_SetPitch(pitch+0.5)
		Stop
	FlashEnderNoRecoil:
		TNT1 A 1
		Stop

	//-----------------------
	// AltFire Seq (Zoom)
	//-----------------------
	AltFire: 	//27 tics, 0.77sec
		TNT1 A 0 A_JumpIfInventory("WeaponZoomedToken",1,"ZoomOut")
		Goto ZoomIn
	
