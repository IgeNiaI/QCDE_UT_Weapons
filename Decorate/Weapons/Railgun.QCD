	inventory.interhubamount 0
}

Actor RailgunCharges : Inventory
{
	+SERVERNETID
	Inventory.MaxAmount 52
	Inventory.InterHubAmount 0
}

// --------------------------------------------------------------------------
//	For competitive DM, weapons dont autoaim
// --------------------------------------------------------------------------
Actor QCRailGunDM : QCRailGun
{
	+WEAPON.NOAUTOAIM
	+CHEATNOTWEAPON
	Tag "$TAG_UTSniperRifle"
	Weapon.AmmoGive1 15
	Weapon.AmmoDmScale 1.0
	Weapon.AmmoDmRefill 1

	States
	{
	Flash:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_JumpIfInventory("WeaponZoomedToken",1,"FlashZoomed")
		TNT1 A 0 A_JumpIfInventory("UTSniperRifleSkin", 4, "Flash.Default")
		TNT1 A 0 A_JumpIfInventory("UTSniperRifleSkin", 3, "Flash.UT2003")
	Flash.Default:
		TNT1 A 0 A_RailAttack(90, 1, true, None, None, RGF_SILENT|RGF_NOPIERCING|RGF_FULLBRIGHT|RGF_EXTRATRAIL, 0, "SniperRiflePuff_DM", 0, 0, 0, 0, 6, 1, "SniperTrail", 1)
		TNT1 A 0 A_FireCustomMissile("SniperSmokeSpawner",0, false,3,2)
		Goto FlashCheckSound
	Flash.UT2003:
		TNT1 A 0 A_RailAttack(90, 4, true, None, None, RGF_SILENT|RGF_NOPIERCING|RGF_FULLBRIGHT, 0, "UTLGPuffDM", 0, 0, 0, 0, 20.0, 1.0, "LaserKraftTrail", -2)
		Goto FlashCheckSound

	FlashZoomed:
		TNT1 A 0 A_JumpIfInventory("UTSniperRifleSkin", 4, "FlashZoomed.Default")
		TNT1 A 0 A_JumpIfInventory("UTSniperRifleSkin", 3, "FlashZoomed.UT2003")
	FlashZoomed.Default:
		TNT1 A 0 A_RailAttack(90, 0, true, None, None, RGF_SILENT|RGF_NOPIERCING|RGF_FULLBRIGHT|RGF_EXTRATRAIL, 0, "SniperRiflePuff_DM", 0, 0, 0, 0, 6, 1, "SniperTrail", 1)
		TNT1 A 0 A_FireCustomMissile("SniperSmokeSpawner",0, false,0,2)
		Goto FlashCheckSound
	FlashZoomed.UT2003:
		TNT1 A 0 A_RailAttack(90, 0, true, None, None, RGF_SILENT|RGF_NOPIERCING|RGF_FULLBRIGHT, 0, "UTLGPuffDM", 0, 0, 0, 0, 20.0, 1.0, "LaserKraftTrail", 1)
		Goto FlashCheckSound
	}
}

// --------------------------------------------------------------------------
//	Effects
// --------------------------------------------------------------------------

Actor SniperTrail
{
	+NOINTERACTION +NOTONAUTOMAP
	+FORCEXYBILLBOARD
	+CLIENTSIDEONLY +NONETID
	RenderStyle Add
	Scale 0.07
	States
	{
	Spawn:
		RTSS A 0
		Goto FadeOut
	FadeOut:
		"####" "#" 1 BRIGHT A_FadeOut(0.03)
		Loop
	}
}

Actor SniperTrailUpgraded : SniperTrail
{
	States
	{
	Spawn:
		RTQW A 0
		Goto FadeOut
	}
}

Actor SniperRiflePuff
{
	+NONETID
	+NOINTERACTION +NOTONAUTOMAP
	+ALWAYSPUFF
	+PUFFGETSOWNER
	+PUFFONACTORS
	+MTHRUSPECIES
	Radius 10
	Obituary "$OB_UTSniperRifle"
	+FORCEXYBILLBOARD
	+DONTSPLASH
	Decal "BulletChip"
	States
	{
	Spawn:	//hit non bleeding actor
		TNT1 A 0 NODELAY A_PlaySound("QC/Weapons/Railgun/Impact",CHAN_AUTO,1,0,1)
		TNT1 A 0 A_GiveToTarget("HitBeepBig",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		Goto Crash
	Xdeath:	//hit bleeding actor
		TNT1 A 0
		TNT1 A 0 A_PlaySound("QC/Weapons/Railgun/Impact",CHAN_AUTO,1,0,1)
		TNT1 A 0 A_GiveToTarget("HitBeepBig",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		TNT1 A 1
		Stop
	Crash:
		TNT1 A 0 A_PlaySound("QC/Weapons/Railgun/Impact",CHAN_AUTO,1,0,1)
		TNT1 A 0 A_SpawnItemEx("SniperPuffFx", 0,0,0, 0,0,0, 0,SXF_NOCHECKPOSITION)
		TNT1 A 1
		Stop
	}
}

Actor SniperRiflePuff_DM : SniperRiflePuff
{
	-MTHRUSPECIES
	States
	{
	Spawn:	//hit non bleeding actor, and we don't want to play hit sound in DM
		TNT1 A 0 NODELAY A_PlaySound("QC/Weapons/Railgun/Impact",CHAN_AUTO,1,0,1)
		Goto Crash
	}
}

Actor SniperPuffFx : QCBulletPuff
{
	+NOINTERACTION +NOTONAUTOMAP
	+CLIENTSIDEONLY +NONETID
	+PUFFGETSOWNER
	+PUFFONACTORS
	+FORCEXYBILLBOARD
	+MTHRUSPECIES
	+DONTSPLASH
	Renderstyle Add
	Scale 0.70
	States
	{
	Spawn:
		TNT1 A 0 NODELAY A_Jump(256,"Type1","Type2","Type3")
	Type1:
		DB63 A 0
		Goto EndAnimation
	Type2:
		DB64 A 0
		Goto EndAnimation
	Type3:
		DB65 A 0
		Goto EndAnimation

	EndAnimation:
		"####" ABCDEFGHIJKLMNOPQRSTUVWXYZ 1 Bright
		Stop
	}
}

Actor SniperSmokeSpawner
{
	Radius 1
	Height 1
	Speed 14
	PROJECTILE
	+NOTIMEFREEZE
	+CLIENTSIDEONLY +NONETID
	States
	{
	Spawn:
		TNT1 A 1
		TNT1 A 0 A_Die
		Goto Death
	Death:
		TNT1 AAA 0 A_SpawnItemEx("MachinegunSmoke",0,random(1,-1),0,0,0,frandom(0.1,0.25),0,32)
		TNT1 A 2
		Stop
	}
}

Actor UTLGPuff
{
	+CLIENTSIDEONLY +NONETID
	+NOINTERACTION
	+ALWAYSPUFF
	+PUFFGETSOWNER
	+EXTREMEDEATH
	+FORCEXYBILLBOARD
	+MTHRUSPECIES
	States
	{
	Spawn:	//hit non bleeding actor
		TNT1 A 0
		TNT1 A 0 A_GiveToTarget("HitBeepBig",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		Goto Crash
	Xdeath:	//hit bleeding actor
		TNT1 A 0
		TNT1 A 0 A_GiveToTarget("HitBeepBig",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		TNT1 A 1
		Stop
	Crash:
		TNT1 A 0 A_PlaySound("UTDE/Weapons/SniperRifle/Impact_UT2003")
		TNT1 A 0 A_SpawnItemEx("LaserPuffFx", 0,0,0, 0,0,0, 0,SXF_NOCHECKPOSITION)
		TNT1 A 10
		Stop
	}
}

Actor UTLGPuffDM : UTLGPuff
{
	-MTHRUSPECIES
}

Actor RailgunWhoosher : FastProjectile
{
	Projectile
	+DONTSPLASH
	+NOEXTREMEDEATH
	+SERVERNETID
	damage 0
	radius 2
	height 2
	speed 125
	renderstyle ADD
	alpha 0.9
	scale 0.13
	states
	{
	Spawn:
		TRAC A 1
		TRAC A 70 BRIGHT A_PlaySound("QC/Weapons/Railgun/Whoosh",CHAN_5,1.0,false,3.0)
		Stop
	Death:
		TNT1 A 1 A_StopSound(CHAN_5)
		Stop
	XDeath:
		TNT1 A 1 A_StopSound(CHAN_5)
		Stop
	}
}

