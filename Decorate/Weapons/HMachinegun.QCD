// --------------------------------------------------------------------------
//
// Minigun
// Pickup sprite by Pixo, weapon sprite by geNia
// Weapon code by geNia
//
// --------------------------------------------------------------------------

Actor HeavyMachinegunPickup : CustomInventory 15600
{
	//$NotAngled
	//$Category "QCDE Weapons"
	//$Color 14
	//$Title "Minigun"
	Height 48
	Radius 20
	Scale 0.64
	Inventory.PickupMessage "$GOT_UTMinigun"
	Inventory.PickupSound "QC/Items/WeaponPick"
	Inventory.RespawnTics 175
	Tag "$TAG_UTMinigun"
	States
	{
	Spawn:
		UTMG Y 35 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		UTMG Y 35 A_CheckFlag("DROPPED", "BecomeWeaponItself")
		Goto Idle
	DMSpawn:
		"####" "#" 0 A_ChangeFlag("DROPPED", 0)
		UTMG Z -1 Bright ACS_NamedExecuteWithResult("QCDE_WeaponSpawned",8,args[4])
		Stop
	
	BecomeWeaponItself:
		TNT1 A 0 A_SpawnItemEx("QCHeavyMachinegun")
		TNT1 A 0 A_JumpIf(true, "End") Goto Idle // <-- this is to fool client-side predictor
	End:TNT1 A 0
		Stop
		
	Idle:
		UTMG Y -1 ACS_NamedExecuteWithResult("QCDE_WeaponSpawned",7,args[4])
		Wait
	Pickup:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMPickup")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"WeaponStay")
		TNT1 A 0 A_GiveInventory("QCHeavyMachinegun")
		TNT1 A 0 A_TakeInventory("QCMachinegun")
		Stop
	DMPickup:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"DMWeaponStay")
		TNT1 A 0 A_GiveInventory("QCHeavyMachinegunDM")
		TNT1 A 0 A_TakeInventory("QCMachinegunDM")
		TNT1 A 0 A_TakeInventory("QCHeavyMachinegun")
		TNT1 A 0 A_TakeInventory("QCMachinegun")
		Stop
	WeaponStay:
		TNT1 A 0 A_JumpIfInventory("QCHeavyMachinegun",1,"Stay")
		TNT1 A 0 A_SpawnItemEx("QCHeavyMachinegun", velx,vely,velz, velx,vely,velz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Fail
	DMWeaponStay:
		TNT1 A 0 A_TakeInventory("QCHeavyMachinegun")
		TNT1 A 0 A_JumpIfInventory("QCHeavyMachinegunDM",1,"Stay")
		TNT1 A 0 A_SpawnItemEx("QCHeavyMachinegunDM", velx,vely,velz, velx,vely,velz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Fail
	Stay:
		TNT1 A 0
		Fail
	}
}

Actor QCHeavyMachinegun : QCWeapon
{
	Height 48
	Weapon.SwaySpeed 1.6
	Weapon.Kickback 20
	Weapon.SelectionOrder 1000
	Weapon.AmmoUse 1
	Weapon.AmmoUse2 1
	Weapon.AmmoGive 50
	Weapon.AmmoType "QCBulletAmmo"
	Weapon.AmmoType2 "QCBulletAmmo"
	Obituary "$OB_UTMinigun"
	Inventory.PickupMessage "$GOT_UTMinigun"
	Tag "$TAG_UTMinigun"
	Scale 0.64
	States
	{
	Spawn:
		UTMG Y 35 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		Goto Idle
	DMSpawn:
		UTMG ZZZZZZZZZZZZZZZ 35 Bright
		Stop
	Idle:
		UTMG Y -1
		Wait

	//-----------------------
	// Select/Deselect Seq
	//-----------------------
	Select:
		UTMG A 0 A_JumpIfInventory("NoWeaponFireToken",1,2)
		UTMG A 0 A_PlaySound("QC/Weapons/Switch",5,1,0,3) //Not in Weapon.UpSound because it interrupts CHAN_WEAPON sounds
		UTMG A 0 A_TakeInventory("QCMachinegunDM")
		UTMG A 0 A_TakeInventory("QCMachinegun")
		"####" "#" 0 A_StopSound(5) //stops any weapon looping sound
	SelectLooper:
		UTMG A 1 A_Raise
		"####" "###" 0 A_Raise
		Loop
		
	Deselect:
		UTMG A 0 A_StopSound(5)
		UTMG A 0 A_StopSound(CHAN_WEAPON)
	DeselectLooper:
		UTMG A 1 A_Lower
		"####" "###" 0 A_Lower
		Loop

	//-----------------------
	// Ready Seq
	//-----------------------
	Ready:
		UTMG A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		UTMG A 3 A_WeaponReady
		Loop
		
		ReadyCantFire:
			UTMG A 0 A_StopSound(5)
			UTMG A 0 A_StopSound(CHAN_WEAPON)
		RCFLooper:
			UTMG A 4 A_WeaponReady(WRF_NOFIRE)
			UTMG A 0 A_JumpIfInventory("NoWeaponFireToken",1,"RCFLooper")
			Goto Ready

	//-----------------------
	// Fire Seq
	//-----------------------
	Fire:
		TNT1 A 0 A_JumpIfInventory("PowerQuad",1,"FireQuadSound")
		Goto FireNormalSound
		
		FireNormalSound:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Minigun/FireStartLoop",CHAN_WEAPON,1,1)
			Goto FireLooper1
		FireQuadSound:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Minigun/Quad/FireStartLoop",CHAN_WEAPON,1,1)
			Goto FireLooper1

	FireLooper1:
		UTMG A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		UTMG B 0 A_GunFlash("Flash")
		UTMG B 1 Offset(2,35)
		UTMG C 1 Offset(2,34)
		UTMG D 1 Offset(1,33)
		UTMG A 1 Offset(1,33) A_ReFire("FireLooper2")
		Goto EndFireLooper1

	FireLooper2:
		UTMG A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		UTMG B 0 A_GunFlash("Flash")
		UTMG B 1 Offset(4,36)
		UTMG C 1 Offset(4,35)
		UTMG D 1 Offset(3,34)
		UTMG A 1 Offset(2,34) A_ReFire("FireLooper3")
		Goto EndFireLooper2

	FireLooper3:
		UTMG A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		UTMG B 0 A_GunFlash("Flash")
		UTMG B 1 Offset(5,38)
		UTMG C 1 Offset(5,37)
		UTMG D 1 Offset(4,36)
		UTMG A 1 Offset(4,36) A_ReFire("FireLooper3")
		Goto EndFireLooper3

	EndFireLooper1:
		UTMG E 1 A_PlaySound("UTDE/Weapons/Minigun/FireEnd",CHAN_WEAPON,1,0)
		UTMG EFGHIIJJAAEEEFFFGGGHHHHIIIIJJJJA 1 A_WeaponReady(WRF_NOBOB)
		Goto Ready
	EndFireLooper2:
		UTMG E 1 A_PlaySound("UTDE/Weapons/Minigun/FireEnd",CHAN_WEAPON,1,0)
		UTMG E 1 Offset(1,33)
		UTMG EFGHIIJJAAEEEFFFGGGHHHHIIIIJJJJA 1 A_WeaponReady(WRF_NOBOB)
		Goto Ready
	EndFireLooper3:
		UTMG E 1 A_PlaySound("UTDE/Weapons/Minigun/FireEnd",CHAN_WEAPON,1,0)
		UTMG E 1 Offset(2,35)
		UTMG F 1 Offset(1,33)
		UTMG EFGHIIJJAAEEEFFFGGGHHHHIIIIJJJJA 1 A_WeaponReady(WRF_NOBOB)
		Goto Ready

	//-----------------------
	// Attack doers
	//-----------------------
	Flash:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_FireBullets(1,1,1,random(10,15),"QCBulletPuff",FBF_NORANDOM|FBF_USEAMMO)
		Goto EndFlash
		
		EndFlash:
			TNT1 A 0 A_FireCustomMissile("BulletSmallTracer",frandom(1,-1),false,8,-3,0,frandom(1,-1))
			TNT1 A 0 A_FireCustomMissile("MinigunSmokeSpawner",0, false,7,2)
			TNT1 A 0 A_JumpIfInventory("WepNoRecoilToken",1,"EndFlashNoRecoil")
			TNT1 A 1 A_SetPitch(Pitch-0.8)
			TNT1 AA 1 A_SetPitch(Pitch+0.4)
			Stop
		EndFlashNoRecoil:
			TNT1 A 1
			Stop
			
	//-----------------------
	// Alt Fire Seq
	//-----------------------
	AltFire:
		TNT1 A 0 A_JumpIfInventory("PowerQuad",1,"AltFireQuadSound")
		Goto AltFireNormalSound
		
		AltFireNormalSound:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Minigun/FireStartLoop",CHAN_WEAPON,1,1)
			Goto AltFireLooper1
		AltFireQuadSound:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Minigun/Quad/FireStartLoop",CHAN_WEAPON,1,1)
			Goto AltFireLooper1
			
	AltFireFast:
		TNT1 A 0 A_JumpIfInventory("PowerQuad",1,"AltFireFastQuadSound")
		Goto AltFireFastNormalSound

		AltFireFastNormalSound:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Minigun/AltFireStartLoop",CHAN_WEAPON,1,1)
			Goto AltFireLooperFast
		AltFireFastQuadSound:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Minigun/Quad/AltFireStartLoop",CHAN_WEAPON,1,1)
			Goto AltFireLooperFast

	AltFireLooper1:
		UTMG A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		UTMG B 0 A_GunFlash("AltFlash")
		UTMG B 1 Offset(2,35)
		UTMG C 1 Offset(2,35)
		UTMG D 1 Offset(1,34)
		UTMG A 1 Offset(1,34) A_ReFire("AltFireLooper2")
		Goto EndFireLooper1
	AltFireLooper2:
		UTMG A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		UTMG B 0 A_GunFlash("AltFlash")
		UTMG B 1 Offset(4,36)
		UTMG C 1 Offset(4,35)
		UTMG D 1 Offset(3,34)
		UTMG A 1 Offset(2,34) A_ReFire("AltFireLooper3")
		Goto EndFireLooper2
	AltFireLooper3:
		UTMG A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		UTMG B 0 A_GunFlash("AltFlash")
		UTMG B 1 Offset(5,38)
		UTMG C 1 Offset(5,37)
		UTMG D 1 Offset(4,36)
		UTMG A 1 Offset(4,36) A_ReFire("AltFireLooper4")
		Goto EndFireLooper3
	AltFireLooper4:
		UTMG A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		UTMG B 0 A_GunFlash("AltFlash")
		UTMG B 1 Offset(5,38)
		UTMG C 1 Offset(5,37)
		UTMG D 1 Offset(4,36)
		UTMG A 1 Offset(4,36) A_ReFire("AltFireLooper5")
		Goto EndFireLooper3
	AltFireLooper5:
		UTMG A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		UTMG B 0 A_GunFlash("AltFlash")
		UTMG B 1 Offset(5,38)
		UTMG C 1 Offset(5,37)
		UTMG D 1 Offset(4,36)
		UTMG A 1 Offset(4,36) A_ReFire("AltFireLooper6")
		Goto EndFireLooper3
	AltFireLooper6:
		UTMG A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		UTMG B 0 A_GunFlash("AltFlash")
		UTMG B 1 Offset(5,38)
		UTMG C 1 Offset(5,37)
		UTMG D 1 Offset(4,36)
		UTMG A 1 Offset(4,36) A_ReFire("AltFireFast")
		Goto EndFireLooper3
	AltFireLooperFast:
		UTMG A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		UTMG B 0 A_GunFlash("AltFlashFast")
		UTMG B 1 Offset(7,40)
		UTMG C 1 Offset(6,39)
		UTMG D 1 A_ReFire("AltFireLooperFast2")
		Goto AltEndFireLooper1
	AltFireLooperFast2:
		UTMG A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		UTMG B 0 A_GunFlash("AltFlashFast")
		UTMG B 1 Offset(8,41)
		UTMG C 1 Offset(7,40)
		UTMG D 1 A_ReFire("AltFireLooperFast2")
		Goto AltEndFireLooper2

	AltEndFireLooper1:
		UTMG E 0 A_PlaySound("UTDE/Weapons/Minigun/FireEnd",CHAN_WEAPON,1,0)
		UTMG E 0 Offset(4,37)
		UTMG E 1 A_WeaponReady(WRF_NOBOB)
		UTMG G 0 Offset(3,36)
		UTMG G 1 A_WeaponReady(WRF_NOBOB)
		UTMG A 0 Offset(2,35)
		UTMG A 1 A_WeaponReady(WRF_NOBOB)
		UTMG E 0 Offset(1,33)
		UTMG EFGHIIJJAAEEEFFFGGGHHHHIIIIJJJJA 1 A_WeaponReady(WRF_NOBOB)
		Goto Ready
	AltEndFireLooper2:
		UTMG E 0 A_PlaySound("UTDE/Weapons/Minigun/FireEnd",CHAN_WEAPON,1,0)
		UTMG E 0 Offset(5,38)
		UTMG E 1 A_WeaponReady(WRF_NOBOB)
		UTMG G 0 Offset(4,37)
		UTMG G 1 A_WeaponReady(WRF_NOBOB)
		UTMG A 0 Offset(3,36)
		UTMG A 1 A_WeaponReady(WRF_NOBOB)
		UTMG E 0 Offset(2,35)
		UTMG E 1 A_WeaponReady(WRF_NOBOB)
		UTMG G 0 Offset(1,33)
		UTMG GIAEFGHIJAAEEFFGGHHHIIIJJJAAAEEEEFFFFGGGGHHHHIIIIJJJJA 1 A_WeaponReady(WRF_NOBOB)
		Goto Ready

	//-----------------------
	// Attack doers
	//-----------------------
	AltFlash:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_FireBullets(1,1,1,random(10,15),"QCBulletPuff",FBF_NORANDOM|FBF_USEAMMO)
		TNT1 A 0 A_FireCustomMissile("BulletSmallTracer",frandom(1,-1),false,8,-3,0,frandom(1,-1))
		Goto AltEndFlash

	AltFlashFast:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_FireBullets(4,4,1,random(10,15),"QCBulletPuff",FBF_NORANDOM|FBF_USEAMMO)
		TNT1 A 0 A_FireCustomMissile("BulletSmallTracer",frandom(4,-4),false,8,-3,0,frandom(4,-4))
		Goto AltEndFlash

		AltEndFlash:
			TNT1 A 0 A_FireCustomMissile("MinigunSmokeSpawner",0, false,7,2)
			TNT1 A 0 A_JumpIfInventory("WepNoRecoilToken",1,"AltEndFlashNoRecoil")
			TNT1 A 1 A_SetPitch(Pitch-0.8)
			TNT1 AA 1 A_SetPitch(Pitch+0.4)
			Stop
		AltEndFlashNoRecoil:
			TNT1 A 1
			Stop
	}
}

// --------------------------------------------------------------------------
//	For competitive DM, weapons dont autoaim
// --------------------------------------------------------------------------
Actor QCHeavyMachinegunDM : QCHeavyMachinegun
{	
	+WEAPON.NOAUTOAIM	
	+CHEATNOTWEAPON
	Tag "$TAG_UTMinigun"
	Weapon.AmmoGive 50
	Weapon.AmmoDmScale 1.0
	Weapon.AmmoDmRefill 10

	States
	{
	Flash:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_FireBullets(1,1,1,10,"QCBulletPuff_DM",FBF_NORANDOM|FBF_USEAMMO)
		Goto EndFlash

	AltFlash:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_FireBullets(1,1,1,10,"QCBulletPuff_DM",FBF_NORANDOM|FBF_USEAMMO)
		TNT1 A 0 A_FireCustomMissile("BulletSmallTracer",frandom(1,-1),false,8,-3,0,frandom(1,-1))
		Goto AltEndFlash

	AltFlashFast:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_FireBullets(4,4,1,10,"QCBulletPuff_DM",FBF_NORANDOM|FBF_USEAMMO)
		TNT1 A 0 A_FireCustomMissile("BulletSmallTracer",frandom(4,-4),false,8,-3,0,frandom(4,-4))
		Goto AltEndFlash
	}
}

Actor MinigunSmokeSpawner
{
	Radius 1
	Height 1
	Speed 14
	PROJECTILE
	+NOTIMEFREEZE
	+CLIENTSIDEONLY +NONETID
	States
	{
	Spawn:
		TNT1 A 1
		TNT1 A 0 A_Die
		Goto Death
	Death:
		TNT1 A 0 A_SpawnItemEx("MinigunSmoke",0,random(1,-1),0,0,0,frandom(0.1,0.25),0,32)
		TNT1 A 2
		Stop
	}
}

Actor MinigunSmoke
{
	+NOINTERACTION +NOTONAUTOMAP
	+FORCEXYBILLBOARD
	+CLIENTSIDEONLY +NONETID
	Alpha 0.6
	Scale 0.03
	States
	{
	Spawn:
		TNT1 A 0
		TNT1 A 0 A_Jump(256,"Type1","Type2")	//to define which graphic will use
	Type1:
		X201 E 0
		Goto "Continue"
	Type2:
		X201 F 0
		Goto "Continue"
	Continue:
		"####" "#" 0 A_Jump(160,2,4,6)
		"####" "#" 0
		"####" "#" 0 A_SetScale(0.03)
		"####" "#" 2 A_FadeOut(0.035)
		"####" "#" 0 A_SetScale(0.033)
		"####" "#" 2 A_FadeOut(0.035)
		"####" "#" 0 A_SetScale(0.036)
		"####" "#" 2 A_FadeOut(0.035)
	Looper:
		"####" "#" 0 A_SetScale(ScaleX+0.003)
		"####" "#" 2 A_FadeOut(0.035)
		Loop
	}
}
