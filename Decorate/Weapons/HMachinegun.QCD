Actor CompatVer30_HMachinegun {} // for compatibility checks

Actor HeavyMachinegunPickup : CustomInventory 15600
{
	//$NotAngled
	//$Category "QCDE Weapons"
	//$Color 14
	//$Title "Minigun"
	Height 48
	Radius 20
	Scale 0.64
	Inventory.PickupMessage "$GOT_UTMinigun"
	Inventory.PickupSound "QC/Items/WeaponPick"
	Inventory.RespawnTics 35
	Tag "$TAG_UTMinigun"
	States
	{
	Spawn:
		UTMG Y 35 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		UTMG Y 35 A_CheckFlag("DROPPED", "BecomeWeaponItself")
		Goto Idle
	DMSpawn:
		"####" "#" 0 A_ChangeFlag("DROPPED", 0)
		UTMG Z 0 ACS_NamedExecuteWithResult("QCDE_WeaponSpawned",8,args[4])
		UTMG Z -1 Bright A_SetArg(4, 0)
		Stop

	BecomeWeaponItself:
		TNT1 A 0 A_SpawnItemEx("QCHeavyMachinegun")
		TNT1 A 0 A_JumpIf(true, "End") Goto Idle // <-- this is to fool client-side predictor
	End:TNT1 A 0
		Stop

	Idle:
		UTMG Y 0 ACS_NamedExecuteWithResult("QCDE_WeaponSpawned",7,args[4])
		UTMG Y -1 A_SetArg(4, 0)
		Wait
	Pickup:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMPickup")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"WeaponStay")
		TNT1 A 0 A_GiveInventory("QCHeavyMachinegun")
		TNT1 A 0 A_JumpIf(CallACS("QCDE_SelectUpgradedWeapon",1,0,0,0), "Stay") // never jumps, but had to wrap CallACS or else the weapon will be always picked up
		TNT1 A 0 A_TakeInventory("QCMachinegun")
		Stop
	DMPickup:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"DMWeaponStay")
		TNT1 A 0 A_GiveInventory("QCHeavyMachinegunDM")
		TNT1 A 0 A_JumpIf(CallACS("QCDE_SelectUpgradedWeapon",1,0,0,0), "Stay") // never jumps, but had to wrap CallACS or else the weapon will be always picked up
		TNT1 A 0 A_TakeInventory("QCMachinegunDM")
		TNT1 A 0 A_TakeInventory("QCHeavyMachinegun")
		TNT1 A 0 A_TakeInventory("QCMachinegun")
		Stop
	WeaponStay:
		TNT1 A 0 A_JumpIfInventory("QCHeavyMachinegun",1,"Stay")
		TNT1 A 0 A_SpawnItemEx("QCHeavyMachinegun", velx,vely,velz, velx,vely,velz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Fail
	DMWeaponStay:
		TNT1 A 0 A_JumpIf(CallACS("QCDE_SelectUpgradedWeapon",1,0,0,0), "Stay") // never jumps, but had to wrap CallACS or else the weapon will be always picked up
		TNT1 A 0 A_TakeInventory("QCHeavyMachinegun")
		TNT1 A 0 A_JumpIfInventory("QCHeavyMachinegunDM",1,"Stay")
		TNT1 A 0 A_SpawnItemEx("QCHeavyMachinegunDM", velx,vely,velz, velx,vely,velz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Fail
	Stay:
		TNT1 A 0
		Fail
	HideIndefinitely:
		TNT1 A 1 A_SetTics(CallACS("QCDE_SetWeaponRespawnTics"))
		Goto Super::HideDoomish+1
	HideDoomish:
		TNT1 A 1
		TNT1 A 1 A_SetTics(CallACS("QCDE_SetWeaponRespawnTics"))
		Goto Super::HideDoomish+1
	}
}

Actor HeavyMachinegunPickupFloat : HeavyMachinegunPickup 15610
{
	//$Title "Float Minigun"
	+NOGRAVITY
}

Actor QCHeavyMachinegun : QCWeapon
{
	Height 48
	Weapon.SwaySpeed 3.2
	Weapon.Kickback 20
	Weapon.SelectionOrder 1000
	Weapon.AmmoUse 1
	Weapon.AmmoUse2 1
	Weapon.AmmoGive 100
	Weapon.AmmoType "QCBulletAmmo"
	Weapon.AmmoType2 "QCBulletAmmo"
	Obituary "$OB_UTMinigun"
	Inventory.PickupMessage "$GOT_UTMinigun"
	Tag "$TAG_UTMinigun"
	Scale 0.64
	States
	{
	Spawn:
		TNT1 A 1
		UTMG Y 35 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		Goto Idle
	DMSpawn:
		UTMG ZZZZZZZZZZZZZZZ 35 Bright
		Stop
	Idle:
		UTMG Y -1
		Wait

	//-----------------------
	// Select/Deselect Seq
	//-----------------------
	Select:
		TNT1 A 0 A_JumpIfInventory("NoWeaponFireToken",1,2)
		TNT1 A 0 A_PlaySound("QC/Weapons/Switch",CHAN_5,1,0,3) //Not in Weapon.UpSound because it interrupts CHAN_WEAPON sounds
		TNT1 A 0 A_TakeInventory("QCMachinegunDM")
		TNT1 A 0 A_TakeInventory("QCMachinegun")
		TNT1 A 0 A_StopSound(CHAN_WEAPON) //stops any weapon looping sound
	SelectLooper:
		UTMG A 1 A_Raise
		"####" "###" 0 A_Raise
		Loop

	Deselect:
		TNT1 A 0 A_StopSound(5)
		TNT1 A 0 A_StopSound(CHAN_WEAPON)
	DeselectLooper:
		UTMG A 1 A_Lower
		"####" "###" 0 A_Lower
		Loop

	//-----------------------
	// Ready Seq
	//-----------------------
	Ready:
		TNT1 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		UTMG A 3 A_WeaponReady
		Loop

		ReadyCantFire:
			TNT1 A 0 A_StopSound(5)
			TNT1 A 0 A_StopSound(CHAN_WEAPON)
		RCFLooper:
			UTMG A 4 A_WeaponReady(WRF_NOFIRE)
			TNT1 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"RCFLooper")
			Goto Ready

	//-----------------------
	// Fire Seq
	//-----------------------
	Fire:
		TNT1 A 0 A_JumpIfInventory("PowerQuad",1,"FireQuadSound")
		TNT1 A 0 A_JumpIfInventory("PowerTerminatorArtifact",1,"FireQuadSound")
		Goto FireNormalSound

		FireNormalSound:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Minigun/FireStartLoop",CHAN_WEAPON,1,1)
			Goto FireLooper1
		FireQuadSound:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Minigun/Quad/FireStartLoop",CHAN_WEAPON,1,1)
			Goto FireLooper1

	FireLooper1:
		TNT1 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		TNT1 A 0 A_GunFlash("Flash")
		UTMG B 1 Offset(2,35)
		UTMG C 1 Offset(2,34)
		UTMG D 1 Offset(1,33)
		UTMG A 1 Offset(0,32) A_ReFire("FireLooper2")
		Goto EndFireLooper1

	FireLooper2:
		TNT1 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		TNT1 A 0 A_GunFlash("Flash")
		UTMG E 1 Offset(4,36)
		UTMG F 1 Offset(4,35)
		UTMG G 1 Offset(3,34)
		UTMG A 1 Offset(1,33) A_ReFire("FireLooper3")
		Goto EndFireLooper2

	FireLooper3:
		TNT1 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		TNT1 A 0 A_GunFlash("Flash")
		UTMG B 1 Offset(5,38)
		UTMG C 1 Offset(5,37)
		UTMG D 1 Offset(4,36)
		UTMG A 1 Offset(3,35) A_ReFire("FireLooper4")
		Goto EndFireLooper3

	FireLooper4:
		TNT1 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		TNT1 A 0 A_GunFlash("Flash")
		UTMG E 1 Offset(5,38)
		UTMG F 1 Offset(5,37)
		UTMG G 1 Offset(4,36)
		UTMG A 1 Offset(3,35) A_ReFire("FireLooper3")
		Goto EndFireLooper3

	EndFireLooper1:
		TNT1 A 0 A_PlaySound("UTDE/Weapons/Minigun/FireEnd",CHAN_WEAPON,1,0)
		UTMG KNQIKKMOQHIJKLMNOPQHHIIJJKKLLLMMMNNNOOOOPPPPQQQQ 1 A_WeaponReady(WRF_NOBOB)
		Goto Ready
	EndFireLooper2:
		TNT1 A 0 A_PlaySound("UTDE/Weapons/Minigun/FireEnd",CHAN_WEAPON,1,0)
		UTMG K 1 Offset(0,32)
		UTMG NQIKKMOQHIJKLMNOPQHHIIJJKKLLLMMMNNNOOOOPPPPQQQQ 1 A_WeaponReady(WRF_NOBOB)
		Goto Ready
	EndFireLooper3:
		TNT1 A 0 A_PlaySound("UTDE/Weapons/Minigun/FireEnd",CHAN_WEAPON,1,0)
		UTMG K 1 Offset(1,33)
		UTMG N 1 Offset(0,32)
		UTMG QIKKMOQHIJKLMNOPQHHIIJJKKLLLMMMNNNOOOOPPPPQQQQ 1 A_WeaponReady(WRF_NOBOB)
		Goto Ready

	//-----------------------
	// Attack doers
	//-----------------------
	Flash:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_JumpIfInventory("HMG_UG_Ricochet",1,"FlashStrong")
		TNT1 A 0 A_FireBullets(1,1,1,random(10,15),"QCBulletPuff",FBF_NORANDOM|FBF_USEAMMO)
		Goto EndFlash

	FlashStrong:
		TNT1 A 0 A_FireBullets(1,1,1,random(15,23),"QCBulletStrongPuff",FBF_NORANDOM|FBF_USEAMMO)
		Goto EndFlash

		EndFlash:
			TNT1 A 0 A_FireCustomMissile("BulletSmallTracer",frandom(1,-1),false,8,-3,FPF_NOUNLAGGED|FPF_SKIPOWNER,frandom(1,-1))
			TNT1 A 0 A_FireCustomMissile("MinigunSmokeSpawner",0, false,3,2)
			TNT1 A 0 A_JumpIfInventory("WepNoRecoilToken",1,"EndFlashNoRecoil")
			TNT1 A 1 A_SetPitch(Pitch-0.4)
			TNT1 AA 1 A_SetPitch(Pitch+0.2)
			Stop
		EndFlashNoRecoil:
			TNT1 A 1
			Stop

	//-----------------------
	// Alt Fire Seq
	//-----------------------
	AltFire:
		TNT1 A 0 A_JumpIfInventory("PowerQuad",1,"AltFireQuadSound")
		TNT1 A 0 A_JumpIfInventory("PowerTerminatorArtifact",1,"AltFireQuadSound")
		Goto AltFireNormalSound

		AltFireNormalSound:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Minigun/FireStartLoop",CHAN_WEAPON,1,1)
			Goto AltFireLooper1
		AltFireQuadSound:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Minigun/Quad/FireStartLoop",CHAN_WEAPON,1,1)
			Goto AltFireLooper1

	AltFireFast:
		TNT1 A 0 A_JumpIfInventory("PowerQuad",1,"AltFireFastQuadSound")
		TNT1 A 0 A_JumpIfInventory("PowerTerminatorArtifact",1,"AltFireFastQuadSound")
		Goto AltFireFastNormalSound

		AltFireFastNormalSound:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Minigun/AltFireStartLoop",CHAN_WEAPON,1,1)
			Goto AltFireLooperFast
		AltFireFastQuadSound:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Minigun/Quad/AltFireStartLoop",CHAN_WEAPON,1,1)
			Goto AltFireLooperFast

	AltFireSuperFast:
		TNT1 A 0 A_JumpIfInventory("PowerQuad",1,"AltFireSuperFastQuadSound")
		TNT1 A 0 A_JumpIfInventory("PowerTerminatorArtifact",1,"AltFireSuperFastQuadSound")
		Goto AltFireSuperFastNormalSound

		AltFireSuperFastNormalSound:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Minigun/AltFireSuperStartLoop",CHAN_WEAPON,1,1)
			Goto AltFireLooperSuperFast
		AltFireSuperFastQuadSound:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Minigun/Quad/AltFireSuperStartLoop",CHAN_WEAPON,1,1)
			Goto AltFireLooperSuperFast

	AltFireLooper1:
		TNT1 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		TNT1 A 0 A_GunFlash("AltFlash")
		UTMG B 1 Offset(2,35)
		UTMG C 1 Offset(2,34)
		UTMG D 1 Offset(1,33)
		UTMG A 1 Offset(0,32) A_ReFire("AltFireLooper2")
		Goto EndFireLooper1
	AltFireLooper2:
		TNT1 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		TNT1 A 0 A_GunFlash("AltFlash")
		UTMG E 1 Offset(4,36)
		UTMG F 1 Offset(4,35)
		UTMG G 1 Offset(3,34)
		UTMG A 1 Offset(1,33) A_ReFire("AltFireLooper3")
		Goto EndFireLooper2
	AltFireLooper3:
		TNT1 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		TNT1 A 0 A_GunFlash("AltFlash")
		UTMG B 1 Offset(5,38)
		UTMG C 1 Offset(5,37)
		UTMG D 1 Offset(4,36)
		UTMG A 1 Offset(3,34) A_ReFire("AltFireLooper4")
		Goto EndFireLooper3
	AltFireLooper4:
		TNT1 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		TNT1 A 0 A_GunFlash("AltFlash")
		UTMG E 1 Offset(5,38)
		UTMG F 1 Offset(5,37)
		UTMG G 1 Offset(4,36)
		UTMG A 1 Offset(3,34) A_ReFire("AltFireLooper5")
		Goto EndFireLooper3
	AltFireLooper5:
		TNT1 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		TNT1 A 0 A_GunFlash("AltFlash")
		UTMG B 1 Offset(5,38)
		UTMG C 1 Offset(5,37)
		UTMG D 1 Offset(4,36)
		UTMG A 1 Offset(3,34) A_ReFire("AltFireLooper6")
		Goto EndFireLooper3
	AltFireLooper6:
		TNT1 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		TNT1 A 0 A_GunFlash("AltFlash")
		UTMG E 1 Offset(5,38)
		UTMG F 1 Offset(5,37)
		UTMG G 1 Offset(4,36)
		UTMG A 1 Offset(3,34) A_ReFire("AltFireFast")
		Goto EndFireLooper3

	AltFireLooperFast:
		TNT1 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		TNT1 A 0 A_GunFlash("AltFlashFast")
		UTMG B 1 Offset(7,40)
		UTMG C 1 Offset(6,39)
		UTMG D 1 A_ReFire("AltFireLooperFast2")
		Goto AltEndFireLooper1
	AltFireLooperFast2:
		TNT1 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		TNT1 A 0 A_GunFlash("AltFlashFast")
		UTMG E 1 Offset(8,41)
		UTMG F 1 Offset(7,40)
		TNT1 G 0 A_JumpIfInventory("HMG_UG_Pierce",1,"AccelerateToSuperFast")
		UTMG D 1 A_ReFire("AltFireLooperFast3")
		Goto AltEndFireLooper2
	AltFireLooperFast3:
		TNT1 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		TNT1 A 0 A_GunFlash("AltFlashFast")
		UTMG B 1 Offset(8,41)
		UTMG C 1 Offset(7,40)
		TNT1 A 0 A_JumpIfInventory("HMG_UG_Pierce",1,"AccelerateToSuperFast")
		UTMG D 1 A_ReFire("AltFireLooperFast2")
		Goto AltEndFireLooper2

	AccelerateToSuperFast:
		UTMG D 1 A_ReFire("AltFireLooperFast4")
	AltFireLooperFast4:
		TNT1 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		TNT1 A 0 A_GunFlash("AltFlashFast")
		UTMG E 1 Offset(7,40)
		UTMG F 1 Offset(6,39)
		UTMG G 1 A_ReFire("AltFireLooperFast5")
		Goto AltEndFireLooper2
	AltFireLooperFast5:
		TNT1 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		TNT1 A 0 A_GunFlash("AltFlashFast")
		UTMG B 1 Offset(8,41)
		UTMG C 1 Offset(7,40)
		UTMG D 1 A_ReFire("AltFireLooperFast6")
		Goto AltEndFireLooper2
	AltFireLooperFast6:
		TNT1 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		TNT1 A 0 A_GunFlash("AltFlashFast")
		UTMG E 1 Offset(7,40)
		UTMG F 1 Offset(6,39)
		UTMG G 1 A_ReFire("AltFireLooperFast7")
		Goto AltEndFireLooper2
	AltFireLooperFast7:
		TNT1 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		TNT1 A 0 A_GunFlash("AltFlashFast")
		UTMG B 1 Offset(8,41)
		UTMG C 1 Offset(7,40)
		UTMG D 1 A_ReFire("AltFireSuperFast")
		Goto AltEndFireLooper2

	AltFireLooperSuperFast:
		TNT1 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		TNT1 A 0 A_GunFlash("AltFlashSuperFast")
		TNT1 A 0 A_ChangeVelocity(1 * -cos(pitch), 0, 1 * sin(pitch), CVF_RELATIVE)
		UTMG E 1 Offset(11,44)
		UTMG G 1 A_ReFire("AltFireLooperSuperFast2")
		Goto AltEndFireLooper3

	AltFireLooperSuperFast2:
		TNT1 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		TNT1 A 0 A_GunFlash("AltFlashSuperFast")
		TNT1 A 0 A_ChangeVelocity(1 * -cos(pitch), 0, 1 * sin(pitch), CVF_RELATIVE)
		UTMG B 1 Offset(10,43)
		UTMG D 1 A_ReFire("AltFireLooperSuperFast")
		Goto AltEndFireLooper3

	AltEndFireLooper1:
		TNT1 A 0 A_PlaySound("UTDE/Weapons/Minigun/FireEnd",CHAN_WEAPON,1,0)
		TNT1 A 0 Offset(4,37)
		UTMG L 1 A_WeaponReady(WRF_NOBOB)
		TNT1 A 0 Offset(2,35)
		UTMG P 1 A_WeaponReady(WRF_NOBOB)
		TNT1 A 0 Offset(1,34)
		UTMG J 1 A_WeaponReady(WRF_NOBOB)
		TNT1 A 0 Offset(0,32)
		UTMG KOHKNQIKKMOQHIJKLMNOPQHHIIJJKKLLLMMMNNNOOOOPPPPQQQQ 1 A_WeaponReady(WRF_NOBOB)
		Goto Ready
	AltEndFireLooper2:
		TNT1 A 0 A_PlaySound("UTDE/Weapons/Minigun/FireEnd",CHAN_WEAPON,1,0)
		TNT1 A 0 Offset(5,38)
		UTMG L 1 A_WeaponReady(WRF_NOBOB)
		TNT1 A 0 Offset(4,37)
		UTMG P 1 A_WeaponReady(WRF_NOBOB)
		TNT1 A 0 Offset(2,35)
		UTMG J 1 A_WeaponReady(WRF_NOBOB)
		TNT1 A 0 Offset(1,34)
		UTMG K 1 A_WeaponReady(WRF_NOBOB)
		TNT1 A 0 Offset(0,32)
		UTMG OHKNQIKKMOQHIJKLMNOPQHHIIJJKKLLLMMMNNNOOOOPPPPQQQQ 1 A_WeaponReady(WRF_NOBOB)
		Goto Ready
	AltEndFireLooper3:
		TNT1 A 0 A_PlaySound("UTDE/Weapons/Minigun/FireEnd",CHAN_WEAPON,1,0)
		TNT1 A 0 Offset(7,40)
		UTMG M 1 A_WeaponReady(WRF_NOBOB)
		TNT1 A 0 Offset(6,39)
		UTMG H 1 A_WeaponReady(WRF_NOBOB)
		TNT1 A 0 Offset(5,38)
		UTMG L 1 A_WeaponReady(WRF_NOBOB)
		TNT1 A 0 Offset(4,37)
		UTMG P 1 A_WeaponReady(WRF_NOBOB)
		TNT1 A 0 Offset(2,35)
		UTMG J 1 A_WeaponReady(WRF_NOBOB)
		TNT1 A 0 Offset(1,34)
		UTMG K 1 A_WeaponReady(WRF_NOBOB)
		TNT1 A 0 Offset(0,32)
		UTMG OHKNQIKKMOQHIJKLMNOPQHHIIJJKKLLLMMMNNNOOOOPPPPQQQQ 1 A_WeaponReady(WRF_NOBOB)
		Goto Ready

	//-----------------------
	// Attack doers
	//-----------------------
	AltFlash:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_FireCustomMissile("BulletSmallTracer",frandom(1,-1),false,8,-3,FPF_NOUNLAGGED|FPF_SKIPOWNER,frandom(1,-1))
		TNT1 A 0 A_JumpIfInventory("HMG_UG_Ricochet",1,"AltFlashStrong")
		TNT1 A 0 A_FireBullets(1,1,1,random(10,15),"QCBulletPuff",FBF_NORANDOM|FBF_USEAMMO)
		Goto AltEndFlash

	AltFlashStrong:
		TNT1 A 0 A_FireBullets(1,1,1,random(13,23),"QCBulletStrongPuff",FBF_NORANDOM|FBF_USEAMMO)
		Goto AltEndFlash

	AltFlashFast:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_FireCustomMissile("BulletSmallTracer",frandom(4,-4),false,8,-3,FPF_NOUNLAGGED|FPF_SKIPOWNER,frandom(4,-4))
		TNT1 A 0 A_JumpIfInventory("HMG_UG_Ricochet",1,"AltFlashFastStrong")
		TNT1 A 0 A_FireBullets(4,4,1,random(10,15),"QCBulletPuff",FBF_NORANDOM|FBF_USEAMMO)
		Goto AltEndFlash

		AltEndFlash:
			TNT1 A 0 A_FireCustomMissile("MinigunSmokeSpawner",0, false,3,2)
			TNT1 A 0 A_JumpIfInventory("WepNoRecoilToken",1,"AltEndFlashNoRecoil")
			TNT1 A 1 A_SetPitch(Pitch-0.4)
			TNT1 AA 1 A_SetPitch(Pitch+0.2)
			Stop
		AltEndFlashNoRecoil:
			TNT1 A 1
			Stop

	AltFlashFastStrong:
		TNT1 A 0 A_FireBullets(4,4,1,random(13,23),"QCBulletStrongPuff",FBF_NORANDOM|FBF_USEAMMO)
		Goto AltEndFlashSuperFast

	AltFlashSuperFast:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_FireCustomMissile("BulletSmallTracer",frandom(5,-5),false,8,-3,FPF_NOUNLAGGED|FPF_SKIPOWNER,frandom(5,-5))
		TNT1 A 0 A_JumpIfInventory("HMG_UG_Ricochet",1,"AltFlashSuperFastStrong")
		TNT1 A 0 A_FireBullets(5,5,1,random(10,15),"QCBulletPuff",FBF_NORANDOM|FBF_USEAMMO)
		Goto AltEndFlashSuperFast

	AltFlashSuperFastStrong:
		TNT1 A 0 A_FireBullets(5,5,1,random(13,23),"QCBulletStrongPuff",FBF_NORANDOM|FBF_USEAMMO)
		Goto AltEndFlashSuperFast

		AltEndFlashSuperFast:
			TNT1 A 0 A_FireCustomMissile("MinigunSmokeSpawner",0, false,3,2)
			TNT1 A 1 A_SetPitch(Pitch-0.4)
			Stop
	}
}

// --------------------------------------------------------------------------
//	For competitive DM, weapons dont autoaim
// --------------------------------------------------------------------------
Actor QCHeavyMachinegunDM : QCHeavyMachinegun
{
	+WEAPON.NOAUTOAIM
	+CHEATNOTWEAPON
	Tag "$TAG_UTMinigun"
	Weapon.AmmoGive 50
	Weapon.AmmoDmScale 1.0
	Weapon.AmmoDmRefill 10

	States
	{
	Flash:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_FireBullets(1,1,1,10,"QCBulletPuff_DM",FBF_NORANDOM|FBF_USEAMMO)
		Goto EndFlash

	AltFlash:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_FireBullets(1,1,1,10,"QCBulletPuff_DM",FBF_NORANDOM|FBF_USEAMMO)
		TNT1 A 0 A_FireCustomMissile("BulletSmallTracer",frandom(1,-1),false,8,-3,FPF_NOUNLAGGED|FPF_SKIPOWNER,frandom(1,-1))
		Goto AltEndFlash

	AltFlashFast:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_FireBullets(4,4,1,10,"QCBulletPuff_DM",FBF_NORANDOM|FBF_USEAMMO)
		TNT1 A 0 A_FireCustomMissile("BulletSmallTracer",frandom(4,-4),false,8,-3,FPF_NOUNLAGGED|FPF_SKIPOWNER,frandom(4,-4))
		Goto AltEndFlash
	}
}

Actor MinigunSmokeSpawner
{
	Radius 1
	Height 1
	Speed 14
	PROJECTILE
	+NOTIMEFREEZE
	+CLIENTSIDEONLY +NONETID
	States
	{
	Spawn:
		TNT1 A 1
		TNT1 A 0 A_Die
		Goto Death
	Death:
		TNT1 A 0 A_SpawnItemEx("MinigunSmoke",0,random(1,-1),0,0,0,frandom(0.1,0.25),0,32)
		TNT1 A 2
		Stop
	}
}

Actor MinigunSmoke
{
	+NOINTERACTION +NOTONAUTOMAP
	+FORCEXYBILLBOARD
	+CLIENTSIDEONLY +NONETID
	Alpha 0.6
	Scale 0.03
	States
	{
	Spawn:
		TNT1 A 0
		TNT1 A 0 A_Jump(256,"Type1","Type2")	//to define which graphic will use
	Type1:
		X201 E 0
		Goto "Continue"
	Type2:
		X201 F 0
		Goto "Continue"
	Continue:
		"####" "#" 0 A_Jump(160,2,4,6)
		"####" "#" 0
		"####" "#" 0 A_SetScale(0.03)
		"####" "#" 2 A_FadeOut(0.035)
		"####" "#" 0 A_SetScale(0.033)
		"####" "#" 2 A_FadeOut(0.035)
		"####" "#" 0 A_SetScale(0.036)
		"####" "#" 2 A_FadeOut(0.035)
	Looper:
		"####" "#" 0 A_SetScale(ScaleX+0.003)
		"####" "#" 2 A_FadeOut(0.035)
		Loop
	}
}

