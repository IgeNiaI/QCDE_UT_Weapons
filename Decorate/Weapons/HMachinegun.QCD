	//-----------------------
	// Attack doers
	//-----------------------
	AltFlash:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_JumpIfInventory("HMG_UG_Ricochet",1,"AltFlashStrong")
		TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 7, "AltFlash.Default")
		TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 6, "AltFlash.UC2")
	AltFlash.Default:
		TNT1 A 0 A_FireBullets(1,1,1,random(10,15),"QCBulletPuff",FBF_NORANDOM|FBF_USEAMMO)
		TNT1 A 0 A_FireCustomMissile("BulletSmallTracer",frandom(1,-1),false,9,-3,FPF_NOUNLAGGED|FPF_SKIPOWNER,frandom(1,-1))
		Goto AltEndFlash
	AltFlash.UC2:
		TNT1 A 0 A_FireBullets(1,1,1,random(10,15),"QCBulletPuff_UC2",FBF_NORANDOM|FBF_USEAMMO)
		TNT1 A 0 A_FireCustomMissile("BulletSmallTracer_Quake4",frandom(1,-1),false,9,-3,FPF_NOUNLAGGED|FPF_SKIPOWNER,frandom(1,-1))
		Goto AltEndFlash

	AltFlashStrong:
		TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 7, "AltFlashStrong.Default")
		TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 6, "AltFlashStrong.UC2")
	AltFlashStrong.Default:
		TNT1 A 0 A_FireBullets(1,1,1,random(13,23),"QCBulletStrongPuff",FBF_NORANDOM|FBF_USEAMMO)
		TNT1 A 0 A_FireCustomMissile("BulletSmallTracer",frandom(1,-1),false,9,-3,FPF_NOUNLAGGED|FPF_SKIPOWNER,frandom(1,-1))
		Goto AltEndFlash
	AltFlashStrong.UC2:
		TNT1 A 0 A_FireBullets(1,1,1,random(13,23),"QCBulletStrongPuff_UC2",FBF_NORANDOM|FBF_USEAMMO)
		TNT1 A 0 A_FireCustomMissile("BulletSmallTracer_Quake4",frandom(1,-1),false,9,-3,FPF_NOUNLAGGED|FPF_SKIPOWNER,frandom(1,-1))
		Goto AltEndFlash

	AltFlashFast:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 7, "AltFlashFast.Default")
		TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 6, "AltFlashFast.UC2")
	AltFlashFast.Default:
		TNT1 A 0 A_JumpIfInventory("HMG_UG_Ricochet",1,"AltFlashFastStrong")
		TNT1 A 0 A_FireBullets(4,4,1,random(10,15),"QCBulletPuff",FBF_NORANDOM|FBF_USEAMMO)
		TNT1 A 0 A_FireCustomMissile("BulletSmallTracer",frandom(4,-4),false,9,-3,FPF_NOUNLAGGED|FPF_SKIPOWNER,frandom(4,-4))
		Goto AltEndFlash
	AltFlashFast.UC2:
		TNT1 A 0 A_JumpIfInventory("HMG_UG_Ricochet",1,"AltFlashFastStrong")
		TNT1 A 0 A_FireBullets(4,4,1,random(10,15),"QCBulletPuff_UC2",FBF_NORANDOM|FBF_USEAMMO)
		TNT1 A 0 A_FireCustomMissile("BulletSmallTracer_Quake4",frandom(4,-4),false,9,-3,FPF_NOUNLAGGED|FPF_SKIPOWNER,frandom(4,-4))
		Goto AltEndFlash

		AltEndFlash:
			TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 7, "AltEndFlash.Default")
			TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 6, "AltEndFlash.UC2")
		AltEndFlash.Default:
			TNT1 A 0 A_FireCustomMissile("MachinegunSmokeSpawner",0, false,3,2)
			TNT1 A 0 A_JumpIfInventory("WepNoFlashToken",1,"AltEndFlashCont")
			TNT1 A 0 A_SetBlend("Yellow",0.03,3)
		AltEndFlash.UC2:
			TNT1 A 0 A_JumpIfInventory("WepNoFlashToken",1,"AltEndFlashCont")
			TNT1 A 0 A_SetBlend("Cyan",0.03,3)
		AltEndFlashCont:
			TNT1 A 0 A_JumpIfInventory("WepNoRecoilToken",1,"AltEndFlashNoRecoil")
			TNT1 A 1 A_SetPitch(Pitch-0.4)
			TNT1 AA 1 A_SetPitch(Pitch+0.2)
			Stop
		AltEndFlashNoRecoil:
			TNT1 A 1
			Stop

	AltFlashFastStrong:
		TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 7, "AltFlashFastStrong.Default")
		TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 6, "AltFlashFastStrong.UC2")
	AltFlashFastStrong.Default:
		TNT1 A 0 A_FireBullets(4,4,1,random(13,23),"QCBulletStrongPuff",FBF_NORANDOM|FBF_USEAMMO)
		TNT1 A 0 A_FireCustomMissile("BulletSmallTracer",frandom(4,-4),false,9,-3,FPF_NOUNLAGGED|FPF_SKIPOWNER,frandom(4,-4))
		Goto AltEndFlashSuperFast
	AltFlashFastStrong.UC2:
		TNT1 A 0 A_FireBullets(4,4,1,random(13,23),"QCBulletStrongPuff_UC2",FBF_NORANDOM|FBF_USEAMMO)
		TNT1 A 0 A_FireCustomMissile("BulletSmallTracer_Quake4",frandom(4,-4),false,9,-3,FPF_NOUNLAGGED|FPF_SKIPOWNER,frandom(4,-4))
		Goto AltEndFlashSuperFast

	AltFlashSuperFast:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_JumpIfInventory("HMG_UG_Ricochet",1,"AltFlashSuperFastStrong")
		TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 7, "AltFlashSuperFast.Default")
		TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 6, "AltFlashSuperFast.UC2")
	AltFlashSuperFast.Default:
		TNT1 A 0 A_FireBullets(5,5,1,random(10,15),"QCBulletPuff",FBF_NORANDOM|FBF_USEAMMO)
		TNT1 A 0 A_FireCustomMissile("BulletSmallTracer",frandom(5,-5),false,9,-3,FPF_NOUNLAGGED|FPF_SKIPOWNER,frandom(5,-5))
		Goto AltEndFlashSuperFast
	AltFlashSuperFast.UC2:
		TNT1 A 0 A_FireBullets(5,5,1,random(10,15),"QCBulletPuff_UC2",FBF_NORANDOM|FBF_USEAMMO)
		TNT1 A 0 A_FireCustomMissile("BulletSmallTracer_Quake4",frandom(5,-5),false,9,-3,FPF_NOUNLAGGED|FPF_SKIPOWNER,frandom(5,-5))
		Goto AltEndFlashSuperFast

	AltFlashSuperFastStrong:
		TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 7, "AltFlashSuperFastStrong.Default")
		TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 6, "AltFlashSuperFastStrong.UC2")
	AltFlashSuperFastStrong.Default:
		TNT1 A 0 A_FireBullets(5,5,1,random(13,23),"QCBulletStrongPuff",FBF_NORANDOM|FBF_USEAMMO)
		TNT1 A 0 A_FireCustomMissile("BulletSmallTracer",frandom(5,-5),false,9,-3,FPF_NOUNLAGGED|FPF_SKIPOWNER,frandom(5,-5))
		Goto AltEndFlashSuperFast
	AltFlashSuperFastStrong.UC2:
		TNT1 A 0 A_FireBullets(5,5,1,random(13,23),"QCBulletStrongPuff_UC2",FBF_NORANDOM|FBF_USEAMMO)
		TNT1 A 0 A_FireCustomMissile("BulletSmallTracer_Quake4",frandom(5,-5),false,9,-3,FPF_NOUNLAGGED|FPF_SKIPOWNER,frandom(5,-5))
		Goto AltEndFlashSuperFast

		AltEndFlashSuperFast:
			TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 7, "AltEndFlashSuperFast.Default")
			TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 6, "AltEndFlashSuperFast.UC2")
		AltEndFlashSuperFast.Default:
			TNT1 A 0 A_FireCustomMissile("MachinegunSmokeSpawner",0, false,3,2)
			TNT1 A 0 A_JumpIfInventory("WepNoFlashToken",1,"AltEndFlashSuperFastCont")
			TNT1 A 0 A_SetBlend("Yellow",0.03,3)
		AltEndFlashSuperFast.UC2:
			TNT1 A 0 A_JumpIfInventory("WepNoFlashToken",1,"AltEndFlashSuperFastCont")
			TNT1 A 0 A_SetBlend("Cyan",0.03,3)
		AltEndFlashSuperFastCont:
			TNT1 A 1 A_SetPitch(Pitch-0.4)
			Stop
	}
}

// --------------------------------------------------------------------------
//	For competitive DM, weapons dont autoaim
// --------------------------------------------------------------------------
Actor QCHeavyMachinegunDM : QCHeavyMachinegun
{
	+WEAPON.NOAUTOAIM
	+CHEATNOTWEAPON
	Tag "$TAG_UTMinigun"
	Weapon.AmmoGive 50
	Weapon.AmmoDmScale 1.0
	Weapon.AmmoDmRefill 10

	States
	{
	Flash:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 7, "Flash.Default")
		TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 6, "Flash.UC2")
	Flash.Default:
		TNT1 A 0 A_FireBullets(1,1,1,10,"QCBulletPuff_DM",FBF_NORANDOM|FBF_USEAMMO)
		Goto EndFlash
	Flash.UC2:
		TNT1 A 0 A_FireBullets(1,1,1,10,"QCBulletPuff_DM_UC2",FBF_NORANDOM|FBF_USEAMMO)
		Goto EndFlash

	AltFlash:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 7, "AltFlash.Default")
		TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 6, "AltFlash.UC2")
	AltFlash.Default:
		TNT1 A 0 A_FireBullets(1,1,1,10,"QCBulletPuff_DM",FBF_NORANDOM|FBF_USEAMMO)
		TNT1 A 0 A_FireCustomMissile("BulletSmallTracer",frandom(1,-1),false,9,-3,FPF_NOUNLAGGED|FPF_SKIPOWNER,frandom(1,-1))
		Goto AltEndFlash
	AltFlash.UC2:
		TNT1 A 0 A_FireBullets(1,1,1,10,"QCBulletPuff_DM_UC2",FBF_NORANDOM|FBF_USEAMMO)
		TNT1 A 0 A_FireCustomMissile("BulletSmallTracer_Quake4",frandom(1,-1),false,9,-3,FPF_NOUNLAGGED|FPF_SKIPOWNER,frandom(1,-1))
		Goto AltEndFlash

	AltFlashFast:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 7, "AltFlashFast.Default")
		TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 6, "AltFlashFast.UC2")
	AltFlashFast.Default:
		TNT1 A 0 A_FireBullets(4,4,1,10,"QCBulletPuff_DM",FBF_NORANDOM|FBF_USEAMMO)
		TNT1 A 0 A_FireCustomMissile("BulletSmallTracer",frandom(4,-4),false,9,-3,FPF_NOUNLAGGED|FPF_SKIPOWNER,frandom(4,-4))
		Goto AltEndFlash
	AltFlashFast.UC2:
		TNT1 A 0 A_FireBullets(4,4,1,10,"QCBulletPuff_DM_UC2",FBF_NORANDOM|FBF_USEAMMO)
		TNT1 A 0 A_FireCustomMissile("BulletSmallTracer_Quake4",frandom(4,-4),false,9,-3,FPF_NOUNLAGGED|FPF_SKIPOWNER,frandom(4,-4))
		Goto AltEndFlash
	}
}

Actor MachinegunSmokeSpawner
{
	Radius 1
	Height 1
	Speed 14
	PROJECTILE
	+NOTIMEFREEZE
	+CLIENTSIDEONLY +NONETID
	States
	{
	Spawn:
		TNT1 A 1
		TNT1 A 0 A_Die
		Goto Death
	Death:
		TNT1 A 0 A_SpawnItemEx("MachinegunSmoke",0,random(1,-1),0,0,0,frandom(0.1,0.25),0,32)
		TNT1 A 2
		Stop
	}
}

Actor MachinegunSmoke
{
	+NOINTERACTION +NOTONAUTOMAP
	+FORCEXYBILLBOARD
	+CLIENTSIDEONLY +NONETID
	Alpha 0.6
	Scale 0.03
	States
	{
	Spawn:
		TNT1 A 0
		TNT1 A 0 A_Jump(256,"Type1","Type2")	//to define which graphic will use
	Type1:
		X201 E 0
		Goto "Continue"
	Type2:
		X201 F 0
		Goto "Continue"
	Continue:
		"####" "#" 0 A_Jump(160,2,4,6)
		"####" "#" 0
		"####" "#" 0 A_SetScale(0.03)
		"####" "#" 2 A_FadeOut(0.035)
		"####" "#" 0 A_SetScale(0.033)
		"####" "#" 2 A_FadeOut(0.035)
		"####" "#" 0 A_SetScale(0.036)
		"####" "#" 2 A_FadeOut(0.035)
	Looper:
		"####" "#" 0 A_SetScale(ScaleX+0.003)
		"####" "#" 2 A_FadeOut(0.035)
		Loop
	}
}


