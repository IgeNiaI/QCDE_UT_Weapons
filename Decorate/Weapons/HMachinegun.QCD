Actor CompatVer31_HMachinegun {} // for compatibility checks

Actor HeavyMachinegunPickup : QCWeaponPickup 15600
{
	//$NotAngled
	//$Category "QCDE Weapons"
	//$Color 14
	//$Title "Minigun"
	Height 48
	Radius 20
	Scale 0.64
	Inventory.PickupMessage "$GOT_UTMinigun"
	Inventory.PickupSound "QC/Items/WeaponPick"
	Inventory.RespawnTics 35
	Tag "$TAG_UTMinigun"
	States
	{
	Spawn:
		U4GB Y 35 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		U4GB Y 35 A_CheckFlag("DROPPED", "BecomeWeaponItself")
		Goto Idle
	DMSpawn:
		"####" "#" 0 A_ChangeFlag("DROPPED", 0)
		U4GB Z 0 ACS_NamedExecuteWithResult("QCDE_WeaponSpawned",8,args[4],args[3])
		U4GB Z 0 A_SetArg(3, 1)
		U4GB Z -1 Bright A_SetArg(4, 0)
		Stop

	BecomeWeaponItself:
		TNT1 A 0 A_SpawnItemEx("QCHeavyMachinegun")
		TNT1 A 0 A_JumpIf(true, "End") Goto Idle // <-- this is to fool client-side predictor
	End:TNT1 A 0
		Stop

	Idle:
		U4GB Y 0 ACS_NamedExecuteWithResult("QCDE_WeaponSpawned",7,args[4],args[3])
		U4GB Y 0 A_SetArg(3, 1)
		U4GB Y -1 A_SetArg(4, 0)
		Wait
	Pickup:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMPickup")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"WeaponStay")
		TNT1 A 0 A_GiveInventory("QCHeavyMachinegun")
		TNT1 A 0 A_JumpIf(CallACS("QCDE_SelectUpgradedWeapon",1,0,0,0), "Stay") // never jumps, but had to wrap CallACS or else the weapon will be always picked up
		TNT1 A 0 A_TakeInventory("QCMachinegun")
		Stop
	DMPickup:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"DMWeaponStay")
		TNT1 A 0 A_GiveInventory("QCHeavyMachinegunDM")
		TNT1 A 0 A_JumpIf(CallACS("QCDE_SelectUpgradedWeapon",1,0,0,0), "Stay") // never jumps, but had to wrap CallACS or else the weapon will be always picked up
		TNT1 A 0 A_TakeInventory("QCMachinegunDM")
		TNT1 A 0 A_TakeInventory("QCHeavyMachinegun")
		TNT1 A 0 A_TakeInventory("QCMachinegun")
		Stop
	WeaponStay:
		TNT1 A 0 A_JumpIfInventory("QCHeavyMachinegun",1,"Stay")
		TNT1 A 0 A_SpawnItemEx("QCHeavyMachinegun", velx,vely,velz, velx,vely,velz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Fail
	DMWeaponStay:
		TNT1 A 0 A_JumpIf(CallACS("QCDE_SelectUpgradedWeapon",1,0,0,0), "Stay") // never jumps, but had to wrap CallACS or else the weapon will be always picked up
		TNT1 A 0 A_TakeInventory("QCHeavyMachinegun")
		TNT1 A 0 A_JumpIfInventory("QCHeavyMachinegunDM",1,"Stay")
		TNT1 A 0 A_SpawnItemEx("QCHeavyMachinegunDM", velx,vely,velz, velx,vely,velz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Fail
	Stay:
		TNT1 A 0
		Fail
	HideIndefinitely:
		TNT1 A 1 A_SetTics(CallACS("QCDE_SetWeaponRespawnTics"))
		Goto Super::HideDoomish+1
	HideDoomish:
		TNT1 A 1
		TNT1 A 1 A_SetTics(CallACS("QCDE_SetWeaponRespawnTics"))
		Goto Super::HideDoomish+1
	}
}

Actor HeavyMachinegunPickupNoGravity : HeavyMachinegunPickup 15610
{
	//$Category "QCDE Weapons (No Gravity)"
	//$Title "Minigun (No Gravity)"
	+NOGRAVITY
}

Actor QCHeavyMachinegun : QCWeapon
{
	Height 48
	Weapon.SwaySpeed 3.2
	Weapon.Kickback 20
	Weapon.SelectionOrder 1000
	Weapon.AmmoUse 1
	Weapon.AmmoUse2 1
	Weapon.AmmoGive 100
	Weapon.AmmoType "QCBulletAmmo"
	Weapon.AmmoType2 "QCBulletAmmo"
	Obituary "$OB_UTMinigun"
	Inventory.PickupMessage "$GOT_UTMinigun"
	Tag "$TAG_UTMinigun"
	Scale 0.64
	States
	{
	Spawn:
		TNT1 A 1
		U4GB Y 35 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		Goto Idle
	DMSpawn:
		U4GB ZZZZZZZZZZZZZZZ 35 Bright
		Stop
	Idle:
		U4GB Y -1
		Wait

	//-----------------------
	// Select/Deselect Seq
	//-----------------------
	Select:
		TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 9, "Select.UT99")
		TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 6, "Select.UC2")
		TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 4, "Select.UT2004")
		TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 1, "Select.U1")
	Select.U1:
		U1GB A 0
		Goto SelectCont
	Select.UT2004:
		U4GB A 0
		Goto SelectCont
	Select.UC2:
		U6GB A 0
		Goto SelectCont
	Select.UT99:
		U9GB A 0
		Goto SelectCont

	SelectCont:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,2)
		"####" A 0 A_PlaySound("QC/Weapons/Switch",CHAN_5,1,0,3) //Not in Weapon.UpSound because it interrupts CHAN_WEAPON sounds
		"####" A 0 A_TakeInventory("QCMachinegunDM")
		"####" A 0 A_TakeInventory("QCMachinegun")
		"####" A 0 A_StopSound(CHAN_WEAPON) //stops any weapon looping sound
	SelectLooper:
		"####" A 1 A_Raise
		"####" AAA 0 A_Raise
		Loop

	Deselect:
		"####" A 0 A_StopSound(5)
		"####" A 0 A_StopSound(CHAN_WEAPON)
	DeselectLooper:
		"####" A 1 A_Lower
		"####" AAA 0 A_Lower
		Loop

	//-----------------------
	// Ready Seq
	//-----------------------
	Ready:
		TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 9, "Ready.UT99")
		TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 6, "Ready.UC2")
		TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 4, "Ready.UT2004")
		TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 1, "Ready.U1")
	Ready.U1:
		U1GB A 0
		Goto ReadyCont
	Ready.UT2004:
		U4GB A 0
		Goto ReadyCont
	Ready.UC2:
		U6GB A 0
		Goto ReadyCont
	Ready.UT99:
		U9GB A 0
		Goto ReadyCont

	ReadyCont:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		"####" A 3 A_WeaponReady
		Loop

		ReadyCantFire:
			"####" A 0 A_StopSound(5)
			"####" A 0 A_StopSound(CHAN_WEAPON)
		RCFLooper:
			"####" A 4 A_WeaponReady(WRF_NOFIRE)
			"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"RCFLooper")
			Goto Ready

	//-----------------------
	// Fire Seq
	//-----------------------
	Fire:
		"####" A 0 A_JumpIfInventory("PowerQuad",1,"FireQuadSound")
		"####" A 0 A_JumpIfInventory("PowerTerminatorArtifact",1,"FireQuadSound")
		Goto FireNormalSound

		FireNormalSound:
			TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 9, "FireNormalSound.UT99")
			TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 6, "FireNormalSound.UC2")
			TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 4, "FireNormalSound.UT2004")
			TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 1, "FireNormalSound.U1")
		FireNormalSound.U1:
			U1GB A 0 A_PlaySound("UTDE/Weapons/Minigun/FireStartLoop_U1",CHAN_WEAPON,1,1)
			Goto FireLooper1
		FireNormalSound.UT2004:
			U4GB A 0 A_PlaySound("UTDE/Weapons/Minigun/FireStartLoop_UT2004",CHAN_WEAPON,1,1)
			Goto FireLooper1
		FireNormalSound.UC2:
			U6GB A 0 A_PlaySound("UTDE/Weapons/Minigun/FireStartLoop_UC2",CHAN_WEAPON,1,1)
			Goto FireLooper1
		FireNormalSound.UT99:
			U9GB A 0 A_PlaySound("UTDE/Weapons/Minigun/FireStartLoop_UT99",CHAN_WEAPON,1,1)
			Goto FireLooper1

		FireQuadSound:
			TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 9, "FireQuadSound.UT99")
			TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 6, "FireQuadSound.UC2")
			TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 4, "FireQuadSound.UT2004")
			TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 1, "FireQuadSound.U1")
		FireQuadSound.U1:
			U1GB A 0 A_PlaySound("UTDE/Weapons/Minigun/Quad/FireStartLoop_U1",CHAN_WEAPON,1,1)
			Goto FireLooper1
		FireQuadSound.UT2004:
			U4GB A 0 A_PlaySound("UTDE/Weapons/Minigun/Quad/FireStartLoop_UT2004",CHAN_WEAPON,1,1)
			Goto FireLooper1
		FireQuadSound.UC2:
			U6GB A 0 A_PlaySound("UTDE/Weapons/Minigun/Quad/FireStartLoop_UC2",CHAN_WEAPON,1,1)
			Goto FireLooper1
		FireQuadSound.UT99:
			U4GB A 0 A_PlaySound("UTDE/Weapons/Minigun/Quad/FireStartLoop_UT99",CHAN_WEAPON,1,1)
			Goto FireLooper1

	FireLooper1:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		"####" A 0 A_GunFlash("Flash")
		"####" B 1 Offset(2,35)
		"####" C 1 Offset(2,34)
		"####" D 1 Offset(1,33)
		"####" I 1 Offset(0,32) A_ReFire("FireLooper2")
		Goto EndFireLooper1

	FireLooper2:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		"####" A 0 A_GunFlash("Flash")
		"####" E 1 Offset(4,36)
		"####" F 1 Offset(4,35)
		"####" G 1 Offset(3,34)
		"####" H 1 Offset(1,33) A_ReFire("FireLooper3")
		Goto EndFireLooper2

	FireLooper3:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		"####" A 0 A_GunFlash("Flash")
		"####" B 1 Offset(5,38)
		"####" C 1 Offset(5,37)
		"####" D 1 Offset(4,36)
		"####" I 1 Offset(3,35) A_ReFire("FireLooper4")
		Goto EndFireLooper3

	FireLooper4:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		"####" A 0 A_GunFlash("Flash")
		"####" E 1 Offset(5,38)
		"####" F 1 Offset(5,37)
		"####" G 1 Offset(4,36)
		"####" H 1 Offset(3,35) A_ReFire("FireLooper3")
		Goto EndFireLooper3

	EndFireLooper1:
		TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 9, "EndFireLooper1.UT99")
		TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 6, "EndFireLooper1.UC2")
		TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 4, "EndFireLooper1.UT2004")
		TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 1, "EndFireLooper1.U1")
	EndFireLooper1.U1:
		U1GB A 0 A_PlaySound("UTDE/Weapons/Minigun/FireEnd_U1",CHAN_WEAPON,1,0)
		Goto EndFireLooper1Static
	EndFireLooper1.UT2004:
		U4GB A 0 A_PlaySound("UTDE/Weapons/Minigun/FireEnd_UT2004",CHAN_WEAPON,1,0)
		Goto EndFireLooper1Cont
	EndFireLooper1.UC2:
		U6GB A 0 A_PlaySound("UTDE/Weapons/Minigun/FireEnd_UC2",CHAN_WEAPON,1,0)
		Goto EndFireLooper1Cont
	EndFireLooper1.UT99:
		U9GB A 0 A_PlaySound("UTDE/Weapons/Minigun/FireEnd_UT99",CHAN_WEAPON,1,0)
		Goto EndFireLooper1Cont

	EndFireLooper1Cont:
		"####" KNQIKKMOQHIJKLMNOPQHHIIJJKKLLLMMMNNNOOOOPPPPQQQQ 1 A_WeaponReady(WRF_NOBOB)
		Goto Ready

	EndFireLooper1Static:
		"####" HHHIIIJJJKKKLLLMMMNNNOOOPPPQQQRRRSSSTTTUUUVVV 1 A_WeaponReady(WRF_NOBOB)
		Goto Ready

	EndFireLooper2:
		TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 9, "EndFireLooper2.UT99")
		TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 6, "EndFireLooper2.UC2")
		TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 4, "EndFireLooper2.UT2004")
		TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 1, "EndFireLooper2.U1")
	EndFireLooper2.U1:
		U1GB A 0 A_PlaySound("UTDE/Weapons/Minigun/FireEnd_U1",CHAN_WEAPON,1,0)
		Goto EndFireLooper2Static
	EndFireLooper2.UT2004:
		U4GB A 0 A_PlaySound("UTDE/Weapons/Minigun/FireEnd_UT2004",CHAN_WEAPON,1,0)
		Goto EndFireLooper2Cont
	EndFireLooper2.UC2:
		U6GB A 0 A_PlaySound("UTDE/Weapons/Minigun/FireEnd_UC2",CHAN_WEAPON,1,0)
		Goto EndFireLooper2Cont
	EndFireLooper2.UT99:
		U9GB A 0 A_PlaySound("UTDE/Weapons/Minigun/FireEnd_UT99",CHAN_WEAPON,1,0)
		Goto EndFireLooper2Cont

	EndFireLooper2Cont:
		"####" K 1 Offset(0,32)
		"####" NQIKKMOQHIJKLMNOPQHHIIJJKKLLLMMMNNNOOOOPPPPQQQQ 1 A_WeaponReady(WRF_NOBOB)
		Goto Ready

	EndFireLooper2Static:
		"####" H 1 Offset(0,32)
		"####" HHIIIJJJKKKLLLMMMNNNOOOPPPQQQRRRSSSTTTUUUVVV 1 A_WeaponReady(WRF_NOBOB)
		Goto Ready

	EndFireLooper3:
		TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 9, "EndFireLooper3.UT99")
		TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 6, "EndFireLooper3.UC2")
		TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 4, "EndFireLooper3.UT2004")
		TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 1, "EndFireLooper3.U1")
	EndFireLooper3.U1:
		U1GB A 0 A_PlaySound("UTDE/Weapons/Minigun/FireEnd_U1",CHAN_WEAPON,1,0)
		Goto EndFireLooper3Static
	EndFireLooper3.UT2004:
		U4GB A 0 A_PlaySound("UTDE/Weapons/Minigun/FireEnd_UT2004",CHAN_WEAPON,1,0)
		Goto EndFireLooper3Cont
	EndFireLooper3.UC2:
		U6GB A 0 A_PlaySound("UTDE/Weapons/Minigun/FireEnd_UC2",CHAN_WEAPON,1,0)
		Goto EndFireLooper3Cont
	EndFireLooper3.UT99:
		U9GB A 0 A_PlaySound("UTDE/Weapons/Minigun/FireEnd_UT99",CHAN_WEAPON,1,0)
		Goto EndFireLooper3Cont

	EndFireLooper3Cont:
		"####" K 1 Offset(1,33)
		"####" N 1 Offset(0,32)
		"####" QIKKMOQHIJKLMNOPQHHIIJJKKLLLMMMNNNOOOOPPPPQQQQ 1 A_WeaponReady(WRF_NOBOB)
		Goto Ready

	EndFireLooper3Static:
		"####" H 1 Offset(1,33)
		"####" H 1 Offset(0,32)
		"####" HIIIJJJKKKLLLMMMNNNOOOPPPQQQRRRSSSTTTUUUVVV 1 A_WeaponReady(WRF_NOBOB)
		Goto Ready

	//-----------------------
	// Attack doers
	//-----------------------
	Flash:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_JumpIfInventory("HMG_UG_Ricochet",1,"FlashStrong")
		TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 7, "Flash.Default")
		TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 6, "Flash.UC2")
	Flash.Default:
		TNT1 A 0 A_FireBullets(1,1,1,random(10,15),"QCBulletPuff",FBF_NORANDOM|FBF_USEAMMO)
		Goto EndFlash
	Flash.UC2:
		TNT1 A 0 A_FireBullets(1,1,1,random(10,15),"QCBulletPuff_UC2",FBF_NORANDOM|FBF_USEAMMO)
		Goto EndFlash

	FlashStrong:
		TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 7, "FlashStrong.Default")
		TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 6, "FlashStrong.UC2")
	FlashStrong.Default:
		TNT1 A 0 A_FireBullets(1,1,1,random(15,23),"QCBulletStrongPuff",FBF_NORANDOM|FBF_USEAMMO)
		Goto EndFlash
	FlashStrong.UC2:
		TNT1 A 0 A_FireBullets(1,1,1,random(10,15),"QCBulletStrongPuff_UC2",FBF_NORANDOM|FBF_USEAMMO)
		Goto EndFlash

		EndFlash:
			TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 7, "EndFlash.Default")
			TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 6, "EndFlash.UC2")
		EndFlash.Default:
			TNT1 A 0 A_FireCustomMissile("BulletSmallTracer",frandom(1,-1),false,9,-3,FPF_NOUNLAGGED|FPF_SKIPOWNER,frandom(1,-1))
			TNT1 A 0 A_FireCustomMissile("MachinegunSmokeSpawner",0, false,3,2)
			TNT1 A 0 A_JumpIfInventory("WepNoFlashToken",1,"EndFlashCont")
			TNT1 A 0 A_SetBlend("Yellow",0.03,3)
			Goto EndFlashCont
		EndFlash.UC2:
			TNT1 A 0 A_FireCustomMissile("BulletSmallTracer_Quake4",frandom(1,-1),false,9,-3,FPF_NOUNLAGGED|FPF_SKIPOWNER,frandom(1,-1))
			TNT1 A 0 A_JumpIfInventory("WepNoFlashToken",1,"EndFlashCont")
			TNT1 A 0 A_SetBlend("Cyan",0.03,3)
			Goto EndFlashCont

		EndFlashCont:
			TNT1 A 0 A_JumpIfInventory("WepNoRecoilToken",1,"EndFlashNoRecoil")
			TNT1 A 1 A_SetPitch(Pitch-0.4)
			TNT1 AA 1 A_SetPitch(Pitch+0.2)
			Stop
		EndFlashNoRecoil:
			TNT1 A 1
			Stop

	//-----------------------
	// Alt Fire Seq
	//-----------------------
	AltFire:
		TNT1 A 0 A_JumpIfInventory("PowerQuad",1,"AltFireQuadSound")
		TNT1 A 0 A_JumpIfInventory("PowerTerminatorArtifact",1,"AltFireQuadSound")
		Goto AltFireNormalSound

		AltFireNormalSound:
			TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 9, "AltFireNormalSound.UT99")
			TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 6, "AltFireNormalSound.UC2")
			TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 4, "AltFireNormalSound.UT2004")
			TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 1, "AltFireNormalSound.U1")
		AltFireNormalSound.U1:
			U1GB A 0 A_PlaySound("UTDE/Weapons/Minigun/FireStartLoop_U1",CHAN_WEAPON,1,1)
			Goto AltFireLooper1
		AltFireNormalSound.UT2004:
			U4GB A 0 A_PlaySound("UTDE/Weapons/Minigun/FireStartLoop_UT2004",CHAN_WEAPON,1,1)
			Goto AltFireLooper1
		AltFireNormalSound.UC2:
			U6GB A 0 A_PlaySound("UTDE/Weapons/Minigun/FireStartLoop_UC2",CHAN_WEAPON,1,1)
			Goto AltFireLooper1
		AltFireNormalSound.UT99:
			U9GB A 0 A_PlaySound("UTDE/Weapons/Minigun/FireStartLoop_UT99",CHAN_WEAPON,1,1)
			Goto AltFireLooper1

		AltFireQuadSound:
			TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 9, "AltFireQuadSound.UT99")
			TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 6, "AltFireQuadSound.UC2")
			TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 4, "AltFireQuadSound.UT2004")
			TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 1, "AltFireQuadSound.U1")
		AltFireQuadSound.U1:
			U1GB A 0 A_PlaySound("UTDE/Weapons/Minigun/Quad/FireStartLoop_U1",CHAN_WEAPON,1,1)
			Goto AltFireLooper1
		AltFireQuadSound.UT2004:
			U4GB A 0 A_PlaySound("UTDE/Weapons/Minigun/Quad/FireStartLoop_UT2004",CHAN_WEAPON,1,1)
			Goto AltFireLooper1
		AltFireQuadSound.UC2:
			U6GB A 0 A_PlaySound("UTDE/Weapons/Minigun/Quad/FireStartLoop_UC2",CHAN_WEAPON,1,1)
			Goto AltFireLooper1
		AltFireQuadSound.UT99:
			U9GB A 0 A_PlaySound("UTDE/Weapons/Minigun/Quad/FireStartLoop_UT99",CHAN_WEAPON,1,1)
			Goto AltFireLooper1

	AltFireFast:
		TNT1 A 0 A_JumpIfInventory("PowerQuad",1,"AltFireFastQuadSound")
		TNT1 A 0 A_JumpIfInventory("PowerTerminatorArtifact",1,"AltFireFastQuadSound")
		Goto AltFireFastNormalSound

		AltFireFastNormalSound:
			TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 9, "AltFireFastNormalSound.UT99")
			TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 6, "AltFireFastNormalSound.UC2")
			TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 4, "AltFireFastNormalSound.UT2004")
			TNT1 A 0 A_JumpIfInventory("UTMinigunSkin", 1, "AltFireFastNormalSound.U1")
		AltFireFastNormalSound.U1:
			U1GB A 0 A_PlaySound("UTDE/Weapons/Minigun/AltFireStartLoop_U1",CHAN_WEAPON,1,1)
			Goto AltFireLooperFast
		AltFireFastNormalSound.UT2004:
			U4GB A 0 A_PlaySound("UTDE/Weapons/Minigun/AltFireStartLoop_UT2004",CHAN_WEAPON,1,1)
			Goto AltFireLooperFast
		AltFireFastNormalSound.UC2:
			U6GB A 0 A_PlaySound("UTDE/Weapons/Minigun/AltFireStartLoop_UC2",CHAN_WEAPON,1,1)
			Goto AltFireLooperFast
