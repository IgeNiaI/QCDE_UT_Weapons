// --------------------------------------------------------------------------
//
// Pulse Gun
// Weapon and Pickup sprite by Pixo
// Weapon code by geNia
//
// --------------------------------------------------------------------------

Actor SuperNailgunPickup : CustomInventory 15603
{
	//$NotAngled
	//$Category "QCDE Weapons"
	//$Color 14
	//$Title "Pulse Rifle"
	Height 48
	Radius 20
	Scale 0.67
	Inventory.PickupSound "QC/Items/WeaponPick"
	Inventory.PickupMessage "$GOT_UTPulseGun"
	Tag "$TAG_UTPulseGun"
	Inventory.RespawnTics 35
	States
	{
	Spawn:
		UTPG Y 35 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		UTPG Y 35 A_CheckFlag("DROPPED", "BecomeWeaponItself")
		Goto Idle
	DMSpawn:
		"####" "#" 0 A_ChangeFlag("DROPPED", 0)
		UTPG Z -1 Bright ACS_NamedExecuteWithResult("QCDE_WeaponSpawned",12,args[4])
		Stop
	
	BecomeWeaponItself:
		TNT1 A 0 A_SpawnItemEx("QCSuperNailgun")
		TNT1 A 0 A_JumpIf(true, "End") Goto Idle // <-- this is to fool client-side predictor
	End:TNT1 A 0
		Stop
		
	Idle:
		UTPG Y -1 ACS_NamedExecuteWithResult("QCDE_WeaponSpawned",11,args[4])
		Wait
	Pickup:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMPickup")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"WeaponStay")
		TNT1 A 0 A_GiveInventory("QCSuperNailgun")
		TNT1 A 0 A_TakeInventory("QCNailgun")
		Stop
	DMPickup:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"DMWeaponStay")
		TNT1 A 0 A_GiveInventory("QCSuperNailgunDM")
		TNT1 A 0 A_TakeInventory("QCNailgunDM")
		TNT1 A 0 A_TakeInventory("QCSuperNailgun")
		TNT1 A 0 A_TakeInventory("QCNailgun")
		Stop
	WeaponStay:
		TNT1 A 0 A_JumpIfInventory("QCSuperNailgun",1,"Stay")
		TNT1 A 0 A_SpawnItemEx("QCSuperNailgun", velx,vely,velz, velx,vely,velz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Fail
	DMWeaponStay:
		TNT1 A 0 A_TakeInventory("QCSuperNailgun")
		TNT1 A 0 A_JumpIfInventory("QCSuperNailgunDM",1,"Stay")
		TNT1 A 0 A_SpawnItemEx("QCSuperNailgunDM", velx,vely,velz, velx,vely,velz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Fail
	Stay:
		TNT1 A 0
		Fail
	HideIndefinitely:
		TNT1 A 1 A_SetTics(CallACS("QCDE_SetWeaponRespawnTics"))
		Goto HideDoomish+1
	}
}


Actor QCSuperNailgun : QCWeapon
{
	Height 48
	Weapon.SwaySpeed 2.7
	Weapon.Kickback 0
	Weapon.SelectionOrder 1400
	Weapon.AmmoUse 1
	Weapon.AmmoUse2 1
	Weapon.AmmoGive 100
	Weapon.AmmoType "QCNailAmmo"
	Weapon.AmmoType2 "QCNailAmmo"
	Obituary "$OB_UTPulseGunAlt"
	Inventory.PickupMessage "$GOT_UTPulseGun"
	Tag "$TAG_UTPulseGun"
	Scale 0.67
	States
	{
	Spawn:
		UTPG Y 35 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		Goto Idle
	DMSpawn:
		UTPG ZZZZZZZZZZZZZZZ 35 Bright
		Stop
	Idle:
		UTPG Y -1
		Wait
		
	//-----------------------
	// Select/Deselect Seq
	//-----------------------
	Select:
		UTPG A 0 A_JumpIfInventory("NoWeaponFireToken",1,2)
		UTPG A 0 A_PlaySound("QC/Weapons/Switch",5,1,0,3) //Not in Weapon.UpSound because it interrupts CHAN_WEAPON sounds
		UTPG A 0 A_TakeInventory("QCNailgunDM")
		UTPG A 0 A_TakeInventory("QCNailgun")
		"####" "#" 0 A_StopSound(CHAN_WEAPON) //stops any weapon looping sound
	SelectLooper:
		UTPG A 1 A_Raise
		"####" "###" 0 A_Raise
		Loop
		
	Deselect:
		UTPG A 0 A_StopSound(5)
		UTPG A 0 A_StopSound(CHAN_WEAPON)
	DeselectLooper:
		UTPG A 1 A_Lower
		"####" "###" 0 A_Lower
		Loop

	//-----------------------
	// Ready Seq
	//-----------------------
	Ready:
		UTPG A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		UTPG A 3 A_WeaponReady
		Loop
		
		ReadyCantFire:
			UTPG A 0 A_StopSound(5)
			UTPG A 0 A_StopSound(CHAN_WEAPON)
		RCFLooper:
			UTPG A 4 A_WeaponReady(WRF_NOFIRE)
			UTPG A 0 A_JumpIfInventory("NoWeaponFireToken",1,"RCFLooper")
			Goto Ready

	//-----------------------
	// Fire Seq
	//-----------------------
	Fire:
		TNT1 A 0 A_JumpIfInventory("PowerQuad",1,"FireQuadSound")
		Goto FireNormalSound
		
		FireNormalSound:
			UTPG A 0 A_PlaySound("UTDE/Weapons/PulseGun/FireStartLoop",CHAN_WEAPON,1,1)
			Goto FireLooper
		FireQuadSound:
			UTPG A 0 A_PlaySound("UTDE/Weapons/PulseGun/Quad/FireStartLoop",CHAN_WEAPON,1,1)
			Goto FireLooper

	FireLooper:
		UTPG A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		UTPG B 0 A_GunFlash("Flash")
		UTPG B 1 Bright 	Offset(3,34)
		UTPG C 1 		 	Offset(6,36)
		UTPG D 1 			Offset(4,35)
		UTPG G 1 			Offset(2,34)
		UTPG H 1 			Offset(1,33)
		UTPG H 0 A_ReFire("FireLooper")
		Goto EndFireLooper

	EndFireLooper:
		UTPG A 0 A_PlaySound("UTDE/Weapons/PulseGun/FireEnd",CHAN_WEAPON,1,0)
		UTPG AEFGHAAEEFFGGHHA 1 A_WeaponReady(WRF_NOBOB)
		Goto Ready

	//-----------------------
	// Attack doers
	//-----------------------
	
	Flash:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_FireCustomMissile("UTPulseStrong",0,true,1,4)
		Goto EndFlash
		
		EndFlash:
			TNT1 A 0 A_JumpIfInventory("WepNoRecoilToken",1,"EndFlashNoRecoil")
			TNT1 A 1 A_SetPitch(Pitch-0.6)
			TNT1 AA 1 A_SetPitch(Pitch+0.3)
			Stop
		EndFlashNoRecoil:
			TNT1 A 1
			Stop
			
			
	//-----------------------
	// AltFire Seq
	//-----------------------
	AltFire:
		TNT1 A 0 A_JumpIfInventory("PowerQuad",1,"AltFireQuadSound")
		Goto AltFireNormalSound
		
		AltFireNormalSound:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/PulseGun/AltFireStartLoop",CHAN_WEAPON,1.0,1)
			TNT1 A 0 A_Jump(256,"AltFireLoop1") //for virtual jump to inherited versions
			Goto AltFireLoop1
		AltFireQuadSound:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/PulseGun/Quad/AltFireStartLoop",CHAN_WEAPON,1.0,1)
			TNT1 A 0 A_Jump(256,"AltFireLoop1") //for virtual jump to inherited versions
			Goto AltFireLoop1

	AltFireLoop1:	
		UTPG I 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		UTPG I 0 Offset(3,35)
		UTPG I 0 A_GunFlash("AltFlash")
		UTPG I 0 A_RailAttack(0,0,0,None,"White",RGF_SILENT|RGF_FULLBRIGHT|RGF_NOPIERCING,0,"None",0,0,512,1,25,1.0,"PGworldactor",-4)
		UTPG I 1 Bright A_FireBullets(0,0,1,random(8,16),"PulseBeamPuff",FBF_NORANDOM|FBF_NORANDOMPUFFZ|FBF_USEAMMO,512)
		UTPG J 0 A_RailAttack(0,0,0,None,"White",RGF_SILENT|RGF_FULLBRIGHT|RGF_NOPIERCING,0,"None",0,0,512,1,25,1.0,"PGworldactor",-4)
		UTPG J 0 Offset(2,33)
		UTPG J 1 Bright 
		UTPG J 0 A_ReFire("AltFireLoop2")
		Goto AltFireEnd

	AltFireLoop2:
		UTPG K 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		UTPG K 0 Offset(4,34)
		UTPG K 0 A_GunFlash("AltFlash")
		UTPG K 0 A_RailAttack(0,0,0,None,"White",RGF_SILENT|RGF_FULLBRIGHT|RGF_NOPIERCING,0,"None",0,0,512,1,25,1.0,"PGworldactor",-4)
		UTPG K 1 Bright A_FireBullets(0,0,1,random(8,16),"PulseBeamPuff",FBF_NORANDOM|FBF_NORANDOMPUFFZ,512)
		UTPG L 0 A_RailAttack(0,0,0,None,"White",RGF_SILENT|RGF_FULLBRIGHT|RGF_NOPIERCING,0,"None",0,0,512,1,25,1.0,"PGworldactor",-4)
		UTPG L 0 Offset(2,33)
		UTPG L 1 Bright 
		UTPG L 0 A_ReFire("AltFireLoop1")
		Goto AltFireEnd

	AltFireEnd:
		TNT1 A 0 A_StopSound(CHAN_WEAPON)
		UTPG A 1 Offset(1,33)
		Goto Ready

	AltFlash:
		TNT1 A 0 A_AlertMonsters
		TNT1 C 1 A_Light2
		TNT1 C 0 A_Light0
		Stop
	}
}

Actor UTPulseStrong : FastProjectile
{
	Projectile
	+FORCEXYBILLBOARD
	+BLOODSPLATTER
	+MTHRUSPECIES
	+DONTBLAST
	Obituary "$OB_UTPulseGun"
	Speed 52
	Radius 4
	Height 9
	Damage (random(18,27))
	Scale 0.30
	Decal "Q4PlasmaBlack"
	States
	{
	Spawn:
		PULS A 1 Bright
		Wait
	
	XDeath:
		TNT1 A 10 A_GiveToTarget("HitBeepMid",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		Stop
		
	Death:
		PULS A 0 A_PlaySound("UTDE/Weapons/PulseGun/Impact",CHAN_AUTO,1,0,1)
		PULS A 1 Light("YellowSmallFlicker3") Bright
		PULS BCDEFGH 1 Bright
		Stop
	}
}

Actor PulseBeamPuff
{
	+CLIENTSIDEONLY +NONETID
	+NOINTERACTION +NOTONAUTOMAP
	+ALWAYSPUFF
	+PUFFGETSOWNER
	+PUFFONACTORS
	+FORCEXYBILLBOARD
	+DONTSPLASH
	+MTHRUSPECIES
	Radius 10
	Scale 0.35
	Renderstyle Add
	Obituary "$OB_UTPulseGunAlt"
	Decal "Q4PlasmaBlack"
	States
	{
	XDeath:
		TNT1 A 0 
		TNT1 A 10 A_GiveToTarget("HitBeepLow",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		Stop
	}
}

// --------------------------------------------------------------------------
//	For competitive DM, weapons dont autoaim
// --------------------------------------------------------------------------
Actor QCSuperNailgunDM : QCSuperNailgun
{
	+WEAPON.NOAUTOAIM
	+CHEATNOTWEAPON
	Tag "$TAG_UTPulseGun"
	Weapon.AmmoGive 100
	Weapon.AmmoDmScale 1.0
	Weapon.AmmoDmRefill 15
	States
	{
	Flash:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_FireCustomMissile("UTPulseStrongDM",0,true,1,4)
		Goto EndFlash
	AltFireLoop1:
		UTPG I 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		UTPG I 0 Offset(3,35)
		UTPG I 0 A_GunFlash("AltFlash")
		UTPG I 0 A_RailAttack(0,0,0,None,"White",RGF_SILENT|RGF_FULLBRIGHT|RGF_NOPIERCING,0,"None",0,0,512,1,25,1.0,"PGworldactor",-4)
		UTPG I 1 Bright A_FireBullets(0,0,1,7,"PulseBeamPuffDM",FBF_NORANDOM|FBF_NORANDOMPUFFZ|FBF_USEAMMO,512)
		UTPG J 0 A_RailAttack(0,0,0,None,"White",RGF_SILENT|RGF_FULLBRIGHT|RGF_NOPIERCING,0,"None",0,0,512,1,25,1.0,"PGworldactor",-4)
		UTPG J 0 Offset(2,33)
		UTPG J 1 Bright
		UTPG J 0 A_ReFire("AltFireLoop2")
		Goto AltFireEnd

	AltFireLoop2:
		UTPG K 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		UTPG K 0 Offset(4,34)
		UTPG K 0 A_GunFlash("AltFlash")
		UTPG K 0 A_RailAttack(0,0,0,None,"White",RGF_SILENT|RGF_FULLBRIGHT|RGF_NOPIERCING,0,"None",0,0,512,1,25,1.0,"PGworldactor",-4)
		UTPG K 1 Bright A_FireBullets(0,0,1,7,"PulseBeamPuffDM",FBF_NORANDOM|FBF_NORANDOMPUFFZ,512)
		UTPG L 0 A_RailAttack(0,0,0,None,"White",RGF_SILENT|RGF_FULLBRIGHT|RGF_NOPIERCING,0,"None",0,0,512,1,25,1.0,"PGworldactor",-4)
		UTPG L 0 Offset(2,33)
		UTPG L 1 Bright
		UTPG L 0 A_ReFire("AltFireLoop1")
		Goto AltFireEnd
	}
}

Actor UTPulseStrongDM : UTPulseStrong
{
	-MTHRUSPECIES
	-DONTBLAST
	Damage (25)
}

Actor PulseBeamPuffDM : PulseBeamPuff
{
	-MTHRUSPECIES
}

