// --------------------------------------------------------------------------
//	For competitive DM, weapons dont autoaim
// --------------------------------------------------------------------------
Actor QCRocketLauncherDM : QCRocketLauncher
{
	+WEAPON.NOAUTOAIM
	+CHEATNOTWEAPON
	Tag "$TAG_UTRocketLauncher"
	Weapon.AmmoGive 12
	Weapon.AmmoDmScale 1.0
	Weapon.AmmoDmRefill 1
	States
	{

	//-----------------------
	// Primary Fire
	//-----------------------
	Fire:
		UTRL A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		TNT1 A 0 A_JumpIfInventory("RocketArena",1,"FireRA")
		TNT1 A 0 A_FireCustomMissile("UTRocketMissileDM", 0, true, 1, 5)
		Goto PostFire

		FireRA:
			TNT1 A 0 A_FireCustomMissile("UTRocketMissileDM", 0, false, 1, 5) // maybe shoot a no-self-damage rocket?
			Goto PostFire

	//-----------------------
	// Alt Fire
	//-----------------------
	Fire1:
		TNT1 A 0 A_JumpIfInventory("RocketArena",1,"FireRA1")
		TNT1 A 0 A_FireCustomMissile("UTRocketMissileDM", 0, false, 1, 5)
		Goto PostFire

		FireRA1:
			TNT1 A 0 A_FireCustomMissile("UTRocketMissileDM", 0, false, 1, 5)
			Goto PostFire

	Fire2:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("UTDE_RlAltCheck",0,0,0,0) == 1,"Fire2Alt")
		TNT1 A 0 A_JumpIfInventory("RocketArena",1,"FireRA2")
		TNT1 A 0 A_FireCustomMissile("UTRocketMissileDM", 3, false, 1, 5)
		TNT1 A 0 A_FireCustomMissile("UTRocketMissileDM", -3, false, 1, 5)
		Goto PostFire

		FireRA2:
			TNT1 A 0 A_FireCustomMissile("UTRocketMissileDM", 3, false, 1, 5)
			TNT1 A 0 A_FireCustomMissile("UTRocketMissileDM", -3, false, 1, 5)
			Goto PostFire

	Fire2Alt:
		TNT1 A 0 A_JumpIfInventory("RocketArena",1,"FireRA2Alt")
		TNT1 A 0 A_FireCustomMissile("UTRocketMissileSpinningTopDM", 0, false, 1, 7)
		TNT1 A 0 A_FireCustomMissile("UTRocketMissileSpinningBottomDM", 0, false, 1, 7)
		Goto PostFire

		FireRA2Alt:
			TNT1 A 0 A_FireCustomMissile("UTRocketMissileSpinningTopDM", 0, false, 1, 7)
			TNT1 A 0 A_FireCustomMissile("UTRocketMissileSpinningBottomDM", 0, false, 1, 7)
			Goto PostFire

	Fire3:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("UTDE_RlAltCheck",0,0,0,0) == 1,"Fire3Alt")
		TNT1 A 0 A_JumpIfInventory("RocketArena",1,"FireRA3")
		TNT1 A 0 A_FireCustomMissile("UTRocketMissileDM", 0, false, 1, 5)
		TNT1 A 0 A_FireCustomMissile("UTRocketMissileDM", 6, false, 1, 5)
		TNT1 A 0 A_FireCustomMissile("UTRocketMissileDM", -6, false, 1, 5)
		Goto PostFire

		FireRA3:
			TNT1 A 0 A_FireCustomMissile("UTRocketMissileDM", 0, false, 1, 5)
			TNT1 A 0 A_FireCustomMissile("UTRocketMissileDM", 6, false, 1, 5)
			TNT1 A 0 A_FireCustomMissile("UTRocketMissileDM", -6, false, 1, 5)
			Goto PostFire

	Fire3Alt:
		TNT1 A 0 A_JumpIfInventory("RocketArena",1,"FireRA3Alt")
		TNT1 A 0 A_FireCustomMissile("UTRocketMissileSpinningTopDM", 0, false, 1, 7)
		TNT1 A 0 A_FireCustomMissile("UTRocketMissileSpinningBottomLeftDM", 0, false, 1, 7)
		TNT1 A 0 A_FireCustomMissile("UTRocketMissileSpinningBottomRightDM", 0, false, 1, 7)
		Goto PostFire

		FireRA3Alt:
			TNT1 A 0 A_FireCustomMissile("UTRocketMissileSpinningTopDM", 0, false, 1, 7)
			TNT1 A 0 A_FireCustomMissile("UTRocketMissileSpinningBottomLeftDM", 0, false, 1, 7)
			TNT1 A 0 A_FireCustomMissile("UTRocketMissileSpinningBottomRightDM", 0, false, 1, 7)
			Goto PostFire
	}
}

