	Fire1:
		TNT1 A 0 A_JumpIfInventory("RocketArena",1,"FireRA1")
		TNT1 A 0 A_FireCustomMissile("UTRocketMissile", 0, false, 1, 5)
		Goto PostFire

		FireRA1:
			TNT1 A 0 A_FireCustomMissile("UTRocketMissile", 0, false, 1, 5)
			Goto PostFire

	Fire2:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("UTDE_RlAltCheck",0,0,0,0) == 1,"Fire2Alt")
		TNT1 A 0 A_JumpIfInventory("RocketArena",1,"FireRA2")
		TNT1 A 0 A_FireCustomMissile("UTRocketMissile", 3, false, 1, 5)
		TNT1 A 0 A_FireCustomMissile("UTRocketMissile", -3, false, 1, 5)
		Goto PostFire

		FireRA2:
			TNT1 A 0 A_FireCustomMissile("UTRocketMissile", 3, false, 1, 5)
			TNT1 A 0 A_FireCustomMissile("UTRocketMissile", -3, false, 1, 5)
			Goto PostFire

	Fire2Alt:
		TNT1 A 0 A_JumpIfInventory("RocketArena",1,"FireRA2Alt")
		TNT1 A 0 A_FireCustomMissile("UTRocketMissileSpinningTop", 0, false, 1, 7)
		TNT1 A 0 A_FireCustomMissile("UTRocketMissileSpinningBottom", 0, false, 1, 7)
		Goto PostFire

		FireRA2Alt:
			TNT1 A 0 A_FireCustomMissile("UTRocketMissileSpinningTop", 0, false, 1, 7)
			TNT1 A 0 A_FireCustomMissile("UTRocketMissileSpinningBottom", 0, false, 1, 7)
			Goto PostFire

	Fire3:
