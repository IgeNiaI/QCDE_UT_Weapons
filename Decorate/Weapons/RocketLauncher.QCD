		TNT1 A 0 A_JumpIfInventory("RocketArena",1,"FireRA3")
		TNT1 A 0 A_FireCustomMissile("UTRocketMissile", 0, false, 1, 5)
		TNT1 A 0 A_FireCustomMissile("UTRocketMissile", 6, false, 1, 5)
		TNT1 A 0 A_FireCustomMissile("UTRocketMissile", -6, false, 1, 5)
		Goto PostFire

		FireRA3:
			TNT1 A 0 A_FireCustomMissile("UTRocketMissile", 0, false, 1, 5)
			TNT1 A 0 A_FireCustomMissile("UTRocketMissile", 6, false, 1, 5)
			TNT1 A 0 A_FireCustomMissile("UTRocketMissile", -6, false, 1, 5)
			Goto PostFire

	Fire3Alt:
		TNT1 A 0 A_JumpIfInventory("RocketArena",1,"FireRA3Alt")
		TNT1 A 0 A_FireCustomMissile("UTRocketMissileSpinningTop", 0, false, 1, 7)
		TNT1 A 0 A_FireCustomMissile("UTRocketMissileSpinningBottomLeft", 0, false, 1, 7)
		TNT1 A 0 A_FireCustomMissile("UTRocketMissileSpinningBottomRight", 0, false, 1, 7)
		Goto PostFire

		FireRA3Alt:
			TNT1 A 0 A_FireCustomMissile("UTRocketMissileSpinningTop", 0, false, 1, 7)
			TNT1 A 0 A_FireCustomMissile("UTRocketMissileSpinningBottomLeft", 0, false, 1, 7)
			TNT1 A 0 A_FireCustomMissile("UTRocketMissileSpinningBottomRight", 0, false, 1, 7)
			Goto PostFire

	//-----------------------
	// Fire animations
	//-----------------------
	PostFire:		//28 tics, 0.8sec
		TNT1 A 0 A_GunFlash("FlashCheckSound")
		Goto PostPostFire
	PostAltFire:	//28 tics, 0.8sec
		TNT1 A 0 A_GunFlash("AltFlashCheckSound")
		Goto PostPostFire

	PostPostFire:
		TNT1 A 0 A_AlertMonsters

		UTRL B 1 Offset(20,29) Bright
		UTRL C 1 Offset(30,23) Bright
		UTRL D 1 Offset(33,17) Bright

		UTRL AAAA 1 Offset(37,14)

		TNT1 A 0 A_PlaySound("UTDE/Weapons/RocketLauncher/Load", CHAN_WEAPON, 1.0, 0)

		UTRL EEFFGGHHII 1 Offset(37,14)
		UTRL J 1 Offset(31,16)
		UTRL J 1 Offset(23,18)
		UTRL K 1 Offset(17,20)
		UTRL K 1 Offset(12,22)
		UTRL L 1 Offset(10,24)

		TNT1 A 0 A_JumpIfNoAmmo("PostPostFireNoAmmo")

		UTRL L 1 Offset(7,26)
		UTRL M 1 Offset(4,28)
		UTRL N 1 Offset(2,30)
		UTRL A 1 Offset(1,31)
		Goto Ready

	PostPostFireNoAmmo:
		UTRL O 1 Offset(7,26)
		UTRL O 1 Offset(4,28)
		UTRL O 1 Offset(2,30)
		UTRL O 1 Offset(1,31)
		Goto Ready

	FlashCheckSound:
		TNT1 A 0 A_JumpIfInventory("PowerQuad",1,"QuadSound")
		Goto NormalSound

		NormalSound:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/RocketLauncher/Fire", CHAN_WEAPON, 1.0, 0)
			Goto FlashEnder
		QuadSound:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/RocketLauncher/Quad/Fire", CHAN_WEAPON, 1.0, 0)
			Goto FlashEnder

	AltFlashCheckSound:
		TNT1 A 0 A_JumpIfInventory("PowerQuad",1,"AltQuadSound")
		Goto AltNormalSound

		AltNormalSound:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/RocketLauncher/AltFire", CHAN_WEAPON, 1.0, 0)
			Goto FlashEnder
		AltQuadSound:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/RocketLauncher/Quad/AltFire", CHAN_WEAPON, 1.0, 0)
			Goto FlashEnder

	FlashEnder:
		TNT1 A 0 A_JumpIfInventory("WepNoRecoilToken",1,"FlashEnderNoRecoil")
		TNT1 A 7 A_SetPitch(pitch-3.6)
		TNT1 AAAAAA 1 Offset(29,62) A_SetPitch(pitch+0.6)
		Stop
	FlashEnderNoRecoil:
		TNT1 A 1
		Stop

	}
}

Actor UTRocketMissile
{
	Projectile
	+DEHEXPLOSION
	+EXTREMEDEATH
	+FORCERADIUSDMG
	-ROCKETTRAIL
	+SEEKERMISSILE //Not actually used for anything other than checking radius.
	+MTHRUSPECIES
	+DONTBLAST
	Radius 3
	Height 6
	Speed 34
	Damage (random(60, 80))
	Scale 0.6
	Obituary "$OB_UTRocketLauncher"
	SeeSound ""
	DeathSound "UTDE/Weapons/RocketLauncher/RocketExplo"
	Decal "D4ExploScorch"
	DamageType "RocketDamage"
	States
	{
	Spawn:
		TNT1 A 0 NoDelay ACS_NamedExecuteAlways("QCDE_AttachWhoosh")
		RLRK A 2 Light("YellowMediumPoint2") Bright //no trails for a bit
	Looper:
		RLRK A 1 Light("YellowMediumPoint2") Bright A_SpawnItemEx("PlayerRocketTrailFire",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		RLRK A 0 A_SpawnItemEx("RocketTrailSmoke",-8,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		Loop

	Xdeath:	//Direct hit
		TNT1 A 0 A_GiveToTarget("HitBeepBig",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		TNT1 A 0 A_Jump(256,"DeathCont") //for virtual jump to inherited versions
		Goto DeathCont

	Death: //crashed somewhere and checks for splash
		TNT1 A 0 A_ChangeFlag("NOINTERACTION",1)
		TNT1 A 0 A_Stop
		TNT1 A 0 A_SeekerMissile(0,0,SMF_LOOK|SMF_CURSPEED,256)
		TNT1 A 0 A_JumpIfTargetInLOS("RadiusHit",360,JLOSF_PROJECTILE,192)
		TNT1 A 0 A_Jump(256,"DeathCont") //for virtual jump to inherited versions
		Goto DeathCont

		RadiusHit:	//splash damage beep
			TNT1 A 0 A_GiveToTarget("HitBeepMid",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
			TNT1 A 0 A_Jump(256,"DeathCont") //for virtual jump to inherited versions
			Goto DeathCont

	DeathCont:
		TNT1 A 0 A_Explode(15,128,XF_HURTSOURCE,0,18)	//self rocket damage with rocket jump is 15
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", true)
		TNT1 A 0 A_Explode(25,128,XF_HURTSOURCE,0,18)	//self rocket damage without rocket jump is 25
		TNT1 A 0 A_Explode(random(80,105),128,0,0,18)		//then another 80-105 extra damage for impacting a player + (60-100)dmg on the projectile =180-225dmg
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", false)
		TNT1 A 0 A_SpawnItemEx("QCRocketExploDebris",-1,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 AAAAA 0 A_SpawnItemEx("QCRocketExploParticle",3,0,0,frandom(3,5.5),frandom(3,5.5),frandom(1,6),random(0,359),SXF_NOCHECKPOSITION)
		TNT1 A 10 A_SpawnItemEx("QCRocketExplosion",-2,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		Stop
	}
}

