		Goto Fire2

	Charge210:
		UTRL A 1
		UTRL A 0 A_ReFire("Charge211")
		Goto Fire2

	Charge211:
		UTRL A 1
		UTRL A 0 A_ReFire("Charge212")
		Goto Fire2

	Charge212:
		UTRL A 1
		UTRL A 0 A_ReFire("Charge213")
		Goto Fire2

	Charge213:
		UTRL E 1
		UTRL A 0 A_ReFire("Charge214")
		Goto Fire2

	Charge214:
		UTRL E 1
		UTRL A 0 A_ReFire("Charge215")
		Goto Fire2

	Charge215:
		UTRL F 1
		UTRL A 0 A_ReFire("Charge216")
		Goto Fire2

	Charge216:
		UTRL A 1 A_PlaySound("UTDE/Weapons/RocketLauncher/Load", CHAN_WEAPON, 1.0, 0)
		UTRL A 0 A_ReFire("Charge217")
		Goto Fire2

	Charge217:
		UTRL G 1
		UTRL A 0 A_ReFire("Charge218")
		Goto Fire2

	Charge218:
