		UTRL A 0 A_ReFire("Charge113")
		Goto Fire1

	Charge113:
		UTRL E 1
		UTRL A 0 A_ReFire("Charge114")
		Goto Fire1

	Charge114:
		UTRL E 1
		UTRL A 0 A_ReFire("Charge115")
		Goto Fire1

	Charge115:
		UTRL F 1
		UTRL A 0 A_ReFire("Charge116")
		Goto Fire1

	Charge116:
		UTRL A 1 A_PlaySound("UTDE/Weapons/RocketLauncher/Load", CHAN_WEAPON, 1.0, 0)
		UTRL A 0 A_ReFire("Charge117")
		Goto Fire1

	Charge117:
