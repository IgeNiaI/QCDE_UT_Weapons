// --------------------------------------------------------------------------
//
// Rocket Launcher
// Pickup sprite by Pixo, weapon sprite by geNia
// Weapon code by geNia
//
// --------------------------------------------------------------------------

Actor RocketLauncherPickup : CustomInventory 15605
{
	//$NotAngled
	//$Category "QCDE Weapons"
	//$Color 14
	//$Title "Rocket Launcher"
	Height 48
	Radius 20
	Scale 0.69
	Inventory.PickupSound "QC/Items/WeaponPick"
	Inventory.PickupMessage "$GOT_UTRocketLauncher"
	Tag "$TAG_UTRocketLauncher"
	Inventory.RespawnTics 35
	States
	{
	Spawn:
		UTRL Y 35 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		Goto Idle
	DMSpawn:
		"####" "#" 0 A_ChangeFlag("DROPPED", 0)
		UTRL Z -1 Bright ACS_NamedExecuteWithResult("QCDE_WeaponSpawned",16,args[4])
		Stop
	Idle:
		UTRL Y -1 ACS_NamedExecuteWithResult("QCDE_WeaponSpawned",15,args[4])
		Wait
	Pickup:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMPickup")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"WeaponStay")
		TNT1 A 0 A_GiveInventory("QCRocketLauncher")
		TNT1 A 0
		Stop
	DMPickup:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"DMWeaponStay")
		TNT1 A 0 A_GiveInventory("QCRocketLauncherDM")
		TNT1 A 0
		TNT1 A 0 A_TakeInventory("QCRocketLauncher")
		TNT1 A 0
		Stop
	WeaponStay:
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncher",1,"Stay")
		TNT1 A 0 A_SpawnItemEx("QCRocketLauncher", velx,vely,velz, velx,vely,velz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Fail
	DMWeaponStay:
		TNT1 A 0 A_TakeInventory("QCRocketLauncher")
		TNT1 A 0 A_JumpIfInventory("QCRocketLauncherDM",1,"Stay")
		TNT1 A 0 A_SpawnItemEx("QCRocketLauncherDM", velx,vely,velz, velx,vely,velz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Fail
	Stay:
		TNT1 A 0
		Fail
	HideIndefinitely:
		TNT1 A 1 A_SetTics(CallACS("QCDE_SetWeaponRespawnTics"))
		Goto HideDoomish+1
	}
}


Actor QCRocketLauncher : QCWeapon
{
	Height 48
	Weapon.SwaySpeed 2.6
	Weapon.Kickback 0	//to allow rocket jumping that doesnt mess with your forward movement too much
	Weapon.SelectionOrder 1900
	Weapon.AmmoUse 1
	Weapon.AmmoUse2 1
	Weapon.AmmoGive 12
	Weapon.AmmoType "QCRocketAmmo"
	Weapon.AmmoType2 "QCRocketAmmo"
	Inventory.PickupMessage "$GOT_UTRocketLauncher"
	Obituary "$OB_UTRocketLauncher"
	Tag "$TAG_UTRocketLauncher"
	Scale 0.69
	States
	{
	Spawn:
		TNT1 A 1
		UTRL Y 35 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		Goto Idle
	DMSpawn:
		UTRL ZZZZZZZZZZZZZZZ 35 Bright
		Stop
	Idle:
		UTRL Y -1
		Wait

	//-----------------------
	// Ready Seq
	//-----------------------
	Ready:
		UTRL A 0 A_JumpIfNoAmmo("ReadyNoAmmoLoop")
	ReadyLoop:
		UTRL A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		UTRL A 4 A_WeaponReady
		Loop
	ReadyNoAmmoLoop:
		UTRL O 4 A_WeaponReady
		UTRL O 0 A_JumpIfNoAmmo("ReadyNoAmmoLoop")
		UTRL MN 1
		Goto ReadyLoop

		ReadyCantFire:
			UTRL A 0 A_StopSound(5)
			UTRL A 0 A_StopSound(CHAN_WEAPON)
		RCFLooper:
			UTRL A 4 A_WeaponReady(WRF_NOFIRE)
			UTRL A 0 A_JumpIfInventory("NoWeaponFireToken",1,"RCFLooper")
			Goto Ready
	//-----------------------
	// Select/Deselect Seq
	//-----------------------
	Select:
		UTRL A 0 A_JumpIfInventory("NoWeaponFireToken",1,2)
		UTRL A 0 A_PlaySound("QC/Weapons/Switch",5,1,0,3)
	SelectLooper:
		UTRL A 1 A_Raise
		"####" "###" 0 A_Raise
		Loop

	Deselect:
		UTRL A 0 A_StopSound(5)
		UTRL A 0 A_StopSound(CHAN_WEAPON)
	DeselectLooper:
		UTRL A 1 A_Lower
		"####" "###" 0 A_Lower
		Loop

	//-----------------------
	// Fire Seq
	//-----------------------
	Fire:
		UTRL A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		TNT1 A 0 A_JumpIfInventory("RocketArena",1,"FireRA")
		TNT1 A 0 A_FireCustomMissile("UTRocketMissile", 0, true, 1, 5)
		Goto PostFire

		FireRA:
			TNT1 A 0 A_FireCustomMissile("UTRocketMissile", 0, false, 1, 5) // maybe shoot a no-self-damage rocket?
			Goto PostFire

	//-----------------------
	// AltFire Seq
	//-----------------------
	AltFire:
		UTRL A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		Goto Charge100

	// Charge 1
	Charge100:
		TNT1 A 0 A_FireCustomMissile("AmmoSpender", 0, true, 5, 2, FPF_NOUNLAGGED)
		UTRL A 1
		UTRL A 0 A_JumpIfNoAmmo("Fire1")
		UTRL A 0 A_ReFire("Charge101")
		Goto Fire1

	Charge101:
		UTRL A 1
		UTRL A 0 A_ReFire("Charge102")
		Goto Fire1

	Charge102:
		UTRL A 1
		UTRL A 0 A_ReFire("Charge103")
		Goto Fire1

	Charge103:
		UTRL A 1
		UTRL A 0 A_ReFire("Charge104")
		Goto Fire1

	Charge104:
		UTRL A 1
		UTRL A 0 A_ReFire("Charge105")
		Goto Fire1

	Charge105:
		UTRL A 1
		UTRL A 0 A_ReFire("Charge106")
		Goto Fire1

	Charge106:
		UTRL A 1
		UTRL A 0 A_ReFire("Charge107")
		Goto Fire1

	Charge107:
		UTRL A 1
		UTRL A 0 A_ReFire("Charge108")
		Goto Fire1

	Charge108:
		UTRL A 1
		UTRL A 0 A_ReFire("Charge109")
		Goto Fire1

	Charge109:
