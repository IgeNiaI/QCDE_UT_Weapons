// --------------------------------------------------------------------------
//
// Redeemer
// Weapon and Pickup sprite by ?
// Weapon code by geNia
//
// --------------------------------------------------------------------------

Actor BFGPickup : CustomInventory 15608
{
	//$NotAngled
	//$Category "QCDE Weapons"
	//$Color 14
	//$Title "BFG 10k"
	Height 48
	Radius 20
	Scale 0.65
	Inventory.PickupSound "QC/Items/WeaponPick"
	Inventory.PickupMessage "$GOT_UTRedeemer"
	Tag "$TAG_UTRedeemer"
	Inventory.RespawnTics 2100	//60sec

	States
	{
	Spawn:
		UTRD Y 0 NoDelay ACS_NamedExecuteWithResult("QCDE_RemoveIfDuel")
		UTRD Y 35 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		Goto Idle
	DMSpawn:
		UTRD Z 0 A_ChangeFlag("DROPPED", false)
		UTRD Z 70 Bright ACS_NamedExecuteWithResult("QCDE_WeaponSpawned",22,args[4])
		UTRD Z 0 A_ChangeFlag("NOGRAVITY", false)
		UTRD Z -1 Bright
		Stop
	Idle:
		UTRD Y -1 ACS_NamedExecuteWithResult("QCDE_WeaponSpawned",21,args[4])
		Wait
	Pickup:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMPickup")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"WeaponStay")
		TNT1 A 0 A_GiveInventory("QCBFG")
		TNT1 A 0 
		Stop
	DMWeaponStay: // BFG doesn't stay even if it wants to in DM
	DMPickup:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"DMWeaponStay")
		TNT1 A 0 A_GiveInventory("QCBFGDM")
		TNT1 A 0
		TNT1 A 0 A_TakeInventory("QCBFG")
		TNT1 A 0
		Stop
	WeaponStay:
		TNT1 A 0 A_JumpIfInventory("QCBFG",1,"Stay")
		TNT1 A 0 A_SpawnItemEx("QCBFG", velx,vely,velz, velx,vely,velz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Fail
	Stay:
		TNT1 A 0
		Fail
	}
}

Actor QCBFG : QCWeapon
{
	Height 48
	Weapon.SwaySpeed 1.3
	Weapon.SelectionOrder 6666 // lowest
	Weapon.AmmoUse 1
	Weapon.AmmoUse2 1
	Weapon.AmmoGive 1
	Weapon.AmmoType "QCBFGAmmo"
	Weapon.AmmoType2 "QCBFGAmmo"
	Obituary "$OB_UTRedeemer"
	+WEAPON.WIMPY_WEAPON
	Inventory.PickupMessage "$GOT_UTRedeemer"
	Tag "$TAG_UTRedeemer"
	Scale 0.65
	States
	{
	Spawn:
		UTRD Y 35 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		Goto Idle
	DMSpawn:
		"####" "#" 0 ACS_NamedExecuteAlways("QCDE_RemoveIfDuel")
		UTRD ZZZZZZZZZZZZZZZ 35 Bright
		Stop
	Idle:
		UTRD Y -1
		Wait
	//-----------------------
	// Ready Seq
	//-----------------------
	Ready:
		UTRD A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		UTRD A 4 A_WeaponReady
		Loop
		
		ReadyCantFire:
			UTRD A 0 A_StopSound(5)
			UTRD A 0 A_StopSound(CHAN_WEAPON)
		RCFLooper:
			UTRD A 4 A_WeaponReady(WRF_NOFIRE)
			UTRD A 0 A_JumpIfInventory("NoWeaponFireToken",1,"RCFLooper")
			Goto Ready
	//-----------------------
	// Select/Deselect Seq
	//-----------------------
	Select:
		UTRD A 0 A_JumpIfInventory("NoWeaponFireToken",1,2)
		UTRD A 0 A_PlaySound("QC/Weapons/Switch",5,1,0,3)
	SelectLooper:
		UTRD A 1 A_Raise
		"####" "###" 0 A_Raise
		Loop
		
	Deselect:
		UTRD A 0 A_StopSound(5)
		UTRD A 0 A_StopSound(CHAN_WEAPON)
	DeselectLooper:
		UTRD A 1 A_Lower
		"####" "###" 0 A_Lower
		Loop
		
	//-----------------------
	// Fire Seq
	//-----------------------
	Fire:
		UTRD A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		TNT1 A 0 A_FireCustomMissile("UTRedeemerMissile", 0, true, 1, 5)
		Goto PostFire
	
	//-----------------------
	// AltFire Seq
	//-----------------------
	AltFire:
		UTRD A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		TNT1 A 0 A_FireCustomMissile("UTRedeemerMissileFast", 0, true, 1, 5)
		Goto PostFire

	//-----------------------
	// Fire animations
	//-----------------------
	PostFire:	//28 tics, 0.8sec
		TNT1 A 0 A_GunFlash("FlashCheckSound")
		TNT1 A 0 A_AlertMonsters
		
		UTRD B 1 Bright Offset(3, 34)
		UTRD B 1 Bright Offset(5, 36)
		UTRD B 1 Bright Offset(7, 38)
		UTRD C 1 Offset(9, 40)
		UTRD D 1
		UTRD E 1
		UTRD F 1
		UTRD F 1
		UTRD F 1
		UTRD F 1
		UTRD F 1
		UTRD F 1
		UTRD F 1
		UTRD E 1
		UTRD E 1
		UTRD E 1
		UTRD E 1
		UTRD E 1
		UTRD E 1
		UTRD D 1
		UTRD D 1
		UTRD D 1 Offset(9, 40)
		UTRD D 1 Offset(8, 39)
		UTRD D 1 Offset(7, 38)
		UTRD D 1 Offset(6, 37)
		UTRD C 1 Offset(5, 36)
		UTRD C 1 Offset(4, 35)
		UTRD C 1 Offset(3, 34)
		UTRD C 1 Offset(2, 33)
		UTRD C 1 Offset(1, 32)
		UTRD C 1 Offset(0, 31)
		Goto Ready

	FlashCheckSound:
		TNT1 A 0 A_JumpIfInventory("PowerQuad",1,"QuadSound")
		Goto NormalSound
		
		NormalSound:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Redeemer/Fire", CHAN_WEAPON, 1.0, 0)
			Goto FlashEnder
		QuadSound:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Redeemer/Quad/Fire", CHAN_WEAPON, 1.0, 0)
			Goto FlashEnder

	FlashEnder:
		TNT1 A 0 A_JumpIfInventory("WepNoRecoilToken",1,"FlashEnderNoRecoil")
		TNT1 A 7 A_SetPitch(pitch-3.6)
		TNT1 AAAAAA 1 Offset(29,62) A_SetPitch(pitch+0.6)
		Stop
	FlashEnderNoRecoil:
		TNT1 A 1
		Stop

	}
}

// --------------------------------------------------------------------------
//	For competitive DM, weapons dont autoaim
// --------------------------------------------------------------------------
Actor QCBFGDM : QCBFG
{	
	+WEAPON.NOAUTOAIM	
	+CHEATNOTWEAPON
	Tag "$TAG_UTRedeemer"
	Weapon.SelectionOrder 666 // highest
	Weapon.AmmoGive 1
	Weapon.AmmoDmScale 1.0
	Weapon.AmmoDmRefill 1
}

Actor UTRedeemerMissile
{
	Projectile
	+RANDOMIZE
	+DEHEXPLOSION
	+EXTREMEDEATH
	+FORCERADIUSDMG
	-ROCKETTRAIL
	+SEEKERMISSILE //Not actually used for anything other than checking radius.
	Radius 8
	Height 14
	Speed 16
	Damage 0
	Scale 0.6
	Obituary "$OB_UTRedeemer"
	SeeSound ""
	DeathSound "UTDE/Weapons/Redeemer/RocketExplo"
	Decal "D4ExploScorch"
	DamageType "RocketDamage"
	States
	{
	Spawn:
		TNT1 A 0 A_PlaySound("UTDE/Weapons/Redeemer/Fly",CHAN_5|CHAN_NOPAUSE,1.0,true)
		TNT1 A 0 ACS_NamedExecuteAlways("UTDE_AttachWhoosh")
		RDRK A 2 Light("YellowMediumPoint2") Bright //no trails for a bit
	Looper:
		RDRK A 1 Light("YellowMediumPoint2") Bright A_SpawnItemEx("PlayerRocketTrailFire",-20,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		RDRK A 0 A_SpawnItemEx("RocketTrailSmoke",-20,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		Loop

	Xdeath:	//Direct hit
		TNT1 A 0 A_GiveToTarget("HitBeepBig",1)
		Goto DeathCont
		
	Death: //crashed somewhere and checks for splash
		TNT1 A 0 A_ChangeFlag("NOINTERACTION",1)
		TNT1 A 0 A_Stop
		TNT1 A 0 A_SeekerMissile(0,0,SMF_LOOK|SMF_CURSPEED,256)
		TNT1 A 0 A_JumpIfTargetInLOS("RadiusHit",360,JLOSF_PROJECTILE,180)
		Goto DeathCont
		
		RadiusHit:	//splash damage beep
			TNT1 A 0 A_GiveToTarget("HitBeepBig",1)
			Goto DeathCont
		
	DeathCont:
		TNT1 A 0 A_Explode(1500,1024,1,0,18)
		
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion",  0, 0, 0,   0,    0,    0,     0,SXF_NOCHECKPOSITION)
		
		// +X
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion",  5, 0, 0,   2.5,  0,    0,     0,SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion",  5, 0, 0,   5,    0,    0,     0,SXF_NOCHECKPOSITION)
		                                               
		// +X +Y                                       
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion",  5, 5, 0,   2.5,  2.5,  0,     0,SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion",  5, 5, 0,   5,    5,    0,     0,SXF_NOCHECKPOSITION)
		                                               
		// +X -Y                                       
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion",  5,-5, 0,   2.5, -2.5,  0,     0,SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion",  5,-5, 0,   5,   -5,    0,     0,SXF_NOCHECKPOSITION)
		                                               
		// -X                                          
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion", -5, 0, 0,  -2.5,  0,    0,     0,SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion", -5, 0, 0,  -5,    0,    0,     0,SXF_NOCHECKPOSITION)
		                                               
		// -X +Y                                       
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion", -5, 5, 0,  -2.5,  2.5,  0,     0,SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion", -5, 5, 0,  -5,    5,    0,     0,SXF_NOCHECKPOSITION)
		                                               
		// -X -Y                                       
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion", -5,-5, 0,  -2.5, -2.5,  0,     0,SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion", -5,-5, 0,  -5,   -5,    0,     0,SXF_NOCHECKPOSITION)
                                                       
		// +Y                                          
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion",  0, 5, 0,   0,    2.5,  0,     0,SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion",  0, 5, 0,   0,    5,    0,     0,SXF_NOCHECKPOSITION)
																   
		// -Y                                          
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion",  0,-5, 0,   0,   -2.5,  0,     0,SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion",  0,-5, 0,   0,   -5,    0,     0,SXF_NOCHECKPOSITION)
		                                               
		// +X +Z                                       
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion",  5, 0, 5,   2.5,  0,    2.5,   0,SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion",  5, 0, 5,   5,    0,    5,     0,SXF_NOCHECKPOSITION)
		                                               
		// +X +Y +Z                                    
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion",  5, 5, 5,   2.5,  2.5,  2.5,   0,SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion",  5, 5, 5,   5,    5,    5,     0,SXF_NOCHECKPOSITION)
		                                               
		// +X -Y +Z                                    
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion",  5,-5, 5,   2.5, -2.5,  2.5,   0,SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion",  5,-5, 5,   5,   -5,    5,     0,SXF_NOCHECKPOSITION)
		                                               
		// -X +Z                                       
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion", -5, 0, 5,  -2.5,  0,    2.5,   0,SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion", -5, 0, 5,  -5,    0,    5,     0,SXF_NOCHECKPOSITION)
		                                               
		// -X +Y +Z                                    
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion", -5, 5, 5,  -2.5,  2.5,  2.5,   0,SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion", -5, 5, 5,  -5,    5,    5,     0,SXF_NOCHECKPOSITION)
		                                               
		// -X -Y +Z                                    
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion", -5,-5, 5,  -2.5, -2.5,  2.5,   0,SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion", -5,-5, 5,  -5,   -5,    5,     0,SXF_NOCHECKPOSITION)
                                                       
		// +Y +Z                                       
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion",  0, 5, 5,   0,    2.5,  2.5,   0,SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion",  0, 5, 5,   0,    5,    5,     0,SXF_NOCHECKPOSITION)
																   
		// -Y +Z                                                   
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion",  0,-5, 5,   0,   -2.5,  2.5,   0,SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion",  0,-5, 5,   0,   -5,    5,     0,SXF_NOCHECKPOSITION)
																   
		// +Z                                                      
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion",  0, 0, 5,   0,    0,    5,     0,SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion",  0, 0, 5,   0,    0,    7.5,   0,SXF_NOCHECKPOSITION)
		                                               
		// +X -Z                                       
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion",  5, 0,-5,   2.5,  0,   -2.5,   0,SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion",  5, 0,-5,   5,    0,   -5,     0,SXF_NOCHECKPOSITION)
		                                               
		// +X +Y -Z                                    
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion",  5, 5,-5,   2.5,  2.5, -2.5,   0,SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion",  5, 5,-5,   5,    5,   -5,     0,SXF_NOCHECKPOSITION)
		                                               
		// +X -Y -Z                                    
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion",  5,-5,-5,   2.5, -2.5, -2.5,   0,SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion",  5,-5,-5,   5,   -5,   -5,     0,SXF_NOCHECKPOSITION)
		                                               
		// -X -Z                                       
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion", -5, 0,-5,  -2.5,  0,   -2.5,   0,SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion", -5, 0,-5,  -5,    0,   -5,     0,SXF_NOCHECKPOSITION)
		                                               
		// -X +Y -Z                                    
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion", -5, 5,-5,  -2.5,  2.5, -2.5,   0,SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion", -5, 5,-5,  -5,    5,   -5,     0,SXF_NOCHECKPOSITION)
		                                               
		// -X -Y -Z                                    
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion", -5,-5,-5,  -2.5, -2.5, -2.5,   0,SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion", -5,-5,-5,  -5,   -5,   -5,     0,SXF_NOCHECKPOSITION)
                                                       
		// +Y -Z                                       
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion",  0, 5,-5,   0,    2.5, -2.5,   0,SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion",  0, 5,-5,   0,    5,   -5,     0,SXF_NOCHECKPOSITION)
																   
		// -Y -Z                                                   
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion",  0,-5,-5,   0,   -2.5, -2.5,   0,SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion",  0,-5,-5,   0,   -5,   -5,     0,SXF_NOCHECKPOSITION)
																   
		// -Z                                                      
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion",  0, 0,-5,   0,    0,   -5,     0,SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion",  0, 0,-5,   0,    0,   -7.5,   0,SXF_NOCHECKPOSITION)
		
		TNT1 A 10
		Stop		
	}
}

// Faster version, but can be shot
Actor UTRedeemerMissileFast : UTRedeemerMissile {
	+SHOOTABLE
	-NOBLOCKMAP
	Speed 20
	Health 10000
	PainChance 256
	
	States
	{
	Pain:
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion",  0, 0, 0,   0,    0,    0,     0,SXF_NOCHECKPOSITION)
		Stop
	}
}

Actor UTRedeemerExplosion
{
	+NOTONAUTOMAP
	+CLIENTSIDEONLY +NONETID
	+FORCEXYBILLBOARD
	+DONTBLAST
	+NOGRAVITY
	Radius 1
	Height 1
	Scale 0.5
	States
	{
	Spawn:
		X125 A 0
		X125 A 2 Light("YellowSmallFlicker2") 	Bright A_SetScale(scalex+0.1125)
		X125 A 2 Light("YellowMediumFlicker3") 	Bright A_SetScale(scalex+0.1125)
		X125 B 2 Light("YellowMediumFlicker1") 	Bright A_SetScale(scalex+0.075)
		X125 B 2 Light("YellowBigFlicker3") 	Bright A_SetScale(scalex+0.075)
		X125 C 2 Light("YellowBigFlicker3") 	Bright A_SetScale(scalex+0.0525)
		X125 C 2 Light("YellowBigFlicker3") 	Bright A_SetScale(scalex+0.0525)
		X125 D 2 Light("YellowBigFlicker3") 	Bright
		X125 D 2 Light("YellowBigFlicker3") 	Bright
		X125 E 2 Light("YellowBigFlicker3")		Bright A_SetScale(scalex*1.05)
		X125 E 2 Light("YellowMediumFlicker1")	Bright 
		X125 F 2 Light("YellowMediumFlicker1")	Bright A_SetScale(scalex*1.05)
		X125 F 2 Light("YellowMediumFlicker2")	Bright 
		X125 G 2 Light("YellowMediumFlicker2")	Bright A_SetScale(scalex*1.05)
		X125 G 2 Light("YellowMediumFlicker3")	Bright 
		X125 H 1 Light("YellowSmallFlicker1")	Bright A_SetScale(scalex*1.05)
		X125 H 2 Light("YellowSmallFlicker1")	Bright A_FadeOut(0.075)
		X125 H 2 Light("YellowSmallFlicker2")	Bright A_FadeOut(0.075)
		X125 I 1 Light("YellowSmallFlicker3")	Bright A_SetScale(scalex*1.05)
		X125 I 2 Light("YellowSmallFlicker3")	Bright A_FadeOut(0.075)
		X125 I 2 Bright A_FadeOut(0.075)
		X125 J 1 Bright A_SetScale(scalex*1.05)
		X125 J 2 Bright A_FadeOut(0.075)
		X125 J 2 Bright A_FadeOut(0.075)
		X125 K 1 Bright A_SetScale(scalex*1.05)
		X125 K 2 Bright A_FadeOut(0.075)
		X125 K 2 Bright A_FadeOut(0.075)
		X125 L 1 Bright A_FadeOut(0.075)
		X125 L 2 Bright A_SetScale(scalex*1.05) 
		X125 L 2 Bright A_FadeOut(0.075)
		X125 M 1 Bright A_FadeOut(0.075)
		X125 M 2 Bright A_SetScale(scalex*1.05) 
		X125 M 2 Bright A_FadeOut(0.075)
		X125 N 1 Bright A_FadeOut(0.075)
		X125 N 2 Bright A_SetScale(scalex*1.05) 
		X125 N 2 Bright A_FadeOut(0.075)
		X125 O 1 Bright A_FadeOut(0.075)
		X125 O 2 Bright A_SetScale(scalex*1.05) 
		X125 O 2 Bright A_FadeOut(0.075)
		X125 P 1 Bright A_FadeOut(0.075)
		X125 P 2 Bright A_SetScale(scalex*1.05) 
		X125 P 2 Bright A_FadeOut(0.075)
		X125 Q 1 Bright A_FadeOut(0.075)
		X125 Q 2 Bright A_SetScale(scalex*1.05) 
		X125 Q 2 Bright A_FadeOut(0.075)
		X125 R 1 Bright A_FadeOut(0.075)
		X125 R 2 Bright A_SetScale(scalex*1.05) 
		X125 R 2 Bright A_FadeOut(0.075)
		Stop
	}
}
