		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion_Modded", 0, 0, 0,   1.2,  1.2, -1.2,	0,SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion_Modded", 0, 0, 0,   2.4,  2.4, -2.4,	0,SXF_NOCHECKPOSITION)

		// +X -Y -Z
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion_Modded", 0, 0, 0,   1.2, -1.2, -1.2,	0,SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion_Modded", 0, 0, 0,   2.4, -2.4, -2.4,	0,SXF_NOCHECKPOSITION)

		// -X -Z
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion_Modded", 0, 0, 0,  -1.7,  0.0, -1.7,	0,SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion_Modded", 0, 0, 0,  -3.5,  0.0, -3.5,	0,SXF_NOCHECKPOSITION)

		// -X +Y -Z
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion_Modded", 0, 0, 0,  -1.2,  1.2, -1.2,	0,SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion_Modded", 0, 0, 0,  -2.4,  2.4, -2.4,	0,SXF_NOCHECKPOSITION)

		// -X -Y -Z
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion_Modded", 0, 0, 0,  -1.2, -1.2, -1.2,	0,SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion_Modded", 0, 0, 0,  -2.4, -2.4, -2.4,	0,SXF_NOCHECKPOSITION)

		// +Y -Z
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion_Modded", 0, 0, 0,   0.0,  1.7, -1.7,	0,SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion_Modded", 0, 0, 0,   0.0,  3.5, -3.5,	0,SXF_NOCHECKPOSITION)

		// -Y -Z
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion_Modded", 0, 0, 0,   0.0, -1.7, -1.7,	0,SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion_Modded", 0, 0, 0,   0.0, -3.5, -3.5,	0,SXF_NOCHECKPOSITION)

		// -Z
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion_Modded", 0, 0, 0,   0.0,  0.0, -2.5,	0,SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SpawnItemEx("UTRedeemerExplosion_Modded", 0, 0, 0,   0.0,  0.0, -5.0,	0,SXF_NOCHECKPOSITION)

		// Effects start first; seven pulses follow at 5-tic intervals (35 tics = 1 second).
		TNT1 A 0 A_SetUserVar(user_explosionpulse,0)
	NextExplosion:
		TNT1 A 0 A_JumpIf(user_explosionpulse>=7,"ExplosionDone")
		TNT1 A 5
		TNT1 A 0 A_SetUserVar(user_explosionpulse,user_explosionpulse+1)
		TNT1 A 0 A_Jump(256,"DamagePulse") // use the appropriate SP/DM damage profile
		Goto DamagePulse

	ExplosionDone:
		TNT1 A 99 // We need this for proper rocket jump unlagged when exploding too soon
		Stop
	}
}

Actor UTRedeemerMissileControlled_Modded : UTRedeemerMissile_Modded {
	var int user_counter;
	+SKYEXPLODE
	+SHOOTABLE
	-NOBLOCKMAP
	States
	{
	Spawn:
		TNT1 A 0 NODELAY A_PlaySound("UTDE/Weapons/Redeemer/Fly_Modded",CHAN_5|CHAN_NOPAUSE,1.0,true)
		TNT1 A 0 ACS_NamedExecuteAlways("UTDE_AttachWhooshRedeemer")
		MDZ9 A 1 bright ACS_NamedExecuteWithResult("QCDE_RocketControl")//Projectile control and whatnot
		TNT1 A 0 bright ACS_NamedExecuteWithResult("QCDE_TunnelVision")	//Black Screen effect
		TNT1 A 0 A_SetUserVar(user_counter,1)
	Looper:
		TNT1 A 0 A_JumpIfInventory("ImDead",1,"DieTime")
		MDZ9 A 1 Light("YellowMediumPoint2") Bright
		TNT1 A 0 A_SpawnItemEx("RedeemerTrailFire_Modded",-20*cos(pitch),0,-20*sin(-pitch),0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SpawnItemEx("RedeemerTrailSmoke_Modded",-20*cos(pitch),0,-20*sin(-pitch),0,0,0,0,SXF_NOCHECKPOSITION)
		Loop

	Xdeath:	//Direct hit
		TNT1 A 0 A_JumpIfInTargetInventory("PlayHitEffect",3,"DoMark")
		TNT1 A 0 A_JumpIfInTargetInventory("PlayHitEffect",1,"PlayBeep")
		TNT1 A 0 A_Jump(256,"ExplodeCont") //for virtual jump to inherited versions
		Goto ExplodeCont

		PlayBeep:
			TNT1 A 0 A_PlaySound("QC/UI/HitBeepMax",CHAN_7|CHAN_UI,0.85,0,140)
			TNT1 A 0 A_JumpIfInTargetInventory("PlayHitEffect",2,"DoMark")
			TNT1 A 0 A_Jump(256,"ExplodeCont") //for virtual jump to inherited versions
			Goto ExplodeCont
		DoMark:
			TNT1 A 0 ACS_NamedExecuteAlways("QCDE_HitMark",0)
			TNT1 A 0 A_Jump(256,"ExplodeCont") //for virtual jump to inherited versions
			Goto ExplodeCont

		RadiusHit:	//splash damage beep
			TNT1 A 0 A_JumpIfInTargetInventory("PlayHitEffect",3,"DoMark")
			TNT1 A 0 A_JumpIfInTargetInventory("PlayHitEffect",1,"PlayBeep")
			TNT1 A 0 A_Jump(256,"ExplodeCont") //for virtual jump to inherited versions
			Goto ExplodeCont

	DieTime:
		TNT1 A 0 A_Die
		Goto Death

	DeathCont:
		TNT1 A 0 A_JumpIf(user_counter>=1,"SkipForceUnfreeze")	//if it didnt live at least one tic to set everything up
		TNT1 A 0 A_GiveToTarget("UnfreezerProc",1)				//then force unfreeze on player
		Goto DeathFX
	SkipForceUnfreeze:
		TNT1 A 0 A_GiveInventory("ImDead")
		Goto DeathFX
	}
}

Actor UTRedeemerMissileDM_Modded : UTRedeemerMissile_Modded
{
	-MTHRUSPECIES
	-DONTBLAST
	States
	{
	DamagePulse:
		TNT1 A 0 A_Explode(1500/7,1024*user_explosionpulse/7,XF_HURTSOURCE,0,18)
		Goto NextExplosion
	}
}

Actor UTRedeemerMissileControlledDM_Modded : UTRedeemerMissileControlled_Modded
{
	-MTHRUSPECIES
	-DONTBLAST
	States
	{
	DamagePulse:
		TNT1 A 0 A_Explode(1500/7,1024*user_explosionpulse/7,XF_HURTSOURCE,0,18)
		Goto NextExplosion
	}
}

Actor UTRedeemerExplosion_Modded
{
	+NOTONAUTOMAP
	+CLIENTSIDEONLY +NONETID
	+FORCEXYBILLBOARD
	+DONTBLAST
	+NOGRAVITY
	Radius 1
	Height 1
	Scale 0.5
	States
	{
	Spawn:
		X125 A 0
		X125 A 2 Light("YellowSmallFlicker2") 	Bright A_SetScale(scalex+0.1125)
		X125 A 2 Light("YellowMediumFlicker3") 	Bright A_SetScale(scalex+0.1125)
		X125 B 2 Light("YellowMediumFlicker1") 	Bright A_SetScale(scalex+0.075)
		X125 B 2 Light("YellowBigFlicker3") 	Bright A_SetScale(scalex+0.075)
		X125 C 2 Light("YellowBigFlicker3") 	Bright A_SetScale(scalex+0.0525)
		X125 C 2 Light("YellowBigFlicker3") 	Bright A_SetScale(scalex+0.0525)
		X125 D 2 Light("YellowBigFlicker3") 	Bright
		X125 D 2 Light("YellowBigFlicker3") 	Bright
		X125 E 2 Light("YellowBigFlicker3")		Bright A_SetScale(scalex*1.05)
		X125 E 2 Light("YellowMediumFlicker1")	Bright
		X125 F 2 Light("YellowMediumFlicker1")	Bright A_SetScale(scalex*1.05)
		X125 F 2 Light("YellowMediumFlicker2")	Bright
		X125 G 2 Light("YellowMediumFlicker2")	Bright A_SetScale(scalex*1.05)
		X125 G 2 Light("YellowMediumFlicker3")	Bright
		X125 H 1 Light("YellowSmallFlicker1")	Bright A_SetScale(scalex*1.05)
		X125 H 2 Light("YellowSmallFlicker1")	Bright A_FadeOut(0.075)
		X125 H 2 Light("YellowSmallFlicker2")	Bright A_FadeOut(0.075)
		X125 I 1 Light("YellowSmallFlicker3")	Bright A_SetScale(scalex*1.05)
		X125 I 2 Light("YellowSmallFlicker3")	Bright A_FadeOut(0.075)
		X125 I 2 Bright A_FadeOut(0.075)
		X125 J 1 Bright A_SetScale(scalex*1.05)
		X125 J 2 Bright A_FadeOut(0.075)
		X125 J 2 Bright A_FadeOut(0.075)
		X125 K 1 Bright A_SetScale(scalex*1.05)
		X125 K 2 Bright A_FadeOut(0.075)
		X125 K 2 Bright A_FadeOut(0.075)
		X125 L 1 Bright A_FadeOut(0.075)
		X125 L 2 Bright A_SetScale(scalex*1.05)
		X125 L 2 Bright A_FadeOut(0.075)
		X125 M 1 Bright A_FadeOut(0.075)
		X125 M 2 Bright A_SetScale(scalex*1.05)
		X125 M 2 Bright A_FadeOut(0.075)
		X125 N 1 Bright A_FadeOut(0.075)
		X125 N 2 Bright A_SetScale(scalex*1.05)
		X125 N 2 Bright A_FadeOut(0.075)
		X125 O 1 Bright A_FadeOut(0.075)
		X125 O 2 Bright A_SetScale(scalex*1.05)
		X125 O 2 Bright A_FadeOut(0.075)
		X125 P 1 Bright A_FadeOut(0.075)
		X125 P 2 Bright A_SetScale(scalex*1.05)
		X125 P 2 Bright A_FadeOut(0.075)
		X125 Q 1 Bright A_FadeOut(0.075)
		X125 Q 2 Bright A_SetScale(scalex*1.05)
		X125 Q 2 Bright A_FadeOut(0.075)
		X125 R 1 Bright A_FadeOut(0.075)
		X125 R 2 Bright A_SetScale(scalex*1.05)
		X125 R 2 Bright A_FadeOut(0.075)
		Stop
	}
}

Actor RedeemerTrailFire_Modded
{
	+CLIENTSIDEONLY +NONETID
	+NOINTERACTION +NOTONAUTOMAP
	+FORCEXYBILLBOARD
	+DONTBLAST
	RenderStyle Add
	Alpha 0.5
	Scale 0.12
	States
	{
	Spawn:
		TNT1 A 2
		TNT1 A 0 A_Jump(256,"One","Two")
	One:
		X007 CDE 1 Bright
		X007 FGHIJ 1 Bright
		Stop
	Two:
		X007 MNO 1 Bright
		X007 PQRST 1 Bright
		Stop
	}
}

Actor RedeemerTrailSmoke_Modded	//centered smoke
{
	+CLIENTSIDEONLY +NONETID
	+NOINTERACTION +NOTONAUTOMAP
	+FORCEXYBILLBOARD
	+DONTBLAST
	RenderStyle Translucent
	Alpha 0.2
	Scale 0.0
	States
	{
	Spawn:
		TNT1 A 0 NoDelay A_Jump(256,1,2,3,4)
		X037 A 0 A_SetScale(frandom(0,0.2)) Goto Missile
		X037 B 0 A_SetScale(frandom(0,0.2)) Goto Missile
		X037 C 0 A_SetScale(frandom(0,0.2)) Goto Missile
		X037 D 0 A_SetScale(frandom(0,0.2)) Goto Missile
	Missile:
		"####" "#" 1 A_SetScale(ScaleX+0.007)	"####" "#" 0 A_FadeIn(0.02)
		"####" "#" 1 A_SetScale(ScaleX+0.007)	"####" "#" 0 A_FadeIn(0.02)
		"####" "#" 1 A_SetScale(ScaleX+0.007)	"####" "#" 0 A_FadeIn(0.02)
		"####" "#" 1 A_SetScale(ScaleX+0.007)	"####" "#" 0 A_FadeIn(0.02)
		"####" "#" 1 A_SetScale(ScaleX+0.007)	"####" "#" 0 A_FadeIn(0.02)
		"####" "#" 1 A_SetScale(ScaleX+0.007)	"####" "#" 0 A_FadeIn(0.02)
		"####" "#" 1 A_SetScale(ScaleX+0.007)	"####" "#" 0 A_FadeIn(0.02)
		"####" "#" 1 A_SetScale(ScaleX+0.007)	"####" "#" 0 A_FadeIn(0.02)
		Goto Continue
	Continue:
		"####" "#" 1 A_FadeOut(0.025)
		"####" "#" 1 A_SetScale(ScaleX+0.007)
		Loop
	}
}
