// Generated from Tools/WeaponSkinAssets/RocketLauncherActors.json by Tools/WeaponSkinActors.cjs.
// Customize this independent copy; regeneration refuses changed output.

Actor UTRocketMissile_Modded
{
	Projectile
	+DEHEXPLOSION
	+EXTREMEDEATH
	+FORCERADIUSDMG
	-ROCKETTRAIL
	+SEEKERMISSILE //Not actually used for anything other than checking radius.
	+MTHRUSPECIES
	+DONTBLAST
	Radius 3
	Height 6
	Speed 34
	Damage (random(60, 80))
	Scale 0.6
	Obituary "$OB_UTRocketLauncher"
	SeeSound ""
	DeathSound "UTDE/Weapons/RocketLauncher/RocketExplo_Modded"
	Decal "D4ExploScorch"
	DamageType "RocketDamage"
	States
	{
	Spawn:
		TNT1 A 0 NoDelay ACS_NamedExecuteAlways("QCDE_AttachWhoosh")
		MDZ6 A 2 Light("YellowMediumPoint2") Bright //no trails for a bit
	Looper:
		MDZ6 A 1 Light("YellowMediumPoint2") Bright A_SpawnItemEx("PlayerRocketTrailFire_Modded",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		MDZ6 A 0 A_SpawnItemEx("RocketTrailSmoke_Modded",-8,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		Loop

	Xdeath:	//Direct hit
		TNT1 A 0 A_GiveToTarget("HitBeepBig",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		TNT1 A 0 A_JumpIfInTargetInventory("RL_UG_Cluster", 1, "ExplodeUpgraded")
		TNT1 A 0 A_Jump(256,"ExplodeNormal") //for virtual jump to inherited versions
		Goto ExplodeNormal

	Death: //crashed somewhere and checks for splash
		TNT1 A 0 A_ChangeFlag("NOINTERACTION",1)
		TNT1 A 0 A_Stop
		TNT1 A 0 A_SeekerMissile(0,0,SMF_LOOK|SMF_CURSPEED,256)
		TNT1 A 0 A_JumpIfTargetInLOS("RadiusHit",360,JLOSF_PROJECTILE,192)
		TNT1 A 0 A_JumpIfInTargetInventory("RL_UG_Cluster", 1, "ExplodeUpgraded")
		TNT1 A 0 A_Jump(256,"ExplodeNormal") //for virtual jump to inherited versions
		Goto ExplodeNormal

		RadiusHit:	//splash damage beep
			TNT1 A 0 A_GiveToTarget("HitBeepMid",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
			TNT1 A 0 A_JumpIfInTargetInventory("RL_UG_Cluster", 1, "ExplodeUpgraded")
			TNT1 A 0 A_Jump(256,"ExplodeNormal") //for virtual jump to inherited versions
			Goto ExplodeNormal

	ExplodeNormal:
		TNT1 A 0 A_JumpIfInTargetInventory("Class_Ranger",1,"ExplodeNormalRanger")
		TNT1 A 0 A_RadiusThrust(40,128,RTF_AFFECTSOURCE|RTF_THRUSTZ)	//thrust players only this way, without damage
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", true)
		TNT1 A 0 A_Explode(40,128,XF_HURTSOURCE,0,18)
		TNT1 A 0 A_Explode(random(80,105),128,0,0,18)	//then another 80-105 extra damage for impacting a player + (60-100)dmg on the projectile =180-225dmg
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", false)
		Goto DeathCont

	ExplodeNormalRanger:
		TNT1 A 0 A_RadiusThrust(40,128,RTF_AFFECTSOURCE|RTF_THRUSTZ)	//thrust players only this way, without damage
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", true)
		TNT1 A 0 A_Explode(32,128,XF_HURTSOURCE,0,18)
		TNT1 A 0 A_Explode(random(88,112),128,0,0,18)	//then another 88-112 extra damage for impacting a player + (60-100)dmg on the projectile =180-225dmg
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", false)
		Goto DeathCont

	ExplodeUpgraded:
		TNT1 A 0 A_JumpIfInTargetInventory("Class_Ranger",1,"ExplodeUpgradedRanger")
		TNT1 A 0 A_RadiusThrust(40,128,RTF_AFFECTSOURCE|RTF_THRUSTZ)	//thrust players only this way, without damage
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", true)
		TNT1 A 0 A_Explode(40,128,XF_HURTSOURCE,0,128)
		TNT1 A 0 A_Explode(random(80,105),128,0,0,128)	//then another 80-105 extra damage for impacting a player + (60-100)dmg on the projectile =180-225dmg
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", false)
		Goto DeathCont

	ExplodeUpgradedRanger:
		TNT1 A 0 A_RadiusThrust(40,128,RTF_AFFECTSOURCE|RTF_THRUSTZ)	//thrust players only this way, without damage
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", true)
		TNT1 A 0 A_Explode(32,128,XF_HURTSOURCE,0,128)	//self rocket damage with rocket jump is 32
		TNT1 A 0 A_Explode(random(88,112),128,0,0,128)	//then another 88-112 extra damage for impacting a player + (60-100)dmg on the projectile =180-225dmg
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", false)
		Goto DeathCont

	DeathCont:
		TNT1 A 0 A_StopSound(CHAN_5) // Stop whoosh sound
		TNT1 A 0 A_SpawnItemEx("QCRocketExploDebris_Modded",-1,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 AAAAA 0 A_SpawnItemEx("QCRocketExploParticle_Modded",3,0,0,frandom(3,5.5),frandom(3,5.5),frandom(1,6),random(0,359),SXF_NOCHECKPOSITION)
		TNT1 A 0 A_SpawnItemEx("QCRocketExplosion_Modded",-2,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
		TNT1 A 99 // We need this for proper rocket jump unlagged when exploding too soon
		Stop
	}
}

