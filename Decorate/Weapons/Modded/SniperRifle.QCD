// Customize this independent copy; regeneration refuses changed output.

Actor SniperTrail_Modded
{
	+NOINTERACTION +NOTONAUTOMAP
	+FORCEXYBILLBOARD
	+CLIENTSIDEONLY +NONETID
	RenderStyle Add
	Scale 0.07
	States
	{
	Spawn:
		RTSS A 0
		Goto FadeOut
	FadeOut:
		"####" "#" 1 BRIGHT A_FadeOut(0.03)
		Loop
	}
}

Actor SniperTrailUpgraded_Modded : SniperTrail_Modded
{
	States
	{
	Spawn:
		RTQW A 0
		Goto FadeOut
	}
}

Actor SniperRiflePuff_Modded
{
	+NONETID
	+NOINTERACTION +NOTONAUTOMAP
	+ALWAYSPUFF
	+PUFFGETSOWNER
	+PUFFONACTORS
	+MTHRUSPECIES
	Radius 10
	Obituary "$OB_UTSniperRifle"
	+FORCEXYBILLBOARD
	+DONTSPLASH
	Decal "BulletChip"
	States
	{
	Spawn:	//hit non bleeding actor
		TNT1 A 0 NODELAY A_PlaySound("UTDE/Weapons/SniperRifle/Impact_Modded",CHAN_AUTO,1,0,1)
		TNT1 A 0 A_GiveToTarget("HitBeepBig",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		Goto Crash
	Xdeath:	//hit bleeding actor
		TNT1 A 0
		TNT1 A 0 A_PlaySound("UTDE/Weapons/SniperRifle/Impact_Modded",CHAN_AUTO,1,0,1)
		TNT1 A 0 A_GiveToTarget("HitBeepBig",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		TNT1 A 1
		Stop
	Crash:
		TNT1 A 0 A_PlaySound("UTDE/Weapons/SniperRifle/Impact_Modded",CHAN_AUTO,1,0,1)
		TNT1 A 0 A_SpawnItemEx("SniperPuffFx_Modded", 0,0,0, 0,0,0, 0,SXF_NOCHECKPOSITION)
		TNT1 A 1
		Stop
	}
}

Actor SniperRiflePuff_DM_Modded : SniperRiflePuff_Modded
{
	-MTHRUSPECIES
	States
	{
	Spawn:	//hit non bleeding actor, and we don't want to play hit sound in DM
		TNT1 A 0 NODELAY A_PlaySound("UTDE/Weapons/SniperRifle/Impact_Modded",CHAN_AUTO,1,0,1)
		Goto Crash
	}
}

Actor SniperPuffFx_Modded : QCBulletPuff
{
	+NOINTERACTION +NOTONAUTOMAP
	+CLIENTSIDEONLY +NONETID
	+PUFFGETSOWNER
	+PUFFONACTORS
	+FORCEXYBILLBOARD
	+MTHRUSPECIES
	+DONTSPLASH
	Renderstyle Add
	Scale 0.70
	States
	{
	Spawn:
		TNT1 A 0 NODELAY A_Jump(256,"Type1","Type2","Type3")
	Type1:
		DB63 A 0
		Goto EndAnimation
	Type2:
		DB64 A 0
		Goto EndAnimation
	Type3:
		DB65 A 0
		Goto EndAnimation

	EndAnimation:
		"####" ABCDEFGHIJKLMNOPQRSTUVWXYZ 1 Bright
		Stop
	}
}

Actor SniperSmokeSpawner_Modded
{
	Radius 1
	Height 1
	Speed 14
	PROJECTILE
	+NOTIMEFREEZE
	+CLIENTSIDEONLY +NONETID
	States
	{
	Spawn:
		TNT1 A 1
		TNT1 A 0 A_Die
		Goto Death
	Death:
		TNT1 AAA 0 A_SpawnItemEx("MachinegunSmoke_Modded",0,random(1,-1),0,0,0,frandom(0.1,0.25),0,32)
		TNT1 A 2
		Stop
	}
}

Actor MachinegunSmoke_Modded
{
	+NOINTERACTION +NOTONAUTOMAP
	+FORCEXYBILLBOARD
	+CLIENTSIDEONLY +NONETID
	Alpha 0.6
	Scale 0.03
	States
	{
	Spawn:
		TNT1 A 0
		TNT1 A 0 A_Jump(256,"Type1","Type2")	//to define which graphic will use
	Type1:
		X201 E 0
		Goto "Continue"
	Type2:
		X201 F 0
		Goto "Continue"
	Continue:
		"####" "#" 0 A_Jump(160,2,4,6)
		"####" "#" 0
		"####" "#" 0 A_SetScale(0.03)
		"####" "#" 2 A_FadeOut(0.035)
		"####" "#" 0 A_SetScale(0.033)
		"####" "#" 2 A_FadeOut(0.035)
		"####" "#" 0 A_SetScale(0.036)
		"####" "#" 2 A_FadeOut(0.035)
	Looper:
		"####" "#" 0 A_SetScale(ScaleX+0.003)
		"####" "#" 2 A_FadeOut(0.035)
		Loop
	}
}

