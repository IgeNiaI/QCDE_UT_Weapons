ACTOR UTShockRifleCombo_Modded
{
	Projectile
	+NOBLOOD
	+NOINTERACTION
	+DONTRIP
	+DONTREFLECT
	+DONTBLAST
	+FORCERADIUSDMG
	+VULNERABLE
	+NODAMAGETHRUST
	-NOBLOCKMAP
	+SEEKERMISSILE //Not actually used for anything other than checking radius.
	Radius 1
	Height 1
	Speed 0
	Damage 0
	Scale 0.4
	DamageType "ShkRflDmg"
	Obituary "$OB_UTShockRifle"

	States
	{
	Spawn:
		TNT1 A 0 A_SetInvulnerable
		TNT1 A 0 A_ChangeFlag("NOINTERACTION",1)
		TNT1 A 0 A_Stop
		TNT1 A 0 A_SeekerMissile(0,0,SMF_LOOK|SMF_CURSPEED,256)
		TNT1 A 0 A_JumpIfTargetInLOS("RadiusHit",360,JLOSF_PROJECTILE,290)
		TNT1 A 0 A_Die
		Goto Death

		RadiusHit:	//splash damage beep
			TNT1 A 0 A_GiveToTarget("HitBeepBig",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
			TNT1 A 0 A_Die
			Goto Death

	Death:
		TNT1 A 0 A_Explode(175,225,XF_HURTSOURCE,true) // hurt the player for same damage as in DM
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", false)
		TNT1 A 0 A_Explode(random(225,375),225,0,true) // deal extra damage to everyone else for a total of 400-600
		TNT1 A 1 // Need the actor to live one more tick so that a proper obituary message is shown
		Stop
	}
}

