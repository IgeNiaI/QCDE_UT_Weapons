		TNT1 A 0 A_Stop
		TNT1 A 0 A_StopSound(CHAN_5)
		// Damage players while being unlagged
		TNT1 A 0 A_SpawnItemEx("UTShockRifleComboDM_Modded", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS|SXF_FORCESERVERSIDE)
		TNT1 A 1 // Stop unlag here so that we could replicate the actor to clients
		// Spawn combo effects on clients
		TNT1 A 0 A_SpawnItemEx("UTShockRifleComboFX_Modded", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION)
		TNT1 A 1 // Need the actor to live one more tick so that a proper obituary message is shown
		Stop
	}
}

ACTOR UTShockRifleComboDM_Modded : UTShockRifleCombo_Modded
{
	States
	{
	Death:
		TNT1 A 0 A_Explode(175,225,XF_HURTSOURCE,true)
		TNT1 A 1 // Need the actor to live one more tick so that a proper obituary message is shown
		Stop
	}
}

