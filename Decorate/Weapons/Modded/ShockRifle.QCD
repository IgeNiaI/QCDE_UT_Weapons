// Generated from Tools/WeaponSkinAssets/ShockRifleActors.json by Tools/WeaponSkinActors.cjs.
// Customize this independent copy; regeneration refuses changed output.

ACTOR UTShockRifleOrb_Modded : UnlaggedActor
{
	Projectile
	+SHOOTABLE
	+NODAMAGE // React to shots through Pain without being killed
	+NOBLOOD
	+DONTRIP
	+DONTREFLECT
	-NOBLOCKMAP
	+MTHRUSPECIES
	+DONTBLAST
	Mass 0x7FFFFFFF
	Radius 7
	Height 14
	Speed 18
	Damage (random(110,150))
	Scale 0.22
	Health 1
	PainChance "ShkRflDmg", 256
	DamageFactor "Normal" , 0.0
	DamageFactor "ShkRflDmg", 1.1
	DamageType "ShkRflDmg"
	Decal "UTShockPurpleFull"
	SeeSound "weapons/maceshoot"
	Obituary "$OB_UTShockRifle"

	States
	{
	Spawn:
		TNT1 A 0 NODELAY A_PlaySound("UTDE/Weapons/ShockRifle/OrbFly_Modded",CHAN_5|CHAN_NOPAUSE,1.0,true)
		TNT1 A 0 ACS_NamedExecuteAlways("UTDE_AttachWhooshShock")
	Looper:
		MDZ7 AAAABBBBCCCCDDDD 1 Light("PurpleMediumPoint1") BRIGHT
		Loop
	Xdeath:	//hit bleeding actor
		TNT1 A 0 A_StopSound(CHAN_5)
		TNT1 A 0 A_GiveToTarget("HitBeepMid",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
	Death:
		TNT1 A 0 A_StopSound(CHAN_5) // Stop whoosh sound
		TNT1 A 0 A_Jump(256, 1) // force sync the actor state
		TNT1 A 0 A_PlaySound("UTDE/Weapons/ShockRifle/OrbHit_Modded",CHAN_AUTO,1,0,1)
		TNT1 A 0 A_SetInvulnerable
		TNT1 A 0 A_ChangeFlag("NOINTERACTION",1)
		TNT1 A 0 A_Stop
		MDZ7 E 1 BRIGHT
		MDZ7 E 1 BRIGHT A_SetScale(0.23, 0.23)
		TNT1 A 0 BRIGHT A_SetTranslucent(0.85)
		MDZ7 F 1 BRIGHT A_SetScale(0.24, 0.24)
		TNT1 A 0 BRIGHT A_SetTranslucent(0.70)
		MDZ7 F 1 BRIGHT A_SetScale(0.26, 0.26)
		TNT1 A 0 BRIGHT A_SetTranslucent(0.55)
		MDZ7 G 1 BRIGHT A_SetScale(0.28, 0.28)
		TNT1 A 0 BRIGHT A_SetTranslucent(0.40)
		MDZ7 G 1 BRIGHT A_SetScale(0.30, 0.30)
		TNT1 A 0 BRIGHT A_SetTranslucent(0.25)
		MDZ7 E 1 BRIGHT A_SetScale(0.32, 0.32)
		TNT1 A 0 BRIGHT A_SetTranslucent(0.10)
		MDZ7 E 1 BRIGHT A_SetScale(0.34, 0.34)
		TNT1 A 99 // We need this for proper unlagged when hitting a wall too soon
		Stop
	Pain.ShkRflDmg:
		TNT1 A 0 A_SetInvulnerable
		TNT1 A 0 A_ChangeFlag("NOINTERACTION",1)
		TNT1 A 0 A_Stop
		TNT1 A 0 A_StopSound(CHAN_5)
		TNT1 A 0 A_JumpIfInTargetInventory("LG_UG_Static", 1, "ComboUpgraded")
		// Damage players while being unlagged
		TNT1 A 0 A_SpawnItemEx("UTShockRifleCombo_Modded", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS|SXF_FORCESERVERSIDE)
		// Stop unlag here so that we could replicate the actor to clients
		TNT1 A 1
		// Spawn combo effects on clients
		TNT1 A 0 A_SpawnItemEx("UTShockRifleComboFX_Modded", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION)
		Stop
	ComboUpgraded:
		// Damage players while being unlagged
		TNT1 A 0 A_SpawnItemEx("UTShockRifleOrbbSucc_Modded", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS|SXF_FORCESERVERSIDE)
		// Stop unlag here so that we could replicate the actor to clients
		TNT1 A 1
		Stop
	}
}

