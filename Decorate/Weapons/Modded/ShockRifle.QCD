Actor ShockRiflePuff_Modded
{
	+NONETID
	+NOINTERACTION +NOTONAUTOMAP
	+ALWAYSPUFF
	+PUFFGETSOWNER
	+PUFFONACTORS
	+MTHRUSPECIES
	Radius 10
	Obituary "$OB_UTShockRifle"
	+FORCEXYBILLBOARD
	+DONTSPLASH
	DamageType "ShkRflDmg"
	Decal "UTShockPurpleSmall"
	States
	{
	Spawn:	//hit non bleeding actor
		TNT1 A 0 NODELAY A_GiveToTarget("HitBeepMid",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		Goto Crash
	Xdeath:	//hit bleeding actor
		TNT1 A 0
		TNT1 A 0 A_GiveToTarget("HitBeepMid",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		TNT1 A 1
		Stop
	Crash:
		TNT1 A 0 A_SpawnItemEx("ShockRiflePuffFx_Modded", 5,0,0, 0,0,0, 0,SXF_NOCHECKPOSITION)
		TNT1 A 10
		Stop
	}
}

Actor ShockRiflePuffUpgraded_Modded : ShockRiflePuff_Modded
{
	ProjectileKickBack 10000
}

Actor ShockRiflePuff_DM_Modded : ShockRiflePuff_Modded
{
	-MTHRUSPECIES
	States
	{
	Spawn:	//hit non bleeding actor, and we don't want to play hit sound in DM
		TNT1 A 0
		Goto Crash
	}
}

Actor ShockRiflePuffFx_Modded
{
	+NOINTERACTION
	+FORCEXYBILLBOARD
	+CLIENTSIDEONLY +NONETID
	RenderStyle Add
	Translation "0:255=%[0,0,0]:[1.0,0.5,1.5]"
	Scale 0.9
	Alpha 0.99
	States
	{
	Spawn:
		TNT1 A 0 NODELAY A_Jump(256,"Type1","Type2","Type3")
	Type1:
		DB63 A 0
		Goto EndAnimation
	Type2:
		DB64 A 0
		Goto EndAnimation
	Type3:
		DB65 A 0
		Goto EndAnimation

	EndAnimation:
		"####" A 0 A_Jump(128,2)
		"####" A 0 A_SetScale(-0.9,0.9)
		"####" A 0 //nuthn
		"####" ABCDE 1 Bright
		"####" FGHIJK 1 Bright
		"####" LMNOPQRSTUVWXYZ 1 Bright
		Stop
	}
}

