//==========================================================
//	Base weapon, from which all inherit
//==========================================================
Actor QCWeapon : Weapon
{
	Weapon.Kickback 100 //this changes in many weapons
	Weapon.BobStyle Alpha
	Weapon.BobSpeed 2.3
	Weapon.BobRangeX 0.7
	Weapon.BobRangeY 0.5
	Inventory.PickupSound "QC/Items/WeaponPick"
	Inventory.Respawntics 175 //5sec
	+WEAPON.NOALERT
}


Actor AmmoSpender
{
	+NOINTERACTION
	RenderStyle None
	States
	{
	Spawn:
		TNT1 A 3
		Stop
	}
}


//==========================================================
//	Hit beeps, "Low", "Mid", "Big", "Max"
//==========================================================

Actor HitBeepLow : CustomInventory
{
	+INVENTORY.ALWAYSPICKUP 
	RenderStyle None
	States
	{
	Spawn:
		MEGA A 6
		Loop
	Pickup:
		TNT1 A 0 A_JumpIfInventory("PlayHitBeep",1,"Play")
		TNT1 A 0 A_JumpIfInventory("PlayHitMark",1,"Mark")
		Stop
	Play:
		TNT1 A 0 A_JumpIfInventory("PowerQuad",1,"PlayStrong")
		TNT1 A 0 A_PlaySound("QC/UI/HitBeepLow",CHAN_7|CHAN_UI,0.7,0,140)
		TNT1 A 0 A_JumpIfInventory("PlayHitMark",1,"Mark")
		Stop
	PlayStrong:
		TNT1 A 0 A_PlaySound("QC/UI/HitBeepMid",CHAN_7|CHAN_UI,0.7,0,140)
		TNT1 A 0 A_JumpIfInventory("PlayHitMark",1,"Mark")
		Stop
	Mark:
		TNT1 A 0 ACS_NamedExecuteAlways("QCDE_HitMark",0)
		Stop
	}
}

