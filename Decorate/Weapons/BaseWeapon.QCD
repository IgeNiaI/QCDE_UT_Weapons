Actor WaterLightningSparks
{
	Translation "0:255=%[0,0,0]:[0.8,1.2,1.6]"
	+NOINTERACTION +NOTONAUTOMAP
	+CLIENTSIDEONLY
	+DONTBLAST
	var int user_counter;
	RenderStyle Add
	Alpha 0.99
	Scale 0.35
	States
	{
	Spawn:
	Decider:
		TNT1 A 0 NODELAY A_Jump(256,"T1","T2","T3","T4","T5")

		T1:	DLI1 A 0
			Goto PlayOff
		T2:	DLI2 A 0
			Goto PlayOff
		T3:	DLI3 A 0
			Goto PlayOff
		T4:	DLI4 A 0
			Goto PlayOff
		T5:	DLI5 A 0
			Goto PlayOff

	PlayOff:
		"####" A 0 A_Jump(128,"FromL")

		FromA:
			"####" ABCDE 1 Bright
			"####" FGHIJK 1 Bright
			Goto Destroy
		FromL:
			"####" LMNOP 1 Bright
			"####" QRSTUV 1 Bright
			Goto Destroy


	Destroy:
		TNT1 A 5
		Stop

	}
}

