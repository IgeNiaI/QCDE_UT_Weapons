//==========================================================
//	Generic player bullet puffs
//==========================================================

Actor QCBulletPuff
{
	+NOINTERACTION +NOTONAUTOMAP
	+NONETID
	+PUFFGETSOWNER
	+PUFFONACTORS
	+FORCEXYBILLBOARD
	+MTHRUSPECIES
	+DONTSPLASH
	Renderstyle Add
	Decal "BulletChip"
	Scale 0.35
	States
	{
	Spawn:	//hit non bleeding actor
		TNT1 A 0 NODELAY A_GiveToTarget("HitBeepLow",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		Goto Crash
	XDeath: //hit bleeding actor
		TNT1 A 0 A_GiveToTarget("HitBeepLow",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		TNT1 A 10 A_PlaySound("BulletHitFleshRandom",7,0.6,0,9)
		Stop
	Crash: //hit everything else
		TNT1 A 0 A_PlaySound("UTDE/Other/BulletImpact",7,0.6,0,9)
	Choose:
		TNT1 A 0 A_Jump(256,"Type1","Type2")
	Type1:
		FX57 ABCD 1 Bright
		FX57 EFGHIJ 2 Bright
		Stop
	Type2:
		FX57 KLMN 1 Bright
		FX57 OPQRST 2 Bright
		Stop
	}
}

Actor QCBulletStrongPuff : QCBulletPuff
{
	States
	{
	Spawn:	//hit non bleeding actor
		TNT1 A 0 NODELAY A_GiveToTarget("HitBeepMid",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		Goto Crash
	XDeath: //hit bleeding actor
		TNT1 A 0 A_GiveToTarget("HitBeepMid",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		TNT1 A 10 A_PlaySound("BulletHitFleshRandom",7,0.6,0,9)
		Stop
	}
}


//How is this different than the regular puff? Different hit beep sound
Actor QCShotgunPuff : QCBulletPuff
{
	States
	{
	XDeath:
		TNT1 A 0 A_GiveToTarget("HitBeepMid",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		TNT1 A 10 A_PlaySound("BulletHitFleshRandom",7,0.6,0,9)
		Stop
	}
}

Actor QCBulletPuff_DM : QCBulletPuff
{
	-MTHRUSPECIES
	States
	{
	Spawn:	//hit non bleeding actor, and we don't want to play hit sound in DM
		TNT1 A 0
		Goto Crash
	}
}
Actor QCShotgunPuff_DM : QCBulletPuff
{
	-MTHRUSPECIES
	States
	{
	Spawn:	//hit non bleeding actor, and we don't want to play hit sound in DM
		TNT1 A 0
		Goto Crash
	}
}



//Bullet puff for monsters, same as player's, except no hit beep sound
// and doesn't go through players
Actor QCBulletPuffMonster : QCBulletPuff replaces BulletPuff
{
	-MTHRUSPECIES
	States
	{
	XDeath:
		TNT1 A 10 A_PlaySound("BulletHitFleshRandom",7,0.6,0,9)
		Stop
	}
}



//----------------------------------------------
// This is a fake weapon to hack around the weapon desync in
// net games caused by ACS weapon switching, like when going
// from doomslayer bfg back to RL.
Actor FakeruWeapun : DoomWeapon
{
	Height 40
	Weapon.Kickback 40
	Weapon.SelectionOrder 988759
	Obituary "$OB_FakeruWeapun" // "%o was blank'd by %k."
	Inventory.PickupMessage "$GOT_FakeruWeapun" // "Picked up a nutin."
	Tag "$TAG_FakeruWeapun" // " "
	Scale 0.47
	+CHEATNOTWEAPON
	+WEAPON.NOAUTOFIRE
	+WEAPON.NO_AUTO_SWITCH
	States
	{
	Spawn:
		NULL A 35 NoDelay
		Stop
	//-----------------------
	// Ready Seq
	//-----------------------
	Ready:
		NULL A 0 //A_PrintBold("yep",0.1)
		NULL A 3 A_WeaponReady(WRF_NOFIRE)
		Loop
	//-----------------------
	// Select/Deselect Seq
	//-----------------------
	Select:
		NULL A 1 A_Raise
		NULL AAA 0 A_Raise
		Loop

	Deselect:
		NULL A 1 A_Lower
		NULL AAA 0 A_Lower
		Loop

	Fire:
		NULL ABC 3
		Goto Ready

	}
}


