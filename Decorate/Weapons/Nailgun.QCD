Actor CompatVer31_Nailgun {} // for compatibility checks

// This pickup is only for consistency -- it never gives weapon.
Actor NailgunPickup : CustomInventory
{
	Height 48
	Radius 20
	Scale 0.5
	Inventory.PickupSound "QC/Items/WeaponPick"
	Inventory.PickupMessage "$GOT_UTLinkGun"
	Tag "$TAG_UTLinkGun"
	States
	{
	Spawn:
		TNT1 A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		Goto Idle
	DMSpawn:
		"####" "#" 0 A_ChangeFlag("DROPPED", 0)
		Stop
	Idle:
		TNT1 A 0
		Stop
	Pickup:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMPickup")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"WeaponStay")
		TNT1 A 0 //A_GiveInventory("QCNailgun")
		TNT1 A 0
		Stop
	DMPickup:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"DMWeaponStay")
		TNT1 A 0 //A_GiveInventory("QCNailgunDM")
		TNT1 A 0
		TNT1 A 0 //A_TakeInventory("QCNailgun")
		TNT1 A 0
		Stop
	WeaponStay:
		TNT1 A 0 A_JumpIfInventory("QCNailgun",1,"Stay")
		TNT1 A 0 //A_SpawnItemEx("QCNailgun", velx,vely,velz, velx,vely,velz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Fail
	DMWeaponStay:
		TNT1 A 0 A_TakeInventory("QCNailgun")
		TNT1 A 0 A_JumpIfInventory("QCNailgunDM",1,"Stay")
		TNT1 A 0 //A_SpawnItemEx("QCNailgunDM", velx,vely,velz, velx,vely,velz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Fail
	Stay:
		TNT1 A 0
		Fail
	HideIndefinitely:
		TNT1 A 1 A_SetTics(CallACS("QCDE_SetWeaponRespawnTics"))
		Goto HideDoomish+1
	}
}



Actor QCNailgun : QCWeapon
{
	Height 48
	Weapon.SwaySpeed 3.4
	Weapon.Kickback 30
	Weapon.SelectionOrder 2000
	Weapon.AmmoUse 1
	Weapon.AmmoGive 50
	Weapon.AmmoType "QCNailAmmo"
	+INVENTORY.UNDROPPABLE
	Obituary "$OB_UTLinkGun"
	Inventory.PickupMessage "$GOT_UTLinkGun"
	Tag "$TAG_UTLinkGun"
	Scale 0.5
	States
	{
	Spawn:
		TNT1 A 0 NODELAY A_ChangeFlag("NOBLOCKMAP",1)	//in DM, if a player drops this weapon, cant be picked
		TNT1 A 3	//and disappears
		Stop
	//-----------------------
	// Select/Deselect Seq
	//-----------------------
	Select:
		TNT1 A 0 A_JumpIfInventory("UTLinkGunSkin", 9, "Select.UC2") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTLinkGunSkin", 8, "Select.UC2") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTLinkGunSkin", 7, "Select.UC2") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTLinkGunSkin", 6, "Select.UC2")
		TNT1 A 0 A_JumpIfInventory("UTLinkGunSkin", 5, "Select.UT2004") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTLinkGunSkin", 4, "Select.UT2004")
		TNT1 A 0 A_JumpIfInventory("UTLinkGunSkin", 3, "Select.UT2004") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTLinkGunSkin", 2, "Select.UC2") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTLinkGunSkin", 1, "Select.UC2") // Fallback to another skin
	Select.UT2004:
		U4G4 A 0
		Goto SelectCont
	Select.UC2:
		U6G4 A 0
		Goto SelectCont

	SelectCont:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,2)
		"####" A 0 A_PlaySound("QC/Weapons/Switch",CHAN_5,1,0,3) //Not in Weapon.UpSound because it interrupts CHAN_WEAPON sounds
		"####" A 0 A_StopSound(CHAN_WEAPON) //stops any weapon looping sound
	SelectLooper:
		"####" A 1 A_Raise
		"####" AAA 0 A_Raise
		Loop

	Deselect:
		"####" A 0 A_StopSound(5)
		"####" A 0 A_StopSound(CHAN_WEAPON)
	DeselectLooper:
		"####" A 1 A_Lower
		"####" AAA 0 A_Lower
		Loop

	//-----------------------
	// Ready Seq
	//-----------------------
	Ready:
		TNT1 A 0 A_JumpIfInventory("UTLinkGunSkin", 9, "Ready.UC2") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTLinkGunSkin", 8, "Ready.UC2") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTLinkGunSkin", 7, "Ready.UC2") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTLinkGunSkin", 6, "Ready.UC2")
		TNT1 A 0 A_JumpIfInventory("UTLinkGunSkin", 5, "Ready.UT2004") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTLinkGunSkin", 4, "Ready.UT2004")
		TNT1 A 0 A_JumpIfInventory("UTLinkGunSkin", 3, "Ready.UT2004") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTLinkGunSkin", 2, "Ready.UC2") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTLinkGunSkin", 1, "Ready.UC2") // Fallback to another skin
	Ready.UT2004:
		U4G4 A 0
		Goto ReadyCont
	Ready.UC2:
		U6G4 A 0
		Goto ReadyCont

	ReadyCont:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		"####" AAAABBBBCCCCDDDDEEEEFFFFGGGGHHHHIIIIJJJJ 1 A_WeaponReady
		Loop

		ReadyCantFire:
			"####" A 0 A_StopSound(5)
			"####" A 0 A_StopSound(CHAN_WEAPON)
		RCFLooper:
			"####" A 4 A_WeaponReady(WRF_NOFIRE)
			"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"RCFLooper")
			Goto Ready

	//-----------------------
	// Fire Seq
	//-----------------------
	Fire:
	FireLooper1:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		"####" A 0 A_GunFlash("Flash")
		"####" K 1 Bright 	Offset(2,33)
		"####" L 1 Bright	Offset(5,35)
		"####" F 1 			Offset(3,34)
		"####" G 1 			Offset(1,33)
		"####" H 1 			Offset(0,32)
		"####" I 1
		"####" J 1
		"####" A 0 A_ReFire("FireLooper2")
		Goto EndFireLooper

	FireLooper2:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		"####" A 0 A_GunFlash("Flash")
		"####" M 1 Bright 	Offset(2,33)
		"####" N 1 Bright	Offset(5,35)
		"####" F 1 			Offset(3,34)
		"####" G 1 			Offset(1,33)
		"####" H 1 			Offset(0,32)
		"####" I 1
		"####" J 1
		"####" A 0 A_ReFire("FireLooper1")
		Goto EndFireLooper

	EndFireLooper:
		"####" A 1 A_WeaponReady(WRF_NOBOB)
		Goto Ready


	//-----------------------
	// Attack doers
	//-----------------------

	Flash:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_JumpIfInventory("UTLinkGunSkin", 9, "Flash.UC2") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTLinkGunSkin", 8, "Flash.UC2") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTLinkGunSkin", 7, "Flash.UC2") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTLinkGunSkin", 6, "Flash.UC2")
		TNT1 A 0 A_JumpIfInventory("UTLinkGunSkin", 5, "Flash.UT2004") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTLinkGunSkin", 4, "Flash.UT2004")
		TNT1 A 0 A_JumpIfInventory("UTLinkGunSkin", 3, "Flash.UT2004") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTLinkGunSkin", 2, "Flash.UC2") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTLinkGunSkin", 1, "Flash.UC2") // Fallback to another skin
	Flash.UT2004:
		TNT1 A 0 A_FireCustomMissile("UTPulseWeak",0,true,1,4)
		Goto FlashCont
	Flash.UC2:
		TNT1 A 0 A_FireCustomMissile("UTPulseWeak_UC2",0,true,1,4)
		Goto FlashCont

	FlashCont:
		TNT1 A 0 A_JumpIfInventory("PowerQuad",1,"FireQuadSound")
		TNT1 A 0 A_JumpIfInventory("PowerTerminatorArtifact",1,"FireQuadSound")
		Goto FireNormalSound

		FireNormalSound:
			TNT1 A 0 A_JumpIfInventory("UTLinkGunSkin", 9, "FireNormalSound.UC2") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTLinkGunSkin", 8, "FireNormalSound.UC2") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTLinkGunSkin", 7, "FireNormalSound.UC2") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTLinkGunSkin", 6, "FireNormalSound.UC2")
			TNT1 A 0 A_JumpIfInventory("UTLinkGunSkin", 5, "FireNormalSound.UT2004") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTLinkGunSkin", 4, "FireNormalSound.UT2004")
			TNT1 A 0 A_JumpIfInventory("UTLinkGunSkin", 3, "FireNormalSound.UT2004") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTLinkGunSkin", 2, "FireNormalSound.UC2") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTLinkGunSkin", 1, "FireNormalSound.UC2") // Fallback to another skin
		FireNormalSound.UT2004:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/LinkGun/Fire_UT2004",CHAN_WEAPON,1,false)
			Goto EndFlash
		FireNormalSound.UC2:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/LinkGun/Fire_UC2",CHAN_WEAPON,1,false)
			Goto EndFlash

		FireQuadSound:
			TNT1 A 0 A_JumpIfInventory("UTLinkGunSkin", 9, "FireQuadSound.UC2") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTLinkGunSkin", 8, "FireQuadSound.UC2") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTLinkGunSkin", 7, "FireQuadSound.UC2") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTLinkGunSkin", 6, "FireQuadSound.UC2")
			TNT1 A 0 A_JumpIfInventory("UTLinkGunSkin", 5, "FireQuadSound.UT2004") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTLinkGunSkin", 4, "FireQuadSound.UT2004")
			TNT1 A 0 A_JumpIfInventory("UTLinkGunSkin", 3, "FireQuadSound.UT2004") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTLinkGunSkin", 2, "FireQuadSound.UC2") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTLinkGunSkin", 1, "FireQuadSound.UC2") // Fallback to another skin
		FireQuadSound.UT2004:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/LinkGun/Quad/Fire_UT2004",CHAN_WEAPON,1,false)
			Goto EndFlash
		FireQuadSound.UC2:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/LinkGun/Quad/Fire_UC2",CHAN_WEAPON,1,false)
			Goto EndFlash

		EndFlash:
			TNT1 A 0 A_JumpIfInventory("WepNoFlashToken",1,"EndFlashCont")
			TNT1 A 0 A_SetBlend("Green",0.03,3)
		EndFlashCont:
			TNT1 A 0 A_JumpIfInventory("WepNoRecoilToken",1,"EndFlashNoRecoil")
			TNT1 A 1 A_SetPitch(Pitch-0.4)
			TNT1 AA 1 A_SetPitch(Pitch+0.2)
			Stop
		EndFlashNoRecoil:
			TNT1 A 1
			Stop
	}
}

Actor UTPulseWeak : FastProjectile
{
	Projectile
	+FORCEXYBILLBOARD
	+BLOODSPLATTER
	+MTHRUSPECIES
	+DONTBLAST
	Obituary "$OB_UTLinkGun"
	Speed 52
	Radius 4
	Height 9
	Damage (random(8,16))
	Decal "UTPulseGunFull"
	Scale 0.30
	RenderStyle Add
	States
	{
	Spawn:
		PULC A 1 Bright Light("GreenMediumFlicker2") Bright
		Loop

	XDeath:
		TNT1 A 10 A_GiveToTarget("HitBeepLow",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		Stop

	Death:
		PULC A 0 A_PlaySound("UTDE/Weapons/PulseGun/Impact",CHAN_AUTO,1,0,1)
		PULC A 1 Light("YellowMediumFlicker3") Bright
		PULC BBCCDDEEFFGGHH 1 Bright
		TNT1 A 1 // Need the actor to live one more tick so that a proper obituary message is shown
		Stop
	}
}

Actor UTPulseWeak_UC2 : UTPulseWeak
{
	Decal "BulletChipBlack"
	States
	{
	Spawn:
		NA8I A 1 Bright Light("YellowSmallPoint2")
		Loop

	XDeath:
		TNT1 A 10 A_GiveToTarget("HitBeepLow",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		Stop

	Death:
		TNT1 A 0 A_PlaySound("QC/Weapons/Nailgun/Impact_SeriousSam",CHAN_AUTO,0.6,0,1.7,AAPTR_TARGET)
		TNT1 A 0 A_SpawnItemEx("UTPulseWeakDeathFx_UC2", 0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION)
		TNT1 A 1 // Need the actor to live one more tick so that a proper obituary message is shown
		Stop
	}
}

Actor UTPulseWeakDeathFx_UC2
{
	+NOINTERACTION
	+FORCEXYBILLBOARD
	+NONETID
	+CLIENTSIDEONLY
	Radius 1
	Height 1
	Speed 0
	Scale 0.45

	States
	{
	Spawn:
		TNT1 A 0 NODELAY A_Jump(256,"T1","T2","T3","T4")

	T1:
		DB09 A 0
		Goto EndDeath
	T2:
		DB10 A 0
		Goto EndDeath
	T3:
		DB11 A 0
		Goto EndDeath
	T4:
		DB12 A 0
		Goto EndDeath

	EndDeath:
		"####" ABCDEF 1 Light("YellowSmallFlicker3") Bright
		"####" GH 1 Bright
		"####" IJKLMNOPQRST 2 Bright
		Stop
	}
}

// --------------------------------------------------------------------------
//	For competitive DM, weapons dont autoaim
// --------------------------------------------------------------------------
Actor QCNailgunDM : QCNailgun
{
	+WEAPON.NOAUTOAIM
	+CHEATNOTWEAPON
	Tag "$TAG_UTLinkGun"
	Weapon.AmmoGive 100
	Weapon.AmmoDmScale 1.0
	Weapon.AmmoDmRefill 10
	States
	{
	Flash:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_JumpIfInventory("UTLinkGunSkin", 9, "Flash.UC2") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTLinkGunSkin", 8, "Flash.UC2") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTLinkGunSkin", 7, "Flash.UC2") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTLinkGunSkin", 6, "Flash.UC2")
		TNT1 A 0 A_JumpIfInventory("UTLinkGunSkin", 5, "Flash.UT2004") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTLinkGunSkin", 4, "Flash.UT2004")
		TNT1 A 0 A_JumpIfInventory("UTLinkGunSkin", 3, "Flash.UT2004") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTLinkGunSkin", 2, "Flash.UC2") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTLinkGunSkin", 1, "Flash.UC2") // Fallback to another skin
	Flash.UT2004:
		TNT1 A 0 A_FireCustomMissile("UTPulseWeakDM",0,true,1,4)
		Goto FlashCont
	Flash.UC2:
		TNT1 A 0 A_FireCustomMissile("UTPulseWeakDM_UC2",0,true,1,4)
		Goto FlashCont
	}
}

Actor UTPulseWeakDM : UTPulseWeak
{
	Decal "BulletChipBlack"
	-MTHRUSPECIES
	-DONTBLAST
	Damage (25)
}

Actor UTPulseWeakDM_UC2 : UTPulseWeakDM
{
	States
	{
	Spawn:
		NA8I A 1 Bright Light("YellowSmallPoint2")
		Loop

	XDeath:
		TNT1 A 10 A_GiveToTarget("HitBeepLow",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		Stop

	Death:
		TNT1 A 0 A_PlaySound("QC/Weapons/Nailgun/Impact_SeriousSam",CHAN_AUTO,0.6,0,1.7,AAPTR_TARGET)
		TNT1 A 0 A_SpawnItemEx("UTPulseWeakDeathFx_UC2", 0,0,0, 0,0,0, 0, SXF_NOCHECKPOSITION)
		TNT1 A 1 // Need the actor to live one more tick so that a proper obituary message is shown
		Stop
	}
}

