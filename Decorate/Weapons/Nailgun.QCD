// --------------------------------------------------------------------------
//
// Pulse Gun Mini
// Weapon and Pickup sprite by Pixo
// Weapon code by geNia
//
// --------------------------------------------------------------------------

// This pickup is only for consistency -- it never gives weapon.
Actor NailgunPickup : CustomInventory
{
	Height 48
	Radius 20
	Scale 0.5
	Inventory.PickupSound "QC/Items/WeaponPick"
	Inventory.PickupMessage "$GOT_UTPulseMini"
	Tag "$TAG_UTPulseMini"
	States
	{
	Spawn:
		TNT1 A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		Goto Idle
	DMSpawn:
		"####" "#" 0 A_ChangeFlag("DROPPED", 0)
		Stop
	Idle:
		TNT1 A 0
		Stop
	Pickup:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMPickup")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"WeaponStay")
		TNT1 A 0 //A_GiveInventory("QCNailgun")
		TNT1 A 0
		Stop
	DMPickup:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"DMWeaponStay")
		TNT1 A 0 //A_GiveInventory("QCNailgunDM")
		TNT1 A 0
		TNT1 A 0 //A_TakeInventory("QCNailgun")
		TNT1 A 0
		Stop
	WeaponStay:
		TNT1 A 0 A_JumpIfInventory("QCNailgun",1,"Stay")
		TNT1 A 0 //A_SpawnItemEx("QCNailgun", velx,vely,velz, velx,vely,velz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Fail
	DMWeaponStay:
		TNT1 A 0 A_TakeInventory("QCNailgun")
		TNT1 A 0 A_JumpIfInventory("QCNailgunDM",1,"Stay")
		TNT1 A 0 //A_SpawnItemEx("QCNailgunDM", velx,vely,velz, velx,vely,velz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Fail
	Stay:
		TNT1 A 0
		Fail
	HideIndefinitely:
		TNT1 A 1 A_SetTics(CallACS("QCDE_SetWeaponRespawnTics"))
		Goto HideDoomish+1
	}
}



Actor QCNailgun : QCWeapon
{
	Height 48
	Weapon.SwaySpeed 2.8
	Weapon.Kickback 30
	Weapon.SelectionOrder 2000
	Weapon.AmmoUse 1
	Weapon.AmmoGive 50
	Weapon.AmmoType "QCNailAmmo"
	+INVENTORY.UNDROPPABLE
	Obituary "$OB_UTPulseMini"
	Inventory.PickupMessage "$GOT_UTPulseMini"
	Tag "$TAG_UTPulseMini"
	Scale 0.5
	States
	{
	Spawn:
		TNT1 A 0 NODELAY A_ChangeFlag("NOBLOCKMAP",1)	//in DM, if a player drops this weapon, cant be picked
		TNT1 A 3	//and disappears
		Stop
	//-----------------------
	// Select/Deselect Seq
	//-----------------------
	Select:
		UTPM A 0 A_JumpIfInventory("NoWeaponFireToken",1,2)
		UTPM A 0 A_PlaySound("QC/Weapons/Switch",5,1,0,3) //Not in Weapon.UpSound because it interrupts CHAN_WEAPON sounds
		"####" "#" 0 A_StopSound(CHAN_WEAPON) //stops any weapon looping sound
	SelectLooper:
		UTPM A 1 A_Raise
		"####" "###" 0 A_Raise
		Loop

	Deselect:
		UTPM A 0 A_StopSound(5)
		UTPM A 0 A_StopSound(CHAN_WEAPON)
	DeselectLooper:
		UTPM A 1 A_Lower
		"####" "###" 0 A_Lower
		Loop

	//-----------------------
	// Ready Seq
	//-----------------------
	Ready:
		UTPM A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		UTPM AAAABBBBCCCCDDDDEEEEFFFFGGGGHHHHIIIIJJJJ 1 A_WeaponReady
		Loop

		ReadyCantFire:
			UTPM A 0 A_StopSound(5)
			UTPM A 0 A_StopSound(CHAN_WEAPON)
		RCFLooper:
			UTPM A 4 A_WeaponReady(WRF_NOFIRE)
			UTPM A 0 A_JumpIfInventory("NoWeaponFireToken",1,"RCFLooper")
			Goto Ready

	//-----------------------
	// Fire Seq
	//-----------------------
	Fire:
		TNT1 A 0 A_JumpIfInventory("PowerQuad",1,"FireQuadSound")
		Goto FireNormalSound

		FireNormalSound:
			UTPM A 0 A_PlaySound("UTDE/Weapons/PulseMini/FireStartLoop",CHAN_WEAPON,1,1)
			Goto FireLooper
		FireQuadSound:
			UTPM A 0 A_PlaySound("UTDE/Weapons/PulseMini/Quad/FireStartLoop",CHAN_WEAPON,1,1)
			Goto FireLooper

	FireLooper:
		UTPM A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		UTPM K 0 A_GunFlash("Flash")
		UTPM K 1 Bright 	Offset(2,33)
		UTPM L 1 		 	Offset(4,35)
		UTPM L 1
		UTPM M 1
		UTPM N 1
		UTPM A 1
		UTPM A 1 			Offset(2,33)
		UTPM A 0 A_ReFire("FireLooper")
		Goto EndFireLooper

	EndFireLooper:
		UTPM A 0 A_PlaySound("UTDE/Weapons/PulseMini/FireEnd",CHAN_WEAPON,1,0)
		UTPM A 1 A_WeaponReady(WRF_NOBOB)
		Goto Ready


	//-----------------------
	// Attack doers
	//-----------------------

	Flash:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_FireCustomMissile("UTPulseWeak",0,true,1,4)
		Goto EndFlash

		EndFlash:
			TNT1 A 0 A_JumpIfInventory("WepNoRecoilToken",1,"EndFlashNoRecoil")
			TNT1 A 1 A_SetPitch(Pitch-0.6)
			TNT1 AA 1 A_SetPitch(Pitch+0.3)
			Stop
		EndFlashNoRecoil:
			TNT1 A 1
			Stop
	}
}

Actor UTPulseWeak : FastProjectile
{
	Projectile
	+FORCEXYBILLBOARD
	+BLOODSPLATTER
	+MTHRUSPECIES
	+DONTBLAST
	Obituary "$OB_UTPulseMini"
	Speed 52
	Radius 4
	Height 9
	Damage (random(8,16))
	Decal "Q4PlasmaBlack"
	Scale 0.30
	States
	{
	Spawn:
		PULS A 1 Bright
		Wait

	XDeath:
		TNT1 A 10 A_GiveToTarget("HitBeepLow",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		Stop

	Death:
		PULS A 0 A_PlaySound("UTDE/Weapons/PulseGun/Impact",CHAN_AUTO,1,0,1)
		PULS A 1 Light("YellowSmallFlicker3") Bright
		PULS BCDEFGH 1 Bright
		Stop
	}
}

// --------------------------------------------------------------------------
//	For competitive DM, weapons dont autoaim
// --------------------------------------------------------------------------
Actor QCNailgunDM : QCNailgun
{
	+WEAPON.NOAUTOAIM
	+CHEATNOTWEAPON
	Tag "$TAG_UTPulseMini"
	Weapon.AmmoGive 100
	Weapon.AmmoDmScale 1.0
	Weapon.AmmoDmRefill 10
	States
	{
	Flash:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_FireCustomMissile("UTPulseWeakDM",0,true,1,4)
		Goto EndFlash
	}
}

Actor UTPulseWeakDM : UTPulseWeak
{
	-MTHRUSPECIES
	-DONTBLAST
	Damage (25)
}
