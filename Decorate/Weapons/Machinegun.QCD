Actor CompatVer30_Machinegun {} // for compatibility checks

// This pickup is only for consistency -- it never gives weapon.
Actor MachinegunPickup : CustomInventory
{
	Scale 0.5
	Inventory.PickupSound "QC/Items/WeaponPick"
	Inventory.PickupMessage "$GOT_UTEnforcer"
	Tag "$TAG_UTEnforcer"
	States
	{
	Spawn:
		UTEN Z 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		Goto Idle
	DMSpawn:
		"####" "#" 0 A_ChangeFlag("DROPPED", 0)
		Stop
	Idle:
		TNT1 A 0
		Stop
	Pickup:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMPickup")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"WeaponStay")
		TNT1 A 0 //A_GiveInventory("QCMachinegun")
		TNT1 A 0
		Stop
	DMPickup:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"DMWeaponStay")
		TNT1 A 0 //A_GiveInventory("QCMachinegunDM")
		TNT1 A 0
		TNT1 A 0 //A_TakeInventory("QCMachinegun")
		TNT1 A 0
		Stop
	WeaponStay:
		TNT1 A 0 A_JumpIfInventory("QCMachinegun",1,"Stay")
		TNT1 A 0 //A_SpawnItemEx("QCMachinegun", velx,vely,velz, velx,vely,velz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Fail
	DMWeaponStay:
		TNT1 A 0 A_TakeInventory("QCMachinegun")
		TNT1 A 0 A_JumpIfInventory("QCMachinegunDM",1,"Stay")
		TNT1 A 0 //A_SpawnItemEx("QCMachinegunDM", velx,vely,velz, velx,vely,velz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Fail
	Stay:
		TNT1 A 0
		Fail
	}
}



Actor QCMachineGun : QCWeapon
{
	Weapon.SwaySpeed 3.4
	Weapon.Kickback 20
	Weapon.SelectionOrder 2000
	Weapon.AmmoUse 1
	Weapon.AmmoGive 50
	Weapon.AmmoType "QCBulletAmmo"
	Obituary "$OB_UTEnforcer"
	+INVENTORY.UNDROPPABLE
	Inventory.PickupMessage "$GOT_UTEnforcer"
	Tag "$TAG_UTEnforcer"
	States
	{
 	Spawn:
		TNT1 A 0 NODELAY A_ChangeFlag("NOBLOCKMAP",1)	//in DM, if a player drops this weapon, cant be picked
		TNT1 A 3	//and disappears
		Stop

	//-----------------------
	// Select/Deselect Seq
	//-----------------------
	Select:
		UTEN A 0 A_JumpIfInventory("NoWeaponFireToken",1,2)
		UTEN A 0 A_PlaySound("QC/Weapons/Switch",CHAN_5,1,0,3) //Not in Weapon.UpSound because it interrupts CHAN_WEAPON sounds
		"####" "#" 0 A_StopSound(CHAN_WEAPON) //stops any weapon looping sound
	SelectLooper:
		UTEN A 1 A_Raise
		"####" "###" 0 A_Raise
		Loop

	Deselect:
		UTEN A 0 A_StopSound(5)
		UTEN A 0 A_StopSound(CHAN_WEAPON)
	DeselectLooper:
		UTEN A 1 A_Lower
		"####" "###" 0 A_Lower
		Loop

	//-----------------------
	// Ready Seq
	//-----------------------
	Ready:
		UTEN A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		UTEN A 1 A_WeaponReady
		Loop

		ReadyCantFire:
			UTEN A 0 A_StopSound(5)
			UTEN A 0 A_StopSound(CHAN_WEAPON)
		RCFLooper:
			UTEN A 4 A_WeaponReady(WRF_NOFIRE)
			UTEN A 0 A_JumpIfInventory("NoWeaponFireToken",1,"RCFLooper")
			Goto Ready

	//-----------------------
	// Fire Seq
	//-----------------------
	Fire:
		UTEN A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		UTEN A 0 A_GunFlash("Flash")
		UTEN A 0 A_Jump(256,"Muzzle1","Muzzle2")
	Muzzle1:
		UTEN B 1 Offset(2,33)
		UTEN C 1 Offset(4,35)
		UTEN C 1 Offset(5,36)
		UTEN D 1 Offset(5,36)
		UTEN D 1 Offset(5,36)
		Goto FireCont
	Muzzle2:
		UTEN E 1 Offset(1,32)
		UTEN F 1 Offset(3,34)
		UTEN F 1 Offset(4,35)
		UTEN G 1 Offset(4,35)
		UTEN G 1 Offset(4,35)
		Goto FireCont
	FireCont:
		UTEN A 1 Offset(4,34)
		UTEN A 1 Offset(3,33)
		UTEN A 1 Offset(2,32)
		UTEN A 1 Offset(1,32)
		UTEN A 1 Offset(0,32)
		UTEN A 1 Offset(0,32) A_ReFire("Fire")
		Goto EndFireLooper

	EndFireLooper:
		UTEN A 1 A_WeaponReady(WRF_NOBOB)
		Goto Ready

	//-----------------------
	// Attack doers
	//-----------------------
	Flash:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_FireBullets(1.5,1.5,1,random(5,8),"QCBulletPuff",FBF_NORANDOM|FBF_USEAMMO)
		TNT1 A 0 A_JumpIfInventory("PowerQuad",1,"FireQuadSound")
		Goto FireNormalSound

	FlashNA:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_FireBullets(1.5,1.5,1,random(5,8),"QCBulletPuff",FBF_NORANDOM)
		TNT1 A 0 A_JumpIfInventory("PowerQuad",1,"FireQuadSound")
		Goto FireNormalSound

		FireNormalSound:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Enforcer/Fire",CHAN_WEAPON,1,false)
			Goto EndFlash
		FireQuadSound:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Enforcer/Quad/Fire",CHAN_WEAPON,1,false)
			Goto EndFlash

		EndFlash:
			TNT1 A 0 A_JumpIfInventory("WepNoRecoilToken",1,"EndFlashNoRecoil")
			TNT1 A 1 A_SetPitch(Pitch-0.4)
			TNT1 AA 1 A_SetPitch(Pitch+0.2)
			Stop
		EndFlashNoRecoil:
			TNT1 A 1
			Stop
	}
}



// --------------------------------------------------------------------------
//	For competitive DM, weapons don't autoaim
// --------------------------------------------------------------------------

Actor QCMachineGunDM : QCMachineGun
{
	+WEAPON.NOAUTOAIM
	+CHEATNOTWEAPON
	Tag "$TAG_UTEnforcer"
	Weapon.AmmoGive 100
	Weapon.AmmoDmScale 1.0
	Weapon.AmmoDmRefill 10

	States
	{
	Flash:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_FireBullets(1.5,1.5,1,10,"QCBulletPuff_DM",FBF_NORANDOM|FBF_USEAMMO)
		TNT1 A 0 A_JumpIfInventory("PowerQuad",1,"FireQuadSound")
		Goto FireNormalSound
	}
}
