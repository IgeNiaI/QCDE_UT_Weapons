// --------------------------------------------------------------------------
//
// Assault Rifle (Replaces Machinegun)
// Weapon and Pickup sprite by Pixo
// Weapon code by geNia
//
// --------------------------------------------------------------------------

// This pickup is only for consistency -- it never gives weapon.
Actor MachinegunPickup : CustomInventory
{
	Scale 0.5
	Inventory.PickupSound "QC/Items/WeaponPick"
	Inventory.PickupMessage "$GOT_UTAssaltRifle" // "Picked up the Machinegun."
	Tag "$TAG_UTAssaltRifle" // "Machinegun"
	States
	{
	Spawn:
		UTAR Z 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		Goto Idle
	DMSpawn:
		"####" "#" 0 A_ChangeFlag("DROPPED", 0)
		Stop
	Idle:
		TNT1 A 0
		Stop
	Pickup:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMPickup")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"WeaponStay")
		TNT1 A 0 //A_GiveInventory("QCMachinegun")
		TNT1 A 0 
		Stop
	DMPickup:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"DMWeaponStay")
		TNT1 A 0 //A_GiveInventory("QCMachinegunDM")
		TNT1 A 0
		TNT1 A 0 //A_TakeInventory("QCMachinegun")
		TNT1 A 0
		Stop
	WeaponStay:
		TNT1 A 0 A_JumpIfInventory("QCMachinegun",1,"Stay")
		TNT1 A 0 //A_SpawnItemEx("QCMachinegun", velx,vely,velz, velx,vely,velz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Fail
	DMWeaponStay:
		TNT1 A 0 A_TakeInventory("QCMachinegun")
		TNT1 A 0 A_JumpIfInventory("QCMachinegunDM",1,"Stay")
		TNT1 A 0 //A_SpawnItemEx("QCMachinegunDM", velx,vely,velz, velx,vely,velz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Fail
	Stay:
		TNT1 A 0
		Fail
	}
}



Actor QCMachineGun : QCWeapon
{
	Weapon.SwaySpeed 1.7
	Weapon.Kickback 20
	Weapon.SelectionOrder 2000
	Weapon.AmmoUse 1
	Weapon.AmmoGive 50
	Weapon.AmmoType "QCBulletAmmo"
	Obituary "$OB_UTAssaltRifle" // "%o was riddled with holes by %k."
	+INVENTORY.UNDROPPABLE
	Inventory.PickupMessage "$GOT_UTAssaltRifle" // "Picked up the Machinegun."
	Tag "$TAG_UTAssaltRifle" // "Machinegun"
	States
	{
 	Spawn:
		TNT1 A 0 NODELAY A_ChangeFlag("NOBLOCKMAP",1)	//in DM, if a player drops this weapon, cant be picked
		TNT1 A 3	//and disappears
		Stop

	//-----------------------
	// Select/Deselect Seq
	//-----------------------
	Select:
		UTAR A 0 A_JumpIfInventory("NoWeaponFireToken",1,2)
		UTAR A 0 A_PlaySound("QC/Weapons/Switch",5,1,0,3) //Not in Weapon.UpSound because it interrupts CHAN_WEAPON sounds
		"####" "#" 0 A_StopSound(CHAN_WEAPON) //stops any weapon looping sound
	SelectLooper:
		UTAR A 1 A_Raise
		"####" "###" 0 A_Raise
		Loop
		
	Deselect:
		UTAR A 0 A_StopSound(5)
		UTAR A 0 A_StopSound(CHAN_WEAPON)
	DeselectLooper:	
		UTAR A 1 A_Lower
		"####" "###" 0 A_Lower
		Loop

	//-----------------------
	// Ready Seq
	//-----------------------
	Ready:
		UTAR A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		UTAR A 1 A_WeaponReady
		Loop
		
		ReadyCantFire:
			UTAR A 0 A_StopSound(5)
			UTAR A 0 A_StopSound(CHAN_WEAPON)
		RCFLooper:
			UTAR A 4 A_WeaponReady(WRF_NOFIRE)
			UTAR A 0 A_JumpIfInventory("NoWeaponFireToken",1,"RCFLooper")
			Goto Ready

	//-----------------------
	// Fire Seq
	//-----------------------
	Fire:
		TNT1 A 0 A_JumpIfInventory("PowerQuad",1,"FireQuadSound")
		Goto FireNormalSound
		
		FireNormalSound:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/AssaultRifle/FireStartLoop",CHAN_WEAPON,1,1)
			Goto FireLooper
		FireQuadSound:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/AssaultRifle/Quad/FireStartLoop",CHAN_WEAPON,1,1)
			Goto FireLooper
			
	FireLooper:	
		UTAR A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		UTAR B 0 A_GunFlash("Flash")
		UTAR B 1 Offset(2,34)
		UTAR C 1 Offset(3,34)
		UTAR D 1 Offset(2,33)
		UTAR A 1 Offset(1,32) A_ReFire("FireLooper")
		Goto EndFireLooper
			
	EndFireLooper:
		UTAR A 0 A_PlaySound("UTDE/Weapons/AssaultRifle/FireEnd",CHAN_WEAPON,1,0)
		UTAR A 1 A_WeaponReady(WRF_NOBOB)
		Goto Ready
		
	//-----------------------
	// Attack doers
	//-----------------------
	Flash:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_FireBullets(3,3,1,7,"QCBulletPuff_DM",FBF_NORANDOM|FBF_USEAMMO)
		Goto EndFlash
			
		EndFlash:
			TNT1 A 0 A_JumpIfInventory("WepNoRecoilToken",1,"EndFlashNoRecoil")
			TNT1 A 1 A_SetPitch(Pitch-0.4)
			TNT1 AA 1 A_SetPitch(Pitch+0.2)
			Stop
		EndFlashNoRecoil:
			TNT1 A 1 
			Stop
	}
}



// --------------------------------------------------------------------------
//	For competitive DM, weapons don't autoaim
// --------------------------------------------------------------------------

Actor QCMachineGunDM : QCMachineGun
{	
	+WEAPON.NOAUTOAIM
	+CHEATNOTWEAPON
	Tag "$TAG_UTAssaltRifle" // "Machinegun (DM)"
	Weapon.AmmoGive 100
	Weapon.AmmoDmScale 1.0
	Weapon.AmmoDmRefill 10
}
