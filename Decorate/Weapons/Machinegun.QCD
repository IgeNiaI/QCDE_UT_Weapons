Actor CompatVer31_Machinegun {} // for compatibility checks

// This pickup is only for consistency -- it never gives weapon.
Actor MachinegunPickup : CustomInventory
{
	Scale 0.5
	Inventory.PickupSound "QC/Items/WeaponPick"
	Inventory.PickupMessage "$GOT_UTEnforcer"
	Tag "$TAG_UTEnforcer"
	States
	{
	Spawn:
		TNT1 A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMSpawn")
		Goto Idle
	DMSpawn:
		"####" "#" 0 A_ChangeFlag("DROPPED", 0)
		Stop
	Idle:
		TNT1 A 0
		Stop
	Pickup:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck",0,0,0,0) == 2,"DMPickup")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"WeaponStay")
		TNT1 A 0 //A_GiveInventory("QCMachinegun")
		TNT1 A 0
		Stop
	DMPickup:
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponStayCheck",0,0,0,0),"DMWeaponStay")
		TNT1 A 0 //A_GiveInventory("QCMachinegunDM")
		TNT1 A 0
		TNT1 A 0 //A_TakeInventory("QCMachinegun")
		TNT1 A 0
		Stop
	WeaponStay:
		TNT1 A 0 A_JumpIfInventory("QCMachinegun",1,"Stay")
		TNT1 A 0 //A_SpawnItemEx("QCMachinegun", velx,vely,velz, velx,vely,velz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Fail
	DMWeaponStay:
		TNT1 A 0 A_TakeInventory("QCMachinegun")
		TNT1 A 0 A_JumpIfInventory("QCMachinegunDM",1,"Stay")
		TNT1 A 0 //A_SpawnItemEx("QCMachinegunDM", velx,vely,velz, velx,vely,velz, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION)
		Fail
	Stay:
		TNT1 A 0
		Fail
	}
}



Actor QCMachineGun : QCWeapon
{
	Weapon.SwaySpeed 3.4
	Weapon.Kickback 20
	Weapon.SelectionOrder 2000
	Weapon.AmmoUse 1
	Weapon.AmmoGive 50
	Weapon.AmmoType "QCBulletAmmo"
	Obituary "$OB_UTEnforcer"
	+INVENTORY.UNDROPPABLE
	Inventory.PickupMessage "$GOT_UTEnforcer"
	Tag "$TAG_UTEnforcer"
	States
	{
 	Spawn:
		TNT1 A 0 NODELAY A_ChangeFlag("NOBLOCKMAP",1)	//in DM, if a player drops this weapon, cant be picked
		TNT1 A 3	//and disappears
		Stop

	//-----------------------
	// Select/Deselect Seq
	//-----------------------
	Select:
		TNT1 A 0 A_JumpIfInventory("UTEnforcerSkin", 9, "Select.UT99")
		TNT1 A 0 A_JumpIfInventory("UTEnforcerSkin", 8, "Select.UT99") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTEnforcerSkin", 7, "Select.UT99") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTEnforcerSkin", 6, "Select.UC2")
		TNT1 A 0 A_JumpIfInventory("UTEnforcerSkin", 5, "Select.UC1")
		TNT1 A 0 A_JumpIfInventory("UTEnforcerSkin", 4, "Select.UT2004")
		TNT1 A 0 A_JumpIfInventory("UTEnforcerSkin", 3, "Select.UT2003")
		TNT1 A 0 A_JumpIfInventory("UTEnforcerSkin", 2, "Select.U1") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTEnforcerSkin", 1, "Select.U1")
	Select.U1:
		U1G2 A 0
		Goto SelectCont
	Select.UT2003:
		U3G2 A 0
		Goto SelectCont
	Select.UT2004:
		U4G2 A 0
		Goto SelectCont
	Select.UC1:
		U5G2 A 0
		Goto SelectCont
	Select.UC2:
		U6G2 A 0
		Goto SelectCont
	Select.UT99:
		U9G2 A 0
		Goto SelectCont

	SelectCont:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,2)
		"####" A 0 A_PlaySound("QC/Weapons/Switch",CHAN_5,1,0,3) //Not in Weapon.UpSound because it interrupts CHAN_WEAPON sounds
		"####" A 0 A_StopSound(CHAN_WEAPON) //stops any weapon looping sound
	SelectLooper:
		"####" A 1 A_Raise
		"####" AAA 0 A_Raise
		Loop

	Deselect:
		"####" A 0 A_StopSound(5)
		"####" A 0 A_StopSound(CHAN_WEAPON)
	DeselectLooper:
		"####" A 1 A_Lower
		"####" AAA 0 A_Lower
		Loop

	//-----------------------
	// Ready Seq
	//-----------------------
	Ready:
		TNT1 A 0 A_JumpIfInventory("UTEnforcerSkin", 9, "Ready.UT99")
		TNT1 A 0 A_JumpIfInventory("UTEnforcerSkin", 8, "Ready.UT99") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTEnforcerSkin", 7, "Ready.UT99") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTEnforcerSkin", 6, "Ready.UC2")
		TNT1 A 0 A_JumpIfInventory("UTEnforcerSkin", 5, "Ready.UC1")
		TNT1 A 0 A_JumpIfInventory("UTEnforcerSkin", 4, "Ready.UT2004")
		TNT1 A 0 A_JumpIfInventory("UTEnforcerSkin", 3, "Ready.UT2003")
		TNT1 A 0 A_JumpIfInventory("UTEnforcerSkin", 2, "Ready.U1") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTEnforcerSkin", 1, "Ready.U1")
	Ready.U1:
		U1G2 A 0
		Goto ReadyCont
	Ready.UT2003:
		U3G2 A 0
		Goto ReadyCont
	Ready.UT2004:
		U4G2 A 0
		Goto ReadyCont
	Ready.UC1:
		U5G2 A 0
		Goto ReadyCont
	Ready.UC2:
		U6G2 A 0
		Goto ReadyCont
	Ready.UT99:
		U9G2 A 0
		Goto ReadyCont

	ReadyCont:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		"####" A 1 A_WeaponReady
		Loop

		ReadyCantFire:
			"####" A 0 A_StopSound(5)
			"####" A 0 A_StopSound(CHAN_WEAPON)
		RCFLooper:
			"####" A 4 A_WeaponReady(WRF_NOFIRE)
			"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"RCFLooper")
			Goto Ready

	//-----------------------
	// Fire Seq
	//-----------------------
	Fire:
		TNT1 A 0 A_JumpIfInventory("UTEnforcerSkin", 9, "Fire.UT99")
		TNT1 A 0 A_JumpIfInventory("UTEnforcerSkin", 8, "Fire.UT99") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTEnforcerSkin", 7, "Fire.UT99") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTEnforcerSkin", 6, "Fire.UC2")
		TNT1 A 0 A_JumpIfInventory("UTEnforcerSkin", 5, "Fire.UC1")
		TNT1 A 0 A_JumpIfInventory("UTEnforcerSkin", 4, "Fire.UT2004")
		TNT1 A 0 A_JumpIfInventory("UTEnforcerSkin", 3, "Fire.UT2003")
		TNT1 A 0 A_JumpIfInventory("UTEnforcerSkin", 2, "Fire.U1") // Fallback to another skin
		TNT1 A 0 A_JumpIfInventory("UTEnforcerSkin", 1, "Fire.U1")
	Fire.U1:
		U1G2 A 0
		Goto FireCont
	Fire.UT2003:
		U3G2 A 0
		Goto FireCont_Offsets
	Fire.UT2004:
		U4G2 A 0
		Goto FireCont_Offsets
	Fire.UC1:
		U5G2 A 0
		Goto FireCont_Offsets
	Fire.UC2:
		U6G2 A 0
		Goto FireCont
	Fire.UT99:
		U9G2 A 0
		Goto FireCont

	FireCont:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		"####" A 0 A_Jump(256, "Fire1", "Fire2")

	Fire1:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		"####" B 1 A_GunFlash("Flash")
		"####" C 1
		"####" D 1
		"####" E 1
		"####" F 1
		"####" G 1
		"####" A 0 A_ReFire("Fire2")
		Goto EndFireLooper

	Fire2:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		"####" H 1 A_GunFlash("Flash")
		"####" I 1
		"####" J 1
		"####" K 1
		"####" L 1
		"####" M 1
		"####" A 0 A_ReFire("Fire1")
		Goto EndFireLooper

	FireCont_Offsets:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		"####" A 0 A_Jump(256, "Fire1_Offsets", "Fire2_Offsets")

	Fire1_Offsets:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		"####" B 1 A_GunFlash("Flash")
		"####" C 1 Offset(2,33)
		"####" D 1 Offset(5,35)
		"####" E 1 Offset(3,34)
		"####" F 1 Offset(1,33)
		"####" G 1 Offset(0,32)
		"####" A 0 A_ReFire("Fire2_Offsets")
		Goto EndFireLooper

	Fire2_Offsets:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		"####" H 1 A_GunFlash("Flash")
		"####" I 1 Offset(2,33)
		"####" J 1 Offset(5,35)
		"####" K 1 Offset(3,34)
		"####" L 1 Offset(1,33)
		"####" M 1 Offset(0,32)
		"####" A 0 A_ReFire("Fire1_Offsets")
		Goto EndFireLooper

	EndFireLooper:
		"####" A 1 A_WeaponReady(WRF_NOBOB)
		Goto Ready

	//-----------------------
	// Attack doers
	//-----------------------
	Flash:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_FireBullets(1.75,1.75,1,random(5,8),"QCBulletPuff",FBF_NORANDOM|FBF_USEAMMO)
		TNT1 A 0 A_JumpIfInventory("PowerQuad",1,"FireQuadSound")
		TNT1 A 0 A_JumpIfInventory("PowerTerminatorArtifact",1,"FireQuadSound")
		Goto FireNormalSound

	FlashNA:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_FireBullets(1.75,1.75,1,random(5,8),"QCBulletPuff",FBF_NORANDOM)
		TNT1 A 0 A_JumpIfInventory("PowerQuad",1,"FireQuadSound")
		TNT1 A 0 A_JumpIfInventory("PowerTerminatorArtifact",1,"FireQuadSound")
		Goto FireNormalSound

		FireNormalSound:
			TNT1 A 0 A_JumpIfInventory("UTEnforcerSkin", 9, "FireNormalSound.UT99")
			TNT1 A 0 A_JumpIfInventory("UTEnforcerSkin", 8, "FireNormalSound.UT99") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTEnforcerSkin", 7, "FireNormalSound.UT99") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTEnforcerSkin", 6, "FireNormalSound.UC2")
			TNT1 A 0 A_JumpIfInventory("UTEnforcerSkin", 5, "FireNormalSound.UT2003") // UC1 uses UT2003 sounds
			TNT1 A 0 A_JumpIfInventory("UTEnforcerSkin", 4, "FireNormalSound.UT2004")
			TNT1 A 0 A_JumpIfInventory("UTEnforcerSkin", 3, "FireNormalSound.UT2003")
			TNT1 A 0 A_JumpIfInventory("UTEnforcerSkin", 2, "FireNormalSound.U1") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTEnforcerSkin", 1, "FireNormalSound.U1")
		FireNormalSound.U1:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Enforcer/Fire_U1",CHAN_WEAPON,1.0,false)
			Goto EndFlash
		FireNormalSound.UT2003:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Enforcer/Fire_UT2003",CHAN_WEAPON,1.0,false)
			Goto EndFlash
		FireNormalSound.UT2004:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Enforcer/Fire_UT2004",CHAN_WEAPON,1.0,false)
			Goto EndFlash
		FireNormalSound.UC2:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Enforcer/Fire_UC2",CHAN_WEAPON,1.0,false)
			Goto EndFlash
		FireNormalSound.UT99:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Enforcer/Fire_UT99",CHAN_WEAPON,0.75,false)
			Goto EndFlash

		FireQuadSound:
			TNT1 A 0 A_JumpIfInventory("UTEnforcerSkin", 9, "FireQuadSound.UT99")
			TNT1 A 0 A_JumpIfInventory("UTEnforcerSkin", 8, "FireQuadSound.UT99") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTEnforcerSkin", 7, "FireQuadSound.UT99") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTEnforcerSkin", 6, "FireQuadSound.UC2")
			TNT1 A 0 A_JumpIfInventory("UTEnforcerSkin", 5, "FireQuadSound.UT2003") // UC1 uses UT2003 sounds
			TNT1 A 0 A_JumpIfInventory("UTEnforcerSkin", 4, "FireQuadSound.UT2004")
			TNT1 A 0 A_JumpIfInventory("UTEnforcerSkin", 3, "FireQuadSound.UT2003")
			TNT1 A 0 A_JumpIfInventory("UTEnforcerSkin", 2, "FireQuadSound.U1") // Fallback to another skin
			TNT1 A 0 A_JumpIfInventory("UTEnforcerSkin", 1, "FireQuadSound.U1")
		FireQuadSound.U1:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Enforcer/Quad/Fire_U1",CHAN_WEAPON,1.0,false)
			Goto EndFlash
		FireQuadSound.UT2003:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Enforcer/Quad/Fire_UT2003",CHAN_WEAPON,1.0,false)
			Goto EndFlash
		FireQuadSound.UT2004:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Enforcer/Quad/Fire_UT2004",CHAN_WEAPON,1.0,false)
			Goto EndFlash
		FireQuadSound.UC2:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Enforcer/Quad/Fire_UC2",CHAN_WEAPON,1.0,false)
			Goto EndFlash
		FireQuadSound.UT99:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/Enforcer/Quad/Fire_UT99",CHAN_WEAPON,0.75,false)
			Goto EndFlash

		EndFlash:
			TNT1 A 0 A_JumpIfInventory("WepNoFlashToken",1,"EndFlashCont")
			TNT1 A 0 A_SetBlend("Yellow",0.03,3)
		EndFlashCont:
			TNT1 A 0 A_JumpIfInventory("WepNoRecoilToken",1,"EndFlashNoRecoil")
			TNT1 A 1 A_SetPitch(Pitch-0.4)
			TNT1 AA 1 A_SetPitch(Pitch+0.2)
			Stop
		EndFlashNoRecoil:
			TNT1 A 1
			Stop
	}
}



// --------------------------------------------------------------------------
//	For competitive DM, weapons don't autoaim
// --------------------------------------------------------------------------

Actor QCMachineGunDM : QCMachineGun
{
	+WEAPON.NOAUTOAIM
	+CHEATNOTWEAPON
	Tag "$TAG_UTEnforcer"
	Weapon.AmmoGive 100
	Weapon.AmmoDmScale 1.0
	Weapon.AmmoDmRefill 10

	States
	{
	Flash:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_FireBullets(1.75,1.75,1,10,"QCBulletPuff_DM",FBF_NORANDOM|FBF_USEAMMO)
		TNT1 A 0 A_JumpIfInventory("PowerQuad",1,"FireQuadSound")
		TNT1 A 0 A_JumpIfInventory("PowerTerminatorArtifact",1,"FireQuadSound")
		Goto FireNormalSound
	}
}


// ==========================================================================
// ==========================================================================
//	Weapon tokens
// ==========================================================================
// ==========================================================================

Actor UTEnforcerSkin	: Token { Inventory.MaxAmount 20 }

