Actor HammerAutofire
{
	+NOINTERACTION +NOTONAUTOMAP
	+NONETID
	+PUFFGETSOWNER
	+PUFFONACTORS
	+FORCEXYBILLBOARD
	Scale 0.35
	DamageType "ZombieGibber"
	States
	{
	Spawn:	//Hit non bleeder
		TNT1 A 0 NODELAY A_GiveToTarget("PunchedAlready",1)
		TNT1 A 0 A_PlaySound("UTDE/Weapons/ImpactHammer/Hit",CHAN_7,1,0,9)
		Goto Crash
	XDeath:	//hit bleeder
		TNT1 A 0 A_GiveToTarget("PunchedAlready",1)
		TNT1 A 0 A_PlaySound("UTDE/Weapons/ImpactHammer/Hit",CHAN_7,1,0,9)
		Stop
	Crash:	//hit everything else
		TNT1 A 0 // do nothing
		Stop
	}
}

Actor HammerPuff1
{
	+NONETID
	+NOINTERACTION
	+ALWAYSPUFF
	+PUFFGETSOWNER
	+EXTREMEDEATH
	+FORCEXYBILLBOARD
	Renderstyle Add
	Scale 0.35
	DamageType "ZombieGibber"
	Obituary "$OB_UTImpactHammer"
	States
	{
	Spawn:	//Hit non bleeder
		TNT1 A 0 NODELAY A_GiveToTarget("HitBeepMid",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		Goto Crash
	XDeath:	//hit bleeder
		TNT1 A 0 A_GiveToTarget("HitBeepMid",1,AAPTR_DEFAULT,GIF_FORCESERVERSIDE)
		TNT1 A 10
		Stop
	Crash:	//hit everything else
		TNT1 A 0 A_JumpIfInTargetInventory("Instagib",1,"DoPush")
		TNT1 A 0 A_JumpIfInTargetInventory("RocketArena",1,"DoPush")
		TNT1 A 0 A_JumpIfInTargetInventory("GNT_UG_Burn",1,"DoPush")
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", true)
		TNT1 A 0 A_Explode(12,32,XF_HURTSOURCE,0,32)	//self damage without hammer jump is 12
		TNT1 A 0 A_ChangeFlag("NODAMAGETHRUST", false)
	DoPush:
		TNT1 A 0 A_RadiusThrust(33,32,RTF_AFFECTSOURCE|RTF_THRUSTZ,32)
		Stop
	}
}

