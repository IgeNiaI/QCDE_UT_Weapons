// --------------------------------------------------------------------------
//
// Impact Hammer
// Weapon and Pickup sprite by Pixo
// Weapon code by geNia
//
// --------------------------------------------------------------------------

Actor QCGauntlet : QCWeapon
{
	Weapon.SwaySpeed 3.2
	Weapon.Kickback 0
	Weapon.SelectionOrder 2000
	Inventory.PickupMessage "$GOT_UTImpactHammer"
	Obituary "$OB_UTImpactHammer"
	Tag "$TAG_UTImpactHammer"
	+INVENTORY.UNDROPPABLE
	+WEAPON.MELEEWEAPON
	Weapon.KickBack 64
	States
	{
	Spawn:
		TNT1 A 0
		Stop	
	//-----------------------
	// Ready Seq
	//-----------------------
	Ready:
		UTIH A 0 A_JumpIfInventory("Class_Painkiller",1,"PKReady")
		UTIH A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		UTIH A 3 A_WeaponReady
		Goto Ready+2
		
		ReadyCantFire:
			UTIH A 0 A_StopSound(5)
		RCFLooper:
			UTIH A 4 A_WeaponReady(WRF_NOFIRE)
			UTIH A 0 A_JumpIfInventory("NoWeaponFireToken",1,"RCFLooper")
			Goto Ready

	//-----------------------
	// Select/Deselect Seq
	//-----------------------
	Select:
		UTIH A 0 A_JumpIfInventory("Class_Painkiller",1,"PKSelect")
		UTIH A 0 A_JumpIfInventory("NoWeaponFireToken",1,2)
		"####" "#" 0 A_StopSound(5) //stops any weapon looping sound
	SelectLooper:
		"####" "#" 1 A_Raise
		"####" "###" 0 A_Raise
		Loop
		
	Deselect:
		"####" A 0 A_StopSound(CHAN_WEAPON)
		"####" A 0 A_StopSound(5)
		"####" "#" 0 A_JumpIfInventory("PKTipDetached",1,"PKDetachedDeSelect")
	DeselectLooper:
		"####" "#" 1 A_Lower
		"####" "###" 0 A_Lower
		Loop

	//-----------------------
	// Fire Seq
	//-----------------------
	Fire:
		UTIH A 0 A_JumpIfInventory("Class_Painkiller",1,"PKFire")
		UTIH A 0 A_PlaySound("UTDE/Weapons/ImpactHammer/Charge",CHAN_WEAPON,1.0,0)
		UTIH A 0 A_Jump(256,"Charge10") //for virtual jump to inherited versions
		Goto Charge10

	//-----------------------
	// AltFire Seq
	//-----------------------
	AltFire: //38 tics, 1.1sec
		UTIH A 0 A_JumpIfInventory("Class_Painkiller",1,"PKAltFire")
		UTIH A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		UTIH A 0 A_Jump(256,"Fire1") //for virtual jump to inherited versions
		Goto Fire1

	//-----------------------
	// Charge States
	//-----------------------
	// Charge 1
	Charge10:
		UTIH B 1 A_CustomPunch(0,1,0,"HammerAutofire",56)
		UTIH B 0 A_JumpIfInventory("PunchedAlready",1,"Fire1")
		UTIH B 0 A_ReFire("Charge11")
		Goto Fire1
	Charge11:
		UTIH B 1 A_CustomPunch(0,1,0,"HammerAutofire",56)
		UTIH B 0 A_JumpIfInventory("PunchedAlready",1,"Fire1")
		UTIH B 0 A_ReFire("Charge12")
		Goto Fire1
	Charge12:
		UTIH B 1 A_CustomPunch(0,1,0,"HammerAutofire",56)
		UTIH B 0 A_JumpIfInventory("PunchedAlready",1,"Fire1")
		UTIH B 0 A_ReFire("Charge13")
		Goto Fire1
	Charge13:
		UTIH B 1 A_CustomPunch(0,1,0,"HammerAutofire",56)
		UTIH B 0 A_JumpIfInventory("PunchedAlready",1,"Fire1")
		UTIH B 0 A_ReFire("Charge14")
		Goto Fire1
	Charge14:
		UTIH B 1 A_CustomPunch(0,1,0,"HammerAutofire",56)
		UTIH B 0 A_JumpIfInventory("PunchedAlready",1,"Fire1")
		UTIH B 0 A_ReFire("Charge15")
		Goto Fire1

	// Charge 2
	Charge15:
		UTIH C 1 A_CustomPunch(0,1,0,"HammerAutofire",56)
		UTIH C 0 A_JumpIfInventory("PunchedAlready",1,"Fire2")
		UTIH C 0 A_ReFire("Charge16")
		Goto Fire2
	Charge16:
		UTIH C 1 A_CustomPunch(0,1,0,"HammerAutofire",56)
		UTIH C 0 A_JumpIfInventory("PunchedAlready",1,"Fire2")
		UTIH C 0 A_ReFire("Charge17")
		Goto Fire2
	Charge17:
		UTIH C 1 A_CustomPunch(0,1,0,"HammerAutofire",56)
		UTIH C 0 A_JumpIfInventory("PunchedAlready",1,"Fire2")
		UTIH C 0 A_ReFire("Charge18")
		Goto Fire2
	Charge18:
		UTIH C 1 A_CustomPunch(0,1,0,"HammerAutofire",56)
		UTIH C 0 A_JumpIfInventory("PunchedAlready",1,"Fire2")
		UTIH C 0 A_ReFire("Charge19")
		Goto Fire2
	Charge19:
		UTIH C 1 A_CustomPunch(0,1,0,"HammerAutofire",56)
		UTIH C 0 A_JumpIfInventory("PunchedAlready",1,"Fire2")
		UTIH C 0 A_ReFire("Charge20")
		Goto Fire2

	// Charge 3
	Charge20:
		UTIH D 1 A_CustomPunch(0,1,0,"HammerAutofire",56)
		UTIH D 0 A_JumpIfInventory("PunchedAlready",1,"Fire3")
		UTIH D 0 A_ReFire("Charge21")
		Goto Fire3
	Charge21:
		UTIH D 1 A_CustomPunch(0,1,0,"HammerAutofire",56)
		UTIH D 0 A_JumpIfInventory("PunchedAlready",1,"Fire3")
		UTIH D 0 A_ReFire("Charge22")
		Goto Fire3
	Charge22:
		UTIH D 1 A_CustomPunch(0,1,0,"HammerAutofire",56)
		UTIH D 0 A_JumpIfInventory("PunchedAlready",1,"Fire3")
		UTIH D 0 A_ReFire("Charge23")
		Goto Fire3
	Charge23:
		UTIH D 1 A_CustomPunch(0,1,0,"HammerAutofire",56)
		UTIH D 0 A_JumpIfInventory("PunchedAlready",1,"Fire3")
		UTIH D 0 A_ReFire("Charge24")
		Goto Fire3
	Charge24:
		UTIH D 1 A_CustomPunch(0,1,0,"HammerAutofire",56)
		UTIH D 0 A_JumpIfInventory("PunchedAlready",1,"Fire3")
		UTIH D 0 A_ReFire("Charge25")
		Goto Fire3

	// Charge 4
	Charge25:
		UTIH E 1 A_CustomPunch(0,1,0,"HammerAutofire",56)
		UTIH E 0 A_JumpIfInventory("PunchedAlready",1,"Fire4")
		UTIH E 0 A_ReFire("Charge26")
		Goto Fire4
	Charge26:
		UTIH E 1 A_CustomPunch(0,1,0,"HammerAutofire",56)
		UTIH E 0 A_JumpIfInventory("PunchedAlready",1,"Fire4")
		UTIH E 0 A_ReFire("Charge27")
		Goto Fire4
	Charge27:
		UTIH E 1 A_CustomPunch(0,1,0,"HammerAutofire",56)
		UTIH E 0 A_JumpIfInventory("PunchedAlready",1,"Fire4")
		UTIH E 0 A_ReFire("Charge28")
		Goto Fire4
	Charge28:
		UTIH E 1 A_CustomPunch(0,1,0,"HammerAutofire",56)
		UTIH E 0 A_JumpIfInventory("PunchedAlready",1,"Fire4")
		UTIH E 0 A_ReFire("Charge29")
		Goto Fire4
	Charge29:
		UTIH E 1 A_CustomPunch(0,1,0,"HammerAutofire",56)
		UTIH E 0 A_JumpIfInventory("PunchedAlready",1,"Fire4")
		UTIH E 0 A_ReFire("Charge30")
		Goto Fire4

	// Charge 5
	Charge30:
		UTIH F 1 A_CustomPunch(0,1,0,"HammerAutofire",56)
		UTIH F 0 A_JumpIfInventory("PunchedAlready",1,"Fire5")
		UTIH F 0 A_ReFire("Charge31")
		Goto Fire5
	Charge31:
		UTIH F 1 A_CustomPunch(0,1,0,"HammerAutofire",56)
		UTIH F 0 A_JumpIfInventory("PunchedAlready",1,"Fire5")
		UTIH F 0 A_ReFire("Charge32")
		Goto Fire5
	Charge32:
		UTIH F 1 A_CustomPunch(0,1,0,"HammerAutofire",56)
		UTIH F 0 A_JumpIfInventory("PunchedAlready",1,"Fire5")
		UTIH F 0 A_ReFire("Charge33")
		Goto Fire5
	Charge33:
		UTIH F 1 A_CustomPunch(0,1,0,"HammerAutofire",56)
		UTIH F 0 A_JumpIfInventory("PunchedAlready",1,"Fire5")
		UTIH F 0 A_ReFire("Charge34")
		Goto Fire5
	Charge34:
		UTIH F 1 A_CustomPunch(0,1,0,"HammerAutofire",56)
		UTIH F 0 A_JumpIfInventory("PunchedAlready",1,"Fire5")
		UTIH F 0 A_ReFire("Charge35")
		Goto Fire5

	// Charge 6
	Charge35:
		UTIH G 1 Offset(1,32)
		UTIH G 0 A_CustomPunch(0,1,0,"HammerAutofire",56)
		UTIH G 0 A_JumpIfInventory("PunchedAlready",1,"Fire6")
		UTIH G 0 A_ReFire("Charge36")
		Goto Fire6
	Charge36:
		UTIH G 1 Offset(1,33)
		UTIH G 0 A_CustomPunch(0,1,0,"HammerAutofire",56)
		UTIH G 0 A_JumpIfInventory("PunchedAlready",1,"Fire6")
		UTIH G 0 A_ReFire("Charge37")
		Goto Fire6
	Charge37:
		UTIH G 1 Offset(2,33)
		UTIH G 0 A_CustomPunch(0,1,0,"HammerAutofire",56)
		UTIH G 0 A_JumpIfInventory("PunchedAlready",1,"Fire6")
		UTIH G 0 A_ReFire("Charge38")
		Goto Fire6
	Charge38:
		UTIH G 1 Offset(2,34)
		UTIH G 0 A_CustomPunch(0,1,0,"HammerAutofire",56)
		UTIH G 0 A_JumpIfInventory("PunchedAlready",1,"Fire6")
		UTIH G 0 A_ReFire("Charge39")
		Goto Fire6
	Charge39:
		UTIH G 1 Offset(3,33)
		UTIH G 0 A_CustomPunch(0,1,0,"HammerAutofire",56)
		UTIH G 0 A_JumpIfInventory("PunchedAlready",1,"Fire6")
		UTIH G 0 A_ReFire("Charge40")
		Goto Fire6

	// Charge 7
	Charge40:
		UTIH H 1 A_PlaySound("UTDE/Weapons/ImpactHammer/Charged",CHAN_WEAPON,1.0,1)
		UTIH H 0 A_CustomPunch(0,1,0,"HammerAutofire",56)
		UTIH H 0 A_JumpIfInventory("PunchedAlready",1,"Fire7")
		UTIH H 0 A_ReFire("Charge41")
		Goto Fire7
	Charge41:
		UTIH H 1 Offset(2,33)
		UTIH H 0 A_CustomPunch(0,1,0,"HammerAutofire",56)
		UTIH H 0 A_JumpIfInventory("PunchedAlready",1,"Fire7")
		UTIH H 0 A_ReFire("Charge42")
		Goto Fire7
	Charge42:
		UTIH H 1 Offset(1,34)
		UTIH H 0 A_CustomPunch(0,1,0,"HammerAutofire",56)
		UTIH H 0 A_JumpIfInventory("PunchedAlready",1,"Fire7")
		UTIH H 0 A_ReFire("Charge43")
		Goto Fire7
	Charge43:
		UTIH H 1 Offset(0,32)
		UTIH H 0 A_CustomPunch(0,1,0,"HammerAutofire",56)
		UTIH H 0 A_JumpIfInventory("PunchedAlready",1,"Fire7")
		UTIH H 0 A_ReFire("Charge44")
		Goto Fire7
	Charge44:
		UTIH H 1 Offset(2,32)
		UTIH H 0 A_CustomPunch(0,1,0,"HammerAutofire",56)
		UTIH H 0 A_JumpIfInventory("PunchedAlready",1,"Fire7")
		UTIH H 0 A_ReFire("Charge45")
		Goto Fire7
	Charge45:
		UTIH H 1 Offset(3,35)
		UTIH H 0 A_CustomPunch(0,1,0,"HammerAutofire",56)
		UTIH H 0 A_JumpIfInventory("PunchedAlready",1,"Fire7")
		UTIH H 0 A_ReFire("Charge41")
		Goto Fire7

	//-----------------------
	// Actually firing the weapon
	//-----------------------
	Fire1:
		TNT1 A 0 A_JumpIfInventory("Instagib",1,"FireIG")
		TNT1 A 0 A_RailAttack(30, 0, 0, None, None, RGF_SILENT|RGF_NOPIERCING, 0, "HammerPuff1", 0, 0, 56)
		Goto PostFire
		
	Fire2:
		TNT1 A 0 A_JumpIfInventory("Instagib",1,"FireIG")
		TNT1 A 0 A_RailAttack(48, 0, 0, None, None, RGF_SILENT|RGF_NOPIERCING, 0, "HammerPuff2", 0, 0, 56)
		Goto PostFire
		
	Fire3:
		TNT1 A 0 A_JumpIfInventory("Instagib",1,"FireIG")
		TNT1 A 0 A_RailAttack(65, 0, 0, None, None, RGF_SILENT|RGF_NOPIERCING, 0, "HammerPuff3", 0, 0, 56)
		Goto PostStrongFire
		
	Fire4:
		TNT1 A 0 A_JumpIfInventory("Instagib",1,"FireIG")
		TNT1 A 0 A_RailAttack(82, 0, 0, None, None, RGF_SILENT|RGF_NOPIERCING, 0, "HammerPuff4", 0, 0, 56)
		Goto PostStrongFire
		
	Fire5:
		TNT1 A 0 A_JumpIfInventory("Instagib",1,"FireIG")
		TNT1 A 0 A_RailAttack(100, 0, 0, None, None, RGF_SILENT|RGF_NOPIERCING, 0, "HammerPuff5", 0, 0, 56)
		Goto PostStrongFire
		
	Fire6:
		TNT1 A 0 A_JumpIfInventory("Instagib",1,"FireIG")
		TNT1 A 0 A_RailAttack(118, 0, 0, None, None, RGF_SILENT|RGF_NOPIERCING, 0, "HammerPuff6", 0, 0, 56)
		Goto PostStrongFire
		
	Fire7:
		TNT1 A 0 A_JumpIfInventory("Instagib",1,"FireIG")
		TNT1 A 0 A_RailAttack(135, 0, 0, None, None, RGF_SILENT|RGF_NOPIERCING, 0, "HammerPuff7", 0, 0, 56)
		Goto PostStrongFire

	FireIG:
		TNT1 A 0 A_RailAttack(999, 0, 0, None, None, RGF_SILENT|RGF_NOPIERCING, 0, "HammerPuff7", 0, 0, 56)
		Goto PostStrongFire

	PostFire:
		TNT1 A 0 A_SpawnItemEx("HammerReflector", 16 * cos(pitch), 0, 20 + 16 * sin(-pitch), 0, 0, 0, 0, SXF_NOCHECKPOSITION)
		TNT1 A 0 A_GunFlash("Flash", GFF_NOEXTCHANGE)
		TNT1 A 0 A_TakeInventory("PunchedAlready",32767)
		UTIH H 1 Offset(3,35)
		UTIH A 1 Offset(5,37)
		UTIH A 1 Offset(13,45)
		UTIH A 1 Offset(12,42)
		UTIH A 1 Offset(12,42)
		UTIH A 1 Offset(11,42)
		UTIH A 1 Offset(10,41)
		UTIH A 1 Offset(9,41)
		UTIH A 1 Offset(8,40)
		UTIH A 1 Offset(7,39)
		UTIH A 1 Offset(6,38)
		UTIH A 1 Offset(5,37)
		UTIH A 1 Offset(4,36)
		UTIH A 1 Offset(3,35)
		UTIH A 1 Offset(2,34)
		UTIH A 1 Offset(1,33)
		Goto "Ready"

	PostStrongFire:
		TNT1 A 0 A_SpawnItemEx("HammerReflector", 16 * cos(pitch), 0, 20 + 16 * sin(-pitch), 0, 0, 0, 0, SXF_NOCHECKPOSITION)
		TNT1 A 0 A_GunFlash("StrongFlash", GFF_NOEXTCHANGE)
		TNT1 A 0 A_TakeInventory("PunchedAlready",32767)
		UTIH H 1 Offset(4,37)
		UTIH A 1 Offset(7,41)
		UTIH A 1 Offset(16,47)
		UTIH A 1 Offset(14,46)
		UTIH A 1 Offset(13,44)
		UTIH A 1 Offset(11,42)
		UTIH A 1 Offset(10,41)
		UTIH A 1 Offset(9,41)
		UTIH A 1 Offset(8,40)
		UTIH A 1 Offset(7,39)
		UTIH A 1 Offset(6,38)
		UTIH A 1 Offset(5,37)
		UTIH A 1 Offset(4,36)
		UTIH A 1 Offset(3,35)
		UTIH A 1 Offset(2,34)
		UTIH A 1 Offset(1,33)
		Goto "Ready"

	Flash:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_JumpIfInventory("PowerQuad",1,"QuadSound")
		Goto NormalSound
			
		NormalSound:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/ImpactHammer/Fire",CHAN_WEAPON,1.0,0)
			Goto EndFlash
		QuadSound:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/ImpactHammer/Quad/Fire",CHAN_WEAPON,1.0,0)
			Goto EndFlash

	StrongFlash:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_JumpIfInventory("PowerQuad",1,"StrongQuadSound")
		Goto StrongNormalSound
			
		StrongNormalSound:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/ImpactHammer/AltFire",CHAN_WEAPON,1.0,0)
			Goto EndFlash
		StrongQuadSound:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/ImpactHammer/Quad/AltFire",CHAN_WEAPON,1.0,0)
			Goto EndFlash
			
	EndFlash:
		TNT1 A 0 A_JumpIfInventory("WepNoRecoilToken",1,"EndFlashNoRecoil")
		TNT1 A 2 A_SetPitch(pitch-1.2)
		TNT1 AAA 1 A_SetPitch(pitch+0.4)
		Stop
	EndFlashNoRecoil:
		TNT1 A 1
		Stop

	//----------------------------------------------------------------------------
	//----------------------------------------------------------------------------
	// And a whole new section just for the Painkiller weapon.
	// This is why replacing weapons is not easy kids.
	// The definition needs to exists within the QC gauntlet actor, for the
	// gauntlet keybind to still work.
	// And it's fully separate states instead of "#", for custom behaviour
	// and timings. It doesn't have to have 1:1 times to gauntlet
	//----------------------------------------------------------------------------
	//----------------------------------------------------------------------------
	PKReady:
		WP30 A 0 
		WP30 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"PKReadyCantFire")
		WP30 A 0 A_JumpIfInventory("PKTipDetached",1,"PKCallTipBack")
		WP30 A 3 A_WeaponReady
		Goto PKReady+1
		
		PKReadyCantFire:
			WP30 A 0 A_StopSound(5)
			WP30 A 0 A_StopSound(6)
		PKRCFLooper:
			WP30 A 4 A_WeaponReady(WRF_NOFIRE)
			WP30 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"PKRCFLooper")
			Goto Ready
	PKFire:
		TNT1 A 0 A_JumpIfInventory("PKTipDetached",1,"PKCallTipBack")
		WP30 A 0 A_PlaySound("QC/Abilities/Painkiller/Weapon/SpinStartLoop",CHAN_WEAPON,1,1)
		Goto PKFirePostSoundCheck
			
	PKFirePostSoundCheck:
		TNT1 A 0 A_AlertMonsters
		WP30 A 1
		WP30 B 1
		WP30 A 0 A_JumpIfInventory("DMToken",1,"PKDMFireLooper")
		Goto PKFireLooper1
		
		PKFireLooper1:
			WP30 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"PKReadyCantFire")
			WP30 F 1 A_CustomPunch((random(3,5)*10),1,0,"PKGauntletPuff",56)
			WP30 GH 1
			WP30 C 0 A_ReFire("PKFireLooper2")
			Goto PKEndFire
		PKFireLooper2:
			WP30 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"PKReadyCantFire")
			WP30 I 1 
			WP30 FG 1
			WP30 B 0 A_ReFire("PKFireLooper3")
			Goto PKEndFire
		PKFireLooper3:
			WP30 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"PKReadyCantFire")
			WP30 H 1 A_CustomPunch((random(3,5)*10),1,0,"PKGauntletPuff",56)
			WP30 IF 1
			WP30 B 0 A_ReFire("PKFireLooper4")
			Goto PKEndFire
		PKFireLooper4:
			WP30 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"PKReadyCantFire")
			WP30 G 1 
			WP30 HI 1
			WP30 B 0 A_ReFire("PKFireLooper1")
			Goto PKEndFire
		
		PKDMFireLooper:
			WP30 A 0 A_JumpIfInventory("Instagib",1,"PKIGRefire")
		PKNormalDMRefire:
			WP30 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"PKReadyCantFire")
			
			WP30 F 1 A_CustomPunch(90,1,0,"PKGauntletPuff_DM",56)			
			WP30 G 1
			TNT1 A 0 A_JumpIfInventory("PunchedAlready",1,"PKGauntStop")
			
			WP30 H 1 A_CustomPunch(90,1,0,"PKGauntletPuff_DM_NoFX",56)	
			WP30 I 1
			TNT1 A 0 A_JumpIfInventory("PunchedAlready",1,"PKGauntStop")
			
			WP30 B 0 A_ReFire("PKNormalDMRefire")
			Goto PKEndFire
			
		PKIGRefire:
			WP30 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"PKReadyCantFire")
			
			WP30 F 1 A_CustomPunch(999,1,0,"PKGauntletPuff_DM",56)			
			WP30 G 1
			TNT1 A 0 A_JumpIfInventory("PunchedAlready",1,"PKGauntStop")
			
			WP30 H 1 A_CustomPunch(999,1,0,"PKGauntletPuff_DM_NoFX",56)	
			WP30 I 1
			TNT1 A 0 A_JumpIfInventory("PunchedAlready",1,"PKGauntStop")
			
			WP30 B 0 A_ReFire("PKIGRefire")
			Goto PKEndFire
			
	PKGauntStop:
		WP30 A 0 A_StopSound(5)
		WP30 A 0 A_PlaySound("QC/Abilities/Painkiller/Weapon/SpinStop",CHAN_WEAPON,1,0)
		WP30 FGHIFGHI 1
		WP30 E 3 A_TakeInventory("PunchedAlready",32767)
		WP30 A 8 
		Goto PKReady
	PKEndFire:
		WP30 C 0 A_PlaySound("QC/Abilities/Painkiller/Weapon/SpinStop",CHAN_5,1,0)
		WP30 E 1 A_TakeInventory("PunchedAlready",32767)
		WP30 E 1 A_WeaponReady(WRF_NOBOB)
		WP30 E 1 A_WeaponReady(WRF_NOBOB)
		Goto PKReady
			
			
			
	//-----------------------
	// Alt Fire Seq
	//-----------------------
	PKAltFire:
		TNT1 A 0 A_JumpIfInventory("PKTipDetached",1,"PKCallTipBack")
		TNT1 A 0 A_PlaySound("QC/Abilities/Painkiller/Weapon/ShootTip",CHAN_WEAPON,1.0)
		TNT1 A 0 A_JumpIfInventory("DMToken",1,"PKFireBlade_DM")
		
		PKFireBlade:
			WP30 N 1 Bright 
			WP30 B 1 A_FireCustomMissile("PKProjectile", 0, false, 0, 5)
			Goto PKResumeFireBlade
		PKFireBlade_DM:
			WP30 N 1 Bright 
			WP30 B 1 A_FireCustomMissile("PKProjectileDM", 0, false, 0, 5)
			Goto PKResumeFireBlade
		
	PKResumeFireBlade:
		WP30 B 0 A_AlertMonsters
		WP30 B 0 A_GiveInventory("PKTipDetached",1)
		//detach animation
		WP30 C 0 A_JumpIfInventory("PKisBack",1,"PKPlayIsBackSound")
		WP30 C 2 
		WP30 C 0 A_JumpIfInventory("PKisBack",1,"PKPlayIsBackSound")
		WP30 C 2 
	PKWaiterLoopIfHoldingAltFire:	
		WP30 C 2 A_JumpIfInventory("PKisBack",1,"PKPlayIsBackSound")
		WP30 C 0 A_Refire("PKWaiterLoopIfHoldingAltFire") //if player holds altfire after shooting the tip, it loops to do nothing
		goto WaitingForTip
	
		//Reached after tip was shot, player releases alt fire, and weapons goes here
		WaitingForTip:	
			WP30 C 0 A_JumpIfInventory("PKisBack",1,"PKPlayIsBackSound")
			WP30 C 2 A_WeaponReady(WRF_NOBOB) //if player presses fire or alt fire, it will go to "PKCallTipBack"
			Loop
		
		PKCallTipBack:
			WP30 C 0 A_GiveInventory("IWantMyPKBack",1)
			WP30 C 2 A_JumpIfInventory("PKisBack",1,"PKPlayIsBackSound")
			Wait
		
		
	PKPlayIsBackSound:
		TNT1 A 0 A_TakeInventory("PKisBack",1)
		TNT1 A 0 A_TakeInventory("IWantMyPKBack",1)
		TNT1 A 0 A_TakeInventory("PKTipDetached",1)
		WP30 N 0 A_PlaySound("QC/Abilities/Painkiller/Weapon/TipReturn",CHAN_WEAPON,1.0)
		WP30 N 1 Bright Offset(10,42)
		WP30 N 1 Bright Offset(20,52)
		WP30 A 4 Offset(20,52)
		WP30 A 1 Offset(18,50)
		WP30 A 1 Offset(16,48)
		WP30 A 1 Offset(14,46)
		WP30 A 1 Offset(12,44)
		WP30 A 1 Offset(10,42)
		WP30 A 1 Offset(8,40)
		WP30 A 1 Offset(6,38)
		WP30 A 1 Offset(4,36)
		WP30 A 1 Offset(3,35)
		WP30 A 1 Offset(2,34)
		WP30 A 1 Offset(1,33)
		Goto PKReady
	//-----------------------
	// Select/Deselect Seq
	//-----------------------
	PKSelect:
		WP30  A 0 A_JumpIfInventory("NoWeaponFireToken",1,2)
		WP30  A 0 A_PlaySound("QC/Weapons/Switch",6,1,0,3)
		"####" "#" 0 A_StopSound(5) //stops any weapon looping sound
		"####" "#" 0 A_TakeInventory("PunchedAlready",32767)
		"####" "#" 0 A_JumpIfInventory("PKTipDetached",1,"RaiseDetached")
	PKSelectLooper:
		"####" "#" 1 A_Raise
		"####" "###" 0 A_Raise
		Loop
	RaiseDetached:
		"####" C 1 A_Raise
		"####" "###" 0 A_Raise
		Loop
		
	PKDetachedDeSelect:
		WP30 C 0 A_Jump(255,"DeselectLooper")
		Goto DeselectLooper
	}
}

