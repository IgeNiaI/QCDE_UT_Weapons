Actor CompatVer31_Gauntlet {} // for compatibility checks

Actor QCGauntlet : QCWeapon
{
	Weapon.SwaySpeed 3.2
	Weapon.Kickback 0
	Weapon.SelectionOrder 2000
	Inventory.PickupMessage "$GOT_UTImpactHammer"
	Obituary "$OB_UTImpactHammer"
	Tag "$TAG_UTImpactHammer"
	+INVENTORY.UNDROPPABLE
	+WEAPON.MELEEWEAPON
	Weapon.KickBack 64
	States
	{
	Spawn:
		TNT1 A 0
		Stop
	//-----------------------
	// Ready Seq
	//-----------------------
	Ready:
		TNT1 A 0 A_JumpIfInventory("Class_Painkiller",1,"PKReady")
		TNT1 A 0 A_JumpIfInventory("UTImpactHammerSkin", 9, "Ready.UT99")
		TNT1 A 0 A_JumpIfInventory("UTImpactHammerSkin", 4, "Ready.UT2004")
	Ready.UT2004:
		U4G1 A 0
		Goto ReadyCont
	Ready.UT99:
		U9G1 A 0
		Goto ReadyCont

	ReadyCont:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
	ReadyLoop:
		"####" A 3 A_WeaponReady
		Loop

		ReadyCantFire:
			"####" A 0 A_StopSound(CHAN_WEAPON)
			"####" A 0 A_StopSound(6)
		RCFLooper:
			"####" A 4 A_WeaponReady(WRF_NOFIRE)
			"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"RCFLooper")
			Goto Ready

	//-----------------------
	// Select/Deselect Seq
	//-----------------------
	Select:
		TNT1 A 0 A_JumpIfInventory("Class_Painkiller",1,"PKSelect")
		TNT1 A 0 A_JumpIfInventory("UTImpactHammerSkin", 9, "Select.UT99")
		TNT1 A 0 A_JumpIfInventory("UTImpactHammerSkin", 4, "Select.UT2004")
	Select.UT2004:
		U4G1 A 0
		Goto SelectCont
	Select.UT99:
		U9G1 A 0
		Goto SelectCont

	SelectCont:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,2)
		"####" A 0 A_PlaySound("QC/Weapons/Switch",CHAN_5,1,0,3) //Not in Weapon.UpSound because it interrupts CHAN_WEAPON sounds
		"####" A 0 A_StopSound(CHAN_WEAPON) //stops any weapon looping sound
	SelectLooper:
		"####" A 1 A_Raise
		"####" AAA 0 A_Raise
		Loop

	Deselect:
		"####" A 0 A_StopSound(CHAN_WEAPON)
		"####" A 0 A_JumpIfInventory("PKTipDetached",1,"PKDetachedDeSelect")
	DeselectLooper:
		"####" A 1 A_Lower
		"####" AAA 0 A_Lower
		Loop

	//-----------------------
	// Fire Seq
	//-----------------------
	Fire:
		TNT1 A 0 A_JumpIfInventory("Class_Painkiller",1,"PKFire")
		TNT1 A 0 A_JumpIfInventory("UTImpactHammerSkin", 9, "Fire.UT99")
		TNT1 A 0 A_JumpIfInventory("UTImpactHammerSkin", 4, "Fire.UT2004")
	Fire.UT2004:
		U4G1 A 0 A_PlaySound("UTDE/Weapons/ImpactHammer/Charge_UT2004",CHAN_WEAPON,1.0,0)
		Goto Charge10
	Fire.UT99:
		U9G1 A 0 A_PlaySound("UTDE/Weapons/ImpactHammer/Charge_UT99",CHAN_WEAPON,1.0,0)
		Goto Charge10

	//-----------------------
	// AltFire Seq
	//-----------------------
	AltFire:
		TNT1 A 0 A_JumpIfInventory("Class_Painkiller",1,"PKAltFire")
		TNT1 A 0 A_JumpIfInventory("UTImpactHammerSkin", 9, "AltFire.UT99")
		TNT1 A 0 A_JumpIfInventory("UTImpactHammerSkin", 4, "AltFire.UT2004")
	AltFire.UT2004:
		U4G1 A 0
		Goto AltFireCont
	AltFire.UT99:
		U9G1 A 0
		Goto AltFireCont

	AltFireCont:
		"####" A 0 A_JumpIfInventory("NoWeaponFireToken",1,"ReadyCantFire")
		Goto Fire1

	//-----------------------
	// Charge States
	//-----------------------
	// Charge 1
	Charge10:
		"####" B 1 A_CustomPunch(0,1,0,"HammerAutofire",56)
		"####" B 0 A_JumpIfInventory("PunchedAlready",1,"Fire1")
		"####" B 0 A_ReFire("Charge11")
		Goto Fire1
	Charge11:
		"####" B 1 A_CustomPunch(0,1,0,"HammerAutofire",56)
		"####" B 0 A_JumpIfInventory("PunchedAlready",1,"Fire1")
		"####" B 0 A_ReFire("Charge12")
		Goto Fire1
	Charge12:
		"####" C 1 A_CustomPunch(0,1,0,"HammerAutofire",56)
		"####" C 0 A_JumpIfInventory("PunchedAlready",1,"Fire1")
		"####" C 0 A_ReFire("Charge13")
		Goto Fire1
	Charge13:
		"####" C 1 A_CustomPunch(0,1,0,"HammerAutofire",56)
		"####" C 0 A_JumpIfInventory("PunchedAlready",1,"Fire1")
		"####" C 0 A_ReFire("Charge14")
		Goto Fire1
	Charge14:
		"####" D 1 A_CustomPunch(0,1,0,"HammerAutofire",56)
		"####" D 0 A_JumpIfInventory("PunchedAlready",1,"Fire1")
		"####" D 0 A_ReFire("Charge20")
		Goto Fire1

	// Charge 2
	Charge20:
		"####" D 1 A_CustomPunch(0,1,0,"HammerAutofire",56)
		"####" D 0 A_JumpIfInventory("PunchedAlready",1,"Fire2")
		"####" D 0 A_ReFire("Charge21")
		Goto Fire2
	Charge21:
		"####" E 1 A_CustomPunch(0,1,0,"HammerAutofire",56)
		"####" E 0 A_JumpIfInventory("PunchedAlready",1,"Fire2")
		"####" E 0 A_ReFire("Charge22")
		Goto Fire2
	Charge22:
		"####" E 1 A_CustomPunch(0,1,0,"HammerAutofire",56)
		"####" E 0 A_JumpIfInventory("PunchedAlready",1,"Fire2")
		"####" E 0 A_ReFire("Charge23")
		Goto Fire2
	Charge23:
		"####" F 1 A_CustomPunch(0,1,0,"HammerAutofire",56)
		"####" F 0 A_JumpIfInventory("PunchedAlready",1,"Fire2")
		"####" F 0 A_ReFire("Charge24")
		Goto Fire2
	Charge24:
		"####" F 1 A_CustomPunch(0,1,0,"HammerAutofire",56)
		"####" F 0 A_JumpIfInventory("PunchedAlready",1,"Fire2")
		"####" F 0 A_ReFire("Charge30")
		Goto Fire2

	// Charge 3
	Charge30:
		"####" G 1 A_CustomPunch(0,1,0,"HammerAutofire",56)
		"####" G 0 A_JumpIfInventory("PunchedAlready",1,"Fire3")
		"####" G 0 A_ReFire("Charge31")
		Goto Fire3
	Charge31:
		"####" G 1 A_CustomPunch(0,1,0,"HammerAutofire",56)
		"####" G 0 A_JumpIfInventory("PunchedAlready",1,"Fire3")
		"####" G 0 A_ReFire("Charge32")
		Goto Fire3
	Charge32:
		"####" H 1 A_CustomPunch(0,1,0,"HammerAutofire",56)
		"####" H 0 A_JumpIfInventory("PunchedAlready",1,"Fire3")
		"####" H 0 A_ReFire("Charge33")
		Goto Fire3
	Charge33:
		"####" H 1 A_CustomPunch(0,1,0,"HammerAutofire",56)
		"####" H 0 A_JumpIfInventory("PunchedAlready",1,"Fire3")
		"####" H 0 A_ReFire("Charge34")
		Goto Fire3
	Charge34:
		"####" I 1 A_CustomPunch(0,1,0,"HammerAutofire",56)
		"####" I 0 A_JumpIfInventory("PunchedAlready",1,"Fire3")
		"####" I 0 A_ReFire("Charge40")
		Goto Fire3

	// Charge 4
	Charge40:
		"####" I 1 A_CustomPunch(0,1,0,"HammerAutofire",56)
		"####" I 0 A_JumpIfInventory("PunchedAlready",1,"Fire4")
		"####" I 0 A_ReFire("Charge41")
		Goto Fire4
	Charge41:
		"####" J 1 A_CustomPunch(0,1,0,"HammerAutofire",56)
		"####" J 0 A_JumpIfInventory("PunchedAlready",1,"Fire4")
		"####" J 0 A_ReFire("Charge42")
		Goto Fire4
	Charge42:
		"####" J 1 A_CustomPunch(0,1,0,"HammerAutofire",56)
		"####" J 0 A_JumpIfInventory("PunchedAlready",1,"Fire4")
		"####" J 0 A_ReFire("Charge43")
		Goto Fire4
	Charge43:
		"####" K 1 A_CustomPunch(0,1,0,"HammerAutofire",56)
		"####" K 0 A_JumpIfInventory("PunchedAlready",1,"Fire4")
		"####" K 0 A_ReFire("Charge44")
		Goto Fire4
	Charge44:
		"####" K 1 A_CustomPunch(0,1,0,"HammerAutofire",56)
		"####" K 0 A_JumpIfInventory("PunchedAlready",1,"Fire4")
		"####" K 0 A_ReFire("Charge50")
		Goto Fire4

	// Charge 5
	Charge50:
		"####" L 1 A_CustomPunch(0,1,0,"HammerAutofire",56)
		"####" L 0 A_JumpIfInventory("PunchedAlready",1,"Fire5")
		"####" L 0 A_ReFire("Charge51")
		Goto Fire5
	Charge51:
		"####" L 1 A_CustomPunch(0,1,0,"HammerAutofire",56)
		"####" L 0 A_JumpIfInventory("PunchedAlready",1,"Fire5")
		"####" L 0 A_ReFire("Charge52")
		Goto Fire5
	Charge52:
		"####" M 1 A_CustomPunch(0,1,0,"HammerAutofire",56)
		"####" M 0 A_JumpIfInventory("PunchedAlready",1,"Fire5")
		"####" M 0 A_ReFire("Charge53")
		Goto Fire5
	Charge53:
		"####" M 1 A_CustomPunch(0,1,0,"HammerAutofire",56)
		"####" M 0 A_JumpIfInventory("PunchedAlready",1,"Fire5")
		"####" M 0 A_ReFire("Charge54")
		Goto Fire5
	Charge54:
		"####" N 1 A_CustomPunch(0,1,0,"HammerAutofire",56)
		"####" N 0 A_JumpIfInventory("PunchedAlready",1,"Fire5")
		"####" N 0 A_ReFire("Charge60")
		Goto Fire5

	// Charge 6
	Charge60:
		"####" N 1 Offset(1,32)
		"####" N 0 A_CustomPunch(0,1,0,"HammerAutofire",56)
		"####" N 0 A_JumpIfInventory("PunchedAlready",1,"Fire6")
		"####" N 0 A_ReFire("Charge61")
		Goto Fire6
	Charge61:
		"####" O 1 Offset(1,33)
		"####" O 0 A_CustomPunch(0,1,0,"HammerAutofire",56)
		"####" O 0 A_JumpIfInventory("PunchedAlready",1,"Fire6")
		"####" O 0 A_ReFire("Charge62")
		Goto Fire6
	Charge62:
		"####" O 1 Offset(2,33)
		"####" O 0 A_CustomPunch(0,1,0,"HammerAutofire",56)
		"####" O 0 A_JumpIfInventory("PunchedAlready",1,"Fire6")
		"####" O 0 A_ReFire("Charge63")
		Goto Fire6
	Charge63:
		"####" P 1 Offset(2,34)
		"####" P 0 A_CustomPunch(0,1,0,"HammerAutofire",56)
		"####" P 0 A_JumpIfInventory("PunchedAlready",1,"Fire6")
		"####" P 0 A_ReFire("Charge64")
		Goto Fire6
	Charge64:
		"####" P 1 Offset(3,33)
		"####" P 0 A_CustomPunch(0,1,0,"HammerAutofire",56)
		"####" P 0 A_JumpIfInventory("PunchedAlready",1,"Fire6")
		"####" P 0 A_ReFire("Charge70")
		Goto Fire6

	// Charge 7
	Charge70:
		"####" A 0 A_JumpIfInventory("UTImpactHammerSkin", 9, "Charge70.UT99")
		"####" A 0 A_JumpIfInventory("UTImpactHammerSkin", 4, "Charge70.UT2004")
	Charge70.UT2004:
		"####" Q 0 A_PlaySound("UTDE/Weapons/ImpactHammer/Charged_UT2004",CHAN_WEAPON,1.0,1)
		Goto Charge70.Loop
	Charge70.UT99:
		"####" Q 0 A_PlaySound("UTDE/Weapons/ImpactHammer/Charged_UT99",CHAN_WEAPON,1.0,1)
		Goto Charge70.Loop

	Charge70.Loop:
		"####" Q 1 Offset(3,34)
		"####" Q 0 A_CustomPunch(0,1,0,"HammerAutofire",56)
		"####" Q 0 A_JumpIfInventory("PunchedAlready",1,"Fire7")
		"####" Q 0 A_ReFire("Charge71")
		Goto Fire7
	Charge71:
		"####" Q 1 Offset(2,33)
		"####" Q 0 A_CustomPunch(0,1,0,"HammerAutofire",56)
		"####" Q 0 A_JumpIfInventory("PunchedAlready",1,"Fire7")
		"####" Q 0 A_ReFire("Charge72")
		Goto Fire7
	Charge72:
		"####" R 1 Offset(1,34)
		"####" R 0 A_CustomPunch(0,1,0,"HammerAutofire",56)
		"####" R 0 A_JumpIfInventory("PunchedAlready",1,"Fire7")
		"####" R 0 A_ReFire("Charge73")
		Goto Fire7
	Charge73:
		"####" R 1 Offset(0,32)
		"####" R 0 A_CustomPunch(0,1,0,"HammerAutofire",56)
		"####" R 0 A_JumpIfInventory("PunchedAlready",1,"Fire7")
		"####" R 0 A_ReFire("Charge74")
		Goto Fire7
	Charge74:
		"####" S 1 Offset(2,32)
		"####" S 0 A_CustomPunch(0,1,0,"HammerAutofire",56)
		"####" S 0 A_JumpIfInventory("PunchedAlready",1,"Fire7")
		"####" S 0 A_ReFire("Charge75")
		Goto Fire7
	Charge75:
		"####" S 1 Offset(3,35)
		"####" S 0 A_CustomPunch(0,1,0,"HammerAutofire",56)
		"####" S 0 A_JumpIfInventory("PunchedAlready",1,"Fire7")
		"####" S 0 A_ReFire("Charge70.Loop")
		Goto Fire7

	//-----------------------
	// Actually firing the weapon
	//-----------------------
	Fire1:
		"####" A 0 A_JumpIfInventory("Instagib",1,"FireIG")
		"####" A 0 A_RailAttack(0, 0, 0, None, None, RGF_SILENT|RGF_NOPIERCING, 0, "HammerPuff1", 0, 0, 96)
		"####" A 0 A_RailAttack(30, 0, 0, None, None, RGF_SILENT|RGF_NOPIERCING, 0, "none", 0, 0, 56)
		Goto PostFire

	Fire2:
		"####" A 0 A_JumpIfInventory("Instagib",1,"FireIG")
		"####" A 0 A_RailAttack(0, 0, 0, None, None, RGF_SILENT|RGF_NOPIERCING, 0, "HammerPuff2", 0, 0, 96)
		"####" A 0 A_RailAttack(48, 0, 0, None, None, RGF_SILENT|RGF_NOPIERCING, 0, "none", 0, 0, 56)
		Goto PostFire

	Fire3:
		"####" A 0 A_JumpIfInventory("Instagib",1,"FireIG")
		"####" A 0 A_RailAttack(0, 0, 0, None, None, RGF_SILENT|RGF_NOPIERCING, 0, "HammerPuff3", 0, 0, 96)
		"####" A 0 A_RailAttack(65, 0, 0, None, None, RGF_SILENT|RGF_NOPIERCING, 0, "none", 0, 0, 56)
		Goto PostStrongFire

	Fire4:
		"####" A 0 A_JumpIfInventory("Instagib",1,"FireIG")
		"####" A 0 A_RailAttack(0, 0, 0, None, None, RGF_SILENT|RGF_NOPIERCING, 0, "HammerPuff4", 0, 0, 96)
		"####" A 0 A_RailAttack(82, 0, 0, None, None, RGF_SILENT|RGF_NOPIERCING, 0, "none", 0, 0, 56)
		Goto PostStrongFire

	Fire5:
		"####" A 0 A_JumpIfInventory("Instagib",1,"FireIG")
		"####" A 0 A_RailAttack(0, 0, 0, None, None, RGF_SILENT|RGF_NOPIERCING, 0, "HammerPuff5", 0, 0, 96)
		"####" A 0 A_RailAttack(100, 0, 0, None, None, RGF_SILENT|RGF_NOPIERCING, 0, "none", 0, 0, 56)
		Goto PostStrongFire

	Fire6:
		"####" A 0 A_JumpIfInventory("Instagib",1,"FireIG")
		"####" A 0 A_RailAttack(0, 0, 0, None, None, RGF_SILENT|RGF_NOPIERCING, 0, "HammerPuff6", 0, 0, 96)
		"####" A 0 A_RailAttack(118, 0, 0, None, None, RGF_SILENT|RGF_NOPIERCING, 0, "none", 0, 0, 56)
		Goto PostStrongFire

	Fire7:
		"####" A 0 A_JumpIfInventory("Instagib",1,"FireIG")
		"####" A 0 A_RailAttack(0, 0, 0, None, None, RGF_SILENT|RGF_NOPIERCING, 0, "HammerPuff7", 0, 0, 96)
		"####" A 0 A_RailAttack(135, 0, 0, None, None, RGF_SILENT|RGF_NOPIERCING, 0, "none", 0, 0, 56)
		Goto PostStrongFire

	FireIG:
		"####" A 0 A_RailAttack(0, 0, 0, None, None, RGF_SILENT|RGF_NOPIERCING, 0, "HammerPuff7", 0, 0, 96)
		"####" A 0 A_RailAttack(999, 0, 0, None, None, RGF_SILENT|RGF_NOPIERCING, 0, "none", 0, 0, 56)
		Goto PostStrongFire

	PostFire:
		"####" A 0 A_JumpIfInventory("GNT_UG_Omni",1,"FireReflector")
		"####" A 0 A_SpawnItemEx("HammerReflector", 16 * cos(pitch), 0, 20 + 16 * sin(-pitch), 0, 0, 0, 0, SXF_NOCHECKPOSITION)
		goto Cooldown

	FireReflector:
		"####" A 0 A_FireCustomMissile("HammerReflectorUpgraded", 0, false, 1, 5, FPF_NOUNLAGGED)
		goto Cooldown

	Cooldown:
		"####" A 0 A_GunFlash("Flash", GFF_NOEXTCHANGE)
		"####" A 0 A_TakeInventory("PunchedAlready",32767)
		"####" T 1 Offset(3,35)
		"####" U 1 Offset(5,37)
		"####" V 1 Offset(13,45)
		"####" W 1 Offset(12,42)
		"####" X 1 Offset(11,42)
		"####" A 1 Offset(10,42)
		"####" A 1 Offset(9,41)
		"####" A 1 Offset(8,40)
		"####" A 1 Offset(7,39)
		"####" A 1 Offset(6,38)
		"####" A 1 Offset(5,37)
		"####" A 1 Offset(4,36)
		"####" A 1 Offset(3,35)
		"####" A 1 Offset(2,34)
		"####" A 1 Offset(1,33)
		"####" A 1 Offset(0,32)
		Goto "Ready"

	PostStrongFire:
		"####" A 0 A_JumpIfInventory("GNT_UG_Omni",1,"FireReflectorStrong")
		"####" A 0 A_SpawnItemEx("HammerReflector", 16 * cos(pitch), 0, 20 + 16 * sin(-pitch), 0, 0, 0, 0, SXF_NOCHECKPOSITION)
		goto CooldownStrong

	FireReflectorStrong:
		"####" A 0 A_FireCustomMissile("HammerReflectorUpgraded", 0, false, 1, 5, FPF_NOUNLAGGED)
		goto CooldownStrong

	CooldownStrong:
		"####" A 0 A_GunFlash("StrongFlash", GFF_NOEXTCHANGE)
		"####" A 0 A_TakeInventory("PunchedAlready",32767)
		"####" T 1 Offset(3,37)
		"####" U 1 Offset(6,41)
		"####" V 1 Offset(15,47)
		"####" W 1 Offset(13,46)
		"####" X 1 Offset(12,44)
		"####" A 1 Offset(10,42)
		"####" A 1 Offset(9,41)
		"####" A 1 Offset(8,40)
		"####" A 1 Offset(7,39)
		"####" A 1 Offset(6,38)
		"####" A 1 Offset(5,37)
		"####" A 1 Offset(4,36)
		"####" A 1 Offset(3,35)
		"####" A 1 Offset(2,34)
		"####" A 1 Offset(1,33)
		"####" A 1 Offset(0,32)
		Goto "Ready"

	Flash:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_JumpIfInventory("PowerQuad",1,"QuadSound")
		TNT1 A 0 A_JumpIfInventory("PowerTerminatorArtifact",1,"QuadSound")
		Goto NormalSound

		NormalSound:
			TNT1 A 0 A_JumpIfInventory("UTImpactHammerSkin", 9, "NormalSound.UT99")
			TNT1 A 0 A_JumpIfInventory("UTImpactHammerSkin", 4, "NormalSound.UT2004")
		NormalSound.UT2004:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/ImpactHammer/Fire_UT2004",CHAN_WEAPON,1.0,0)
			Goto EndFlash
		NormalSound.UT99:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/ImpactHammer/Fire_UT99",CHAN_WEAPON,1.0,0)
			Goto EndFlash

		QuadSound:
			TNT1 A 0 A_JumpIfInventory("UTImpactHammerSkin", 9, "QuadSound.UT99")
			TNT1 A 0 A_JumpIfInventory("UTImpactHammerSkin", 4, "QuadSound.UT2004")
		QuadSound.UT2004:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/ImpactHammer/Quad/Fire_UT2004",CHAN_WEAPON,1.0,0)
			Goto EndFlash
		QuadSound.UT99:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/ImpactHammer/Quad/Fire_UT99",CHAN_WEAPON,1.0,0)
			Goto EndFlash

	StrongFlash:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_JumpIfInventory("PowerQuad",1,"StrongQuadSound")
		TNT1 A 0 A_JumpIfInventory("PowerTerminatorArtifact",1,"StrongQuadSound")
		Goto StrongNormalSound

		StrongNormalSound:
			TNT1 A 0 A_JumpIfInventory("UTImpactHammerSkin", 9, "StrongNormalSound.UT99")
			TNT1 A 0 A_JumpIfInventory("UTImpactHammerSkin", 4, "StrongNormalSound.UT2004")
		StrongNormalSound.UT2004:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/ImpactHammer/AltFire_UT2004",CHAN_WEAPON,1.0,0)
			Goto EndFlash
		StrongNormalSound.UT99:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/ImpactHammer/AltFire_UT99",CHAN_WEAPON,1.0,0)
			Goto EndFlash

		StrongQuadSound:
			TNT1 A 0 A_JumpIfInventory("UTImpactHammerSkin", 9, "StrongQuadSound.UT99")
			TNT1 A 0 A_JumpIfInventory("UTImpactHammerSkin", 4, "StrongQuadSound.UT2004")
		StrongQuadSound.UT2004:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/ImpactHammer/Quad/AltFire_UT2004",CHAN_WEAPON,1.0,0)
			Goto EndFlash
		StrongQuadSound.UT99:
			TNT1 A 0 A_PlaySound("UTDE/Weapons/ImpactHammer/Quad/AltFire_UT99",CHAN_WEAPON,1.0,0)
			Goto EndFlash

	EndFlash:
		TNT1 A 0 A_JumpIfInventory("WepNoRecoilToken",1,"EndFlashNoRecoil")
		TNT1 A 2 A_SetPitch(pitch-1.2)
		TNT1 AAA 1 A_SetPitch(pitch+0.4)
		Stop
	EndFlashNoRecoil:
		TNT1 A 1
		Stop

	//----------------------------------------------------------------------------
	//----------------------------------------------------------------------------
	// And a whole new section just for the Painkiller weapon.
	// This is why replacing weapons is not easy kids.
	// The definition needs to exists within the QC gauntlet actor, for the
	// gauntlet keybind to still work.
	// And it's fully separate states instead of "#", for custom behaviour
	// and timings. It doesn't have to have 1:1 times to gauntlet
	//----------------------------------------------------------------------------
	//----------------------------------------------------------------------------
	PKReady:
		WP30 A 0
		WP30 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"PKReadyCantFire")
		WP30 A 0 A_JumpIfInventory("PKTipDetached",1,"PKPlayIsBackSound")
		WP30 A 3 A_WeaponReady
		Goto PKReady+1

		PKReadyCantFire:
			WP30 A 0 A_StopSound(CHAN_WEAPON)
		PKRCFLooper:
			WP30 A 4 A_WeaponReady(WRF_NOFIRE)
			WP30 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"PKRCFLooper")
			Goto PKReady
	PKFire:
		WP30 A 0 A_JumpIfInventory("PKTipDetached",1,"PKPlayIsBackSound")
		WP30 A 0 A_PlaySound("QC/Abilities/Painkiller/Weapon/SpinStartLoop",CHAN_WEAPON,1,1)
		Goto PKFirePostSoundCheck

	PKFirePostSoundCheck:
		WP30 A 0 A_AlertMonsters
		WP30 A 1
		WP30 B 1
		WP30 A 0 A_JumpIfInventory("DMToken",1,"PKDMFireLooper")
		WP30 A 0 A_JumpIfInventory("GNT_UG_Burn",1,"PKBurner")
		WP30 A 0 A_JumpIfInventory("GNT_UG_Omni",1,"PKOmnier")
		Goto PKFireLooper1

		PKFireLooper1:
			WP30 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"PKReadyCantFire")
			WP30 F 1 A_CustomPunch((random(3,5)*10),1,0,"PKGauntletPuff",56)
			WP30 GH 1
			WP30 C 0 A_ReFire("PKFireLooper2")
			Goto PKEndFire
		PKFireLooper2:
			WP30 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"PKReadyCantFire")
			WP30 I 1
			WP30 FG 1
			WP30 B 0 A_ReFire("PKFireLooper3")
			Goto PKEndFire
		PKFireLooper3:
			WP30 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"PKReadyCantFire")
			WP30 H 1 A_CustomPunch((random(3,5)*10),1,0,"PKGauntletPuff",56)
			WP30 IF 1
			WP30 B 0 A_ReFire("PKFireLooper4")
			Goto PKEndFire
		PKFireLooper4:
			WP30 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"PKReadyCantFire")
			WP30 G 1
			WP30 HI 1
			WP30 B 0 A_ReFire("PKFireLooper1")
			Goto PKEndFire

		PKOmnier:
			WP30 A 0 A_JumpIfInventory("GNT_UG_Burn",1,"PKBurnOmniLooper1")
			Goto PKOmniLooper1

			PKOmniLooper1:
				WP30 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"PKReadyCantFire")
				WP30 C 0 A_CustomPunch(1,1,0,"PKGauntletPuff",56)
				WP30 F 0 A_FireCustomMissile("OmnislashProjectileFX_Painkiller",0,0)
				WP30 F 1 A_FireCustomMissile("OmnislashProjectile",0,0,0,0, FPF_FORCESERVERSIDE)
				WP30 GH 1
				WP30 C 0 A_ReFire("PKOmniLooper2")
				Goto PKEndFire
			PKOmniLooper2:
				WP30 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"PKReadyCantFire")
				WP30 I 1 A_FireCustomMissile("OmnislashProjectileFX_Painkiller",0,0)
				WP30 FG 1
				WP30 B 0 A_ReFire("PKOmniLooper3")
				Goto PKEndFire
			PKOmniLooper3:
				WP30 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"PKReadyCantFire")
				WP30 C 0 A_CustomPunch(1,1,0,"PKGauntletPuff",56)
				WP30 H 0 A_FireCustomMissile("OmnislashProjectileFX_Painkiller",0,0)
				WP30 H 1 A_FireCustomMissile("OmnislashProjectile",0,0,0,0, FPF_FORCESERVERSIDE)
				WP30 IF 1
				WP30 C 0 A_ReFire("PKOmniLooper4")
				Goto PKEndFire
			PKOmniLooper4:
				WP30 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"PKReadyCantFire")
				WP30 G 1 A_FireCustomMissile("OmnislashProjectileFX_Painkiller",0,0)
				WP30 HI 1
				WP30 B 0 A_ReFire("PKOmniLooper1")
				Goto PKEndFire

		PKBurner:
			WP30 A 0 A_JumpIfInventory("GNT_UG_Omni",1,"PKBurnOmniLooper1")
			Goto PKBurnLooper1

			PKBurnLooper1:
				WP30 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"PKReadyCantFire")
				WP30 C 0 A_CustomPunch((random(3,5)*10),1,0,"PKGauntletPuffBurn",56)
				WP30 A 0 A_Jump(128,2)
				WP30 C 0 A_FireCustomMissile("BurnerFlamelet",0,0,random(6,-6),random(4,-4))
				WP30 V 1
				WP30 WX 1
				WP30 C 0 A_ReFire("PKBurnLooper2")
				Goto PKEndFire
			PKBurnLooper2:
				WP30 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"PKReadyCantFire")
				WP30 A 0 A_Jump(128,2)
				WP30 D 0 A_FireCustomMissile("BurnerFlamelet",0,0,random(6,-6),random(4,-4))
				WP30 Y 1
				WP30 VW 1
				WP30 B 0 A_ReFire("PKBurnLooper3")
				Goto PKEndFire
			PKBurnLooper3:
				WP30 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"PKReadyCantFire")
				WP30 C 0 A_CustomPunch((random(3,5)*10),1,0,"PKGauntletPuffBurn",56)
				WP30 A 0 A_Jump(128,2)
				WP30 C 0 A_FireCustomMissile("BurnerFlamelet",0,0,random(6,-6),random(4,-4))
				WP30 X 1
				WP30 YV 1
				WP30 C 0 A_ReFire("PKBurnLooper4")
				Goto PKEndFire
			PKBurnLooper4:
				WP30 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"PKReadyCantFire")
				WP30 A 0 A_Jump(128,2)
				WP30 D 0 A_FireCustomMissile("BurnerFlamelet",0,0,random(6,-6),random(4,-4))
				WP30 W 1
				WP30 XY 1
				WP30 B 0 A_ReFire("PKBurnLooper1")
				Goto PKEndFire


			PKBurnOmniLooper1:
				WP30 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"PKReadyCantFire")
				WP30 C 0 A_CustomPunch(1,1,0,"PKGauntletPuff",56)
				WP30 C 0 A_FireCustomMissile("OmnislashFireProjectileFX_Painkiller",0,0)
				WP30 C 0 A_FireCustomMissile("OmnislashFireProjectile",0,0,0,0, FPF_FORCESERVERSIDE)
				WP30 V 1
				WP30 WX 1
				WP30 C 0 A_ReFire("PKBurnOmniLooper2")
				Goto PKEndFire
			PKBurnOmniLooper2:
				WP30 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"PKReadyCantFire")
				WP30 D 0 A_FireCustomMissile("OmnislashFireProjectileFX_Painkiller",0,0)
				WP30 Y 1
				WP30 VW 1
				WP30 B 0 A_ReFire("PKBurnOmniLooper3")
				Goto PKEndFire
			PKBurnOmniLooper3:
				WP30 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"PKReadyCantFire")
				WP30 C 0 A_CustomPunch(1,1,0,"PKGauntletPuff",56)
				WP30 C 0 A_FireCustomMissile("OmnislashFireProjectileFX_Painkiller",0,0)
				WP30 C 0 A_FireCustomMissile("OmnislashFireProjectile",0,0,0,0, FPF_FORCESERVERSIDE)
				WP30 X 1
				WP30 YV 1
				WP30 C 0 A_ReFire("PKBurnOmniLooper4")
				Goto PKEndFire
			PKBurnOmniLooper4:
				WP30 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"PKReadyCantFire")
				WP30 D 0 A_FireCustomMissile("OmnislashFireProjectileFX_Painkiller",0,0)
				WP30 W 1
				WP30 XY 1
				WP30 B 0 A_ReFire("PKBurnOmniLooper1")
				Goto PKEndFire


		PKDMFireLooper:
			WP30 A 0 A_JumpIfInventory("Instagib",1,"PKIGRefire")
		PKNormalDMRefire:
			WP30 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"PKReadyCantFire")

			WP30 F 1 A_CustomPunch(90,1,0,"PKGauntletPuff_DM",56)
			WP30 G 1
			WP30 A 0 A_JumpIfInventory("PunchedAlready",1,"PKGauntStop")

			WP30 H 1 A_CustomPunch(90,1,0,"PKGauntletPuff_DM_NoFX",56)
			WP30 I 1
			WP30 A 0 A_JumpIfInventory("PunchedAlready",1,"PKGauntStop")

			WP30 B 0 A_ReFire("PKNormalDMRefire")
			Goto PKEndFire

		PKIGRefire:
			WP30 A 0 A_JumpIfInventory("NoWeaponFireToken",1,"PKReadyCantFire")

			WP30 F 1 A_CustomPunch(999,1,0,"PKGauntletPuff_DM",56)
			WP30 G 1
			WP30 A 0 A_JumpIfInventory("PunchedAlready",1,"PKGauntStop")

			WP30 H 1 A_CustomPunch(999,1,0,"PKGauntletPuff_DM_NoFX",56)
			WP30 I 1
			WP30 A 0 A_JumpIfInventory("PunchedAlready",1,"PKGauntStop")

			WP30 B 0 A_ReFire("PKIGRefire")
			Goto PKEndFire

	PKGauntStop:
		WP30 A 0 A_StopSound(CHAN_WEAPON)
		WP30 A 0 A_PlaySound("QC/Abilities/Painkiller/Weapon/SpinStop",CHAN_WEAPON,1,0)
		WP30 FGHIFGHI 1
		WP30 E 3 A_TakeInventory("PunchedAlready",32767)
		WP30 A 8
		Goto PKReady
	PKEndFire:
		WP30 C 0 A_PlaySound("QC/Abilities/Painkiller/Weapon/SpinStop",CHAN_WEAPON,1,0)
		WP30 E 1 A_TakeInventory("PunchedAlready",32767)
		WP30 E 1 A_WeaponReady
		WP30 E 1 A_WeaponReady
		Goto PKReady



	//-----------------------
	// Fire Seq / Zoom
	//-----------------------
	PKAltFire:
		WP30 A 0 A_JumpIfInventory("PKTipDetached",1,"PKPlayIsBackSound")
		WP30 A 0 A_PlaySound("QC/Abilities/Painkiller/Weapon/ShootTip",CHAN_WEAPON,1.0)
		WP30 A 0 A_JumpIfInventory("DMToken",1,"PKFireBlade_DM")

		PKFireBlade:
			WP30 N 1 Bright A_GiveInventory("PKTipDetached",1,0, GIF_SKIPOWNER)
			WP30 B 1 A_FireCustomMissile("PKProjectile", 0, false, 0, 5)
			Goto PKResumeFireBlade
		PKFireBlade_DM:
			WP30 N 1 Bright A_GiveInventory("PKTipDetached",1,0, GIF_SKIPOWNER)
			WP30 B 1 A_FireCustomMissile("PKProjectileDM", 0, false, 0, 5)
			Goto PKResumeFireBlade

	PKResumeFireBlade:
		WP30 B 0 A_AlertMonsters
		//detach animation
		WP30 C 0 A_JumpIfInventory("PKTipDetached",-1,"PKPlayIsBackSound")
		WP30 C 2
		WP30 C 0 A_JumpIfInventory("PKTipDetached",-1,"PKPlayIsBackSound")
		WP30 C 2
	PKWaiterLoopIfHoldingAltFire:
		WP30 C 2 A_JumpIfInventory("PKTipDetached",-1,"PKPlayIsBackSound")
		WP30 C 0 A_Refire("PKWaiterLoopIfHoldingAltFire") //if player holds altfire after shooting the tip, it loops to do nothing
		goto WaitingForTip

		//Reached after tip was shot, player releases alt fire, and weapons goes here
		WaitingForTip:
			WP30 C 0 A_JumpIfInventory("PKTipDetached",-1,"PKPlayIsBackSound")
			WP30 C 2 A_WeaponReady(WRF_NOBOB)
			Loop


	PKPlayIsBackSound:
		WP30 A 0 A_TakeInventory("PKTipDetached",32767,TIF_SKIPOWNER)
		WP30 N 0 A_PlaySound("QC/Abilities/Painkiller/Weapon/TipReturn",CHAN_WEAPON,1.0)
		WP30 N 1 Bright Offset(9,41)
		WP30 N 1 Bright Offset(19,51)
		WP30 A 4 Offset(19,51)
		WP30 A 1 Offset(17,49)
		WP30 A 1 Offset(15,47)
		WP30 A 1 Offset(13,45)
		WP30 A 1 Offset(11,43)
		WP30 A 1 Offset(9,41)
		WP30 A 1 Offset(7,39)
		WP30 A 1 Offset(5,37)
		WP30 A 1 Offset(3,35)
		WP30 A 1 Offset(2,34)
		WP30 A 1 Offset(1,33)
		WP30 A 1 Offset(0,32)
		Goto PKReady
	//-----------------------
	// Select/Deselect Seq
	//-----------------------
	PKSelect:
		WP30  A 0 A_JumpIfInventory("NoWeaponFireToken",1,2)
		WP30  A 0 A_PlaySound("QC/Weapons/Switch",CHAN_5,1,0,3)
		"####" "#" 0 A_StopSound(CHAN_WEAPON) //stops any weapon looping sound
		"####" "#" 0 A_TakeInventory("PunchedAlready",32767)
		"####" "#" 0 A_JumpIfInventory("PKTipDetached",1,"RaiseDetached")
	PKSelectLooper:
		"####" "#" 1 A_Raise
		"####" "###" 0 A_Raise
		Loop
	RaiseDetached:
		"####" C 1 A_Raise
		"####" "###" 0 A_Raise
		Loop

	PKDetachedDeSelect:
		WP30 C 0
		Goto DeselectLooper
	}
}

Actor HammerReflector
{
	+NOINTERACTION
	+NOGRAVITY
	radius 1
	height 1
	States
	{
