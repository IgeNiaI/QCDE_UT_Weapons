// --------------------------------------------------------------------------
//
// Eleena's abilities
//
// Active:  Doppelganger
//          Spawns a hologram.
//          Activate again to swap places with it while it's alive.
//
// Passive: Training Weights
//          Runs faster without armor.
//
// --------------------------------------------------------------------------

Actor CompatVer30_Eleena {} // for compatibility checks

//--------------------------------------------------------
// Active
//--------------------------------------------------------

Actor Doppelganger
{
	+BRIGHT
	+FRIENDLY
	+SHOOTABLE
	+BLOODLESSIMPACT +NOBLOOD
	+SERVERNETID
	Health 10000
	Radius 12
	Height 52
	DamageType "NoDamageToPlayers"
	Alpha 0.95
	Scale 0.59
	Obituary "$OB_Doppelganger" // "%o was barking at the wrong tree all along."
	HitObituary "$OBH_Doppelganger" // "%o was delivered the sweet release of death by snusnu." // Thanks Abysswalker!
	States
	{
	Spawn:
		QP24 A 0 NodeLay ACS_NamedExecuteWithResult("QCDE_DoppelgangerSpawned")
		QP24 A 0 A_JumpIf(ACS_NamedExecuteWithResult("MultiplayerCheck") >= 2,"DM")
		Goto Idle
	DM:
		QP24 A 0 A_ChangeFlag("FRIENDLY", false)
		QP24 A 0 A_ChangeFlag("SHOOTABLE", false)
		QP24 A 0 A_ChangeFlag("CANBLAST", true) //in DM freeman can blast it away
		Goto Idle
	Idle:
		QP24 A 0 A_Explode(1,512,XF_NOTMISSILE,0,512)
		QP24 A 0 A_JumpIfInventory("TeamColor",2, "RedSpawn")
		QP24 A 0 A_JumpIfInventory("TeamColor",1,"BlueSpawn")
		QP24 A 0 A_JumpIf(true,                   "DefSpawn")
		QP24 G 100
		Loop

		RedSpawn:
			RP24 A 0 A_Jump(240,"RedSee")
			RP24 G 4
			Loop
		BlueSpawn:
			BP24 A 0 A_Jump(240,"BlueSee")
			BP24 G 4
			Loop
		DefSpawn:
			QP24 A 0 A_Jump(240,"DefSee")
			QP24 G 4
			Loop

		RedSee:
			RP24 ABCDEF 3 ThrustThing(angle + random(-64,64), random(-1,3), 0, 0)
			"####" "#" 0 A_Turn(random(-45,45))
			"####" "#" 0 A_Jump(192, "RedSee", "RedMissile")
			"####" "#" 0 A_PlaySound("EleenaJump", CHAN_VOICE)
			"####" "#" 0 ThrustThingZ(0,40,0,1)
			"####" "#" 0 A_Jump(192, "RedMissile")
			Loop
		BlueSee:
			BP24 ABCDEF 3 ThrustThing(angle + random(-64,64), random(-1,3), 0, 0)
			"####" "#" 0 A_Turn(random(-45,45))
			"####" "#" 0 A_Jump(192, "BlueSee", "BlueMissile")
			"####" "#" 0 A_PlaySound("EleenaJump", CHAN_VOICE)
			"####" "#" 0 ThrustThingZ(0,40,0,1)
			"####" "#" 0 A_Jump(192, "BlueMissile")
			Loop
		DefSee:
			QP24 ABCDEF 3 ThrustThing(angle + random(-64,64), random(-1,3), 0, 0)
			"####" "#" 0 A_Turn(random(-45,45))
			"####" "#" 0 A_Jump(192, "DefSee", "DefMissile")
			"####" "#" 0 A_PlaySound("EleenaJump", CHAN_VOICE)
			"####" "#" 0 ThrustThingZ(0,40,0,1)
			"####" "#" 0 A_Jump(192, "DefMissile")
			Loop

		RedMissile:  RP24 G 0 A_LookEx(LOF_NOSEESOUND|LOF_NOJUMP, 0,0,0, 360, "See")  Goto See
		BlueMissile: BP24 G 0 A_LookEx(LOF_NOSEESOUND|LOF_NOJUMP, 0,0,0, 360, "See")  Goto See
		DefMissile:  QP24 G 0 A_LookEx(LOF_NOSEESOUND|LOF_NOJUMP, 0,0,0, 360, "See")  Goto See

		See:
			"####" "#" 0 A_Explode(1,512,XF_NOTMISSILE,0,512)
			"####" "#" 0 A_JumpIfInventory("QCRocketLauncherDM",1,"Rocket")
			"####" "#" 0 A_JumpIfInventory("QCLightningGunDM",1,"Shock")
			"####" "#" 100 A_Jump(256,"MG","Flak","Pulse","Rocket","Shock")


		MG:
			"####" H 0 A_PlaySound("UTDE/Weapons/Minigun/FireStartLoop",CHAN_WEAPON,1,1)
			"####" "#" 100 A_Jump(128,"MGAltAgain1")
		MGPrimAgain:
			"####" H 0 A_FaceTarget
			"####" H 0 A_Turn(random(-5,5))
			"####" H 0 A_CustomMissile("BulletSmallTracer", 40, 0, frandom(1,-1), CMF_AIMDIRECTION|CMF_NOUNLAGGED, frandom(1,-1))
			"####" H 0 A_CustomMissile("MinigunSmokeSpawner", 40, 0, 0, CMF_AIMOFFSET|CMF_OFFSETPITCH|CMF_NOUNLAGGED)
			"####" H 4 ThrustThing(angle + random(-64,64), random(-1,3), 0, 0)
			"####" H 0 A_Jump(24,"EndMG")
			Goto MGAgain
		MGAltAgain1:
			"####" H 0 A_FaceTarget
			"####" H 0 A_Turn(random(-5,5))
			"####" H 0 A_CustomMissile("BulletSmallTracer", 40, 0, frandom(1,-1), CMF_AIMDIRECTION|CMF_NOUNLAGGED, frandom(1,-1))
			"####" H 0 A_CustomMissile("MinigunSmokeSpawner", 40, 0, 0, CMF_AIMOFFSET|CMF_OFFSETPITCH|CMF_NOUNLAGGED)
			"####" H 4 ThrustThing(angle + random(-64,64), random(-1,3), 0, 0)
			"####" H 0 A_Jump(24,"EndMG")
			Goto MGAltAgain2
		MGAltAgain2:
			"####" H 0 A_FaceTarget
			"####" H 0 A_Turn(random(-5,5))
			"####" H 0 A_CustomMissile("BulletSmallTracer", 40, 0, frandom(1,-1), CMF_AIMDIRECTION|CMF_NOUNLAGGED, frandom(1,-1))
			"####" H 0 A_CustomMissile("MinigunSmokeSpawner", 40, 0, 0, CMF_AIMOFFSET|CMF_OFFSETPITCH|CMF_NOUNLAGGED)
			"####" H 4 ThrustThing(angle + random(-64,64), random(-1,3), 0, 0)
			"####" H 0 A_Jump(24,"EndMG")
			Goto MGAltAgain3
		MGAltAgain3:
			"####" H 0 A_FaceTarget
			"####" H 0 A_Turn(random(-5,5))
			"####" H 0 A_CustomMissile("BulletSmallTracer", 40, 0, frandom(1,-1), CMF_AIMDIRECTION|CMF_NOUNLAGGED, frandom(1,-1))
			"####" H 0 A_CustomMissile("MinigunSmokeSpawner", 40, 0, 0, CMF_AIMOFFSET|CMF_OFFSETPITCH|CMF_NOUNLAGGED)
			"####" H 4 ThrustThing(angle + random(-64,64), random(-1,3), 0, 0)
			"####" H 0 A_Jump(24,"EndMG")
			Goto MGAltAgain4
		MGAltAgain4:
			"####" H 0 A_FaceTarget
			"####" H 0 A_Turn(random(-5,5))
			"####" H 0 A_CustomMissile("BulletSmallTracer", 40, 0, frandom(1,-1), CMF_AIMDIRECTION|CMF_NOUNLAGGED, frandom(1,-1))
			"####" H 0 A_CustomMissile("MinigunSmokeSpawner", 40, 0, 0, CMF_AIMOFFSET|CMF_OFFSETPITCH|CMF_NOUNLAGGED)
			"####" H 4 ThrustThing(angle + random(-64,64), random(-1,3), 0, 0)
			"####" H 0 A_Jump(24,"EndMG")
			Goto MGAltAgain5
		MGAltAgain5:
			"####" H 0 A_FaceTarget
			"####" H 0 A_Turn(random(-5,5))
			"####" H 0 A_CustomMissile("BulletSmallTracer", 40, 0, frandom(1,-1), CMF_AIMDIRECTION|CMF_NOUNLAGGED, frandom(1,-1))
			"####" H 0 A_CustomMissile("MinigunSmokeSpawner", 40, 0, 0, CMF_AIMOFFSET|CMF_OFFSETPITCH|CMF_NOUNLAGGED)
			"####" H 4 ThrustThing(angle + random(-64,64), random(-1,3), 0, 0)
			"####" H 0 A_Jump(24,"EndMG")
			Goto MGAltAgain6
		MGAltAgain6:
			"####" H 0 A_FaceTarget
			"####" H 0 A_Turn(random(-5,5))
			"####" H 0 A_CustomMissile("BulletSmallTracer", 40, 0, frandom(1,-1), CMF_AIMDIRECTION|CMF_NOUNLAGGED, frandom(1,-1))
			"####" H 0 A_CustomMissile("MinigunSmokeSpawner", 40, 0, 0, CMF_AIMOFFSET|CMF_OFFSETPITCH|CMF_NOUNLAGGED)
			"####" H 4 ThrustThing(angle + random(-64,64), random(-1,3), 0, 0)
			"####" H 0 A_Jump(24,"EndMG")
			"####" H 0 A_PlaySound("UTDE/Weapons/Minigun/AltFireStartLoop",CHAN_WEAPON,1,0)
			Goto MGAltAgainFast
		MGAltAgainFast:
			"####" H 0 A_FaceTarget
			"####" H 0 A_Turn(random(-5,5))
			"####" H 0 A_CustomMissile("BulletSmallTracer", 40, 0, frandom(4,-4), CMF_AIMDIRECTION|CMF_NOUNLAGGED, frandom(4,-4))
			"####" H 0 A_CustomMissile("MinigunSmokeSpawner", 40, 0, 0, CMF_AIMOFFSET|CMF_OFFSETPITCH|CMF_NOUNLAGGED)
			"####" H 3 ThrustThing(angle + random(-64,64), random(-1,3), 0, 0)
			"####" H 0 A_Jump(24,"EndMG")
			Goto MGAltAgainFast
		EndMG:
			"####" H 0 A_PlaySound("UTDE/Weapons/Minigun/FireEnd",CHAN_WEAPON,1,0)
			Goto Idle


		Flak:
			"####" H 0 A_Jump(128,"FlakAlt")
		FlakPrim:
			"####" H 0 A_PlaySound("UTDE/Weapons/Flak/Fire", CHAN_WEAPON, 1.0, 0)
			"####" H 0 A_FaceTarget
			"####" H 0 A_Turn(random(-5,5))
			"####" AAAAAAAAA 0 A_CustomMissile("UTFlakShellIllusion",40,0,frandom(4.0,-4.0),CMF_AIMOFFSET|CMF_OFFSETPITCH,frandom(4.0,-4.0))
			"####" HHHHH 3 ThrustThing(angle + random(-64,64), random(-1,3), 0, 0)
			"####" "#" 0 ThrustThingZ(0,40 * random(0,1),0,1)
			"####" GGGGGG 3 ThrustThing(angle + random(-64,64), random(-1,3), 0, 0)
			"####" H 0 A_Jump(64,"FlakAlt")
			"####" H 0 A_Jump(64,"Idle")
			Goto Flak
		FlakAlt:
			"####" H 0 A_PlaySound("UTDE/Weapons/Flak/AltFire", CHAN_WEAPON, 1.0, 0)
			"####" H 0 A_FaceTarget
			"####" H 0 A_Turn(random(-5,5))
			"####" A 0 A_CustomMissile("UTFlakBombIllusion",40,0,0,CMF_AIMOFFSET|CMF_OFFSETPITCH,2)
			"####" HHHHH 3 ThrustThing(angle + random(-64,64), random(-1,3), 0, 0)
			"####" "#" 0 ThrustThingZ(0,40 * random(0,1),0,1)
			"####" GGGGGG 4 ThrustThing(angle + random(-64,64), random(-1,3), 0, 0)
			"####" H 0 A_Jump(128,"Flak")
			"####" H 0 A_Jump(64,"Idle")
			Goto FlakAlt


		Pulse:
			"####" H 0 A_Jump(128,"PulseAlt")
			"####" H 0 A_PlaySound("UTDE/Weapons/PulseGun/FireStartLoop",CHAN_WEAPON,1,1)
		PulseAgain:
			"####" H 0 A_FaceTarget
			"####" H 0 A_Turn(random(-5,5))
			"####" H 0 A_CustomMissile ("UTPulseStrongIllusion", 40, 0, random(-1,1), CMF_AIMOFFSET|CMF_OFFSETPITCH, random(-1,1))
			"####" H 3 ThrustThing(angle + random(-64,64), random(-1,3), 0, 0)
			"####" H 0 A_Jump(24,"EndPulse")
			Goto PulseAgain
		PulseAlt:
			"####" H 0 A_PlaySound("UTDE/Weapons/PulseGun/AltFireStartLoop",CHAN_WEAPON,1,1)
		PulseAltAgain:
			"####" H 0 A_FaceTarget
			"####" H 0 A_Turn(random(-1,1))
			"####" H 0 A_CustomRailgun(0, 2, None, "White", RGF_SILENT|RGF_NOPIERCING|RGF_FULLBRIGHT, 0, 0, "None", 0, 0, 768, 1, 25, 1.0, "PGworldactor")
			"####" H 1 ThrustThing(angle + random(-64,64), random(-1,3), 0, 0)
			"####" H 0 A_Jump(8,"EndPulse")
			Goto PulseAltAgain
		EndPulse:
			"####" H 0 A_PlaySound("UTDE/Weapons/PulseGun/FireEnd",CHAN_WEAPON,1,0)
			Goto Idle


		Rocket:
			"####" H 0 A_FaceTarget
			"####" H 0 A_Turn(random(-5,5))
			"####" H 0 A_PlaySound("UTDE/Weapons/RocketLauncher/Fire", CHAN_WEAPON, 1.0, 0)
			"####" H 0 A_CustomMissile("UTRocketMissileIllusion", 40, 0, random(-1,1), CMF_AIMOFFSET|CMF_OFFSETPITCH, random(-1,1))
			"####" HHHH 3 ThrustThing(angle + random(-64,64), random(-1,3), 0, 0)
			"####" "#" 0 ThrustThingZ(0,40 * random(0,1),0,1)
			"####" GGGGG 3 ThrustThing(angle + random(-64,64), random(-1,3), 0, 0)
			"####" H 0 A_Jump(64,"Idle")
			Goto Rocket


		Shock:
			"####" H 0 A_Jump(128,"ShockAlt")
		ShockPrim:
			"####" H 0 A_FaceTarget
			"####" H 0 A_Turn(random(-5,5))
			"####" H 0 A_PlaySound("UTDE/Weapons/ShockRifle/Fire", CHAN_WEAPON, 1.0, 0)
			"####" H 0 A_CustomRailgun(0, 2, None, "BlueViolet", RGF_SILENT|RGF_NOPIERCING|RGF_FULLBRIGHT, 0, 0, "ShockRiflePuff")
			"####" HHHHH 3 ThrustThing(angle + 64, random(-4,4), 0, 0)
			"####" "#" 0 ThrustThingZ(0,50 * random(0,1),0,1)
			"####" GGGGGGG 3 ThrustThing(angle + 64, random(-5,5), 0, 0)
			"####" H 0 A_Jump(96,"Idle")
			Goto Shock
		ShockAlt:
			"####" H 0 A_FaceTarget
			"####" H 0 A_Turn(random(-5,5))
			"####" H 0 A_PlaySound("UTDE/Weapons/ShockRifle/AltFire", CHAN_WEAPON, 1.0, 0)
			"####" H 0 A_CustomMissile("UTShockRifleOrbIllusion", 40, 0, random(-1,1), CMF_AIMOFFSET|CMF_OFFSETPITCH, random(-1,1))
			"####" HHHHH 3 ThrustThing(angle + 64, random(-4,4), 0, 0)
			"####" "#" 0 ThrustThingZ(0,50 * random(0,1),0,1)
			"####" GGGGGGG 3 ThrustThing(angle + 64, random(-5,5), 0, 0)
			"####" H 0 A_Jump(96,"Idle")
			Goto Shock

	Vanish:
	Death:
		TNT1 A 0 A_ChangeFlag("BRIGHT",0)
		TNT1 A 0 A_StopSound(5) //stops looping sounds
		TNT1 A 10 A_SpawnItemEx("EleenaDisappearFX", 0,0,30, 0,0,0, 0,SXF_CLIENTSIDE)
		Stop
	}
}

Actor DrawAttentionProc : CustomInventory
{
	DamageType "NoDamageToPlayers"
	States
	{
	Pickup:
		TNT1 A 0 A_Explode(1,512,XF_NOTMISSILE,0,512)
		Stop
	}
}

Actor UTFlakShellIllusion : UTFlakShell
{
	+SERVERNETID
	Damage (0)
	States
	{
	Death:
		TNT1 A 0 A_SpawnItemEx("UTFlakShellBouncedIllusion", 0, 0, 0, user_velx, user_vely, user_velz, 0, SXF_ABSOLUTEVELOCITY|SXF_TRANSFERPOINTERS)
		Stop
	}
}

Actor UTFlakShellBouncedIllusion : UTFlakShellBounced
{
	+SERVERNETID
	Damage (0)
}

Actor UTFlakBombIllusion : UTFlakBomb
{
	+SERVERNETID
	Damage (0)
	States
	{
	Death:
		TNT1 A 0 A_ChangeFlag("NOINTERACTION",1)
		TNT1 A 0 A_Stop
		Goto DeathCont

	XDeath:
		TNT1 A 0 A_ChangeFlag("NOINTERACTION",1)
		TNT1 A 0 A_Stop
		Goto DeathCont

	DeathCont:
		TNT1 A 0 A_PlaySound("UTDE/Weapons/Flak/Explo",CHAN_AUTO,1,0,1)
		TNT1 AAAAAAAAAA 0 A_SpawnItemEx("UTFlakShellBouncedIllusion",0,0,1,frandom(-30.0, 30.0),frandom(-30.0, 30.0),frandom(-30.0, 30.0))
		TNT1 A 0 A_SpawnItemEx("QCRocketExploDebris",-1,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED)
		TNT1 AAAAA 0 A_SpawnItemEx("QCRocketExploParticle",3,0,0,frandom(3,5.5),frandom(3,5.5),frandom(1,6),random(0,359),SXF_NOCHECKPOSITION|SXF_NOUNLAGGED)
		TNT1 A 10 A_SpawnItemEx("QCRocketExplosion",-2,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED)
		Stop
	}
}

Actor UTPulseStrongIllusion : UTPulseStrong
{
	+SERVERNETID
	Damage (0)
	States
	{
	Death:
		PULS A 0 A_PlaySound("UTDE/Weapons/PulseGun/Impact",CHAN_AUTO,1,0,1)
		PULS A 1 Light("YellowSmallFlicker3") Bright
		PULS B 3 Bright
		Stop
	}
}

Actor UTRocketMissileIllusion : UTRocketMissile
{
	+SERVERNETID
	Damage (0)
	States
	{
	XDeath:
	Crash:
	Death:
		TNT1 A 0 A_Stop
		TNT1 A 0 A_StopSound(7)
		TNT1 A 0 A_SpawnItemEx("QCRocketExploDebris",-1,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED)
		TNT1 AAAAA 0 A_SpawnItemEx("QCRocketExploParticle",3,0,0,frandom(3,5.5),frandom(3,5.5),frandom(1,6),random(0,359),SXF_NOCHECKPOSITION|SXF_NOUNLAGGED)
		TNT1 A 10 A_SpawnItemEx("QCRocketExplosion",-2,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED)
		Stop
	}
}

ACTOR UTShockRifleOrbIllusion : UTShockRifleOrb
{
	+SERVERNETID
	-SHOOTABLE
	+NOBLOCKMAP
	Damage 0
}

Actor EleenaSwapProc : CustomInventory
{
	States
	{
	Pickup:
		TNT1 A 0 A_SetBlend("Black", 0.7, 30)
		TNT1 A 0 A_SpawnItemEx("EleenaSwapFXRed", 0,0,0, 0,0,0, 0,SXF_NOCHECKPOSITION|SXF_NOUNLAGGED)
		TNT1 A 0 A_PlaySound("QC/Abilities/Eleena/SwapReal",CHAN_AUTO,1.0,false,1.5) // real Eleena sound
		Stop
	}
}

Actor EleenaSwapFXRed
{
	+NOINTERACTION
	+CLIENTSIDEONLY
	+NONETID
	RenderStyle Add
	Scale 0.7
	+BRIGHT
	States
	{
	Spawn:
		DB26 ABCDEFGHIJKLMNOPQRSTUV 1
		Stop
	}
}
Actor EleenaDisappearFX : EleenaSwapFXRed
{
	Scale 1.1
	Translation "0:255=%[0,0,0]:[1,1,2]"
	States
	{
	Spawn:
		DB17 ABCDEFGHIJKLMNOPQRSTUVWXYZ 1 BRIGHT
		Stop
	}
}


//--------------------------------------------------------
// Passive
//--------------------------------------------------------

Actor PowerEleenaSpeed : PowerSpeed
{
	+SERVERNETID
	Speed 1.20
	Inventory.Icon ""
	+POWERSPEED.NOTRAIL
}
